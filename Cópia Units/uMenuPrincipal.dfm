  object QVenda: TIBQuery
    Database = dmConexao.IBDConexao
    Active = True
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'SELECT V.CODIGO, V.DATA_VENDA,'
      '       LPAD(EXTRACT(MONTH FROM V.DATA_VENDA), 2, '#39'0'#39') AS MES,'
      '       EXTRACT(YEAR FROM V.DATA_VENDA) AS ANO,'
      
        '       P.CODIGO AS CODIGO_PRODUTO, VI.QUANTIDADE, P.DESCRICAO, E' +
        'F.CODIGO, EF.FANTASIA'
      ''
      'FROM VENDA V'
      '  JOIN VENDA_ITEM VI ON VI.CODIGO_VENDA = V.CODIGO'
      '  JOIN PRODUTO P ON P.CODIGO = VI.CODIGO_PRODUTO'
      '  JOIN EMPRESA_FILIAL EF ON EF.CODIGO = V.CODIGO_FILIAL'
      '--  LEFT JOIN PRODUTO_MARCA PM ON PM.CODIGO = P.COD_MARCA'
      '--  LEFT JOIN PRODUTO_SECAO PS ON PS.CODIGO = P.COD_SECAO'
      ''
      'WHERE V.DATA_VENDA BETWEEN '#39'01.01.2022'#39' AND '#39'31.03.2025'#39
      'ORDER BY 3,4, P.CODIGO')
    PrecommittedReads = False
    Left = 736
    Top = 352
