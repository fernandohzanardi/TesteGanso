unit uCalculaFuncoesFinanceiras;

interface

type
  TUcalculaFuncFinan = class

  private

  public
    class function CalculaTotalLiquido(Valor, PercDesc, PercAcresc: float): float; static;

  end;


implementation

class function TUcalculaFuncFinan.CalculaTotalLiquido (Valor, PercDesc, PercAcresc : float): float;
begin
  Result := (Valor * (1 - PercDesc / 100)) * (1 + PercAcresc / 100);
end;


end.
