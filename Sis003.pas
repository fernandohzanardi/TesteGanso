Function SintegraGeraReg10(_SinDtIni, _SinDtFim : TDate; _SinCodEstruArq, _SinCodNatOp, _SinFinalidadeArq : String ) : String;
var
  _SinFaxEmp : String;
begin
  try
    _SinFaxEmp := Copy(Trim(StringReplace(StringReplace(StringReplace(_EmpFax,'(','',[rfReplaceAll]),')','',[rfReplaceAll]),'-','',[rfReplaceAll])),1,10);
    if _SinFaxEmp = '' then _SinFaxEmp := '0';

    Result := '10'
             +_CNPJFilial.Trim.PadLeft(14, '0')
             +Copy(Trim(StringReplace(StringReplace(_EmpIE,'.','',[rfReplaceAll]),'-','',[rfReplaceAll])) + DupeString(Chr(32),14 - StrLen(pChar(Trim(StringReplace(StringReplace(_EmpIE,'.','',[rfReplaceAll]),'-','',[rfReplaceAll]))))),1,14)
             +Copy(Trim(_RazaoFilial) + DupeString(Chr(32),35 - StrLen(pChar(Trim(_RazaoFilial)))),1,35)
             +Copy(Trim(_EmpCidade) + DupeString(Chr(32),30 - StrLen(pChar(Trim(_EmpCidade)))),1,30)
             +Copy(Trim(_EmpUFLogada) + DupeString(Chr(32),2 - StrLen(pChar(Trim(_EmpUFLogada)))),1,2)
             +FormatFloat('0000000000',StrToFloat(_SinFaxEmp))
             +FormatDateTime('yyyymmdd',_SinDtIni)
             +FormatDateTime('yyyymmdd',_SinDtFim)
             +_SinCodEstruArq
             +_SinCodNatOp
             +_SinFinalidadeArq;
  except
    on _e : exception do
    begin
      Application.MessageBox(pChar('Erro ao gerar o Registro 10 do SINTEGRA.'+#13+#13+_e.Message),'ATENÇÃO',MB_OK+MB_ICONINFORMATION);
      Result := '';
    end;
  end;
end;

Function SintegraGeraReg11 : String;
