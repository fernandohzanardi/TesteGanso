Function GradeEstoques(_CodigoProdutoGrade, _CodigoEstoqueVer : Integer) : String;
var
  _EF, _ER, _EA, _EM, _EP : String;
begin
  Result := '';
  _Cria_IBQuery(nil,999);
  _IBQuery999.SQL.Text := ' select coalesce(pge.estoque,0) as "EF", '       // Estoque Físico
                        + ' coalesce(pge.estoque_reservado,0) as "ER", '    // Estoque Reservado
                        + ' coalesce(pge.estoque_aretirar,0) as "EA", '     // Estoque A Retirar
                        + ' coalesce(pge.estoque_minimo,0) as "EM", '       // Estoque Mínimo
                        + ' coalesce(pge.estoque,0) '
                        + '   - coalesce(pge.estoque_reservado,0) '
                        + +IIF(_ParEstConsARetPresumido,'- coalesce(pge.estoque_aretirar,0)','- 0')+' as "EP" ' // Estoque Presumido
                        + ' from produto_grade_estoque pge '
                        + ' where pge.codigo_produto_grade = '+IntToStr(_CodigoProdutoGrade)
                        + '  and pge.codigo_estoque = '+IntToStr(_CodigoEstoqueVer);
  _IBQuery999.Open;

  // Estoque Físico
  if _IBQuery999.FieldByName('EF').AsCurrency < 0 then
    _EF := FormatFloat('0000000000000',StrToCurr(StringReplace(FormatFloat('0.000',_IBQuery999.FieldByName('EF').AsCurrency),',','',[rfReplaceAll])))
  else
    _EF := FormatFloat('00000000000000',StrToCurr(StringReplace(FormatFloat('0.000',_IBQuery999.FieldByName('EF').AsCurrency),',','',[rfReplaceAll])));

  // Estoque Reservado
  if _IBQuery999.FieldByName('ER').AsCurrency < 0 then
    _ER := FormatFloat('0000000000000',StrToCurr(StringReplace(FormatFloat('0.000',_IBQuery999.FieldByName('ER').AsCurrency),',','',[rfReplaceAll])))
  else
    _ER := FormatFloat('00000000000000',StrToCurr(StringReplace(FormatFloat('0.000',_IBQuery999.FieldByName('ER').AsCurrency),',','',[rfReplaceAll])));

  // Estoque A Retirar
  if _IBQuery999.FieldByName('EA').AsCurrency < 0 then
    _EA := FormatFloat('0000000000000',StrToCurr(StringReplace(FormatFloat('0.000',_IBQuery999.FieldByName('EA').AsCurrency),',','',[rfReplaceAll])))
  else
    _EA := FormatFloat('00000000000000',StrToCurr(StringReplace(FormatFloat('0.000',_IBQuery999.FieldByName('EA').AsCurrency),',','',[rfReplaceAll])));

  // Estoque Mínimo
  if _IBQuery999.FieldByName('EM').AsCurrency < 0 then
    _EM := FormatFloat('0000000000000',StrToCurr(StringReplace(FormatFloat('0.000',_IBQuery999.FieldByName('EM').AsCurrency),',','',[rfReplaceAll])))
  else
    _EM := FormatFloat('00000000000000',StrToCurr(StringReplace(FormatFloat('0.000',_IBQuery999.FieldByName('EM').AsCurrency),',','',[rfReplaceAll])));

  // Estoque Presumido
  if _IBQuery999.FieldByName('EP').AsCurrency < 0 then
    _EP := FormatFloat('0000000000000',StrToCurr(StringReplace(FormatFloat('0.000',_IBQuery999.FieldByName('EP').AsCurrency),',','',[rfReplaceAll])))
  else
    _EP := FormatFloat('00000000000000',StrToCurr(StringReplace(FormatFloat('0.000',_IBQuery999.FieldByName('EP').AsCurrency),',','',[rfReplaceAll])));

  // 01 - 14 -> Estoque Físico
  // 15 - 28 -> Estoque Reservado
  // 29 - 42 -> Estoque A Retirar
  // 43 - 56 -> Estoque Mínimo
  // 57 - 70 -> Estoque Presumido

  Result := _EF + _ER + _EA + _EM + _EP;
  
  _IBQuery999.Close;
  _Destroy_IBQuery(999);
end;

