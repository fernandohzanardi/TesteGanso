function TCfg.CheckURI(pLocal: TLocalCfg; var pURI: String; pTipoValor: TTipoValor = tvStr): Integer;
var
  c: Integer;
begin
  //Esta função pertence a classe "TCfg".
  //Nunca chamar por outros métodos.
  //26.08.2015 - Marcio Rodrigues

  Result := -1;

  if (Trim(pURI) = '') then
    raise Exception.Create('O endereço do elemento não foi informado.')
  else
  if (Pos('[', pURI) <= 0) or (Pos(']', pURI) <= 0) then
    raise Exception.Create('O elemento raiz não foi informado.')
  else
  if (Pos(':', pURI) <= 0) then
    raise Exception.Create('O elemento limitador raiz não foi informado.')
  else
  if (pLocal in [lcXMLDB,lcFileXML,lcDAT]) then
    raise Exception.Create('Local de configuração não implementado.')
  else
  if (pLocal <> lcReg) and (pTipoValor = tvRegCurrency) then
    raise Exception.Create('O tipo de valor informado não é compatível com o local de armazenamento.');

  pURI := (Trim(pURI) + '\');
end;

function TCfg.SetINIContext(pURI: String): TDataContext;
var
  i: Integer;
  c: String;
begin
  //Esta função pertence a classe "TCfg".
  //Nunca chamar por outros métodos.
  //26.08.2015 - Marcio Rodrigues

  Result.dcINI_Sessao := '';
  Result.dcINI_Ident := '';

  c := '';

  for i := (Pos(']:', pURI) + 2) to Length(pURI) do
  begin
    if (Copy(pURI, i, 1) <> '\') then
      c := c + Copy(pURI, i, 1)
    else
    begin
      if (Result.dcINI_Sessao = '') then
        Result.dcINI_Sessao := c
      else
      if (Result.dcINI_Ident = '') then
      begin
        Result.dcINI_Ident := c;
        c := '';
        Break;
      end;

      c := '';
    end;
  end;
end;

function TCfg.SetRegContext(pURI: String): TDataContext;
var
  i: Integer;
  c, l: String;
begin
  //Esta função pertence a classe "TCfg".
  //Nunca chamar por outros métodos.
  //26.08.2015 - Marcio Rodrigues

  Result.dcREG_Valor := '';
  Result.dcREG_Chave := '';

  c := '';
  l := '\';

  pURI := StringReplace(pURI, '\\', '\', [rfReplaceAll]);
  pURI := StringReplace(pURI, '\\', '\', [rfReplaceAll]);

  for i := (Length(pURI) - 1) downto PosEx(':', pURI) do
  begin
    if (Copy(pURI, i, 1) <> l) then
      c := Copy(pURI, i, 1) + c
    else
    begin
      if (Result.dcREG_Valor = '') then
      begin
        Result.dcREG_Valor := c;
        c := '';
        l := ':';
      end
      else
      if (Result.dcREG_Chave = '') then
        Result.dcREG_Chave := c;
    end;
  end;
end;

procedure TCfg.ExecCmdSQL(pCmd: String);
var
  tmpQryCmd: TIBQuery;
  tmpTrs: TIBTransaction;
begin
  //Este procedimento pertence a classe "TCfg".
  //Nunca chamar por outros métodos.
  //26.08.2015 - Marcio Rodrigues

  if (Trim(pCmd) = '') then
    Exit;

  try
    tmpQryCmd := TIBQuery.Create(nil);
    tmpTrs := TIBTransaction.Create(nil);

    tmpQryCmd.Database := DM.IBbanco;
    tmpTrs.DefaultDatabase := DM.IBbanco;
    tmpTrs.Params.Add('read_committed');
    tmpTrs.Params.Add('rec_version');
    tmpTrs.Params.Add('nowait');
    tmpTrs.AutoStopAction := saRollback;
    tmpTrs.DefaultAction := TARollback;

    tmpQryCmd.Transaction := tmpTrs;
    tmpQryCmd.SQL.Text := pCmd;

    if (not tmpTrs.InTransaction) then
      tmpTrs.StartTransaction;

    tmpQryCmd.ExecSQL;

    if (tmpTrs.InTransaction) then
      tmpTrs.Commit;
  finally
    tmpQryCmd.Free;
  end;
end;

procedure TCfg.SetCfg(pLocal: TLocalCfg; pURI: String; pValor: Variant; pTipoValor: TTipoValor = tvStr; pCriar: Boolean = True);
var
  fINI: TIniFile;
  fDB: TMemIniFile;
  StrList: TStringList;
  r: TRegistry;
  dc: TDataContext;
  p, s: String;
begin
  {
    ### Classe criada para prover manipulação mais prática de configurações para objetos em Run-Time;
    ### 26.08.2015 - Marcio Rodrigues (Projeto DF-e)

    ### Nota: - Cuidado ao utilizar esta função em laço de repetição, pois a performance pode cair ao acessar arquivos muito grande ou o banco de dados.
              - ATENÇÃO para "lcINIDB": - Evite utilizar em operações críticas que requerem integridade na gravação dos dados.
                                     - A gravação simultânea do mesmo identificador poderá causar perda de dados do processo que gravar primeiro.
                                     - Se precisar utilizar no Firebird 1.5 então deve ser feita uma compatibilização.


    ### [lcINI] - Arquivo INI ###

    []:FILIAL_0001\Chave1   - OU -   [Ganso]:FILIAL_0001\Chave1   - OU -   [Path]:FILIAL_0001\Chave1  ->  Acessar arquivo "Banco.INI", padrão do Ganso.
    [C:\Ganso\Outro.INI]:Grupo1\Chave2  ->  Acessar arquivo específico pelo caminho absoluto.


    ### [lcINIDB] - Banco de Dados (INI) ###

    [REG_ID]:FILIAL_0001\Chave1  ->  Selecionar o registro indicado em "REG_ID". Ex.: "DFE_CFG_001".


    ### [lcReg] - Registro do Windows ###

    [HKEY_CURRENT_USER]:Grupo1\Subgrupo\Subgrupo\Valor3  ->  Acessar o ROOT específico, e em seguida o caminho da chave que contém os dados.


    ### Implementar futuramente se for necessário ###

      [lcDBXML]  ->  Arquivo de configuração no formato XML armazenado no banco de dados.
    [lcFileXML]  ->  Arquivo de configuração no formato XML armazenado num arquivo .XML no HD.
        [lcDAT]  ->  Mesmo funcionamento do "lcINIDB" ou "lcDBXML", mas com o arquivo criptografado e com assinatura MD5 no cabeçalho.

     TTipoValor  ->  Adicionar novos tipos de dados para armazenamento no Registro do Windows.  
  }

  try
    p := '';
    s := '';

    if (CheckURI(pLocal, pURI, pTipoValor) > 0) then
      Exit;

    p := CopyStrInTag(Trim(pURI), '[', ']');

    if (pLocal = lcINI) then
    begin
      if (Trim(p) = '') or (LowerCase(Trim(p)) = 'ganso') or (LowerCase(Trim(p)) = 'path') then
        p := ExtractFilePath(Application.ExeName) + '\Banco.ini';

      if (not pCriar) and (not FileExists(p)) then
        raise Exception.Create('O arquivo de configuração "' + p + '" não foi encontrado.');

      dc := SetINIContext(pURI);

      try
        fINI := TIniFile.Create(p);

        if (not pCriar) then
        begin
          if (not fINI.SectionExists(dc.dcINI_Sessao)) then
            raise Exception.Create('A sessão "' + dc.dcINI_Sessao + '" não foi encontrada no arquivo de configuração "' + p + '".');

          if (not fINI.ValueExists(dc.dcINI_Sessao, dc.dcINI_Ident)) then
            raise Exception.Create('A chave "' + dc.dcINI_Ident + '" da sessão "' + dc.dcINI_Sessao + '" não foi encontrada no arquivo de configuração "' + p + '".');
        end;

        case pTipoValor of
          tvStr: fINI.WriteString(dc.dcINI_Sessao, dc.dcINI_Ident, pValor);
          tvInt: fINI.WriteInteger(dc.dcINI_Sessao, dc.dcINI_Ident, pValor);
          tvBool: fINI.WriteBool(dc.dcINI_Sessao, dc.dcINI_Ident, pValor);
          tvDate: fINI.WriteDate(dc.dcINI_Sessao, dc.dcINI_Ident, pValor);
          tvTime: fINI.WriteTime(dc.dcINI_Sessao, dc.dcINI_Ident, pValor);
          tvDateTime: fINI.WriteDateTime(dc.dcINI_Sessao, dc.dcINI_Ident, pValor);
          tvFloat: fINI.WriteFloat(dc.dcINI_Sessao, dc.dcINI_Ident, pValor);
        end;
      finally
        fINI.Free;
      end;
    end
    else
    if (pLocal = lcINIDB) then
    begin
      if (p = '') then
        raise Exception.Create('O identificador do registro de configuração não foi informado.');

      if (Length(p) > 10) then
        raise Exception.Create('O identificador do registro de configuração deve possuir no máximo 10 caracteres.');

      s := coalesce(GetQryResult('select first 1 ini_file from ibe$f_config where (id = ''' + p + ''')'),''); { TODO -oWéliton : Conversão XE }

      if (s = '') and (not pCriar) then
        raise Exception.Create('Registro de configuração não encontrado.');

      try
        StrList := TStringList.Create;
        StrList.Clear;
        StrList.Text := s;

        fDB := TMemIniFile.Create('');
        fDB.SetStrings(StrList);

        dc := SetINIContext(pURI);

        if (not pCriar) then
        begin
          if (not fDB.SectionExists(dc.dcINI_Sessao)) then
            raise Exception.Create('A sessão "' + dc.dcINI_Sessao + '" não foi encontrada no registro de configuração com identificação "' + p + '".');

          if (not fDB.ValueExists(dc.dcINI_Sessao, dc.dcINI_Ident)) then
            raise Exception.Create('A chave "' + dc.dcINI_Ident + '" da sessão "' + dc.dcINI_Sessao + '" não foi encontrada no registro de configuração com identificação "' + p + '".');
        end;

        case pTipoValor of
          tvStr: fDB.WriteString(dc.dcINI_Sessao, dc.dcINI_Ident, pValor);
          tvInt: fDB.WriteInteger(dc.dcINI_Sessao, dc.dcINI_Ident, pValor);
          tvBool: fDB.WriteBool(dc.dcINI_Sessao, dc.dcINI_Ident, pValor);
          tvDate: fDB.WriteDate(dc.dcINI_Sessao, dc.dcINI_Ident, pValor);
          tvTime: fDB.WriteTime(dc.dcINI_Sessao, dc.dcINI_Ident, pValor);
          tvDateTime: fDB.WriteDateTime(dc.dcINI_Sessao, dc.dcINI_Ident, pValor);
          tvFloat: fDB.WriteFloat(dc.dcINI_Sessao, dc.dcINI_Ident, pValor);
        end;

        StrList.Clear;
        fDB.GetStrings(StrList);

        //ATENÇÃO: Se precisar utilizar no Firebird 1.5 então deve ser feita uma compatibilização.
        ExecCmdSQL('update or insert into ibe$f_config (id, ini_file) values (' + QuotedStr(p) + ', ' + QuotedStr(StrList.GetText) + ')');
      finally
        StrList.Free;
        fDB.Free;
      end;
    end
    else
    if (pLocal = lcReg) then
    begin
      if (p = '') then
        raise Exception.Create('O endereço raiz não foi informado.');

      //O usuário sempre tem acesso a sua configuração raiz (HKEY_CURRENT_USER) e algumas do computador (HKEY_LOCAL_MACHINE), mas pode não ter de outras raizes.
      //Se precisar acessar outros locais é necessário uma análise e adição no conjunto abaixo.

      if (Pos((',' + UpperCase(p) + ','), ',HKEY_CURRENT_USER,HKEY_LOCAL_MACHINE,') <= 0) then
        raise Exception.Create('O endereço raiz informado não é permitido.');

      s := Trim(Copy(pURI, (Pos(':', pURI) + 1), Length(pURI)));

      if (s = '') then
        raise Exception.Create('O endereço da chave de configuração não foi informado.');

      try
        r := TRegistry.Create;

        if (p = 'HKEY_CURRENT_USER') then
          r.RootKey := HKEY_CURRENT_USER
        else
        if (p = 'HKEY_LOCAL_MACHINE') then
          r.RootKey := HKEY_LOCAL_MACHINE
        else
          raise Exception.Create('O endereço raiz é inválido.');

        dc := SetRegContext(pURI);

        if (not pCriar) then
        begin
          if (not r.KeyExists(dc.dcREG_Chave)) then
            raise Exception.Create('A chave "' + p + '\' + dc.dcREG_Chave + '" não foi encontrada no Registro do Windows.');

          r.OpenKey(dc.dcREG_Chave, False);

          if (not r.ValueExists(dc.dcREG_Valor)) then
            raise Exception.Create('O valor "' + dc.dcREG_Valor + '" não foi encontrado na chave "' + p + '\' + dc.dcREG_Chave + '" no Registro do Windows.');
        end
        else
          r.OpenKey(dc.dcREG_Chave, pCriar);

        case pTipoValor of
          tvStr: r.WriteString(dc.dcREG_Valor, pValor);
          tvInt: r.WriteInteger(dc.dcREG_Valor, pValor);
          tvBool: r.WriteBool(dc.dcREG_Valor, pValor);
          tvDate: r.WriteDate(dc.dcREG_Valor, pValor);
          tvTime: r.WriteTime(dc.dcREG_Valor, pValor);
          tvDateTime: r.WriteDateTime(dc.dcREG_Valor, pValor);
          tvFloat: r.WriteFloat(dc.dcREG_Valor, pValor);
          tvRegCurrency: r.WriteCurrency(dc.dcREG_Valor, pValor);
        end;
      finally
        r.Free;
      end;
    end;
  finally
    Free;
  end;
end;

function TCfg.GetCfg(pLocal: TLocalCfg; var vReturnCode: Integer; pURI: String; pValorPadrao: Variant; pTipoValor: TTipoValor = tvStr; pForceCreate: Boolean = False): Variant;
