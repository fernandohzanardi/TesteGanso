Procedure GravarLOGErroRT(_NomeArqLogRT, _TextoLogRT : String);
var
  _ArquivoLOG : TextFile;
  _NomeArqLog, lCaminho, lLogErroRetaguarda : String;
  lArquivoIni: TIniFile;
begin
  {CD 5333 - João Vitor Nantes - 06/08/2024}
  try
    lCaminho := ExtractFilePath(Application.ExeName)+'Banco.ini';
    lArquivoIni := TIniFile.Create(lCaminho);

    if not lArquivoIni.ValueExists('APLICACAO', 'LogErroRetaguarda') then
      lArquivoIni.WriteString('APLICACAO', 'LogErroRetaguarda', 'N');

    lLogErroRetaguarda := lArquivoIni.ReadString('APLICACAO', 'LogErroRetaguarda', 'N');

    if not(lLogErroRetaguarda.Equals('S')) then
    begin
      Exit;
    end;
  finally
    lArquivoIni.Free;
  end;

  try
    _NomeArqLog := _NomeArqLogRT+'.txt';
    AssignFile(_ArquivoLOG,_NomeArqLog);
    if FileExists(_NomeArqLog) then
    begin
      Append(_ArquivoLOG) // se existe, inclui o texto no arquivo
    end
    else begin
      Rewrite(_ArquivoLOG); // se não existe, cria o arquivo
      Writeln(_ArquivoLOG,'---------------------------------------------------------------');
      Writeln(_ArquivoLOG,DateToStr(Date)+' '+TimeToStr(Time)+' Versão do Log: 1.0');
      Writeln(_ArquivoLOG,'---------------------------------------------------------------');
    end;
    Writeln(_ArquivoLOG,DateToStr(Date)+' '+TimeToStr(Time)+' - '+_TextoLogRT);
    try
      CloseFile(_ArquivoLOG);
    except
    end;
  except
  end;
end;

