        Font.Size := 10;
        Font.Color := $00515151;
        Font.Style := [fsBold];
        Caption := '6';
        Align := alLeft;
        Alignment := taCenter;
        Layout := tlCenter;
        Cursor := crHandPoint;
        OnClick := TMessageForm(Result).MaisDetalhesClick;
      end;

      TMessageForm(Result).lblDetalhes := TLabel.Create(TMessageForm(Result).pnBar);

      with TMessageForm(Result).lblDetalhes do
      begin
        ParentFont := False;
        Parent := TMessageForm(Result).pnBar;
        Font.Name := 'Tahoma';
        Font.Size := 8;
        Font.Color := $00515151;
        Caption := ' Mais detalhes...';
        Align := alClient;
