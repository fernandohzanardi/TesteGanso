function ValidarFinalizador(pCodigoFinalizador: Integer; pDataSetState: TDataSetState = dsEdit; pDataSourceTag: Integer = 0): Boolean;
var i: integer;
begin
  {- O padrão desta função é retornar somente os ativos;
   - Caso esta função seja chamada a partir do botão gravar das telas, pode ser informado apenas o código do finalizador,
    pois o state no momento de gravar é sempre insert ou edit;
   - Caso seja chamada a partir o exit de algum campo ou qualquer outra função, é ideal passar os demais parâmetros,
    já que não se sabe se o state é consulta, edição, inserção, navegando, etc...}

  Result := False;

  //Se a lista de finalizadores está vazia, preenche, e só então valida
  if (Length(_listaFinalizadores) = 0) then
  begin
    try
      _Cria_IBQuery(nil,999);
      _IBQuery999.Close;
      _IBQuery999.SQL.Text := 'select f.codigo, f.status from finalizador f';
      _IBQuery999.Open;

      while not(_IBQuery999.Eof) do
      begin
        SetLength(_listaFinalizadores,Length(_listaFinalizadores) + 1);
        _listaFinalizadores[Length(_listaFinalizadores) - 1].codigo := _IBQuery999.FieldByName('codigo').AsInteger;
        _listaFinalizadores[Length(_listaFinalizadores) - 1].status := _IBQuery999.FieldByName('status').AsString;
        _IBQuery999.Next;
      end;

    finally
      _IBQuery999.Close;
      _Destroy_IBQuery(999);
    end;
  end;

  //Valida finalizador baseado no estado do dataset
  //Se for insert ou edit, aceita somente ativos
  //Se for qualquer outro estado, aceita todos
  if ((pDataSetState in [dsInsert, dsEdit]) and (pDataSourceTag = 0) and (pCodigoFinalizador > 0)) then
  begin
    for i := 0 to (Length(_listaFinalizadores) - 1) do
    begin
      if (_listaFinalizadores[i].codigo = pCodigoFinalizador) then
      begin
        if (_listaFinalizadores[i].status = 'A') then
          Result := True;

        break;
      end;
    end;
  end
  else
    Result := true;
end;

