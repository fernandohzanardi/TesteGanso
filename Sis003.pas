procedure TConfGrid.ConfigurarGrid(colunas: string);
var
  lista: TStringList;
  field: string;
  i, j, width: integer;
begin
  //Configurar colunas do grid baseado em 'colunas'
  if trim(colunas) <> '' then
  begin
    lista := TStringList.Create;
    lista.Delimiter := '|';
    lista.DelimitedText := colunas;
    FGrid.Columns.Clear;
    for i := 0 to lista.Count - 1 do
    begin
      field := Copy(lista[i], 1, PosEx(',', lista[i]) - 1);
      width := StrToInt(Copy(lista[i], PosEx(',', lista[i]) + 1, Length(lista[i])));
      for j := 0 to High(FColunas) do
      begin
        if FColunas[j].field = field then
        begin
          FGrid.Columns.Add.Title.Caption := FColunas[j].Titulo;
          FGrid.Columns[FGrid.Columns.Count - 1].FieldName := FColunas[j].field;
          FGrid.Columns[FGrid.Columns.Count - 1].Alignment := FColunas[j].Alinhamento;
          FGrid.Columns[FGrid.Columns.Count - 1].ReadOnly := FColunas[j].ReadOnly;
          FGrid.Columns[FGrid.Columns.Count - 1].Color := FColunas[j].Cor;
          FGrid.Columns[FGrid.Columns.Count - 1].width := width;
          FGrid.Columns[FGrid.Columns.Count - 1].Title.Alignment := taCenter;
          FGrid.Columns[FGrid.Columns.Count - 1].Visible := FColunas[j].Visible;
          Break;
        end;
      end;
    end;
    FreeAndNil(lista);
  end
  else //Se não passar 'COLUNAS', restaura padrão
  begin
    FGrid.Columns.Clear;
    for j := 0 to High(FColunas) do
    begin
      FGrid.Columns.Add.Title.Caption := FColunas[j].Titulo;
      FGrid.Columns[FGrid.Columns.Count - 1].FieldName := FColunas[j].field;
      FGrid.Columns[FGrid.Columns.Count - 1].Alignment := FColunas[j].Alinhamento;
      FGrid.Columns[FGrid.Columns.Count - 1].ReadOnly := FColunas[j].ReadOnly;
      FGrid.Columns[FGrid.Columns.Count - 1].Color := FColunas[j].Cor;
      FGrid.Columns[FGrid.Columns.Count - 1].width := FColunas[j].WidthP;
      FGrid.Columns[FGrid.Columns.Count - 1].Title.Alignment := taCenter;
      FGrid.Columns[FGrid.Columns.Count - 1].Visible := FColunas[j].Visible;
    end;
  end;
end;

procedure TConfGrid.Atu_DisplayLabel;
var
  i, j: Integer;
begin
  for i := 0 to FGrid.DataSource.DataSet.FieldCount - 1 do
  begin
    for j := 0 to FGrid.Columns.Count -1 do
    begin
      if FGrid.DataSource.DataSet.Fields[i].FieldName = FGrid.Columns[j].FieldName then
      begin
        if Trim(FGrid.Columns[j].Title.Caption) = '' then
        begin
          FGrid.Columns[j].Title.Font.Color := clBtnFace;
          FGrid.Columns[j].Title.Caption := FGrid.DataSource.DataSet.Fields[i].DisplayLabel;
        end;
        Break;
      end;
    end;
  end;

  for i := 0 to FGrid.DataSource.DataSet.FieldCount - 1 do
  begin
    for j := 0 to High(FColunas) do
    begin
      if FGrid.DataSource.DataSet.Fields[i].FieldName = FColunas[j].Field then
      begin
        if Trim(FColunas[j].Titulo) <> '' then
          FGrid.DataSource.DataSet.Fields[i].DisplayLabel := FColunas[j].Titulo;
        Break;
      end;
    end;
  end;
end;

