  _IBQuery999.SQL.Clear;
  _IBQuery999.SQL.Add('SELECT EMPRESA_FILIAL.CODIGO');
  _IBQuery999.SQL.Add('FROM EMPRESA_FILIAL');
  _IBQuery999.SQL.Add('WHERE EMPRESA_FILIAL.CODIGO NOT IN (SELECT IBXBCTABUSERS_EMPRESA_FILIAL.CODIGO_EMPRESA_FILIAL');
  _IBQuery999.SQL.Add('                                    FROM IBXBCTABUSERS_EMPRESA_FILIAL');
  _IBQuery999.SQL.Add('                                    WHERE (IBXBCTABUSERS_EMPRESA_FILIAL.CODIGO_EMPRESA_FILIAL is not null) and IBXBCTABUSERS_EMPRESA_FILIAL.CODIGO_USUARIO = (SELECT IBXBCTABUSERS.UCIDUSER');
  _IBQuery999.SQL.Add('                                                                                         FROM IBXBCTABUSERS WHERE IBXBCTABUSERS.UCLOGIN = ' + QuotedStr(Usuario) + '))');
  _IBQuery999.Open;
  Result := _IBQuery999.IsEmpty;
  _Destroy_IBQuery(999);
end;

