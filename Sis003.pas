procedure IniciarCheckout(const pCodigoDav: Integer; pOwner: TComponent; const Transaction: TIBTransaction);
begin
  if not FrmPrincipalGanso.miCheckoutPedidos.Enabled then
  begin
    Application.MessageBox('O usuário não possui acesso à tela de checkout de pedidos.', 'ATENÇÃO', MB_ICONINFORMATION);
    Exit;
  end;

  with TQuery.Create(DM.IBbanco) do
  try
     Add('select o.status, o.checkout_status from orcamento o where o.codigo = :CodigoDav')
    .Param('CodigoDav', pCodigoDav)
    .Open;

    if not FieldValue('status').AsString.Equals('A') then
    begin
      Application.MessageBox('O DAV-Pedido não está aberto, não é possível iniciar um checkout!', 'ATENÇÃO', MB_ICONINFORMATION);
      Exit;
    end;

    if FieldValue('checkout_status').AsString.Equals('FI') then
    begin
      Application.MessageBox('O DAV-Pedido já possui checkout finalizado, não é possível iniciar um novo!', 'ATENÇÃO', MB_ICONINFORMATION);
      Exit;
    end;

    if FieldValue('checkout_status').AsString.Equals('DE') then
    begin
      Application.MessageBox('O checkout do DAV-Pedido foi devolvido. Revise as divergências para disponibilizá-lo novamente para checkout!', 'ATENÇÃO', MB_ICONINFORMATION);
      Exit;
    end;

    if FieldValue('checkout_status').AsString.IsEmpty or FieldValue('checkout_status').AsString.Equals('DE') then
    begin
      TrocarStatusCheckout('PE', null, null, pCodigoDav);
    end;

    if Assigned(frmCheckoutPedidos) then
    begin
      frmCheckoutPedidos.Close;
    end;

    frmCheckoutPedidos := TfrmCheckoutPedidos.Create(pOwner, pCodigoDav, _CodFilial, _Usuario, _Nome_Computador,
      FrmPrincipalGanso.Retaguarda1.Enabled);

    frmCheckoutPedidos.Show;
  finally
    Free;
  end;
end;

procedure TrocarStatusCheckout(const pNovoStatus: string; const pNovoUsuario, pNovoTerminal: Variant; const pCodigoDav: Integer);
var
  Transaction: TIBTransaction;
begin
  Transaction := TIBTransaction.Create(nil);
  Transaction.DefaultDatabase := DM.IBbanco;
  Transaction.SetTransactionLevel(ibtrReadCommitted);

  try
    with TQuery.Create(DM.IBbanco, Transaction) do
    try
       Add('update')
      .Add('  orcamento_item oi')
      .Add('set')
      .Add('  oi.checkout_status = :pNovoStatus,')
      .Add('  oi.checkout_usuario = :pNovoUsuario,')
      .Add('  oi.checkout_terminal = :pNovoTerminal')
      .Add('where oi.codigo_orcamento = :pCodigoDAV')
      .Add(' and coalesce(oi.checkout_status, ''PE'') <> ''EN''')
      .Param('pNovoStatus', pNovoStatus)
      .Param('pCodigoDAV', pCodigoDav)
      .Param('pNovoUsuario', pNovoUsuario)
      .Param('pNovoTerminal', pNovoTerminal)
      .ExecScript;

      if HasError then
        raise Error;
    finally
      Free;
    end;

    with TQuery.Create(DM.IBbanco, Transaction) do
      try
         Add('update')
        .Add('  orcamento o')
        .Add('set')
        .Add('  o.checkout_status = :pNovoStatus,')
        .Add('  o.checkout_usuario = :pNovoUsuario,')
        .Add('  o.checkout_terminal = :pNovoTerminal')
        .Add('where o.codigo = :pCodigoDAV')
        .Add(' and coalesce(o.checkout_status, ''PE'') <> ''EN''')
        .Param('pNovoStatus', pNovoStatus)
        .Param('pCodigoDAV', pCodigoDav)
        .Param('pNovoUsuario', pNovoUsuario)
        .Param('pNovoTerminal', pNovoTerminal)
        .ExecScript
        .Commit;

      if HasError then
        raise Error;
      finally
        Free;
      end;
  finally
    Transaction.Free;
  end;
end;

