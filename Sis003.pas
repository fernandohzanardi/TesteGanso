Function VerificaSaldoDisp(_CodigoCaixaCadastro, _CodigoFinalizador : Integer) : Currency;
var
  _CodCxDia : Integer;
begin
  // BEGIN - FAZER NA 3.0 (mudado todo o SQL)
  _Cria_IBQuery(nil,999);
  with _IBQuery999 do
  begin
    _IBQuery999.Close;
    _IBQuery999.SQL.Text := ' select c.codigo '
                           +' from caixa c '
                           +' where c.codigo_caixa_cadastro = '+IntToStr(_CodigoCaixaCadastro)
                           +'   and c.status = ''A'' ';
    _IBQuery999.Open;                               

    _CodCxDia := 0;
    if not(_IBQuery999.IsEmpty) then
      _CodCxDia := _IBQuery999.FieldByName('CODIGO').AsInteger;

    _IBQuery999.Close;
    // Buscando Saldo Anterior + Entradas - Troco Entrada - Saidas + Troco Saidas
    SQL.Text :=  ' SELECT '
                +'   (coalesce((select coalesce(csf.saldo_atual,0) '
                +'      from caixa_saldo_finalizador csf '
                +'      where csf.codigo_caixa_cadastro = '+IntToStr(_CodigoCaixaCadastro)
                +'        and csf.codigo_finalizador = '+IntToStr(_CodigoFinalizador)
                +'        and csf.codigo_caixa = (select first 1 c.codigo '
                +'                                from caixa c '
                +'                                where c.codigo_caixa_cadastro = '+IntToStr(_CodigoCaixaCadastro)
                +'                                  and c.status = ''F'' '
                +'                                order by c.data_movimentacao descending)),0)) '
                +' + '
                +'   (coalesce((select coalesce(sum(cmf.valor),0) '
                +'      from caixa_movimentacao_finalizador cmf '
                +'      where cmf.codigo_caixa = '+IntToStr(_CodCxDia)
                +'        and cmf.tipo_movimentacao = ''E'' '
                +'        and cmf.codigo_finalizador = '+IntToStr(_CodigoFinalizador)
                +'        and cmf.tipo = ''NO''),0)) '
                +' - '
                +'   (coalesce((select coalesce(sum(cmf.valor),0) '
                +'      from caixa_movimentacao_finalizador cmf '
                +'      where cmf.codigo_caixa = '+IntToStr(_CodCxDia)
                +'        and cmf.tipo_movimentacao = ''E'' '
                +'        and cmf.codigo_finalizador = '+IntToStr(_CodigoFinalizador)
                +'        and cmf.tipo = ''TR''),0)) '
                +' - '
                +'   (coalesce((select coalesce(sum(cmf.valor),0) '
                +'      from caixa_movimentacao_finalizador cmf '
                +'      where cmf.codigo_caixa = '+IntToStr(_CodCxDia)
                +'        and cmf.tipo_movimentacao = ''S'' '
                +'        and cmf.codigo_finalizador = '+IntToStr(_CodigoFinalizador)
                +'        and cmf.tipo = ''NO''),0)) '
                +' + '
                +'   (coalesce((select coalesce(sum(cmf.valor),0) '
                +'      from caixa_movimentacao_finalizador cmf '
                +'      where cmf.codigo_caixa = '+IntToStr(_CodCxDia)
                +'        and cmf.tipo_movimentacao = ''S'' '
                +'        and cmf.codigo_finalizador = '+IntToStr(_CodigoFinalizador)
                +'        and cmf.tipo = ''TR''),0)) '
                +' as "SALDOANTERIOR" '
                +' from caixa cref '
                +' where cref.codigo_caixa_cadastro = '+IntToStr(_CodigoCaixaCadastro)
                +'    and cref.status = ''A'' ';
    Open;
    if not(IsEmpty) then
    begin
      Result := FieldByName('SALDOANTERIOR').AsCurrency;
    end
    else
      Result := 0;
  end;
  _IBQuery999.Close;
  _Destroy_IBQuery(999);
end;

Procedure _CriaIBSql(_Transacao : TIBTransaction = nil);
begin
  _IBSql := TIBSQL.Create(nil);
  _IBSqlTransacao := TIBTransaction.Create(nil);
  _IBSqlTransacao.DefaultDatabase := DM.IBbanco;
  if _Transacao = nil then
    _IBSql.Transaction := _IBSqlTransacao
  else
    _IBSql.Transaction := _Transacao;
  _IBSqlTransacao.StartTransaction;
end;

Procedure _DestroyIBSql;
begin
  _IBSql.Free;
  if Assigned(_IBSqlTransacao) then
  begin
    if _IBSqlTransacao.InTransaction then _IBSqlTransacao.Rollback;
    _IBSqlTransacao.Free;
  end;
end;

Function VerificaUsoFinalizador(_CodigoFinalizador, _CodigoVenda : Integer; _pOrigem : String) : Boolean;
var
  _Tabela, _Campo, _CWhere : String;
begin
  if _pOrigem = 'ORCAMENTO' then
  begin
    _Tabela := 'orcamento_negociacao';
    _Campo := 'codigo_orcamento';
    _CWhere := ' and neg.tipo_finalizacao = ''NO''';
  end
  else if _pOrigem = 'CONTAS_RECEBER' then
  begin
    _Tabela := 'contas_receber_negociacao';
    _Campo := 'codigo_cr_selecao';
    _CWhere := ' and neg.tipo_finalizacao = ''NO''';
  end
  else if _pOrigem = 'CHEQUE' then
  begin
    _Tabela := 'cheque_recebe_negociacao';
    _Campo := 'codigo_recebe_selecao';
    _CWhere := ' and neg.tipo_finalizacao = ''NO''';
  end
  else if _pOrigem = 'CONTAS_PAGAR' then
  begin
    _Tabela := 'contas_pagar_negociacao';
    _Campo := 'codigo_cp_selecao';
    _CWhere := ' and neg.tipo_pagamento = ''CX''';
  end
  else if _pOrigem = 'OS' then
  begin
    _Tabela := 'os_negociacao';
    _Campo := 'codigo_os';
    _CWhere := ' and neg.tipo_finalizacao = ''NO''';
  end;
  // Buscando Finalizador na Negociação
  _Cria_IBQuery(nil,999);
  _IBQuery999.Close;
  _FinalizadorValorUso := 0;
  with _IBQuery999 do
  begin
    SQL.Text := ' select coalesce(sum(neg.valor),0) as "TOTAL" from '+_Tabela+' neg where neg.'+_Campo+' = '+IntToStr(_CodigoVenda)
               +' and neg.codigo_finalizador = '+IntToStr(_CodigoFinalizador)+_CWhere
               +' group by neg.codigo_finalizador ';
    Open;
    if not(IsEmpty) then
    begin
      _FinalizadorValorUso := FieldByName('TOTAL').AsCurrency;
      Result := True;
    end
    else begin
      _FinalizadorValorUso := 0;
      Result := False;
    end;
    if _pOrigem <> 'CONTAS_PAGAR' then // Não pode passar aqui se for CONTAS A PAGAR
    begin
      _IBQuery999.Close;
      SQL.Text := ' select first 1 coalesce(neg.acrescimo,0) as "acrescimo", coalesce(neg.desconto,0) as "desconto", '

                 +'  (select sum(coalesce(negs.valor_original,0)) from '+_Tabela+' negs '
                 +'     where negs.'+_Campo+' = '+IntToStr(_CodigoVenda)
                 +'     and negs.codigo_finalizador = '+IntToStr(_CodigoFinalizador)+' and negs.tipo_finalizacao = ''NO'' )'
                 +'  as "valor_original", '

                 +'  (select sum(coalesce(negs.acrescimo_valor,0)) from '+_Tabela+' negs '
                 +'     where negs.'+_Campo+' = '+IntToStr(_CodigoVenda)
                 +'     and negs.codigo_finalizador = '+IntToStr(_CodigoFinalizador)+' and negs.tipo_finalizacao = ''NO'' )'
                 +'  as "acrescimo_valor", '

                 +'  (select sum(coalesce(negs.desconto_valor,0)) from '+_Tabela+' negs '
                 +'     where negs.'+_Campo+' = '+IntToStr(_CodigoVenda)
                 +'     and negs.codigo_finalizador = '+IntToStr(_CodigoFinalizador)+' and negs.tipo_finalizacao = ''NO'' )'
                 +'  as "desconto_valor" '

                 +' from '+_Tabela+' neg where neg.'+_Campo+' = '+IntToStr(_CodigoVenda)
                 +' and neg.codigo_finalizador = '+IntToStr(_CodigoFinalizador)+' and neg.tipo_finalizacao = ''NO''';
      Open;
      if not(IsEmpty) then
      begin
        _FinAcrescimoUso := FieldByName('acrescimo').AsCurrency;
        _FinDescontoUso := FieldByName('desconto').AsCurrency;
        _FinVAcrescimoUso := ArredCurr(FieldByName('acrescimo_valor').AsCurrency,2);
        _FinVDescontoUso := ArredCurr(FieldByName('desconto_valor').AsCurrency,2);
        _FinValorOriginal := ArredCurr(FieldByName('valor_original').AsCurrency,2);
      end
      else begin
        _FinAcrescimoUso := 0;
        _FinDescontoUso := 0;
        _FinVAcrescimoUso := 0;
        _FinVDescontoUso := 0;
        _FinValorOriginal := 0;
      end;
    end;      
  end;
  _Destroy_IBQuery(999);
end;

Function PegaCreditoCli(_CodigoCliente : Integer; _TipoDoc : String; _ExcetoEsseDoc : Integer = 0) : Extended;
var
  _CodigoOS, _CodigoOrcamento : Integer;
begin
  _Cria_IBQuery(nil,999);
  _CodigoOS := 0; _CodigoOrcamento := 0;
  if _TipoDoc = 'ORCAMENTO' then
  begin
    _CodigoOrcamento := _ExcetoEsseDoc;
  end
  else if _TipoDoc = 'OS' then
  begin
    _CodigoOS := _ExcetoEsseDoc;
  end;
  with _IBQuery999 do
  begin
    _IBQuery999.Close;

    if _ExcetoEsseDoc > 0 then
    begin
      if _ParClientePadrao <> _CodigoCliente then // Se não for Cliente Padrão então verifica as vendas etc...
      begin
        SQL.Text := ' select first 1 coalesce(clc.credito_atual,0) - '
                   +' (select coalesce(sum(neg.valor),0) from orcamento o '
                   +'   left join orcamento_negociacao neg on (neg.codigo_orcamento = o.codigo) '
                   +'   left join finalizador f on (f.codigo = neg.codigo_finalizador) '
                   +'   where o.status = ''A'' and o.codigo_cliente = '+IntToStr(_CodigoCliente)
                   +'     and neg.tipo_finalizacao = ''NO'' '
                   +'     and neg.codigo_orcamento <> '+IntToStr(_CodigoOrcamento)
                   +'     and f.gera_credito_devolucao = ''S'' )'
                   +' - '
                   +' (select coalesce(sum(neg1.valor),0) from os os  '
                   +'   left join os_negociacao neg1 on (neg1.codigo_os = os.codigo) '
                   +'   left join finalizador f1 on (f1.codigo = neg1.codigo_finalizador) '
                   +'   where os.status = ''A'' and os.codigo_cliente = '+IntToStr(_CodigoCliente)
                   +'     and neg1.tipo_finalizacao = ''NO'' and neg1.codigo_os <> '+IntToStr(_CodigoOS)
                   +'     and f1.gera_credito_devolucao = ''S'' )'
                   +' as "SALDOCREDITO" '
                   +' from cliente_log_credito clc '
                   +' where clc.codigo_cliente = '+IntToStr(_CodigoCliente)
                   +' order by clc.codigo descending ';
      end
      else begin
        SQL.Text := ' select first 1 coalesce(clc.credito_atual,0) as "SALDOCREDITO" '
                   +' from cliente_log_credito clc '
                   +' where clc.codigo_cliente = '+IntToStr(_CodigoCliente)
                   +' order by clc.codigo descending ';
      end;
    end
    else begin
      SQL.Text := ' select first 1 coalesce(clc.credito_atual,0) - '
                 +' (select coalesce(sum(neg.valor),0) from orcamento o '
                 +'   left join orcamento_negociacao neg on (neg.codigo_orcamento = o.codigo) '
                 +'   left join finalizador f on (f.codigo = neg.codigo_finalizador) '
                 +'   where o.status = ''A'' and o.codigo_cliente = '+IntToStr(_CodigoCliente)
                 +'     and neg.tipo_finalizacao = ''NO'' '
                 +'     and f.gera_credito_devolucao = ''S'')'
                 +' - '
                 +' (select coalesce(sum(neg1.valor),0) from os os '
                 +'   left join os_negociacao neg1 on (neg1.codigo_os = os.codigo) '
                 +'   left join finalizador f1 on (f1.codigo = neg1.codigo_finalizador) '
                 +'   where os.status = ''A'' and os.codigo_cliente = '+IntToStr(_CodigoCliente)
                 +'     and neg1.tipo_finalizacao = ''NO'' '
                 +'     and f1.gera_credito_devolucao = ''S'' ) '
                 +' as "SALDOCREDITO" '
                 +' from cliente_log_credito clc '
                 +' where clc.codigo_cliente = '+IntToStr(_CodigoCliente)
                 +' order by clc.codigo descending ';
    end;
    Open;
    if not(IsEmpty) then
    begin
      // Luiz Santana - 24/10/2022 - Resolução de problema relatado pelo suporte quando emite mensagme de saldo insuficiente para valores iguais (digitado vs disponível em saldo)
      Result := ArredCurr(FieldByName('SALDOCREDITO').AsCurrency,2);
    end
    else
      Result := 0;
  end;
  _IBQuery999.Close;
  _Destroy_IBQuery(999);
end;

