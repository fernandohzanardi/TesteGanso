function DataFinal(Data_Inicial : TDateTime; Dias_Uteis : Integer; Sem_Fim_Semana : Boolean = False):TDateTime;
// Retorna uma data acresçida de mais um certo número de dias
// uteis descontando os fins de semana
// David
