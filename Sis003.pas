function _AnoBiSexto(Ayear: Integer): Boolean;
begin
  // Verifica se o ano é Bi-Sexto
  Result := (AYear mod 4 = 0) and ((AYear mod 100 <> 0) or (AYear mod 400 = 0));
end;

function _DiasPorMes(Ayear, AMonth: Integer): Integer;
  const DaysInMonth: array[1..12] of Integer = (31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31);
begin
  Result := DaysInMonth[AMonth];
  if (AMonth = 2) and _AnoBiSexto(AYear) then
    Inc(Result);
end;

