Function DAVUsaGenFilial(_GenNaoPAF : String; _Consulta: Boolean = False) : Integer;
var
  _ReiniciaNDav, _ProximoDAV : Integer;
begin
  // Se for versão PAF usa o GEN de acordo com a Filial, caso contrário usa o Generator normal
  _Cria_IBQuery(nil,999);
  _IBQuery999.Close;
  if (_PKeyCli <> _PKeyLib) then // Versão PAF
  begin
    { 29/09/2015 - Vicente Neto - CD 1748 }
    if _Consulta then
      _IBQuery999.SQL.Text := ' select gen_id(GEN_DAV_FILIAL'+FormatFloat('000',_CodFilial)+',0) as "GEN_DAV" from rdb$database'
    else
      _IBQuery999.SQL.Text := ' select gen_id(GEN_DAV_FILIAL'+FormatFloat('000',_CodFilial)+',1) as "GEN_DAV" from rdb$database';
  end
  else // Versão Não-PAF
  begin
    { 29/09/2015 - Vicente Neto - CD 1748 }
    if _Consulta then
      _IBQuery999.SQL.Text := ' select gen_id('+Trim(_GenNaoPAF)+',0) as "GEN_DAV" from rdb$database'
    else
      _IBQuery999.SQL.Text := ' select gen_id('+Trim(_GenNaoPAF)+',1) as "GEN_DAV" from rdb$database';
  end;
  _IBQuery999.Open;

  _ProximoDAV := _IBQuery999.FieldByName('GEN_DAV').AsInteger;

  { Luiz Santana - 21/04/2017 - Nova regra para numeração do DAV para BD com mais de 9 empresas:

    O número do DAV deve obedecer o mínimo de 10 dígitos conforme requisito do PAF-ECF.

    Legenda: S -> Série do DAV
             F -> Código da Filial
             n -> Numeração sequencial do DAV (utiliza-se o mesmo Generator para O.S. e Pedido)

             Obs: Ao atingir o limite da numeração deverá incrementar a série e reiniciar a numeração daquela filial (aumentar campo CODIGO para Bigint caso necessário)

    - Até a 8ª filial (ID <= 8):
      Formato: SFnnnnnnnn  <- reserva-se 8 dígitos para o numero do DAV
      Exemplo Filial 01: 1112345678

    - 9ª filial (ID = 9):
      Formato: SF0nnnnnnn  <- reserva-se 7 dígitos para o numero do DAV para evitar conflito com a 10ª filial
      Exemplo Filial 09: 1901234567

    - A partir da 10ª filial (ID >= 10):
      Formato: S9FFnnnnnn  <- reserva-se 6 dígitos para o numero do DAV
      Exemplo Filial 10: 1910123456
      Exemplo Filial 11: 1911123456
      Exemplo Filial 12: 1912123456
   }

  if (_PKeyCli <> _PKeyLib) and not _Consulta then { 29/09/2015 - Vicente Neto - CD 1748 }
  begin
    if (_ProximoDAV <= 1) then
    begin
      if _CodFilial <= 8 then
        _ProximoDAV := StrToInt('1'+FormatFloat('0',_CodFilial)+'00000001')
      else if _CodFilial = 9 then
        _ProximoDAV := StrToInt('1'+FormatFloat('0',_CodFilial)+'00000001')
      else if _CodFilial >= 10 then
        _ProximoDAV := StrToInt('19'+FormatFloat('00',_CodFilial)+'000001');
        
      _IBQuery999.Close;
      _IBQuery999.SQL.Text := 'SET GENERATOR GEN_DAV_FILIAL'+FormatFloat('000',_CodFilial)+' TO '+IntToStr(_ProximoDAV);
      try
        _IBQuery999.ExecSQL;
        _IBQuery999.Transaction.Commit;
      except
      end;
    end
    else begin
      _ProximoDAV := _IBQuery999.FieldByName('GEN_DAV').AsInteger;

      // Reiniciando a numeração e mudando a Série (1º Dígito)
      if ((_CodFilial <= 8)and(StrToInt(RightStr(IntToStr(_ProximoDAV),8)) >= 99999999))
       or((_CodFilial = 9)and(StrToInt(RightStr(IntToStr(_ProximoDAV),7)) >= 9999999))
       or((_CodFilial >= 10)and(StrToInt(RightStr(IntToStr(_ProximoDAV),6)) >= 999999)) then
      begin
        // Luiz Santana - 21/04/2017 - Nova regra para numeração do DAV para BD com mais de 9 empresas:
        if (_CodFilial <= 8) then
          _ReiniciaNDav := StrToInt(IntToStr(StrToInt(LeftStr(IntToStr(_ProximoDAV),1))+1)+FormatFloat('0',_CodFilial)+'00000000')
        else if (_CodFilial = 9) then
          _ReiniciaNDav := StrToInt(IntToStr(StrToInt(LeftStr(IntToStr(_ProximoDAV),1))+1)+FormatFloat('0',_CodFilial)+'00000000')
        else if (_CodFilial >= 10) then
          _ReiniciaNDav := StrToInt(IntToStr(StrToInt(LeftStr(IntToStr(_ProximoDAV),1))+1)+'9'+FormatFloat('00',_CodFilial)+'000000');
          
        _IBQuery999.Close;
        _IBQuery999.SQL.Text := 'SET GENERATOR GEN_DAV_FILIAL'+FormatFloat('000',_CodFilial)+' TO '+IntToStr(_ReiniciaNDav);
        try
          _IBQuery999.ExecSQL;
          _IBQuery999.Transaction.Commit;
        except
        end;
      end;
    end;
  end;

  Result := _ProximoDAV;
  _IBQuery999.Close;
  _Destroy_IBQuery(999);
end;

Function PVUsaGenFilial(_GenNaoPAF : String) : Integer;
var
  _ReiniciaNPV, _ProximaPV : Integer;
begin
  // Se for versão PAF usa o GEN de acordo com a Filial, caso contrário usa o Generator normal
  _Cria_IBQuery(nil,999);
  _IBQuery999.Close;
  if (_PKeyCli <> _PKeyLib) then // Versão PAF
    _IBQuery999.SQL.Text := ' select gen_id(GEN_PV_FILIAL'+FormatFloat('000',_CodFilial)+',1) as "GEN_PV" from rdb$database'
