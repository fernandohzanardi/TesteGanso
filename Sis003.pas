function FormatoCEP(Numero : String): String;
begin
  Result := '';
  Numero := Trim(Numero);

  if Length(Numero) = 8 then
    Result := copy(Numero,1,2) + '.' + copy(Numero,3,3) + '-' + copy(Numero,6,3)
  else
    Result := Numero;
end;

function FormatoCPF_CNPJ(Numero : String): String;
begin
  Result := '';
  Numero := Trim(Numero);

  if Length(Numero) = 11 then
    Result := copy(Numero,1,3) + '.' + copy(Numero,4,3) + '.' + copy(Numero,7,3) + '-' + copy(Numero,10,2)
  else if length(Numero) = 14 then
    Result := copy(Numero,1,2) + '.' + copy(Numero,3,3) + '.' + copy(Numero,6,3) + '/' + copy(Numero,9,4) + '-' + copy(Numero,13 ,2)
  else
    Result := Numero;
end;

