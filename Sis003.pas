function GeraArgumentos1500_IN_SQL(vArgSQLIn, vCampoOr : String) : String;
var
  vFiltraChar, vWhereOr : String;
  vX, vY : Integer;
begin
  vFiltraChar := '';
  vWhereOr := '';

  while StrLen(pChar(vArgSQLIn)) > 0 do
  begin
    vFiltraChar := '';
    for vX := 1 to StrLen(pChar(vArgSQLIn)) do
    begin
      if vX > 1500 then
      begin
        for vY := 1500 downto 1 do
        begin
          if vFiltraChar[vY] = ',' then
          begin
            Delete(vFiltraChar, vY, 1);
            Break;
          end;
          Delete(vFiltraChar, vY, 1);
        end;
        Break;
      end else
      begin
        vFiltraChar := vFiltraChar + vArgSQLIn[vX];
      end;
    end;

    if vFiltraChar[1] = ',' then
    begin
      Delete(vFiltraChar,1,1);
    end;

    vArgSQLIn := StringReplace(vArgSQLIn, vFiltraChar, '', [rfReplaceAll]);

    if (StrLen(pChar(vArgSQLIn)) > 0) and (vArgSQLIn[1] = ',') then
    begin
      Delete(vArgSQLIn,1,1);
    end;

    if vWhereOr = '' then
    begin
      vWhereOr := vCampoOr + ' in ('+vFiltraChar+')'
    end else
    begin
      vWhereOr := vWhereOr + ' or ' + vCampoOr + ' in ('+vFiltraChar+')';
    end;
  end;
  Result := '('+vWhereOr+')';
end;

