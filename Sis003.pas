function Busca_Base_ICMS(Codigo_NF_Item, CFOP: Integer; var Base_ICMS : Currency): Boolean;
var
  SQL_ICMS : String;
  _CODIGO_REGRAM_ICMS : Integer;
const
  SQL_ICMS_Padrao  = 'COALESCE((' +
                     '     SELECT REGRAOI.VALOR_TOTAL' +
                     '     FROM NOTA_FISCAL_ITEM REGRAOI' +
                     '       LEFT JOIN PRODUTO REGRAP ON (REGRAP.CODIGO = REGRAOI.CODIGO_PRODUTO)' +
                     '       LEFT JOIN PRODUTO_TRIBUTO REGRAPT ON (REGRAPT.CODIGO = REGRAP.CODIGO_TRIBUTO)' +
                     '     WHERE REGRAOI.CODIGO = NI.CODIGO),0)';
begin
  Result := False;
  _Cria_IBQuery(nil,999);
  _IBQuery999.Close;
  _IBQuery999.SQL.Add('SELECT P.CODIGO_REGRAM_ICMS');
  _IBQuery999.SQL.Add('FROM NOTA_FISCAL_ITEM NI');
  _IBQuery999.SQL.Add('LEFT JOIN PRODUTO P ON (P.CODIGO = NI.CODIGO_PRODUTO)');
  _IBQuery999.SQL.Add('WHERE NI.CODIGO = ' + IntToStr(Codigo_NF_Item));
  _IBQuery999.Open;

  if (_IBQuery999.FieldByName('CODIGO_REGRAM_ICMS').AsInteger > 0) and (CFOP > 0) then
  begin
    _CODIGO_REGRAM_ICMS := _IBQuery999.Fields[0].AsInteger;
    _IBQuery999.Close;
    _IBQuery999.SQL.Clear;
    _IBQuery999.SQL.Add('SELECT PRI.F_BASE_ICMS');
    _IBQuery999.SQL.Add('FROM PRODUTO_REGRAD_ICMS PRI');
    _IBQuery999.SQL.Add('WHERE PRI.CODIGO_REGRAM_ICMS = ' + IntToStr(_CODIGO_REGRAM_ICMS));
    _IBQuery999.SQL.Add('AND PRI.CFOP = ' + IntToStr(CFOP));
    _IBQuery999.Open;

    if (not _IBQuery999.IsEmpty) and (_IBQuery999.FieldByName('F_BASE_ICMS').AsString <> '') then
    begin
      SQL_ICMS := _IBQuery999.FieldByName('F_BASE_ICMS').AsString;
      _IBQuery999.Close;
      _IBQuery999.SQL.Clear;
      _IBQuery999.SQL.Add('SELECT ' + SQL_ICMS);
      _IBQuery999.SQL.Add('FROM NOTA_FISCAL_ITEM NI');
      _IBQuery999.SQL.Add('LEFT JOIN PRODUTO P ON (P.CODIGO = NI.CODIGO_PRODUTO)');
      _IBQuery999.SQL.Add('LEFT JOIN PRODUTO_TRIBUTO PT ON (PT.CODIGO = P.CODIGO_TRIBUTO)');
      _IBQuery999.SQL.Add('WHERE NI.CODIGO = ' + IntToStr(Codigo_NF_Item));
      _IBQuery999.Open;
      if not _IBQuery999.IsEmpty then
      begin
        Result := True;
        Base_ICMS := Base_ICMS + _IBQuery999.Fields[0].AsCurrency;
      end;
    end;
  end;

  if not Result then
  begin
    _IBQuery999.Close;
    _IBQuery999.SQL.Clear;
    _IBQuery999.SQL.Add('SELECT CASE WHEN PT.CST > 0 THEN ' + SQL_ICMS_Padrao +' ELSE 0.00 END ');
    _IBQuery999.SQL.Add('FROM NOTA_FISCAL_ITEM NI');
    _IBQuery999.SQL.Add('LEFT JOIN PRODUTO P ON (P.CODIGO = NI.CODIGO_PRODUTO)');
    _IBQuery999.SQL.Add('LEFT JOIN PRODUTO_TRIBUTO PT ON (PT.CODIGO = P.CODIGO_TRIBUTO)');
    _IBQuery999.SQL.Add('WHERE NI.CODIGO = ' + IntToStr(Codigo_NF_Item));
    _IBQuery999.Open;
//  if not _IBQuery999.IsEmpty then
//  begin
    Result := True;
    Base_ICMS := Base_ICMS + _IBQuery999.Fields[0].AsCurrency;
//  end;
  end;

  _Destroy_IBQuery(999);
end;

function Busca_Valor_ICMS(Codigo_NF_Item, CFOP: Integer; var Valor_ICMS : Currency): Boolean;
var
  SQL_ICMS : String;
  _CODIGO_REGRAM_ICMS : Integer;
const
  SQL_ICMS_Padrao  = 'COALESCE((' +
                     '         SELECT CAST(REGRAOI.VALOR_TOTAL * REGRAPT.CST / 100 AS NUMERIC(15,2))' +
                     '         FROM NOTA_FISCAL_ITEM REGRAOI' +
                     '         LEFT JOIN PRODUTO REGRAP ON (REGRAP.CODIGO = REGRAOI.CODIGO_PRODUTO)' +
                     '         LEFT JOIN PRODUTO_TRIBUTO REGRAPT ON (REGRAPT.CODIGO = REGRAP.CODIGO_TRIBUTO)' +
                     '         WHERE REGRAOI.CODIGO = NI.CODIGO),0)';
begin
  Result := False;
  _Cria_IBQuery(nil,999);
  _IBQuery999.Close;
  _IBQuery999.SQL.Add('SELECT P.CODIGO_REGRAM_ICMS');
  _IBQuery999.SQL.Add('FROM NOTA_FISCAL_ITEM NI');
  _IBQuery999.SQL.Add('LEFT JOIN PRODUTO P ON (P.CODIGO = NI.CODIGO_PRODUTO)');
  _IBQuery999.SQL.Add('WHERE NI.CODIGO = ' + IntToStr(Codigo_NF_Item));
  _IBQuery999.Open;

  if (_IBQuery999.FieldByName('CODIGO_REGRAM_ICMS').AsInteger > 0) and (CFOP > 0) then
  begin
    _CODIGO_REGRAM_ICMS := _IBQuery999.Fields[0].AsInteger;
    _IBQuery999.Close;
    _IBQuery999.SQL.Clear;
    _IBQuery999.SQL.Add('SELECT PRI.F_VALOR_ICMS');
    _IBQuery999.SQL.Add('FROM PRODUTO_REGRAD_ICMS PRI');
    _IBQuery999.SQL.Add('WHERE PRI.CODIGO_REGRAM_ICMS = ' + IntToStr(_CODIGO_REGRAM_ICMS));
    _IBQuery999.SQL.Add('AND PRI.CFOP = ' + IntToStr(CFOP));
    _IBQuery999.Open;

    if (not _IBQuery999.IsEmpty) and (_IBQuery999.FieldByName('F_VALOR_ICMS').AsString <> '') then
    begin
      SQL_ICMS := _IBQuery999.FieldByName('F_VALOR_ICMS').AsString;
      _IBQuery999.Close;
      _IBQuery999.SQL.Clear;
      _IBQuery999.SQL.Add('SELECT ' + SQL_ICMS);
      _IBQuery999.SQL.Add('FROM NOTA_FISCAL_ITEM NI');
      _IBQuery999.SQL.Add('LEFT JOIN PRODUTO P ON (P.CODIGO = NI.CODIGO_PRODUTO)');
      _IBQuery999.SQL.Add('LEFT JOIN PRODUTO_TRIBUTO PT ON (PT.CODIGO = P.CODIGO_TRIBUTO)');
      _IBQuery999.SQL.Add('WHERE NI.CODIGO = ' + IntToStr(Codigo_NF_Item));
      _IBQuery999.Open;
      if not _IBQuery999.IsEmpty then
      begin
        Result := True;
        Valor_ICMS := Valor_ICMS + _IBQuery999.Fields[0].AsCurrency;
      end;
    end;
  end;

  if not Result then
  begin
    _IBQuery999.Close;
    _IBQuery999.SQL.Clear;
    _IBQuery999.SQL.Add('SELECT ' + SQL_ICMS_Padrao);
    _IBQuery999.SQL.Add('FROM NOTA_FISCAL_ITEM NI');
    _IBQuery999.SQL.Add('LEFT JOIN PRODUTO P ON (P.CODIGO = NI.CODIGO_PRODUTO)');
    _IBQuery999.SQL.Add('LEFT JOIN PRODUTO_TRIBUTO PT ON (PT.CODIGO = P.CODIGO_TRIBUTO)');
    _IBQuery999.SQL.Add('WHERE NI.CODIGO = ' + IntToStr(Codigo_NF_Item));
    _IBQuery999.Open;
//    if not _IBQuery999.IsEmpty then
//    begin
    Result := True;
    Valor_ICMS := Valor_ICMS + _IBQuery999.Fields[0].AsCurrency;
//    end;
  end;

  _Destroy_IBQuery(999);
end;


