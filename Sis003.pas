function ConverterTDateTimeToDHXML(pDateTime: TDateTime; pRetornoDH: TRetornoConversaoDHXML = rDataHora; pUTC: Boolean = True): String;
begin
  //Conversão de Data/Hora XML em TDateTime.
  //Data/Hora UTC:  04/07/2013 09:36:44
  //Data/Hora XML:  2013-07-04T09:36:44
  Result := '';
  
  try
    if (pRetornoDH = rData) then
      Result := FormatDateTime('YYYY-MM-DD', pDateTime)
    else
    if (pRetornoDH = rHora) then
      Result := FormatDateTime('HH:NN:SS', pDateTime)
    else
    if (pRetornoDH = rDataHora) and (pUTC) then
      Result := FormatDateTime('YYYY-MM-DD', pDateTime) + 'T' + FormatDateTime('HH:NN:SS', pDateTime) + _NFE_FusoHorario
    else
    if (pRetornoDH = rDataHora) and (not pUTC) then
      Result := FormatDateTime('YYYY-MM-DD', pDateTime) + 'T' + FormatDateTime('HH:NN:SS', pDateTime);
  except
    Result := '';
  end;
end;

function ProcessarStatusNFe(vTipoNF: Char; vCodigoTipoNF: Integer): Boolean;
var
  ibqrNotaFiscal: TIBQuery;
  ibtsNotaFiscal: TIBTransaction;
  vCodigoNF, vCodigoLote: Integer;
begin
  Result := False;
  vCodigoNF := 0;
  vCodigoLote := 0;

  if (vCodigoTipoNF <= 0) or (not (vTipoNF in ['P','O','D','V','T','A'])) then
    Exit;

  try
    ibqrNotaFiscal := TIBQuery.Create(nil);
    ibtsNotaFiscal := TIBTransaction.Create(nil);
    ibqrNotaFiscal.Database := DM.IBbanco;
    ibtsNotaFiscal.DefaultDatabase := DM.IBbanco;
    ibqrNotaFiscal.Transaction := ibtsNotaFiscal;

    if not ibtsNotaFiscal.InTransaction then
      ibtsNotaFiscal.StartTransaction;

    ibqrNotaFiscal.SQL.Text := 'select ' +
                               '  nf.codigo, ' +
                               '  nfl.codigo as CODIGO_LOTE, ' +
                               '  nf.numero_nf, ' +
                               '  nf.data_emissao, ' +
                               '  nf.tipo_transmissao_nfe, ' +
                               '  nf.status as STATUS_NF, ' +
                               '  nf.codigo_lote_nfe, ' +
                               '  nfl.status ' +
                               'from nota_fiscal nf ' +
                               '  left join nfe_lote nfl on (nfl.codigo = nf.codigo_lote_nfe) ' +
                               'where ' +
                               '  (nf.status in (''E'',''L'')) ';

    if (vTipoNF = 'P') then // Pedido/Venda //
      ibqrNotaFiscal.SQL.Add(' and (nf.codigo_prevenda = :pCodigoTipoNF)')
    else
    if (vTipoNF = 'O') then // Ordem de Serviço //
      ibqrNotaFiscal.SQL.Add(' and (nf.codigo_os = :pCodigoTipoNF)')
    else
    if (vTipoNF = 'D') then // Devolução de Compra //
      ibqrNotaFiscal.SQL.Add(' and (nf.codigo_entrada = :pCodigoTipoNF)')
    else
    if (vTipoNF = 'V') then // Devolução de Venda //
      ibqrNotaFiscal.SQL.Add(' and (nf.codigo_devolucao = :pCodigoTipoNF)')
    else
    if (vTipoNF = 'T') then // Transferência de Estoque //
      ibqrNotaFiscal.SQL.Add(' and (nf.codigo_estoque_tranf = :pCodigoTipoNF)')
    else
    if (vTipoNF = 'A') then // Acompanhamento de CF //
      ibqrNotaFiscal.SQL.Add(' and (nf.codigo_venda = :pCodigoTipoNF)')
    else
      Exit;

    ibqrNotaFiscal.ParamByName('pCodigoTipoNF').AsInteger := vCodigoTipoNF;
    ibqrNotaFiscal.Open;

    if (ibqrNotaFiscal.IsEmpty) then
    begin
      Result := True;
      Exit;
    end;

    if (ibqrNotaFiscal.FieldByName('tipo_transmissao_nfe').AsString = 'TL') then
      Application.MessageBox('Esta Nota Fiscal foi marcada para transmissão em lote. Para consultar acesse Movimentação -> Notas Fiscais -> Manutenção de Lote.','ATENÇÃO',MB_OK+MB_ICONINFORMATION)
    else
    if (ibqrNotaFiscal.FieldByName('tipo_transmissao_nfe').AsString = 'TD') and (ibqrNotaFiscal.FieldByName('codigo_lote_nfe').AsInteger <= 0) then
      Application.MessageBox('Esta Nota Fiscal não possui um lote vinculado. Entre em contato com o Suporte Técnico.','ATENÇÃO',MB_OK+MB_ICONINFORMATION)
    else
    if (ibqrNotaFiscal.FieldByName('status').AsString = 'TS') then
      Application.MessageBox('Esta Nota Fiscal já foi transmitida anteriormente, porém, não possui retorno da SEFAZ. Para consultar acesse Movimentação -> Notas Fiscais -> Manutenção de Lote.','ATENÇÃO',MB_OK+MB_ICONINFORMATION)
    else
    if (ibqrNotaFiscal.FieldByName('status').AsString = 'TP') then
      Application.MessageBox('Esta Nota Fiscal já foi transmitida para a SEFAZ.','ATENÇÃO',MB_OK+MB_ICONINFORMATION)
    else
    if (ibqrNotaFiscal.FieldByName('status').AsString = 'TE') then
      Application.MessageBox('Esta Nota Fiscal já foi transmitida para a SEFAZ, mas houve um erro na aplicação após o processo de transmissão. Para consultar acesse Movimentação -> Notas Fiscais -> Manutenção de Lote.','ATENÇÃO',MB_OK+MB_ICONINFORMATION)
    else
    if (ibqrNotaFiscal.FieldByName('status').AsString = 'NT') then
    begin
      vCodigoNF := ibqrNotaFiscal.FieldByName('codigo').AsInteger;
      vCodigoLote := ibqrNotaFiscal.FieldByName('codigo_lote').AsInteger;

      if (ibqrNotaFiscal.FieldByName('tipo_transmissao_nfe').AsString = 'TD') then
      begin
        ibqrNotaFiscal.SQL.Text := 'delete from nfe_lote where codigo = ' + IntToStr(vCodigoLote);
        ibqrNotaFiscal.ExecSQL;
      end;

      ibqrNotaFiscal.SQL.Text := 'delete from nota_fiscal where codigo = ' + IntToStr(vCodigoNF);
      ibqrNotaFiscal.ExecSQL;

      if ibtsNotaFiscal.InTransaction then
        ibqrNotaFiscal.Transaction.Commit;

      Result := True;
    end;
  finally
    if ibtsNotaFiscal.InTransaction then
      ibtsNotaFiscal.Rollback;

     ibqrNotaFiscal.Free;
     ibtsNotaFiscal.Free;
  end;
end;

function ValidarLogotipoDANFE(MostrarAlerta: Boolean = False): String;
var
  imgLogotipoDANFE: TImage;
begin
  Result := '';

  if (Trim(_ParNFELogotipoDANFE) = '') then
    Exit
  else
  if (not FileExists(_ParNFELogotipoDANFE)) then
  begin
    if MostrarAlerta then
      Application.MessageBox(PChar('Logotipo não encontrado no local especificado.' +#13+#13+
                                   'Arquivo: "' + _ParNFELogotipoDANFE + '"'), 'ATENÇÃO', MB_OK+MB_ICONINFORMATION);

    Exit;
  end;

  try
    try
      imgLogotipoDANFE := TImage.Create(nil);
      imgLogotipoDANFE.AutoSize := True;
      imgLogotipoDANFE.Picture.LoadFromFile(_ParNFELogotipoDANFE);

      if (imgLogotipoDANFE.Width <> 339) or (imgLogotipoDANFE.Height <> 114) then
      begin
        if MostrarAlerta then
          Application.MessageBox(PChar('O logotipo deve ter a dimensão de exatamente 339 por 114 pixels.' +#13+#13+
                                       'Arquivo: "' + _ParNFELogotipoDANFE + '"'), 'ATENÇÃO', MB_OK+MB_ICONINFORMATION);
      end
      else
        Result := _ParNFELogotipoDANFE;
    except
      Result := '';
    end;
  finally
    imgLogotipoDANFE.Free;
  end;
end;

function VerificarAcessoPasta(Pasta: String): Boolean;
var
  vArquivoTMP: String;
  F: TextFile;
begin
  Result := False;
  vArquivoTMP := ExtractFilePath(Pasta) + 'nfetmp_' + _Nome_Computador + '_' + FormatDateTime('DDHHNNSSZZZ', Now) + '.$$$';

  try
    AssignFile(F, vArquivoTMP);
    Rewrite(F);
    Writeln(F, 'Ganso Sistemas');
    Writeln(F, 'Ganso Gestão Empresarial');
    Writeln(F, 'Testando leitura e gravação de arquivos. Este arquivo pode ser excluído.');
    CloseFile(F);
    DeleteFile(vArquivoTMP);
    Result := True;
  except
    on E:exception do
    begin
      Result := False;
      Application.MessageBox(PChar('O sistema não conseguiu acessar o caminho "' + Pasta + '". Verifique as possíveis causas:' +#13+#13+
                                   '- A unidade de rede está conectada;' +#13+
                                   '- O usuário possuí privilégios para leitura e gravação;' +#13+
                                   '- O usuário e senha do compartilhamento foram informados corretamente;'), 'ATENÇÃO', MB_OK+MB_ICONINFORMATION);
    end;
  end;
end;

function VerificarStatusVenda(CodigoNF: String): String;
