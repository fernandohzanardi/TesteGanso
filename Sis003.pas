Function GeraCodigo_AD(var vCodigoADOrigem : String; _Key : String) : String;
var
  _x : Integer;
  _addk : Boolean;
  _KeyConf : String;
begin
  _addk := True;
  _KeyConf := StringReplace(StringReplace(_Key,'<','',[rfReplaceAll]),'>','',[rfReplaceAll]);
  _x := 1;
  while _x <= StrLen(pChar(Trim(vCodigoADOrigem))) do
  begin
    if (Copy(vCodigoADOrigem,_x,3) = _KeyConf) then
    begin
      _addk := False;
      Break;
    end;
    _x := _x + 4;
  end;

  if _addk then
  begin
    // Verifica se o usuário possui permissão para esta chave.
    _Cria_IBQuery(nil,999);
    _IBQuery999.Close;
    _IBQuery999.SQL.Text := ' select ar.codigo '
                           +' from ibxbctabusers_acrestrito ar '
                           +' where ar.codigo_usuario = '+IntToStr(_CodUsuario)
                           +'   and ar.codigo_filial = '+IntToStr(_CodFilial)
                           +'   and ar.chave = '+QuotedStr(_Key);
    _IBQuery999.Open;
    _IBQuery999.Last; _IBQuery999.First;

    if (_IBQuery999.IsEmpty) then // Significa que o usuário não tem permissão para tal chave
      vCodigoADOrigem := vCodigoADOrigem + _KeyConf + '0'; { 0 - Não Liberado / 1 - Liberado }

    _IBQuery999.Close;
    _Destroy_IBQuery(999);
  end;
end;

function RemoveNameSpaces(XMLString: String): String;
const
  cRemoveNSTransform =
    '<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">'
    + '<xsl:output method="xml" indent="no"/>' +

    '<xsl:template match="/|comment()|processing-instruction()">' +
    '    <xsl:copy>' + '      <xsl:apply-templates/>' + '    </xsl:copy>' +
    '</xsl:template>' +

    '<xsl:template match="*">' + '    <xsl:element name="{local-name()}">' +
    '      <xsl:apply-templates select="@*|node()"/>' + '    </xsl:element>' +
    '</xsl:template>' +

    '<xsl:template match="@*">' + '    <xsl:attribute name="{local-name()}">' +
    '      <xsl:value-of select="."/>' + '    </xsl:attribute>' +
    '</xsl:template>' +

    '</xsl:stylesheet>';

var
  Doc, XSL: IXMLDOMDocument3;
  Res: string;
  p: integer;
begin
  Doc := CoDOMDocument60.Create;
  Doc.ASync := false;
  XSL := CoDOMDocument60.Create;
  XSL.ASync := false;
  try
    Doc.loadXML(XMLString);
    XSL.loadXML(cRemoveNSTransform);
    Res := Doc.TransFormNode(XSL);

    p := PosEx('?>', Res);
    result := Copy(Res, p + 2, Length(Res));
  except
    result := '';
  end;
end;

function GetXMLTag(vXML: WideString; vURI: String): String;
var
  NodeList : IXMLDOMNodeList;
  Node : IXMLDOMNode;
  XMLDocs: IXMLDOMDocument3;
begin
  Result := '';

  if (Trim(vXML) = '') then
    Exit;

  if (Trim(vURI) = '') then
    Exit;

  try
    try
      { 29/01/2016 - Wéliton Goulart - CD 1908 }
      XMLDocs := CoDOMDocument60.Create;
      XMLDocs.setProperty('SelectionLanguage', 'XPath');
      XMLDocs.loadXML(RemoveNameSpaces(vXML));

      NodeList := XMLDocs.selectNodes(vURI);
      Node := NodeList.item[0];

      if (Node <> nil) and (Node.childNodes.length = 1) then
        Result := Coalesce(Node.childNodes.item[0].nodeValue,'',True)
      else
        Result := '';
    except
      Result := '';
    end;
  finally
    XMLDocs := nil;
  end;
end;

function DecodeExpression(vXML: WideString; vExpression: Variant; vComponent: TObject): Variant;
var
  i2, vOR_Count: Integer;
  vStr, vValue, vXML_Valor, vInfo, vExp: Variant;
  tmpSQLComando: TIBQuery;
begin
  Result := Null;
  vExp := Trim(vExpression);
  i2 := 0;
  vOR_Count := 0;
  vStr := '';
  vValue := '';
  vInfo := Null;

  if (Coalesce(vExp,'',True) = '') then
    Exit;

  //Se não começar com barra ou arroba, então, cancela o processamento;
  if (not (Coalesce(Copy(Coalesce(vExp,'',True),1,1),' ',True)[1] in ['/','@'])) then
    Exit;

  //Se começar com barra e o segundo caractere não for uma barra, então, cancela o processamento;
  if (Copy(Coalesce(vExp,'',True),1,1) = '/') and (Copy(Coalesce(vExp,'',True),2,1) <> '/') then
    Exit;

  //Se começar com arroba e o segundo caractere não for barra ou "S", então, cancela o processamento;
  if (Copy(Coalesce(vExp,'',True),1,1) = '@') and (not (Coalesce(Copy(Coalesce(vExp,'',True),2,1),' ',True)[1] in ['/','S'])) then
    Exit;

  //Se começar com arroba, o segundo caractere for "S" e não iniciar com a sequência "@SQL:", então, cancela o processamento;
  if (Copy(Coalesce(vExp,'',True),1,1) = '@') and (Copy(Coalesce(vExp,'',True),2,1) = 'S') and (Copy(Coalesce(vExp,'',True),1,5) <> '@SQL:') then
    Exit;

  //Se começar com a sequência "@SQL:" mas não existir a palavra "SELECT", então, cancela o processamento;
  if (Copy(Coalesce(vExp,'',True),1,5) = '@SQL:') and (PosEx('SELECT',UpperCase(Coalesce(vExp,'',True))) <= 0) then
    Exit;

  //INICIO DA INTERPRETAÇÃO DE EXPRESSÕES;

  try
    if (Copy(Coalesce(vExp,'',True),1,2) = '//') then
      vInfo := Trim(GetXMLTag(vXML, Coalesce(vExp,'',True)))
    else
    if (Copy(Coalesce(vExp,'',True),1,1) = '@') then
    begin
      if (Copy(Coalesce(vExp,'',True),1,5) = '@SQL:') then
      begin
        try
          tmpSQLComando := TIBQuery.Create(nil);
          tmpSQLComando.Database := DM.IBbanco;
          tmpSQLComando.SQL.Text := Copy(Coalesce(vExp,'',True), PosEx('@SQL:', UpperCase(Coalesce(vExp,'',True)))+6, PosEx('=?', UpperCase(Coalesce(vExp,'',True)))-6);

          if (PosEx('<OR>', UpperCase(Coalesce(vExp,'',True))) > 0) then
          begin
            vOR_Count := 0;
            vValue := '';
            vStr := UpperCase(Coalesce(vExp,'',True));

            for i2 := 0 to (Length(Coalesce(vExp,'',True))-1) do
            begin
              if (PosEx('<OR>', UpperCase(Trim(Coalesce(vExp,'',True)))) > 0) then
              begin
                Inc(vOR_Count);
                vStr := Copy(vStr, PosEx('<OR>', UpperCase(Trim(vStr)))+4, 2000);
              end;
            end;

            vStr := Trim(Copy(Coalesce(vExp,'',True), PosEx('=?', UpperCase(Coalesce(vExp,'',True)))+3, 2000));

            for i2 := 0 to vOR_Count do
            begin
              if (Copy(UpperCase(Trim(vStr)), 1, PosEx('<OR>', UpperCase(Trim(vStr)))-1) <> '') then
                vValue := Trim(Copy(Trim(vStr), 1, PosEx('<OR>', UpperCase(Trim(vStr)))-1))
              else
                vValue := Trim(vStr);

              if (Trim(vValue) <> '') and (Copy(Trim(vValue), 1, 2) = '//') then
              begin
                if (Trim(GetXMLTag(vXML, vValue)) <> '') then
                begin
                  tmpSQLComando.SQL.Text := tmpSQLComando.SQL.Text + ' ' + QuotedStr(Trim(GetXMLTag(vXML, vValue)));
                  Break;
                end
                else
                begin
                  vStr := Trim(Copy(vStr, PosEx('<OR>', UpperCase(Trim(vStr)))+4, 2000));
                  vValue := '';
                end;
              end
              else
              if (Trim(vValue) <> '') and (Copy(Trim(vValue), 1, 1) = '[') then
              begin
                tmpSQLComando.SQL.Text := tmpSQLComando.SQL.Text + ' ' + QuotedStr(Copy(UpperCase(Trim(vValue)), PosEx('[', Trim(vValue))+1, PosEx(']', Trim(vValue))-2));
                Break;
              end;
            end;
          end
          else
            tmpSQLComando.SQL.Text := tmpSQLComando.SQL.Text + ' ' + Trim(GetXMLTag(vXML, Trim(Copy(Coalesce(vExp,'',True), PosEx('//', UpperCase(Coalesce(vExp,'',True)))-1, 2000))));

          if (PosEx('UPDATE', UpperCase(Trim(tmpSQLComando.SQL.Text))) <= 0) and (PosEx('INSERT', UpperCase(Trim(tmpSQLComando.SQL.Text))) <= 0)
            and (PosEx('DELETE', UpperCase(Trim(tmpSQLComando.SQL.Text))) <= 0) then
          begin
            try
              tmpSQLComando.Open;

              if (not tmpSQLComando.IsEmpty) then
                vInfo := tmpSQLComando.Fields[0].Value
              else
                vInfo := Null;
            except
              vInfo := Null;
            end;
          end;
        finally
          tmpSQLComando.Close;
          tmpSQLComando.Free;
        end;
      end
      else
      if (PosEx('<OR>', UpperCase(Coalesce(vExp,'',True))) > 0) then
      begin
        vStr := UpperCase(Coalesce(vExp,'',True));

        for i2 := 0 to Length(vStr)-1 do
        begin
          if (PosEx('<OR>', UpperCase(Trim(vStr))) > 0) then
          begin
            Inc(vOR_Count);
            vStr := Copy(vStr, PosEx('<OR>', UpperCase(Trim(vStr)))+4, 2000);
          end;
        end;

        vStr := StringReplace(Coalesce(vExp,'',True),'@','',[rfReplaceAll]);

        for i2 := 0 to vOR_Count do
        begin
          if (Trim(Copy(vStr, 1, PosEx('<OR>', UpperCase(Trim(vStr)))-1)) <> '') then
            vValue := Trim(Copy(vStr, 1, PosEx('<OR>', UpperCase(Trim(vStr)))-1))
          else
            vValue := Trim(vStr);

          if (Trim(vValue) <> '') and (Copy(Trim(vValue), 1, 2) = '//') then
          begin
            if (Trim(GetXMLTag(vXML, vValue)) <> '') then
            begin
              vInfo := Trim(GetXMLTag(vXML, vValue));
              Break;
            end
            else
            begin
              vStr := Trim(Copy(vStr, PosEx('<OR>', UpperCase(Trim(vStr)))+4, 2000));
              vValue := '';
            end;
          end
          else
          if (Trim(vValue) <> '') and (Copy(Trim(vValue), 1, 1) = '[') then
          begin
            vInfo := Copy(UpperCase(Trim(vValue)), PosEx('[', Trim(vValue))+1, PosEx(']', Trim(vValue))-2);
            Break;
          end;
        end;
      end;
    end;
  finally
    if (vComponent is TDateTimeField) and (Coalesce(vInfo,'',True) <> '') then
      Result := ConverterDataHoraXML(vInfo)
    else
    if (vComponent is TNumericField) and (Coalesce(VarToStr(vInfo),'',True) <> '') then
      Result := StrToFloat(Coalesce(Trim(StringReplace(VarToStr(vInfo),'.',',',[rfReplaceAll])),'0',True))
    else
    if (vComponent is TNumericField) and (Trim(Coalesce(VarToStr(vInfo),'',True)) = '') then
      Result := 0.00
    else
      Result := Coalesce(vInfo,'',True);
  end;
end;
   
procedure SetValueFromXML(vObject: TObject; vXML: WideString);
var
  i: Integer;
  tmpSQLComando: TIBQuery;
  vValorCampo: Variant;

  function GetTableField(vField: TField): String;
  begin
    Result := Copy(vField.Origin, 2, PosEx('"."',vField.Origin)-2);
  end;
begin
  i := 0;
  vValorCampo := Null;

  if (vObject = nil) then
    Exit;

  if (not Assigned(vObject)) then
    Exit;

  if (Trim(vXML) = '') then
    Exit;

  if (vObject is TForm) then
  begin
    for i := 0 to ((vObject as TForm).ComponentCount - 1) do
    begin
      if ((vObject as TForm).Components[i].ClassType = TEdit) and (Trim(((vObject as TForm).Components[i] as TEdit).HelpKeyword) <> '') then
        ((vObject as TForm).Components[i] as TEdit).Text := DecodeExpression(vXML, Trim((((vObject as TForm).Components[i] as TEdit).HelpKeyword)), nil)
      else
      if ((vObject as TForm).Components[i].InheritsFrom(TField)) and (((vObject as TForm).Components[i] as TField).DataSet is TIBDataSet)
        and (not ((vObject as TForm).Components[i] as TField).ReadOnly) and (((vObject as TForm).Components[i] as TField).FieldKind <> fkCalculated)
        and (Trim(((vObject as TForm).Components[i] as TField).Origin) <> '') and (((vObject as TForm).Components[i] as TField).DataSet.State in [dsEdit, dsInsert]) then
      begin
        _Cria_IBQuery(nil,999);
        _IBQuery999.Close;
        _IBQuery999.SQL.Text := 'select rdb$description from rdb$relation_fields where (rdb$relation_name = :pTabela) and (rdb$field_name = :pCampo)';
        _IBQuery999.ParamByName('pTabela').AsString := GetTableField(((vObject as TForm).Components[i] as TField));
        _IBQuery999.ParamByName('pCampo').AsString := ((vObject as TForm).Components[i] as TField).FieldName;
        _IBQuery999.Open;

        if (not _IBQuery999.IsEmpty) and (Trim(_IBQuery999.FieldByName('rdb$description').AsString) <> '') then
        begin
          try
            vValorCampo := DecodeExpression(vXML, Trim(_IBQuery999.FieldByName('rdb$description').AsString), ((vObject as TForm).Components[i] as TField));

            if (vValorCampo <> Null) or (Trim(Coalesce(vValorCampo,'',True)) <> '') then
              ((vObject as TForm).Components[i] as TField).Value := vValorCampo
            else
              ((vObject as TForm).Components[i] as TField).Clear;
          except
            ((vObject as TForm).Components[i] as TField).Clear;
          end;
        end;

        _Destroy_IBQuery(999);
      end;
    end;
  end;
end;

function CheckKeyAmbiente: String;
var
  vSerial, vData, vPC: String;
begin
  vSerial := IntToHex(StrToInt64(NSHD()),50);
  vData := FormatDateTime('MMYYYY',Date);
  vPC := _Nome_Computador;

  _Cria_IBQuery(nil,999);
  _IBQuery999.Close;
  _IBQuery999.SQL.Text := 'select(f_encryptmd5('+QuotedStr(Encrypt(vData+vSerial+vPC,874))+'))from rdb$database';
  _IBQuery999.Open;

  Result := Encrypt(Trim(_IBQuery999.FieldByName('f_encryptmd5').AsString),352);
  _Destroy_IBQuery(999);
end;

//Função que recebe uma chave de NF-e e retorna sua validade.
function ValidaChaveNFe(AChave: string; var ADados: TStringList): Boolean;
var
  LMult: string;
  I, LSoma, LDV: Integer;

  function ValorCharChaveNFe(const AChar: Char): Integer;
  begin
    if AChar in ['0'..'9'] then
      Result := Ord(AChar) - Ord('0')
    else if AChar in ['A'..'Z'] then
      Result := Ord(AChar) - 48
    else
    begin
      GeraMensagem(Format('Caractere inválido na chave: %s', [AChar]));
      Abort;
    end;
  end;
begin
  Result := False;
  AChave := UpperCase(Trim(AChave));

  if Length(AChave) <> 44 then
  begin
    GeraMensagem('A chave digitada não possui 44 caracteres!');
    Exit;
  end;

  if not Assigned(ADados) then
    ADados := TStringList.Create;

  ADados.Clear;

  try
    ADados.Add('UF=' + Copy(AChave, 1, 2));
    ADados.Add('EMISSAO=' + Copy(AChave, 3, 4));
    ADados.Add('CNPJ=' + Copy(AChave, 7, 14));
    ADados.Add('MODELO=' + Copy(AChave, 21, 2));
    ADados.Add('SERIE=' + Copy(AChave, 23, 3));
    ADados.Add('NNF=' + Copy(AChave, 26, 9));
    ADados.Add('CNF=' + Copy(AChave, 35, 9));
    ADados.Add('DV=' + Copy(AChave, 44, 1));

    LMult := '4329876543298765432987654329876543298765432';

    LSoma := 0;
    for I := 1 to 43 do
      LSoma := LSoma + ValorCharChaveNFe(AChave[I]) * StrToInt(LMult[I]);

    LDV := 11 - (LSoma mod 11);

    if LDV > 9 then
      LDV := 0;

    Result := LDV = StrToInt(ADados.Values['DV']);

    if not Result then
    begin
      ADados.Clear;
      GeraMensagem('A chave digitada é inválida!');
    end;

  except
    on E: Exception do
    begin
      ADados.Clear;
      Result := False;
    end;
  end;
end;

procedure TrataCSTICMSProduto(CST: TObject);
var
  _ResultDigIrregularCST : Integer;
  vObjEdit: TEdit;
  vWinControl: TWinControl;
begin
  if (not (CST is TDBEdit)) and (not (CST is TEdit)) and (not (CST is TEditTyped)) then
    Exit;

  vObjEdit := TEdit.Create(nil);
  vObjEdit.Visible := False;

  if (CST is TDBEdit) then
  begin
    vObjEdit.Text := (CST as TDBEdit).Text;
    vObjEdit.Parent := (CST as TDBEdit).Parent;
    vWinControl := (CST as TDBEdit);
  end
  else
  if (CST is TEdit) then
  begin
    vObjEdit.Text := (CST as TEdit).Text;
    vObjEdit.Parent := (CST as TEdit).Parent;
    vWinControl := (CST as TEdit);
  end
  else
  if (CST is TEditTyped) then
  begin
    vObjEdit.Text := (CST as TEditTyped).Text;
    vObjEdit.Parent := (CST as TEditTyped).Parent;
    vWinControl := (CST as TEditTyped);
  end;

  if Trim(vObjEdit.Text) = '' then Exit;

  _ResultDigIrregularCST := TrataCST_ICMS(Trim(vObjEdit.Text));

