      end;

      if PosEx('||'+_CNPJFilial,_StrArqSemAss) > 1 then
        Result := 1;

    finally
      _ArqLicPl.Free;
    end;
  end;
var
  _KFPL : String;
  _RetVPL : Integer;
begin
  _RetVPL := VPLCTRCL;
  if _RetVPL = 0 then
  begin
    Result := 1; // Sem verificação de Plano (Cliente comercializado sem plano) 
    Exit;
  end;

  if _RetVPL = 2 then
  begin
    Result := 0; // Abortar
    Exit;
  end;

  _Cria_IBQuery(nil,999);
  
  try
    Result := 0; // Abortar
    _RetRGPlCtr := '';

    // Verificando/Definindo CPF/CNPJ da empresa logada
    if _CNPJFilial=_RetRGPlCtr then // Sem CPF/CNPJ definido
    begin
      while True do
      begin
        if CaixaDlgPadrao('CPF/CNPJ da Empresa'
                         ,'           Informe o CPF/CNPJ (sem máscara): '
                         ,9
                         ,_CNPJFilial
                         ,''
                         ,teNumber
                         ,#0
                         ,9
                         ,180
                         ,ecUpperCase) then
        begin
          if (Trim(_CNPJFilial) = '') then
          begin
            Application.MessageBox('Informe o CPF/CNPJ válido para esta Empresa.','ATENÇÃO',MB_OK + MB_ICONINFORMATION);
          end
          else begin
            if ((StrLen(pChar(Trim(_CNPJFilial))) = 14) and not(ChecaCNPJ(_CNPJFilial,False)))
            or ((StrLen(pChar(Trim(_CNPJFilial))) < 14) and not(ChecaCPF(_CNPJFilial,False))) then
            begin
              Application.MessageBox(pChar(IfThen(StrLen(pChar(Trim(_CNPJFilial))) = 14,'CNPJ','CPF')+' inválido.'+#13+'Informe o número corretamente e sem a máscara!'),'ATENÇÃO',MB_OK + MB_ICONINFORMATION);
            end
            else begin
              _CNPJFilial := StringReplace(StringReplace(StringReplace(UpperCase(_CNPJFilial),'.','',[rfReplaceAll]),'/','',[rfReplaceAll]),'-','',[rfReplaceAll]);
              try
                _IBQuery999.Close;
                _IBQuery999.SQL.Text := 'update empresa_filial set cnpj = '+QuotedStr(_CNPJFilial)+' where codigo = '+IntToStr(_CodFilial);
                try
                  _IBQuery999.ExecSQL;
                  _IBTransaction999.Commit;
                except
                  on _err : exception do
                  begin
                    if _IBTransaction999.InTransaction then
                      _IBTransaction999.Rollback;
                    Application.MessageBox(pChar('Erro ao gravar "CPF/CNPJ" para esta Empresa, verifique:'+#13+#13+_err.Message),'ATENÇÃO',MB_OK + MB_ICONINFORMATION);
                    Exit;
                  end;
                end;
              finally
              end;
              Break;
            end;
          end;
        end
        else begin
          Exit;
          Break;
        end;
      end;
    end;

    // Verificando/Gravando a Chave para Funcionamento do Plano
    _IBQuery999.Close;
    _IBQuery999.SQL.Text := 'select kfpl from empresa_filial where codigo = '+IntToStr(_CodFilial);
    _IBQuery999.Open;
    _IBQuery999.FetchAll;
    _KFPL := _IBQuery999.FieldByName('kfpl').AsString;

    if _KFPL=_RetRGPlCtr then // Sem Chave de Funcionamento do Plano definido
    begin
      while True do
      begin
        if CaixaDlgPadrao('Ativação do Plano Contratado'
                         ,'           Informe a Chave de ativação do Plano: '
                         ,9
                         ,_KFPL
                         ,'AAAAAA\-AAAAAA\-AAAAAA\-AAAAAA\-AAAAAA\.AA;1'
                         ,teString
                         ,#0
                         ,9
                         ,230
                         ,ecUpperCase) then
        begin
          if (Trim(_KFPL) = '')or(not(ValidaPadraoMD5(StringReplace(StringReplace(UpperCase(_KFPL),'-','',[rfReplaceAll]),'.','',[rfReplaceAll])))) then
          begin
            if Trim(_KFPL) = '' then
              Application.MessageBox('Informe a Chave p/ ativação do Plano contratado.','ATENÇÃO',MB_OK + MB_ICONINFORMATION);
          end
          else begin
            if not(GPlValidaKPl(StringReplace(StringReplace(UpperCase(_KFPL),'-','',[rfReplaceAll]),'.','',[rfReplaceAll]))) then
            begin
              Application.MessageBox(pChar('Chave inválida para esse Cliente.'+#13+#13+'Informe a Chave válida para ativação do Plano.'),'ATENÇÃO',MB_OK + MB_ICONINFORMATION);
            end
            else begin
              try
                _IBQuery999.Close;
                _IBQuery999.SQL.Text := 'update empresa_filial set kfpl = '+QuotedStr(StringReplace(StringReplace(UpperCase(_KFPL),'-','',[rfReplaceAll]),'.','',[rfReplaceAll]))+' where codigo = '+IntToStr(_CodFilial);
                try
                  _IBQuery999.ExecSQL;
                  _IBTransaction999.Commit;
                  Result := 2; // Chave para ativação do Plano válida (2 = Chama função para configurar menus na tela inicial ao retornar desta função)  
                except
                  on _err : exception do
                  begin
                    if _IBTransaction999.InTransaction then
                      _IBTransaction999.Rollback;
                    Application.MessageBox(pChar('Erro ao gravar "Chave de ativação do Plano" para esta Empresa, verifique:'+#13+#13+_err.Message),'ATENÇÃO',MB_OK + MB_ICONINFORMATION);
                    Exit;
                  end;
                end;
              finally
              end;
              Break;
            end;
          end;
        end
        else begin
          Break;
        end;
      end;
    end
    else begin
      // Validando a Chave para ativação do Plano
      if GPlValidaKPl(StringReplace(StringReplace(UpperCase(_KFPL),'-','',[rfReplaceAll]),'.','',[rfReplaceAll])) then
      begin
        Result := 2; // Chave para ativação do Plano válida (2 = Chama função para configurar menus na tela inicial ao retornar desta função)
      end
      else begin
        Application.MessageBox(pChar('Chave inválida para esse Cliente.'+#13+#13+'Reinicie o sistema e informe a chave válida!'),'ATENÇÃO',MB_OK + MB_ICONINFORMATION);
        // Limpando a chave inválida para tentar novamente após reiniciar o sistema
        try
          _IBQuery999.Close;
          _IBQuery999.SQL.Text := 'update empresa_filial set kfpl = null where codigo = '+IntToStr(_CodFilial);
          try
            _IBQuery999.ExecSQL;
            _IBTransaction999.Commit;
          except
            on _err : exception do
            begin
              if _IBTransaction999.InTransaction then
                _IBTransaction999.Rollback;
              Exit;
            end;
          end;
        finally
        end;
      end;
    end;
  finally
    _IBQuery999.Close;
    _Destroy_IBQuery(999);
  end;
end;

