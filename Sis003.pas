          end;
        end;
      end;
    end;

    for B := 0 to (ComponentCount - 1) do
    begin
      if (Components[IdxCmpPadrao].ClassType = TButton) then
      begin
        if (Components[B].ComponentIndex > IdxCmpPadrao) then
        begin
          Inc(vTabOrder);
          (Components[B] as TButton).TabOrder := vTabOrder;
        end;
      end;
    end;
  end;
end;

function ExibirMensagem(vTitulo, vMensagem: String; imIconeMensagem: TIconeMensagem; TextoBotao: String = 'OK'; BotaoPadrao: Integer = 1; PermiteFechar: Boolean = False; TemporizadorFechaMSG: Integer = 0): Integer;
var
  I, nBtn: Integer;
  vStrBtn: String;
  IdxBtn: array of Integer;
  StrBtn: array[0..10] of String;
begin
  //     Result: Caso a janela exija resposta (PermiteFechar = False), esta função retorna o "Index" do botão clicado, iniciando de 1 até a quantidade de botões que houver no Form;
  //             Caso a janela permita não responder (PermiteFechar = True), esta função retorna o valor "-1" para sinalizar que o usuário não clicou nos botões disponíveis;
  // TextoBotao: Cada botão deve ser separado com dois || (pipes). A quantidade de botões é relativa, depende do tamanho do texto de cada botão e da estética da janela;
  //             A omissão deste parâmetro ou não informação de valor gera uma mensagem com o botão "OK";
  //BotaoPadrao: "Index" do botão que receberá foco por padrão. Se for igual ou menor que zero ou maior que a quantidade de botões disponíveis, o valor padrão será "1";

  vStrBtn := '';
  nBtn := 1;

  try
    if (Trim(StringReplace(TextoBotao,'|','',[rfReplaceAll])) = '') then
      TextoBotao := 'OK';

    TextoBotao := TextoBotao + '||';

    for I := 1 to StrLen(PChar(Trim(TextoBotao))) do
      if (Copy(Trim(TextoBotao),I,2) = '||') then
        Inc(nBtn);

    SetLength(IdxBtn,nBtn);
    nBtn := 1;

    for I := 1 to StrLen(PChar(Trim(TextoBotao)))-1 do
    begin
      if (Copy(Trim(TextoBotao),I,2) = '||') then
      begin
        IdxBtn[nBtn] := nBtn;
        StrBtn[nBtn] := StringReplace(vStrBtn,'|','',[rfReplaceAll]);
        Inc(nBtn);
        vStrBtn := '';
      end
      else
        vStrBtn := vStrBtn + Copy(Trim(TextoBotao),I,1);
    end;

    if (BotaoPadrao >= nBtn) or (BotaoPadrao <= 0) then
      BotaoPadrao := 1;

    try
      //O valor de "ExMsgRegLog" não deve ser um parâmetro implícito nesta função.
      if (Trim(vMensagem) <> '') and (ExMsgRegLog <> nil) and ((ExMsgRegLog is TMemo) or (ExMsgRegLog is TDBMemo) or (ExMsgRegLog is TcxMemo) or (ExMsgRegLog is TcxDBMemo)) then
      begin
        if (ExMsgRegLog is TMemo) then
        begin
          with (ExMsgRegLog as TMemo).Lines do
          begin
            Add('');
            Add('');
            Add('[' + vTitulo + '] ' + vMensagem);
          end;
        end
        else
        if (ExMsgRegLog is TcxMemo) then
        begin
          with (ExMsgRegLog as TcxMemo).Lines do
          begin
            Add('');
            Add('');
            Add('[' + vTitulo + '] ' + vMensagem);
          end;
        end
        else
        if (ExMsgRegLog is TDBMemo) then
        begin
          if ((ExMsgRegLog as TDBMemo).DataSource.State in [dsInsert, dsEdit]) then
          begin
            with (ExMsgRegLog as TDBMemo).Lines do
            begin
              Add('');
              Add('');
              Add('[' + vTitulo + '] ' + vMensagem);
            end;
          end;
        end
        else
        if (ExMsgRegLog is TcxDBMemo) then
        begin
          if ((ExMsgRegLog as TcxDBMemo).DataBinding.DataSource.State in [dsInsert, dsEdit]) then
          begin
            with (ExMsgRegLog as TcxDBMemo).Lines do
            begin
              Add('');
              Add('');
              Add('[' + vTitulo + '] ' + vMensagem);
            end;
          end;
        end;
      end;
    except
    end;
  finally
    try
      ExMsgRegLog := nil;
    except
    end;
  end;

  Result := fnMontarCaixaMensagem(vTitulo, vMensagem, '', imIconeMensagem, IdxBtn, StrBtn, BotaoPadrao, PermiteFechar, TemporizadorFechaMSG).ShowModal;
end;

