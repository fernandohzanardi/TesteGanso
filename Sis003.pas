function DecodeSubLocalGravacaoXML(pCmdStr: String): String;
var
  vStr: String;
begin
  {
  Relação de variáveis permitidas (deve-se considerar as chaves):

  nome_computador - Nome do computador que emitiu a NF-e;
     nome_usuario - Nome do usuário que emitiu a NF-e;
      cnpj_filial - CNPJ da filial que emitiu a NF-e;
           ano_f2 - Ano no formato de 2 dígitos;
           ano_f4 - Ano no formato de 4 dígitos;
          num_mes - Mês em número de 2 dígitos;
        ext_mes_a - Mês por extenso abreviado;
        ext_mes_c - Mês por extenso completo;
              dia - Dia no formato de 2 dígitos;
  }

  Result := '';

  if (StringReplace(pCmdStr,'\','',[rfReplaceAll]) = '') then
    Exit;

  vStr := Trim(pCmdStr);

  vStr := Trim(StringReplace(vStr,'{nome_computador}',_NomeComputador,[rfReplaceAll,rfIgnoreCase]));
  vStr := Trim(StringReplace(vStr,'{nome_usuario}',Trim(Caixa_Mista(_usuario)),[rfReplaceAll,rfIgnoreCase]));
  vStr := Trim(StringReplace(vStr,'{cnpj_filial}',_CNPJFilial,[rfReplaceAll,rfIgnoreCase]));
  vStr := Trim(StringReplace(vStr,'{ano_f2}',FormatDateTime('YY',Date),[rfReplaceAll,rfIgnoreCase]));
  vStr := Trim(StringReplace(vStr,'{ano_f4}',FormatDateTime('YYYY',Date),[rfReplaceAll,rfIgnoreCase]));
  vStr := Trim(StringReplace(vStr,'{num_mes}',FormatDateTime('MM',Date),[rfReplaceAll,rfIgnoreCase]));
  vStr := Trim(StringReplace(vStr,'{ext_mes_a}',Trim(Caixa_Mista(FormatDateTime('MMM',Date))),[rfReplaceAll,rfIgnoreCase]));
  vStr := Trim(StringReplace(vStr,'{ext_mes_c}',Trim(Caixa_Mista(FormatDateTime('MMMM',Date))),[rfReplaceAll,rfIgnoreCase]));
  vStr := Trim(StringReplace(vStr,'{dia}',FormatDateTime('DD',Date),[rfReplaceAll,rfIgnoreCase]));

  if (Copy(vStr,1,1) <> '\') then
    vStr := '\' + vStr;

  if (Copy(vStr,(Length(vStr)),1) <> '\') then
    vStr := vStr + '\';

  vStr := Trim(StringReplace(vStr,'{','',[rfReplaceAll]));
  vStr := Trim(StringReplace(vStr,'}','',[rfReplaceAll]));

  Result := vStr;
end;

function BuscaCodigoProdutoPorBarras(_CodBarras:String):Integer;
var
  lQuery: TQuery;
begin
  //Função que retorna o código do produto através do código de barras enviado.
  //Pesquisa por todos os códigos de barras cadastrados.
  //OBS.: NÃO USAR PARA GRADE.
  Result := 0;
  lQuery := TQuery.Create(DM.IBbanco);

  try
    try
      //Testa se é numérico ou maior que o campo (18)
      if Length(_CodBarras) > 18 then
      begin
        Exit;
      end;

      StrToFloat(_CodBarras);

      lQuery
