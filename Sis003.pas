end;

Function ConfiguraImpressora(pCodigoCaixa: Integer) : Boolean;
var
  _ImpAUsar : Integer;
  _Key, _Value : String;
  Device : array[0..255] of char;
  Driver : array[0..255] of char;
  Port : array[0..255] of char;
  hDeviceMode : THandle;
  PrintDialog: TPrintDialog;
  _Size : DWORD;
begin
  Result := False;
  PrintDialog := TPrintDialog.Create(nil);
  _ImpressoraNFC := BuscarImpressora(pCodigoCaixa);
  if (_ImpressoraNFC <> '') then
  begin
    _ImpAUsar := Printer.Printers.IndexOf(_ImpressoraNFC);
    if (_ImpAUsar = -1) then
      _ImpressoraNFC := ''
    else
    begin
      Printer.PrinterIndex := _ImpAUsar;
      Printer.Canvas.Font.Name := 'Courier New';
      Printer.Canvas.Font.Size := 8; // Luiz Santana - 30/11/2022 - Após atualizar com versãao 4.0 do PDV o tamanho da fonte ficou maior (padrão?) quebrando linhas
      Printer.Canvas.Font.Style := [fsBold]; // Luiz Santana - 28/10/2016 - Para testar na Pantanal Garden sem precisar trocar fonte, reclamação da qualidade
    end;
  end;
  if (_ImpressoraNFC = '') then
  begin
    if (Application.MessageBox('Impressora não informada ou informada incorretamente no arquivo de configuração. Deseja escolher a impressora?'
                                ,'ATENÇÃO',MB_YESNO+MB_ICONQUESTION+MB_OK+MB_DEFBUTTON1) = IDYES) then
    begin
      if PrintDialog.Execute then
      begin
        Printer.GetPrinter(Device, Driver, Port, hDeviceMode);
        _ImpressoraNFC := Device;

        //Grava impressora no ini
        if (Trim(_ImpressoraNFC) <> '') then
        begin
          AtualizarImpressora(_ImpressoraNFC, pCodigoCaixa);
          _ImpAUsar := Printer.Printers.IndexOf(_ImpressoraNFC);
          Printer.PrinterIndex := _ImpAUsar;
          Printer.Canvas.Font.Name := 'Courier New';
          Printer.Canvas.Font.Size := 8; // Luiz Santana - 30/11/2022 - Após atualizar com versãao 4.0 do PDV o tamanho da fonte ficou maior (padrão?) quebrando linhas
          Printer.Canvas.Font.Style := [fsBold]; // Luiz Santana - 28/10/2016 - Para testar na Pantanal Garden sem precisar trocar fonte, reclamação da qualidade
          Result := True;
        end
        else
        begin
          Application.MessageBox('Configure ou escolha uma impressora para imprimir os comprovantes!','ATENÇÃO',MB_ICONINFORMATION+MB_OK);
          Result := False;
        end;
      end
      else
      begin
        Application.MessageBox('Configure ou escolha uma impressora para imprimir os comprovantes!','ATENÇÃO',MB_ICONINFORMATION+MB_OK);
        Result := False;
      end;
    end
    else
    begin
      Application.MessageBox('Configure ou escolha uma impressora para imprimir os comprovantes!','ATENÇÃO',MB_ICONINFORMATION+MB_OK);
      Result := False;
    end;
  end
  else
    Result := True;

  try
    PrintDialog.Free;
  except
  end;

//  if (Result and (_TipoDocFiscal = 'N') and (Trim(_ImpressoraNFC) <> '')) then
//  begin
//    _Key := '';
//    _Value := '';
//    _Key := 'SOFTWARE\Microsoft\Windows NT\CurrentVersion\Print\Printers\'+_ImpressoraNFC+'\PrinterDriverData\';
//    _Value := LerValorRegistroWindows(_Key,'Model');
//    if PosEX('BEMATECH',AnsiUpperCase(_Value)) > 0 then
//      GansoNFC.ImpressoraFabricante := 'BEMATECH'
//    else
//      GansoNFC.ImpressoraFabricante := 'OUTRO';
//  end;

end;

procedure AtualizarImpressora(pNomeImpressora: string; pCodigoCaixa: Integer);
var
  lQuery: TIBQuery;
begin
  lQuery := TIBQuery.Criar(DM.IBBanco);
  try
    try
      lQuery.SQL.Add('UPDATE caixa_cadastro SET tef_impressora_padrao = :pNomeImpressora WHERE codigo = ' + pCodigoCaixa.ToString);
      lQuery.ParamByName('pNomeImpressora').AsString := pNomeImpressora;
      lQuery.ExecSQL;
      lQuery.Transaction.Commit;
    except
      lQuery.Transaction.Rollback;
    end;
  finally
    lQuery.Destruir;
  end;
end;

function BuscarImpressora(pCodigoCaixa: Integer): string;
var
  lQuery: TIBQuery;
begin
  lQuery := TIBQuery.Criar(DM.IBBanco);
  try
    try
      lQuery.SQL.Add('SELECT TEF_IMPRESSORA_PADRAO FROM CAIXA_CADASTRO WHERE CODIGO = '+ pCodigoCaixa.ToString);
      lQuery.Open;
      Result := lQuery.FieldByName('TEF_IMPRESSORA_PADRAO').AsString;
    except
      lQuery.Transaction.Rollback;
    end;
  finally
    lQuery.Destruir;
  end;
end;

