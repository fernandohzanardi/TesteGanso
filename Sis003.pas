procedure ManutPDVSetupECF;
begin
  // Procedimento para Manutenção da PDV_SETUP_ECF, devido ao PAF-ECF 2014
  // Busca ECF's que constam na PAFECF_R02 (já foi emitida RZ) mas não constam na PDV_SETUP, e as insere como inativas
  // !!!OBS.!!! Para ECFs inativas inseridas por esse processo, o NUMERO_ECF será 0.!!!
  // Foi usada a CHAVE <030> como flag para essa manutenção.
  try
    _Cria_IBQuery(nil,996);
    _Cria_IBQuery(nil,997);

    //Atualiza status das ECF's existentes como A - Ativo
    _IBQuery996.SQL.Text := 'update pdv_setup_ecfs p set p.status = ''A'' where p.status is null';
    _IBQuery996.ExecSQL;
    _IBQuery996.Transaction.Commit;
    
    //Busca ECF's que já emitiram Redução Z
    _IBQuery996.Close;
    _IBQuery996.SQL.Text := ' select (select first 1 r.codigo_filial from pafecf_r02 r where r.numero_fabricacao = r2.numero_fabricacao order by r.codigo desc) as "CODIGO_FILIAL", '+
                            ' r2.numero_fabricacao '+
                            ' from pafecf_r02 r2 '+
                            ' where r2.numero_fabricacao is not null '+                            
                            ' group by 1, 2 '+
                            ' order by 1, 2 ';
    _IBQuery996.Open;
    _IBQuery996.First;
    while not _IBQuery996.EOF do
    begin
      //Verifica se ECF existe na PDV_SETUP_ECF. Caso não exista, insere como inativa.
      _IBQuery997.Close;
      _IBQuery997.SQL.Text := ' select p.codigo '+
                              ' from pdv_setup_ecfs p '+
                              ' where p.nse = '+QuotedStr(PChar(EncriptECF(_IBQuery996.FieldByName('numero_fabricacao').AsString)));
      _IBQuery997.Open;      
      if _IBQuery997.IsEmpty then
      begin
        //Insere ECFs Inativas
        _IBQuery997.Close;
        _IBQuery997.SQL.Text := ' INSERT INTO PDV_SETUP_ECFS (NSE, NUMERO_ECF, PDV_LOGADO, CODIGO_FILIAL, STATUS, PAF_HASH) '+
                                ' VALUES ('+QuotedStr(PChar(EncriptECF(_IBQuery996.FieldByName('numero_fabricacao').AsString)))+', 0,'+
                                          ' NULL,'+_IBQuery996.FieldByName('CODIGO_FILIAL').AsString+', ''I'', NULL)';
        _IBQuery997.ExecSQL;
      end;
      _IBQuery996.Next;
    end;
    //Gera HASH das ECFs existentes
    _IBQuery997.SQL.Text := ' update pdv_setup_ecfs p '+
                            ' set p.paf_hash = upper(f_encryptmd5(''MSGanso'' '+
                            '       ||coalesce(p.nse,'''') '+
                            '       ||coalesce((select coalesce(ef.cnpj,'''') from empresa_filial ef where ef.codigo = p.codigo_filial),''''))) ';
    _IBQuery997.ExecSQL;

    //Manutenção na PAFECF_R06
    _IBQuery997.Close;
    _IBQuery997.SQL.Text := ' update pafecf_r06 r '+
                            ' set r.paf_ident = upper(f_encryptmd5(r.numero_fabricacao)) ';
    _IBQuery997.ExecSQL;

    //Concluída a manutenção, limpa FLAG na CHAVE <030>
    _IBQuery997.Close;
    _IBQuery997.SQL.Text := ' UPDATE IBE$ACESSO_RESTRITO '+
                            ' SET NRE = null '+
                            ' WHERE CHAVE = ''<030>'' ';
    _IBQuery997.ExecSQL;
                                
    if _IBQuery996.Transaction.InTransaction then
      _IBQuery996.Transaction.Commit;
    if _IBQuery997.Transaction.InTransaction then
      _IBQuery997.Transaction.Commit;

    _IBQuery996.Close;
    _IBQuery997.Close;
    _Destroy_IBQuery(996);
    _Destroy_IBQuery(997);
  except
    if Assigned(_IBQuery996) and _IBQuery996.Transaction.InTransaction then
      _IBQuery996.Transaction.Rollback;
    if Assigned(_IBQuery997) and _IBQuery997.Transaction.InTransaction then
      _IBQuery997.Transaction.Rollback;
    _Destroy_IBQuery(996);
    _Destroy_IBQuery(997);
  end;

end;

