Function ConvenioCalcVence(_DiaFecha, _DiaVence, _Parcela : Integer; _DataBase : TDate) : TDate;
var
  _DiaVencFunc, _Mes, _Ano : Integer;
  _DataVenc, _DataVenceTest, _DataFecha : TDate;
  _TentativasDt : Boolean;
begin
  // ********** REGRA DO CONVÊNIO - por RODRIGO/LUIZ - 17/09/2007
  // 1º) Checa a Data de Fechamento e Data da Venda, para ver se a venda está sendo feita
  //     antes ou depois do fechamento, se for até o dia do fechamento, checar 2º condição,
  //     caso contrário, o vencimento será no próximo Mês.
  // 2º) Sempre que o dia de vencimento do convênio for menor ou igual ao dia de fechamento do convênio
  //     será vencido no próximo mês.

  // FORMANDO A DATA DE Fechamento E VALIDANDO-A
  _TentativasDt := True;
  while _TentativasDt = True do
  begin
    try
      _DataFecha := StrToDate(IntToStr(_DiaFecha)+'/'+IntToStr(MonthOf(_DataBase))+'/'+IntToStr(YearOf(_DataBase)));
      Break;
    except
      Dec(_DiaFecha);
    end;
    if (_DiaFecha <= 0) then Break;
  end;

  // FORMANDO A DATA DE Vencimento E VALIDANDO-A
  _TentativasDt := True;
  _DiaVencFunc := _DiaVence; // Pra usar o valor que veio original mais abaixo.
  while _TentativasDt = True do
  begin
    try
      _DataVenceTest := StrToDate(IntToStr(_DiaVence)+'/'+IntToStr(MonthOf(_DataBase))+'/'+IntToStr(YearOf(_DataBase)));
      Break;                
    except
      Dec(_DiaVence);
    end;
    if (_DiaVence <= 0) then Break;
  end;
        
  if _DataBase <= _DataFecha then // 1º Ciclo
  begin
    if _DiaVence <= _DiaFecha then
      _Mes := MonthOf(_DataBase) + 1
    else
      _Mes := MonthOf(_DataBase);
  end
  else begin // 2º Ciclo
    if _DiaVence <= _DiaFecha then
      _Mes := MonthOf(_DataBase) + 2
    else
      _Mes := MonthOf(_DataBase) + 1;
  end;

  _TentativasDt := True;
  _DiaVence := _DiaVencFunc;

  if _Parcela > 1 then
    _Mes := _Mes + _Parcela - 1;

 if (_Mes >= 13)and(_Mes <= 24) then
  begin
    _Mes := _Mes - 12;
    _Ano := YearOf(_DataBase) + 1;
  end
  else if (_Mes >= 25)and(_Mes <= 36) then
  begin
    _Mes := _Mes - 24;
    _Ano := YearOf(_DataBase) + 2;
  end
  else if (_Mes >= 37)and(_Mes <= 48) then
  begin
    _Mes := _Mes - 36;
    _Ano := YearOf(_DataBase) + 3;
  end
  else if (_Mes >= 49)and(_Mes <= 60) then
  begin
    _Mes := _Mes - 48;
    _Ano := YearOf(_DataBase) + 4;
  end
  else if (_Mes >= 61)and(_Mes <= 72) then
  begin
    _Mes := _Mes - 60;
    _Ano := YearOf(_DataBase) + 5;
  end
  else
    _Ano := YearOf(_DataBase);

  while _TentativasDt = True do
  begin
    try
      _DataVenc := StrToDate(IntToStr(_DiaVence)+'/'+FormatFloat('00',_Mes)+'/'+IntToStr(_Ano));
      Break;
    except
      Dec(_DiaVence);
    end;
    if (_DiaVence <= 0) then Break;
  end;
  Result := _DataVenc;
end;

function GeraEmbalagemVenda(_Un1 : String = ''; _Compl : String = '') : String;
begin
  result := '';
  if (Trim(_Un1) <> '')and(Trim(_Compl) <> '') then
  begin
    Result := _Un1+'x'+_Compl;
  end
  else begin
    if (Trim(_Un1) <> '') and (Trim(_Compl) = '') then
      Result := _Un1
    else if (Trim(_Un1) = '') and (Trim(_Compl) <> '') then
      Result := _Compl;
  end;
end;

function GeraEmbalagemCompra(_UnCompra : String = ''; _Fr1 : Currency = 0; _UnFr1 : String = ''; _Fr2 : Currency = 0;
                             _UnFr2Venda : String = ''; _Compl : String = '') : String;
begin
  result := '';
  if (Trim(_UnCompra) <> '') then Result := Trim(_UnCompra);

  if (_Fr1 > 0) then // Fração 1
  begin
    if Trim(Result) = '' then Result := CurrToStr(_Fr1)+IIF(Trim(_UnFr1) = '','',_UnFr1)
    else Result := Trim(Result)+'x'+CurrToStr(_Fr1)+IIF(Trim(_UnFr1) = '','',_UnFr1);
  end;

  if (_Fr2 > 0) then // Fração 2
  begin
    if ((_UnCompra = _UnFr2Venda) and (_Fr2 > 1)) or (_UnCompra <> _UnFr2Venda) then // Pra não deixar Repetir Compra com Venda no caso de coinciêndia (1)
    begin
      if Trim(Result) = '' then Result := CurrToStr(_Fr2)+IIF(Trim(_UnFr2Venda) = '','',_UnFr2Venda)
      else Result := Trim(Result) + 'x'+CurrToStr(_Fr2)+IIF(Trim(_UnFr2Venda) = '','',_UnFr2Venda);
    end;
  end;

  if (_Compl <> '') then // Complemento
  begin
    if Trim(Result) = '' then Result := _Compl
    else Result := Trim(Result)+'x'+_Compl;
  end;
end;

function MostraEstEmbCompra(_Un1 : String = ''; _Compl : String = ''; _Fr1 : Currency = 1; _Fr2 : Currency = 1) : String;
var
  _QTDEst : String;
begin
  result := '';
  if _Fr1 <= 0 then _Fr1 := 1;
  if _Fr2 <= 0 then _Fr2 := 1;

  _QTDEst := CurrToStr(_Fr1 * _Fr2);

  if Trim(_Un1) <> '' then
    Result := _QTDEst+' '+_Un1
  else
    Result := _QTDEst;
end;

function IIF(AValue: Boolean; const ATrue: Variant; const AFalse: Variant): Variant;
begin
  if AValue then
    Result := ATrue
  else
    Result := AFalse;
end;

