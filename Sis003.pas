function TSLeJSON(_StrJSON, _Campo: String; _InfEntreAspas : Boolean = True) : String;
var
  _x : Integer;
begin
  //{"mensagem":"Token retornado com sucesso","dados":{"token":"2437xf4kc8jmr9vygb91524318691755","tokenexpiracao":"2018-04-21T14:51:31.000Z"}}
  try
    if PosEx('"'+_Campo+'":',_StrJSON) > 0 then
    begin
      Result := '';
      _StrJSON := Copy(_StrJSON,PosEx('"'+_Campo+'":',_StrJSON) + StrLen(pChar('"'+_Campo+'":')) + IfThen(_InfEntreAspas,1,0),StrLen(pChar(_StrJSON)));
      for _x := 1 to StrLen(pChar(_StrJSON)) do
      begin
        if (_StrJSON[_x] = IfThen(_InfEntreAspas,'"',',')) or (_StrJSON[_x] = '}') then
          Break
        else
          Result := Result + _StrJSON[_x];
      end;
    end
    else
      Result := '';
  finally
  end;
end;

function TSBuscaToken : String;
  Function TSGetTokenSaaS(_Modo : String = 'C') : String;
  var
    _SlstTkn : TStringList;
    _HTTPTS : TIdHTTP;
  begin
    _HTTPTS := TIdHTTP.Create;
    _SlstTkn := TStringList.Create;
    try
      Result := '';
      _SlstTkn.Clear;
      _SlstTkn.Add(Decrypt('rHqm5HAk/J7UrHIUn8c4uBu35a9HssTJEC1dZbZsiN54uHcAAB',36525));
      _SlstTkn.Add(Decrypt('SvMZTDkvcJFzuz9sVPQlsUbg',41224));
      _SlstTkn.Add('gerar='+IfThen(_Modo='G','1','0'));
      try
        Result := _HTTPTS.Post(Decrypt('LkjxPfo5orRexSVNsqKXxUy6StdIr3ZS2bszsn62GG2PgMFC2ubxeh/Fu2YMiTVfQwc6zt3dVd0Zur+YtMy4Btwv+9bbmC',25365), _SlstTkn);
      except
        on _errIdhttp : EIdHTTPProtocolException do
        begin
          Result := 'ERRORETTOKEN:'+UTF8Decode(_errIdhttp.ErrorMessage);
        end;
        on _err : exception do
        begin
          Result := 'ERRORETTOKEN:'+UTF8Decode(_err.Message);
        end;
      end;

      if (_HTTPTS.Response.ResponseCode <> 200) then
        Result := 'ERRORETTOKEN:' + Result + #13 + #13 + UTF8Decode(_HTTPTS.Response.ResponseText);

    finally
      _SlstTkn.Free;
      _HTTPTS.Free;
    end;
  end;

  Function TSProcessaToken(_RetGetTkn : String) : String;
  var
    _RetTS, _RetMsgTS, _RetTokenTS, _RetTokenExpTS : String;
    _TSt, _TComFusoTS : TDateTime;
    _TimeZW : String;
  begin
  	{Alexandre Requena - Tecnospeed - A respeito dos retornos:
       Caso seja no cadastro você pode considerar o "Cadastro efetuado com sucesso", caso seja na atualização "Cadastro atualizado com sucesso"
       Caso seja na consulta: "Registros retornados com sucesso" ou "Registro retornados com sucesso"
  	}
    try
      Result := '';

      _RetMsgTS := TSLeJSON(_RetGetTkn,'mensagem', True);
      _RetTokenTS := TSLeJSON(_RetGetTkn,'token', True);
      _RetTokenExpTS := TSLeJSON(_RetGetTkn,'tokenexpiracao', True);

      _TimeZW := PegaFusoWin;

      if (LowerCase(_RetMsgTS) = 'token retornado com sucesso') or (LowerCase(_RetMsgTS) = 'token gerado com sucesso') then
      begin
        FormatSettings.ShortDateFormat := 'yyyy/mm/dd';
        _TSt := StrToDateTime(StringReplace(StringReplace(StringReplace(LeftStr(_RetTokenExpTS,19),'T',' ',[rfReplaceAll]),'Z','',[rfReplaceAll]),'-','/',[rfReplaceAll]));
        _TimeZW := _TimeZW + ':00';

        if (_TimeZW[1] = '-') then
        begin
          _TComFusoTS := _TSt - StrToTime(StringReplace(_TimeZW,'-','',[rfReplaceAll]));
        end
        else if (_TimeZW[1] = '+')or(_TimeZW[1] in ['1','2','3','4','5','6','7','8','9','0']) then
        begin
          _TComFusoTS := _TSt + StrToTime(StringReplace(_TimeZW,'-','',[rfReplaceAll]));
        end;

        FormatSettings.ShortDateFormat := 'dd/mm/yyyy';

        PegaDataHoraServer;

        if _DataHoraServidor + StrToTime('00:05:00') < _TComFusoTS then // 05 minutos de tolerância para a transação no eDoc (Luiz)
        begin
          Result := 'TOKENOK:'+_RetTokenTS;
        end
        else begin
          try
            Result := 'TOKENEXP: '+_TimeZW;
          except
            Result := 'TOKENEXP:';
          end;
        end;
      end
      else begin
        Result := 'ERRORETTOKEN:'+LowerCase(_RetMsgTS);
      end;
    finally
    end;
  end;
var
  _RetFuncGetTkn, _RetornaToken: String;
begin
  Result := '';

  try
    _RetFuncGetTkn := TSGetTokenSaaS;

    if LeftStr(_RetFuncGetTkn,13) = 'ERRORETTOKEN:' then
    begin
      Result := _RetFuncGetTkn;
      Exit;
    end;

    _RetornaToken := TSProcessaToken(_RetFuncGetTkn);

    if LeftStr(_RetornaToken,8) = 'TOKENEXP' then
    begin
      // Token expirado tenta gerar novo token
      _RetFuncGetTkn := TSGetTokenSaaS('G');

      if LeftStr(_RetFuncGetTkn,13) = 'ERRORETTOKEN:' then
      begin
        Result := _RetFuncGetTkn;
        Exit;
      end;
      _RetornaToken := TSProcessaToken(_RetFuncGetTkn);
    end;

    if LeftStr(_RetornaToken,8) = 'TOKENOK:' then
      Result := StringReplace(_RetornaToken,'TOKENOK:','',[rfReplaceAll])
    else
      Result := 'ERRORETTOKEN: Erro ao processar token, verifique: '+#13+_RetornaToken;
  finally
  end;
end;

