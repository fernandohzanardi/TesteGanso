                 +' coalesce(f.cheque,''N'') as "cheque", coalesce(f.imprimir_cheque,''N'') as "imprimir_cheque", coalesce(f.gera_credito_devolucao,''N'') as "gera_credito_devolucao", f.codigo_indicador, '
                 +' f.acrescimo, f.desconto, f.acrescimo_permitealt, f.desconto_permitealt, coalesce(f.pos,''N'') as "pos", '
                 +' coalesce(f.brinde,''N'') as "brinde", coalesce(f.cheque_tef,''N'') as "cheque_tef", coalesce(f.tef_cartdigpix,''N'') as "tef_cartdigpix", '
