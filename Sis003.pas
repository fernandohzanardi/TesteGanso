end;

Function PegaVersaoArquivo(_ArquivoVer : String) : String;
var
  Zero: DWORD; // set to 0 by GetFileVersionInfoSize
  VersionInfoSize: DWORD;
  PVersionData: pointer;
  PFixedFileInfo: PVSFixedFileInfo;
  FixedFileInfoLength: UINT;
  Major, Minor, Release, Build : Integer;
begin
  Result := '';
  Major := 0;
  Minor := 0;
  Release := 0;
  Build := 0;
  VersionInfoSize := GetFileVersionInfoSize(pChar(_ArquivoVer), Zero);
  if VersionInfoSize = 0 then
    Exit;
  PVersionData := AllocMem(VersionInfoSize);
  try
    if GetFileVersionInfo(pChar(_ArquivoVer), 0, VersionInfoSize, PVersionData) = False then
      Exit;
    if VerQueryValue(PVersionData, '', pointer(PFixedFileInfo), FixedFileInfoLength) = False then
      Exit;
    Major := PFixedFileInfo^.dwFileVersionMS shr 16;
    Minor := PFixedFileInfo^.dwFileVersionMS and $FFFF;
    Release := PFixedFileInfo^.dwFileVersionLS shr 16;
    Build := PFixedFileInfo^.dwFileVersionLS and $FFFF;
  finally
    FreeMem(PVersionData);
  end;
  if (Major or Minor or Release or Build) <> 0 then
    Result := IntToStr(Major) +'.'+ IntToStr(Minor) +'.'+ IntToStr(Release) +'.'+ IntToStr(Build);
end;

Function FBVerCompatClientServer : Boolean;
var
  _VersEngFB, _VersFBServMajor, _VersFBServMinor, _VersFBODS, _FBServerCompat, _FBClientCompat, _VerCliGDS32, _VerCliFBClient : String;
begin
  Result := True;
  _EFB25 := False;
  try
    try
      _VersEngFB := DM.IBDatabaseInfo.Version;

      _VersFBServMajor := Copy(_VersEngFB,PosEx('FIREBIRD',UpperCase(_VersEngFB))+9,StrLen(pChar(_VersEngFB)));
      _VersFBServMinor := Copy(_VersEngFB,9,PosEx('FIREBIRD',UpperCase(_VersEngFB)) - 9);
      _VersFBODS := IntToStr(DM.IBDatabaseInfo.ODSMajorVersion)+'.'+IntToStr(DM.IBDatabaseInfo.ODSMinorVersion);

      _FBServerCompat := '';
      _FBClientCompat := '';

      // ODS vs FBServer - GDS32/FBClient vs FBServer
      if (_VersFBServMajor = '1.5') then // FB 1.5
      begin
        // Verificando a compatibilidade da ODS com o Servidor do Firebird instalado
        if (_VersFBODS <> '10.1') then
        begin
          Result := False;
          _FBServerCompat := '';
          if (_VersFBODS = '11.0') then
            _FBServerCompat := 'Firebird 2.0.x'
          else if (_VersFBODS = '11.1') then
            _FBServerCompat := 'Firebird 2.1.x'
          else if (_VersFBODS = '11.2') then
            _FBServerCompat := 'Firebird 2.5.x';
        end
        else begin
          // Verificando a compatibilidade do Client (GDS32/FBClient) com o Server (FBServer)
          _VerCliGDS32 := PegaVersaoArquivo('gds32');
          if (Trim(_VerCliGDS32) = '') then
            _VerCliGDS32 := '(não encontrada)';

          _VerCliFBClient := PegaVersaoArquivo('fbclient');
          if (Trim(_VerCliFBClient) = '') then
            _VerCliFBClient := '(não encontrada)';

          if ((_VerCliGDS32 = '')or(_VerCliGDS32 = '(não encontrada)')or((LeftStr(Trim(_VerCliGDS32),5) <> '6.3.6')and(LeftStr(Trim(_VerCliGDS32),5) <> '1.5.6'))) then
            _FBClientCompat := 'GDS32.dll -> 6.3.6 (ou fbclient.dll v1.5.6 renomeada)';
          if ((_VerCliFBClient = '')or(_VerCliFBClient = '(não encontrada)')or(LeftStr(Trim(_VerCliFBClient),5) <> '1.5.6')) then
            _FBClientCompat := _FBClientCompat+IIF(_FBClientCompat <> '',' / ','')+'FBClient.dll -> 1.5.6.xxxxx';
        end;
      end
      else if (_VersFBServMajor = '2.5') then // FB 2.5
      begin
        // Verificando a compatibilidade da ODS com o Servidor do Firebird instalado
        _EFB25 := True;
        if (_VersFBODS <> '11.2') then
        begin
          Result := False;
          _FBServerCompat := '';
          if (_VersFBODS = '10.1') then
            _FBServerCompat := 'Firebird 1.5.6'
          else if (_VersFBODS = '11.0') then
            _FBServerCompat := 'Firebird 2.0.x'
          else if (_VersFBODS = '11.1') then
            _FBServerCompat := 'Firebird 2.1.x';
        end
        else begin
          // Verificando a compatibilidade do Client (GDS32/FBClient) com o Server (FBServer)
          _VerCliGDS32 := PegaVersaoArquivo('gds32');
          if (Trim(_VerCliGDS32) = '') then
            _VerCliGDS32 := '(não encontrada)';

          _VerCliFBClient := PegaVersaoArquivo('fbclient');
          if (Trim(_VerCliFBClient) = '') then
            _VerCliFBClient := '(não encontrada)';

          if ((_VerCliGDS32 = '')or(_VerCliGDS32 = '(não encontrada)')or((LeftStr(Trim(_VerCliGDS32),3) <> '6.3')and(LeftStr(Trim(_VerCliGDS32),3) <> '2.5'))) then
            _FBClientCompat := 'GDS32.dll -> 6.3.x (ou fbclient.dll v2.5.x renomeada)';
          if ((_VerCliFBClient = '')or(_VerCliFBClient = '(não encontrada)')or(LeftStr(Trim(_VerCliFBClient),3) <> '2.5')) then
            _FBClientCompat := _FBClientCompat+IIF(_FBClientCompat <> '',' / ','')+'FBClient.dll -> 2.5.x.xxxxx';
        end;
      end
      else begin
        Result := False;
        Application.MessageBox(pChar('A versão do servidor de banco de dados (Firebird Server) é incompatível com o sistema Ganso.'),'ATENÇÃO',MB_ICONINFORMATION+MB_OK);
        Exit;
      end;

      if (Trim(_FBServerCompat) <> '') then
      begin
        Result := False;
        Application.MessageBox(pChar('A versão da estrutura do Banco de Dados (Ganso.IB) é incompatível com a versão instalada do servidor de banco de dados (Firebird Server), verifique:'
                            +#13+#13+'FB Server compatível: '+StringReplace(_FBServerCompat,'Firebird ','',[rfReplaceAll])
                            +#13+#13+'FB Server instalado....: '+_VersFBServMajor+'.'+_VersFBServMinor
                        +#13+#13+#13+'Corrija a incompatibilidade e acesse o sistema novamente!'
                            +#13+#13+'Em caso de dúvidas, entre em contato com o suporte técnico.'
                            ),'ATENÇÃO',MB_ICONINFORMATION+MB_OK);
        Exit;
      end;

      if (Trim(_FBClientCompat) <> '') then
      begin
        Result := False;
        Application.MessageBox(pChar('A versão "Client" do Firebird instalada neste terminal é incompatível com o servidor de banco de dados (Firebird Server), verifique:'
                        +#13+#13+#13+'FB Server instalado: '+_VersFBServMajor+'.'+_VersFBServMinor
                            +#13+#13+'Client instalado...: '+'GDS32.dll -> '+_VerCliGDS32+' / FBClient.dll -> '+_VerCliFBClient
                            +#13+#13+'Client compatível: '+_FBClientCompat
                        +#13+#13+#13+'Corrija a incompatibilidade e acesse o sistema novamente!'
                            +#13+#13+'Obs.: instale as bibliotecas "Client''s" corretamente - faça uma busca geral no disco.'
                            +#13+#13+'Em caso de dúvidas, entre em contato com o suporte técnico.'
                            ),'ATENÇÃO',MB_ICONINFORMATION+MB_OK);
        Exit;
      end;
    except
      _VersEngFB := '';
      _VersFBServMajor := '';
      _VersFBServMinor := '';
      _VersFBODS := '';
      _VerCliGDS32 := '';
      _VerCliFBClient := '';
    end;
  finally
  end;
  { Compatibilidade entre Server's, Client's e ODS do Firebird - Luiz Santana - 27/04/2014

      FIREBIRD 1.5
      ==============
        GDS32.dll...: 6.3.6.5026
        FBClient.dll: 1.5.6.5026
        Banco (DB)..: ODS 10.1

      FIREBIRD 2.0.7
      ==============
        GDS32.dll...: 6.3.7.13318
        FBClient.dll: 2.0.7.13318
        Banco (DB)..: ODS 11.0

      FIREBIRD 2.1.5
      ==============
        GDS32.dll...: 6.3.5.18497
        FBClient.dll: 2.1.5.18497
        Banco (DB)..: ODS 11.1

      FIREBIRD 2.5.2
      ==============
        GDS32.dll...: 6.3.2.26540
        FBClient.dll: 2.5.2.26540
        Banco (DB)..: ODS 11.2

      FIREBIRD 2.5.3
      ==============
        GDS32.dll...: 6.3.3.26778
        FBClient.dll: 2.5.3.26778
        Banco (DB)..: ODS 11.2

      FIREBIRD 2.5.9
      ==============
        GDS32.dll...: 6.3.9.27139
        FBClient.dll: 2.5.9.27139
        Banco (DB)..: ODS 11.2
   }
end;

function ReplaceStrInTag(pStr, pReplaceTo: String; pTagFrom, pTagTo: Variant; pIdx: Integer = 1): String;
var
  i, x, vCount, vPosTagFrom, vPosTagTo: Integer;
  vStr: String;
begin
  //pIdx: Implementar controle do Idx conforme CopyStrInTag;

  try
    if (VarIsNumeric(pTagFrom)) then
      vPosTagFrom := pTagFrom
    else
    if (VarIsStr(pTagFrom)) then
      vPosTagFrom := PosEx(pTagFrom,pStr) //+ Length(pTagFrom)
    else
    if (VarIsNull(pTagFrom)) then
      vPosTagFrom := 1;


    if (VarIsNumeric(pTagTo)) then
      vPosTagTo := pTagTo
    else
    if (VarIsStr(pTagTo)) then
      vPosTagTo := (Pos(pTagTo,pStr) + Length(pTagFrom))
    else
    if (VarIsNull(pTagTo)) then
      vPosTagTo := Length(pStr);


    for i := vPosTagFrom to vPosTagTo do
      vStr := vStr + Copy(pStr,i,1);

    Result := StringReplace(pStr, vStr, pReplaceTo, []);
  except
    Result := '';
  end;
end;

function CopyStrInTag(pStr: String; pTagFrom, pTagTo: Variant; pIdx: Integer = 1): String;
var
  i, x, vCount, vPosTagFrom, vPosTagTo: Integer;
  vStr, vSubStr: String;
  vStrFromIdx: array of String;
begin
  Result := '';
  vStr := '';
  vSubStr := '';
  vPosTagFrom := 0;
  vPosTagTo := 0;
  x := 0;

  if (pIdx < 1) then
    pIdx := 1;

  if (pStr = '') or ((pTagFrom = Null) and (pTagTo = Null)) then
    Exit;

  if (pIdx = 1) then
  begin
    try
      if (VarIsNumeric(pTagFrom)) then
        vPosTagFrom := pTagFrom
      else
      if (VarIsStr(pTagFrom)) then
      begin
        if (PosEx(pTagFrom,pStr) > 0) then
          vPosTagFrom := PosEx(pTagFrom,pStr) + Length(pTagFrom)
        else
          Exit;
      end
      else
      if (VarIsNull(pTagFrom)) then
        vPosTagFrom := 1;

      if (VarIsNumeric(pTagTo)) then
        vPosTagTo := pTagTo
      else
      if (VarIsStr(pTagTo)) then
        vPosTagTo := (PosEx(pTagTo,pStr,vPosTagFrom) - 1)
      else
      if (VarIsNull(pTagTo)) then
        vPosTagTo := Length(pStr);

      for i := vPosTagFrom to vPosTagTo do
        vStr := vStr + Copy(pStr,i,1);
    except
      Result := '';
    end;

    Result := vStr;
  end
  else
  if (VarIsStr(pTagFrom)) and (VarIsStr(pTagTo)) then
  begin
    for i := 0 to (Length(pStr) - 1) do
    begin
      if (Copy(pStr, i, Length(pTagFrom)) = pTagFrom) then
        Inc(vCount);
    end;

    if (pIdx > vCount) then
      pIdx := vCount;

    SetLength(vStrFromIdx, (vCount + 1));

    for i := 0 to vCount do
    begin
      vSubStr := CopyStrInTag(pStr, pTagFrom, pTagTo);

      if (vSubStr <> '') then
      begin
        Inc(x);
        vStrFromIdx[x] := vSubStr;

        if (x >= pIdx) then
        begin
          Result := vStrFromIdx[x];
          Break;
        end;

        pStr := Copy(pStr, (Pos(vSubStr,pStr) + Length(vSubStr) + Length(pTagFrom) + Length(pTagTo)), Length(pStr));
      end;
    end;
  end;
end;

function ProcessoEstaEmExec(var _PathRetProc: String; ExeFileName: String): Boolean;
  function GetFullPathFromPID(PID: DWORD): string;
  var
    hProcess: THandle;
    path: array[0..MAX_PATH - 1] of char;
  begin
    Result:='';
    hProcess := OpenProcess(PROCESS_QUERY_INFORMATION or PROCESS_VM_READ, false, PID);
    if hProcess <> 0 then
    begin
      try
        if GetModuleFileNameEx(hProcess, 0, path, MAX_PATH) = 0 then
          Result := 'ERRO'
        else
          Result := path;
      finally
        CloseHandle(hProcess)
      end
    end
    else begin
      Result := 'ERRO';
    end;
  end;
var
  ContinueLoop: BOOL;
  FSnapshotHandle: THandle;
  FProcessEntry32: TProcessEntry32;
begin
  FSnapshotHandle := CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
  FProcessEntry32.dwSize := SizeOf(FProcessEntry32);
  ContinueLoop := Process32First(FSnapshotHandle, FProcessEntry32);
  Result := False;
  while Integer(ContinueLoop) <> 0 do
  begin
    if ((UpperCase(ExtractFileName(FProcessEntry32.szExeFile)) =
      UpperCase(ExeFileName)) or (UpperCase(FProcessEntry32.szExeFile) =
      UpperCase(ExeFileName))) then
    begin
      Result := True;
      _PathRetProc := GetFullPathFromPID(FProcessEntry32.th32ProcessID)
    end;
    ContinueLoop := Process32Next(FSnapshotHandle, FProcessEntry32);
  end;
  CloseHandle(FSnapshotHandle);
end;

function GetServiceExecPath(strMachine: string; strServiceName: string): String;
var
  hSCManager,hSCService: SC_Handle;
  lpServiceConfig: PQueryServiceConfigW;
  nSize, nBytesNeeded: DWord;
begin
  Result := '';
  hSCManager := OpenSCManager(PChar(strMachine), nil, SC_MANAGER_CONNECT);
  if (hSCManager > 0) then
  begin
    hSCService := OpenService(hSCManager, PChar(strServiceName), SERVICE_QUERY_CONFIG);
    if (hSCService > 0) then
    begin
      QueryServiceConfig(hSCService, nil, 0, nSize);
      lpServiceConfig := AllocMem(nSize);
      try
        if not QueryServiceConfig(hSCService, lpServiceConfig, nSize, nBytesNeeded) then
        begin
          Exit;
        end;
        Result := lpServiceConfig^.lpBinaryPathName;
      finally
        Dispose(lpServiceConfig);
      end;
      CloseServiceHandle(hSCService);
    end;
  end;
end;

function FinalizaProcesso(ExeFileName: string): Integer;
const
  PROCESS_TERMINATE = $0001;
var
  ContinueLoop: BOOL;
  FSnapshotHandle: THandle;
  FProcessEntry32: TProcessEntry32;
begin
  Result := 0;
  FSnapshotHandle := CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
  FProcessEntry32.dwSize := SizeOf(FProcessEntry32);
  ContinueLoop := Process32First(FSnapshotHandle, FProcessEntry32);

  while Integer(ContinueLoop) <> 0 do
  begin

    if ((UpperCase(ExtractFileName(FProcessEntry32.szExeFile)) = UpperCase(ExeFileName))
     or (UpperCase(FProcessEntry32.szExeFile) = UpperCase(ExeFileName))) then
    begin
      Result := Integer(TerminateProcess(OpenProcess(PROCESS_TERMINATE,BOOL(0),FProcessEntry32.th32ProcessID),0));
    end;

    ContinueLoop := Process32Next(FSnapshotHandle, FProcessEntry32);
  end;
  CloseHandle(FSnapshotHandle);
end;

function PararServicoWin(_ServNome : String) : Boolean;
var
  schService:SC_HANDLE;
  schSCManager:SC_HANDLE;
  ssStatus:TServiceStatus;
begin
  Result := True;
  schSCManager := OpenSCManager(nil,nil,SC_MANAGER_ALL_ACCESS);
  if (schSCManager <= 0) then
  begin
    //MessageDlg('Serviço não instalado.',mtError,[mbOk],0);
    Exit;
  end;

  schService := OpenService(schSCManager,pChar(_ServNome),SERVICE_ALL_ACCESS);

  if (schService <= 0) then
  begin
    //MessageDlg('Não foi possível acessar o serviço.',mtError,[mbOk],0);
    Result := False;
    Exit;
  end;

  //
  if ControlService(schService,SERVICE_CONTROL_STOP,ssStatus) then
  begin
    //stsMessage.SimpleText:='Parando serviço...';
    Sleep(500);
    while (QueryServiceStatus(schService,ssStatus)) do
    begin
      Application.ProcessMessages;
      if ssStatus.dwCurrentState=SERVICE_STOP_PENDING then
      begin
        //stsMessage.SimpleText:=stsMessage.SimpleText+('.');
        Sleep(500);
      end
      else
        Break;
    end;

    if ssStatus.dwCurrentState=SERVICE_STOPPED then
      Result := True //stsMessage.SimpleText:='Serviço parado com sucesso.'
    else
      Result := False; //stsMessage.SimpleText:='Falha ao parar serviço.';
  end
  else
    Result := False; //stsMessage.SimpleText:='Falha ao parar serviço.';

  CloseServiceHandle(schService);
  CloseServiceHandle(schSCManager);
end;

function IniciarServicoWin(_ServNome : String) : Boolean;
var
  schService:SC_HANDLE;
  schSCManager:SC_HANDLE;
  ssStatus:TServiceStatus;
  Argv : PChar;
begin
  Result := True;
  schSCManager := OpenSCManager(nil,nil,SC_MANAGER_ALL_ACCESS);

  if (schSCManager <= 0) then
  begin
    //MessageDlg('Serviço não instalado.',mtError,[mbOk],0);
    Exit;
  end;

  schService := OpenService(schSCManager,pChar(_ServNome),SERVICE_ALL_ACCESS);

  if (schService <= 0) then
  begin
    Result := False; //MessageDlg('Não foi possível acessar o serviço.',mtError,[mbOk],0);
    Exit;
  end;

  //
  if StartService(schService,0,Argv) then
  begin
    //stsMessage.SimpleText:='Iniciando serviço... ';
    Sleep(500);
    while (QueryServiceStatus(schService,ssStatus)) do
    begin
      Application.ProcessMessages;
      if ssStatus.dwCurrentState = SERVICE_START_PENDING then
      begin
        //stsMessage.SimpleText:=stsMessage.SimpleText+('.');
        Sleep(500);
      end
      else
        Break;
    end;

    if ssStatus.dwCurrentState = SERVICE_RUNNING then
      Result := True // stsMessage.SimpleText:='Serviço iniciado com Sucesso.'
    else
      Result := False; // stsMessage.SimpleText:='Falha ao iniciar o Serviço.';
  end
  else
    Result := False; // stsMessage.SimpleText:='Falha ao iniciar o Serviço.';

  CloseServiceHandle(schService);
  CloseServiceHandle(schSCManager);
end;

