function GetGansoTempDir: String;
var
  pNetpath: array[0..MAX_PATH - 1] of Char;
  nLength: Cardinal;
begin
  Result := '';
  
  try
    nLength := MAX_PATH;
    FillChar(pNetpath, SizeOf(pNetpath), #0);
    GetTempPath(nLength, pNetpath);
    Result := StrPas(pNetpath);

    if (Trim(StringReplace(StringReplace(Result,'/','',[rfReplaceAll]),':','',[rfReplaceAll])) = '') then
      Result := ExtractFileDir(Application.ExeName);

    if not DirectoryExists(Result + '\GansoTemp') then
      ForceDirectories(Result + '\GansoTemp');
  finally
    Result := Result + 'GansoTemp\';
  end;
end;

