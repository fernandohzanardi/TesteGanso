function NomeCaixaMista(_Texto : String; _ListaMinuscula : String = ''; _ListaMaiuscula : String = ''): String;
var
  tam,pos1,pos2 : integer ;
  pal : string;
begin
  tam := Length(_Texto);
  _Texto := TrimRight(_Texto) + ' ';
  _Texto := AnsiUpperCase(_Texto);
  while True do
  begin
    pos1 := PosEx(' ', _Texto);
    if pos1 = 0 then
      break;
    pal := Copy(_Texto,1,pos1) ;

    // Desconsiderar o "-"
    pos1 := PosEx('-',pal) ;

    if pos1 > 0 then
      pal := Copy(_Texto,1,pos1)
    else begin
      // Após o ponto "." - em casos de abreviações de nome (ex: L.A.S.S.)
      pos1 := PosEx('.',pal) ;

      if pos1 > 0 then
        pal := Copy(_Texto,1,pos1)
      else
        pos1 := PosEx(' ', _Texto);
    end;

    pos2 := PosEx(pal, ' DA - DAS - DE - DO - DOS - PARA - POR - P/ - EM - E - '+_ListaMinuscula);

    if pos2 > 0 then
    begin
      pal := AnsiLowerCase(pal);
    end
    else begin
      pos2 := PosEx(pal, _ListaMaiuscula);
      if pos2 > 0 then
      begin
        pal := AnsiUpperCase(pal);
      end
      else
        pal := Copy(pal,1,1) + AnsiLowerCase(Copy(pal,2,tam));
    end;
    Result := Result + pal ;
    _Texto := copy(_Texto,pos1+1,tam)
  end;
end;

function IncrementarDiasUteis(DataInicial : TDateTime; DiasUteis : Integer;
  IgnorarFeriados : Boolean = False; IgnorarSabados : Boolean = True;
    IgnorarDomingos : Boolean = False; IncrementaOuDecrementa: String = 'I'): TDateTime;
var AnoInicial, i, ContFeriados : Integer;
    RetornoData : TDateTime;
    Flag : Boolean;
begin
  {Procedimento que incrementa DiasUteis à DataInicial, podendo ignorar sábados,
   domingos e feriados. Quando (DiasUteis=0), retorna primeira data útil a
   partir da DataInicial.
   IncrementaOuDecrementa pode ser 'I' ou 'D'}
  AnoInicial := ExtractYear(DataInicial);
  Result := 0;

  Flag := True;

  if DiasUteis = 0 then
  begin
    RetornoData := DataInicial;
    _Cria_IBQuery(nil,999);
    While Flag do
    begin
      _IBQuery999.Close;
      _IBQuery999.SQL.Text := ' select f.codigo from feriados f '+
                              ' where cast(substr(f.dia_mes,1,2) as integer) = extract(day from cast('
                                +StringReplace(QuotedStr(DateTimeToStr(RetornoData)),'/','.',[rfReplaceAll])+'as date)) '+
                              ' and cast(substr(f.dia_mes,4,10) as integer) = extract(month from cast('
                                +StringReplace(QuotedStr(DateTimeToStr(RetornoData)),'/','.',[rfReplaceAll])+'as date))';
      _IBQuery999.Open;
      if (((not IgnorarFeriados) and(not _IBQuery999.IsEmpty)) or
          ((not IgnorarSabados)   and (DayOfWeek(RetornoData) = 7)) or
          ((not IgnorarDomingos)  and (DayOfWeek(RetornoData) = 1))) then
      begin
        {16/01/2016 - Edson Gregorio - CD 2331}
        if IncrementaOuDecrementa = 'I' then
          RetornoData := RetornoData+1
        else if IncrementaOuDecrementa = 'D' then
          RetornoData := RetornoData-1;
      end
      else
        Flag := False;
    end;
    _IBQuery999.Close;
    _Destroy_IBQuery(999);
  end
  else
  begin
    if IgnorarDomingos and IgnorarSabados then
    begin
      {16/01/2016 - Edson Gregorio - CD 2331}
      if IncrementaOuDecrementa = 'I' then
        RetornoData := DataInicial + DiasUteis
      else if IncrementaOuDecrementa = 'D' then
        RetornoData := DataInicial - DiasUteis
    end
    else
    begin
      i := DiasUteis;
      RetornoData := DataInicial;

      while i > 0 do
      begin
        Application.ProcessMessages;

        {16/01/2016 - Edson Gregorio - CD 2331}
        if IncrementaOuDecrementa = 'I' then
        begin
          if ((not IgnorarSabados)   and (DayOfWeek(RetornoData+1) = 7)) or
             ((not IgnorarDomingos)  and (DayOfWeek(RetornoData+1) = 1)) then
          begin
            RetornoData := RetornoData + 1;
          end
          else
          begin
            RetornoData := RetornoData + 1;
            Dec(i);
          end;
        end
        else if IncrementaOuDecrementa = 'D' then
        begin
          if ((not IgnorarSabados)   and (DayOfWeek(RetornoData-1) = 7)) or
             ((not IgnorarDomingos)  and (DayOfWeek(RetornoData-1) = 1)) then
          begin
            RetornoData := RetornoData - 1;
          end
          else
          begin
            RetornoData := RetornoData - 1;
            Dec(i);
          end;
        end;
      end;
    end;

    ContFeriados := 0;

    if not IgnorarFeriados then
    begin
      _Cria_IBQuery(nil,999);
      _IBQuery999.Close;
      _IBQuery999.SQL.Clear;
      _IBQuery999.SQL.Add('SELECT CAST(F_REPLACE(FERIADOS.DIA_MES || ' + QuotedStr('/') + ' || ' + QuotedStr(IntToStr(AnoInicial)) + ' , ' + QuotedStr('/') + ', ' + QuotedStr('.') + ') AS DATE)');
      _IBQuery999.SQL.Add('FROM FERIADOS');
      _IBQuery999.SQL.Add('WHERE CAST(F_REPLACE(FERIADOS.DIA_MES || ' + QuotedStr('/') + ' || ' + QuotedStr(IntToStr(AnoInicial)) + ' , ' + QuotedStr('/') + ', ' + QuotedStr('.') + ') AS DATE) BETWEEN :DATA1 AND :DATA2');

      {16/01/2016 - Edson Gregorio - CD 2331}
      if IncrementaOuDecrementa = 'I' then
      begin
        _IBQuery999.Params[0].AsDateTime := DataInicial;
        _IBQuery999.Params[1].AsDateTime := RetornoData;
      end
      else if IncrementaOuDecrementa = 'D' then
      begin
        _IBQuery999.Params[0].AsDateTime := RetornoData;
        _IBQuery999.Params[1].AsDateTime := DataInicial;
      end;

      _IBQuery999.Open;

      _IBQuery999.FetchAll;

      _IBQuery999.First;

      while not _IBQuery999.Eof do
      begin
        Application.ProcessMessages;
        if IgnorarSabados and IgnorarDomingos then
          Inc(ContFeriados)
        else if not IgnorarSabados and (DayOfWeek(_IBQuery999.Fields[0].AsDateTime) <> 7) then
          Inc(ContFeriados)
        else if not IgnorarDomingos and (DayOfWeek(_IBQuery999.Fields[0].AsDateTime) <> 1) then
          Inc(ContFeriados);

        _IBQuery999.Next;
      end;
      _Destroy_IBQuery(999);

      if IgnorarDomingos and IgnorarSabados then
      begin
        {16/01/2016 - Edson Gregorio - CD 2331}
        if IncrementaOuDecrementa = 'I' then
          RetornoData := RetornoData + ContFeriados
        else if IncrementaOuDecrementa = 'D' then
          RetornoData := RetornoData - ContFeriados
      end
      else
      begin
        i := ContFeriados;

        while i > 0 do
        begin
          Application.ProcessMessages;

          {16/01/2016 - Edson Gregorio - CD 2331}
          if IncrementaOuDecrementa = 'I' then
          begin
            if ((not IgnorarSabados)   and (DayOfWeek(RetornoData+1) = 7)) or
               ((not IgnorarDomingos)  and (DayOfWeek(RetornoData+1) = 1)) then
            begin
              RetornoData := RetornoData + 1;
            end
            else
            begin
              RetornoData := RetornoData + 1;
              Dec(i);
            end;
          end
          else if IncrementaOuDecrementa = 'D' then
          begin
            if ((not IgnorarSabados)   and (DayOfWeek(RetornoData-1) = 7)) or
               ((not IgnorarDomingos)  and (DayOfWeek(RetornoData-1) = 1)) then
            begin
              RetornoData := RetornoData - 1;
            end
            else
            begin
              RetornoData := RetornoData - 1;
              Dec(i);
            end;
          end;
        end;
      end;
    end;
  end;
  Result := RetornoData;
end;

function ContarDiasUteis(DataInicial, DataFinal : TDate;
  ConsiderarFeriados : Boolean = False; ConsiderarSabados : Boolean = True;
    ConsiderarDomingos : Boolean = False): Integer;
{ ConsiderarFeriados: Se Feriados serão considerados dias uteis
  ConsiderarSabados : Se Sabados serão considerados dias uteis
  ConsiderarDomingos: Se Domingos serão considerados dias uteis }
var
  AnoInicial: Integer;
  AnoFinal: Integer;
  CountFeriados: Integer;
  CountUteis: Integer;
  LQuery: TQuery;
begin
  AnoInicial := ExtractYear(DataInicial);
  AnoFinal   := ExtractYear(DataFinal);
  Result := 0;

  if DataFinal < DataInicial then
    exit;

  CountFeriados := 0;

  if not ConsiderarFeriados then
  begin
    // RET-1428 • 06/10/2025 • Lucas Frade • CD 5553
    //   Obs: Troca da Query Global >> Query Local
    //    várias chamadas do mesmo evento, acaba criando Qry em cima da outra perdendo o SQL/Referência da anterior
    LQuery := TQuery.Create(DM.IBbanco);

    try
      LQuery
        .Close
        .Clear
        .Add('select')
        .Add('  cast(f_replace(feriados.dia_mes || ''/'' || :pAno , ''/'', ''.'') as date) "DATA"')
        .Add('from feriados')
        .Add('where cast(f_replace(feriados.dia_mes || ''/'' || :pAno , ''/'', ''.'') as date) between :data1 and :data2');

      for var i := AnoInicial to AnoFinal do
      begin
        Application.ProcessMessages;
        LQuery
          .Close
          .Param('data1', DataInicial)
          .Param('data2', DataFinal)
          .Param('pAno', i.ToString)
          .Open
          .FetchAll;

        LQuery.First;
        while not LQuery.Eof do
        begin
          Application.ProcessMessages;
          if ConsiderarSabados and ConsiderarDomingos then
          begin
            Inc(CountFeriados);
            LQuery.Next;
            Continue;
          end;

          if (not ConsiderarSabados and (DayOfWeek(LQuery.FieldValue('DATA').AsDateTime) = 7)) or
             (not ConsiderarDomingos and (DayOfWeek(LQuery.FieldValue('DATA').AsDateTime) = 1)) then
          begin
            LQuery.Next;
            Continue;
          end;

          Inc(CountFeriados);

          LQuery.Next;
        end;
      end;
    finally
      LQuery.Free;
    end;
  end;

  CountUteis := 0;

  if ConsiderarDomingos and ConsiderarSabados then
    CountUteis := DaysInPeriod(DataInicial, DataFinal)
  else
  begin
    for var i := 0 to Trunc(DataFinal-DataInicial) do
    begin
      if (not ConsiderarDomingos and (DayOfWeek(DataInicial+i) = 1)) or
        (not ConsiderarSabados and (DayOfWeek(DataInicial+i) = 7)) then
      begin
        Continue;
      end;

      Inc(CountUteis);
    end;

  end;
  Result := CountUteis - CountFeriados;
end;


