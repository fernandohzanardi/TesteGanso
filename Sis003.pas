Function Encript(TEncSenha: String):String;
var
  x  : integer;
  v  : Char;
  m  : Char;
  E  : Char;
  EncSenha : String;
  Mascara : String;
  Soma : String;
  J : String;
begin
  EncSenha := '';
  for x := 1 to StrLen(PChar(TEncSenha)) do begin
    v := Char(TEncSenha[x]);
    EncSenha := EncSenha + Chr(Ord(v)+026+x);
  end;
  Soma := '';
  for x := 1 to StrLen(PChar(EncSenha)) do begin
    m := Char(EncSenha[x]);
    Soma := Soma + Chr(Ord(m)-056-x);
  end;
  Mascara := '';
  for x := 1 to StrLen(PChar(EncSenha+Soma)) do begin
    E := Char(EncSenha[x]);
    J := Char(Soma[x]);
    Mascara := Mascara + E + J
  end;
  Encript := (Mascara);
end;

Function Decript(TDecSenha: String):String;
var
  E  : Char;
  Mascara : String;
  x  : integer;
  v  : Char;
  DecSenha : String;
begin
  Mascara := '';
  for x := 1 to StrLen(PChar(TDecSenha)) do begin
    if (x mod 2 )<>0 then
    begin
      E := Char(TDecSenha[x]);
      Mascara := Mascara + E ;
    end;
  end;
  DecSenha := '';
  for x := 1 to StrLen(PChar(Mascara)) do begin
    v := Char(Mascara[x]);
    DecSenha := DecSenha + Chr(Ord(v)-026-x);
  end;
  Decript :=(DecSenha);
end;

function Fbusca(_banco: Tibdatabase; _transacao: TIBTransaction; _campo1, _tabela, _campo2: string; _campo3: Tfield; _Empresa_Filial: Integer; AddWhere : String = ''; NotisNull : Boolean = True; AuxMensagem : String = ''):string;
{ fbusca: banco,
          transacao,
          coluna de retorno,
          origem dos dados "tabela",
          campo da primeira condicao de pesquisa,
          campo da segunda condicao de pesquisa
          campo que informe se é empresa ou filial
          inclusão de alguma retrição no SQL
          }

var
  _query : TIBQuery;
  Tipo : String;
begin
  if AuxMensagem = '' then
    AuxMensagem := Trim(StringReplace(_tabela,'_',' ',[rfReplaceAll])); {29/01/2018 - Edson Gregorio}

  if _campo3.IsNull then
     result := ''
  else begin
    _query := TIBQuery.Create(nil);
    with _query do
    begin
      Database := _banco;
      Transaction := _transacao;

      Tipo := '';
      if _Empresa_Filial = 1 then
        Tipo := ' and CODIGO_EMPRESA = ' + IntToStr(_CodEmpresa)
      else if _Empresa_Filial = 2 then
        Tipo := ' and CODIGO_FILIAL = ' + IntToStr(_CodFilial);

      SQL.Clear;
      SQL.Add('select '+_campo2+','+_campo1+' from '+_tabela+' where '+_campo2+' = '+_campo3.AsString + AddWhere + Tipo);
      Open;
    end;

    if PosEx('.', _campo2) > 0 then
      _campo2 := copy(_campo2, PosEx('.', _campo2) + 1, length(_campo2) - PosEx('.', _campo2));

    if PosEx('.', _campo1) > 0 then
      _campo1 := copy(_campo1, PosEx('.', _campo1) + 1, length(_campo1) - PosEx('.', _campo1));

    if (_query.Fields[0].IsNull) and (NotisNull) then
    begin
       result := '';
       Application.MessageBox(PChar('Não foi encontrado '+ Trim(Caixa_Mista(AuxMensagem))+' com o Código informado.'),'ATENÇÃO !',MB_OK+MB_ICONINFORMATION);
       _campo3.Clear;
       keybd_event(VK_UP, 0, 0, 0);
    end
    else
      result := _query.Fields[1].AsString; // Corrigido //Para usar indice do campo no lugar do nome qdo usar "SUM" // David 03/05/2006
    _query.Free;
  end;
end;

