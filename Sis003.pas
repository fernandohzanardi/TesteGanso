    if Trim(CodigoNF) = '' then
    begin
      Result := '';
      Exit;
    end;

    vMensagem := '';
    ibqrConsultaVenda := TIBQuery.Create(nil);
    ibqrConsultaVenda.Database := DM.IBbanco;

    ibqrConsultaVenda.SQL.Text := 'select ' +
                                  '  nf.numero_nf, ' +
                                  '  nf.serie, ' +
                                  '  nf.codigo_lote_nfe, ' +

                                  '  f_lrtrim(case ' +
                                  '    when (coalesce(nf.codigo_prevenda,0) > 0) then ' +
                                  '      ''Pedido'' ' +
                                  '    when (coalesce(nf.codigo_os,0) > 0) then ' +
                                  '      ''Ordem de Serviço'' ' +
                                  '  end) as TIPO_MOVIMENTO, ' +

                                  '  f_lrtrim(case ' +
                                  '    when (coalesce(nf.codigo_prevenda,0) > 0) then ' +
                                  '      o.codigo ' +
                                  '    when (coalesce(nf.codigo_os,0) > 0) then ' +
                                  '      os.codigo ' +
                                  '  end) as NUMERO_VENDA, ' +

                                  '  f_lrtrim(case ' +
                                  '    when (coalesce(nf.codigo_prevenda,0) > 0) then ' +
                                  '      pv.pdv_mescla ' +
                                  '    when (coalesce(nf.codigo_os,0) > 0) then ' +
                                  '      os.pdv_mescla ' +
                                  '  end) as EMISSAO_CF_PDV, ' +

                                  '  f_lrtrim(case ' +
                                  '    when (coalesce(nf.codigo_prevenda,0) > 0) then ' +
                                  '      o.numero_cupom ' +
                                  '    when (coalesce(nf.codigo_os,0) > 0) then ' +
                                  '      os.numero_cupom ' +
                                  '  end) as NUMERO_CF, ' +

                                  ' pv.tipo_doc_fiscal ' + // 14/01/2016 - Vicente Neto - NFC-e

                                  'from nota_fiscal nf ' +
                                  '  left join orcamento o on (o.codigo = nf.codigo_prevenda) ' +
                                  '  left join os on (os.codigo = nf.codigo_os) ' +
                                  '  left join prevenda pv on (pv.codigo_orcamento = o.codigo) and (pv.origem_prevenda = ''P'') ' +
                                  'where ' +
                                  '  (nf.tipo <> ''A'') ' +
                                  '  and (nf.codigo_lote_nfe in (' + CodigoNF + '))';

    ibqrConsultaVenda.Open;

    while not ibqrConsultaVenda.Eof do
    begin
      if (Trim(ibqrConsultaVenda.FieldByName('NUMERO_CF').AsString) <> '') and (Trim(ibqrConsultaVenda.FieldByName('NUMERO_CF').AsString) <> '9999') and (Trim(ibqrConsultaVenda.FieldByName('NUMERO_CF').AsString) <> '9998') then
      begin
        if (UpperCase(Trim(ibqrConsultaVenda.FieldByName('TIPO_MOVIMENTO').AsString)) = 'PEDIDO') then
          vArtigo := ' o '
        else
          vArtigo := ' a ';

        vMensagem := vMensagem +
                     '- O Cupom Fiscal número ' + Trim(ibqrConsultaVenda.FieldByName('NUMERO_CF').AsString) + ' foi emitido para' + vArtigo +
                     Trim(ibqrConsultaVenda.FieldByName('TIPO_MOVIMENTO').AsString) + ' número ' + Trim(ibqrConsultaVenda.FieldByName('NUMERO_VENDA').AsString) +
                     ' que está vinculado à Nota Fiscal número ' + Trim(ibqrConsultaVenda.FieldByName('numero_nf').AsString) + ' da série número ' +
                     Trim(ibqrConsultaVenda.FieldByName('serie').AsString) + ' no lote número ' + Trim(ibqrConsultaVenda.FieldByName('codigo_lote_nfe').AsString) + '. ' +
                     'Cancele a emissão desta Nota Fiscal e emita como Acompanhamento de Cupom Fiscal.' +#13+#13;
      end
      else
      if ((Trim(ibqrConsultaVenda.FieldByName('EMISSAO_CF_PDV').AsString) <> '') and (Trim(ibqrConsultaVenda.FieldByName('EMISSAO_CF_PDV').AsString) <> '9999')
          and (Trim(ibqrConsultaVenda.FieldByName('EMISSAO_CF_PDV').AsString) <> '9998')) or
         ((Trim(ibqrConsultaVenda.FieldByName('EMISSAO_CF_PDV').AsString) = '9999') and (ibqrConsultaVenda.FieldByName('tipo_doc_fiscal').AsString = 'NC')) then // 14/01/2016 - Vicente Neto - NFC-e
      begin
        if (UpperCase(Trim(ibqrConsultaVenda.FieldByName('TIPO_MOVIMENTO').AsString)) = 'PEDIDO') then
          vArtigo := ' ao '
        else
          vArtigo := ' a ';

        vMensagem := vMensagem +
                     '- A Nota Fiscal número ' + Trim(ibqrConsultaVenda.FieldByName('numero_nf').AsString) + ' da série número ' + Trim(ibqrConsultaVenda.FieldByName('serie').AsString) +
                     ' esta vinculada' + vArtigo + Trim(ibqrConsultaVenda.FieldByName('TIPO_MOVIMENTO').AsString) + ' número ' + Trim(ibqrConsultaVenda.FieldByName('NUMERO_VENDA').AsString) +
                     ' que esta em processo de emissão de '+ IfThen((ibqrConsultaVenda.FieldByName('tipo_doc_fiscal').AsString = 'NC'),'NFC-e','Cupom Fiscal') +  // 14/01/2016 - Vicente Neto - NFC-e
                     ' . Se ' + IfThen((ibqrConsultaVenda.FieldByName('tipo_doc_fiscal').AsString = 'NC'),'a NFC-e','o Cupom Fiscal') + ' for emitido a Nota Fiscal deverá ser do tipo Acompanhamento de Cupom Fiscal.' +#13+#13; // 14/01/2016 - Vicente Neto - NFC-e
      end;

      ibqrConsultaVenda.Next;
    end;
  except
    Result := '- O sistema não pôde verificar se existe emissão de Cupom Fiscal em andamento ou se as Notas Fiscais presentes no lote informado possuem Cupom Fiscal vinculado.';
    Exit;
  end;

  Result := vMensagem;
  ibqrConsultaVenda.Free;
end;

function DiaSemanaNumero(_DiaSemanaExtenso : String) : Integer;
begin
  Result := 0;
  if PosEx('DOMINGO',UpperCase(_DiaSemanaExtenso)) > 0 then Result := 1
  else if PosEx('SEGUNDA',UpperCase(_DiaSemanaExtenso)) > 0 then Result := 2
  else if PosEx('TERCA',UpperCase(_DiaSemanaExtenso)) > 0 then Result := 3
  else if PosEx('QUARTA',UpperCase(_DiaSemanaExtenso)) > 0 then Result := 4
  else if PosEx('QUINTA',UpperCase(_DiaSemanaExtenso)) > 0 then Result := 5
  else if PosEx('SEXTA',UpperCase(_DiaSemanaExtenso)) > 0 then Result := 6
  else if PosEx('SABADO',UpperCase(_DiaSemanaExtenso)) > 0 then Result := 7;
end;

function GeraDataConvenio(_TipoFecha : String; _IniProcConv : Boolean; _DiaMesFecha, _DiaMesVence, _NroParc : Integer; _DataBaseConv, _DataVendaConv: TDate; _DiaSemanaVencConv : String) : TDate;
var
  _TentativasDt, _ErroGerarVenc : Boolean;
  _DataFecha, _DataVenceTest, _DataVenc : TDate;
  _Mes, _Ano, _DiaFecha, _DiaVence, _DiaVencSemana, _DiaBase : Integer;
begin
  { Função Compatívil com a PDV003 do PDV - Manter compatibilidade entre os sistemas Retaguarda e PDV }
  if (_TipoFecha = 'M') then
  begin
    if _IniProcConv then
    begin
      { Regra do Convênio - Tipo: MENSAL - Rodrigo/Luiz - 17/09/2007
       1º) Checa a Data de Fechamento e Data da Venda, para ver se a venda está sendo feita
           antes ou depois do fechamento, se for até o dia do fechamento, checar 2º condição,
           caso contrário, o vencimento será no próximo Mês.

       2º) Sempre que o dia de vencimento do convênio for menor ou igual ao dia de fechamento do convênio
           será vencido no próximo mês. }

      // Formando a Data de Fechamento e Validando
      _TentativasDt := True;
      _DiaFecha := _DiaMesFecha;
      while _TentativasDt = True do
      begin
        try
          _DataFecha := StrToDate(IntToStr(_DiaFecha)+'/'+IntToStr(MonthOf(_DataBaseConv))+'/'+IntToStr(YearOf(_DataBaseConv)));
          Break;
        except
          Dec(_DiaFecha);
        end;
        if (_DiaFecha <= 0) then Break;
      end;

      // Formando a Data de Vencimento e Validando
      _TentativasDt := True;
      _DiaVence := _DiaMesVence;
      while _TentativasDt = True do
      begin
        try
          _DataVenceTest := StrToDate(IntToStr(_DiaVence)+'/'+IntToStr(MonthOf(_DataBaseConv))+'/'+IntToStr(YearOf(_DataBaseConv)));
          Break;
        except
          Dec(_DiaVence);
        end;
        if (_DiaVence <= 0) then Break;
      end;

      if _DataBaseConv <= _DataFecha then // 1º Ciclo
      begin
        if _DiaVence <= _DiaFecha then
          _Mes := MonthOf(_DataBaseConv) + 1
        else
          _Mes := MonthOf(_DataBaseConv);
      end
      else begin // 2º Ciclo
        if _DiaVence <= _DiaFecha then
          _Mes := MonthOf(_DataBaseConv) + 2
        else
          _Mes := MonthOf(_DataBaseConv) + 1;
      end;
      _IniProcConv := False;
    end
    else
      _Mes := MonthOf(_DataBaseConv) + 1;

    if (_Mes >= 13)and(_Mes <= 24) then
    begin
      _Mes := _Mes - 12;
      _Ano := YearOf(_DataBaseConv) + 1;
    end
    else if (_Mes >= 25)and(_Mes <= 36) then
    begin
      _Mes := _Mes - 24;
      _Ano := YearOf(_DataBaseConv) + 2;
    end
    else if (_Mes >= 37)and(_Mes <= 48) then
    begin
      _Mes := _Mes - 36;
      _Ano := YearOf(_DataBaseConv) + 3;
    end
    else if (_Mes >= 49)and(_Mes <= 60) then
    begin
      _Mes := _Mes - 48;
      _Ano := YearOf(_DataBaseConv) + 4;
    end
    else if (_Mes >= 61)and(_Mes <= 72) then
    begin
      _Mes := _Mes - 60;
      _Ano := YearOf(_DataBaseConv) + 5;
    end
    else
      _Ano := YearOf(_DataBaseConv);

    _TentativasDt := True;
    _DiaVence := _DiaMesVence;
    while _TentativasDt = True do
    begin
      try
        _DataVenc := StrToDate(IntToStr(_DiaVence)+'/'+FormatFloat('00',_Mes)+'/'+IntToStr(_Ano));
        Break;
      except
        Dec(_DiaVence);
      end;
      if (_DiaVence <= 0) then Break;
    end;

    Result := _DataVenc;
  end
  else if (_TipoFecha = 'Q') then
  begin
    { Regra do Convênio - Tipo: QUINZENAL - Luiz - 25/01/2012
      Quando não existir o dia de fechamento da 2ª quinzena será considerado o último dia do mês, exemplo, 28,29,30,31}

    // Método Padrão desativado em 31/01/2012 - Luiz (Cliente trabalha com Faixas em Dias fixos)
    {
    // if not(_IniProcConv) then // Luiz - 31/01/2012 (a incrementação é pra calcular próximas parcelas
    //                                                 e também pra evitar que o vencimento seja no dia do fechamento - padrão 2 Irmãos)
    _DataBaseConv := _DataBaseConv + 1;

    // Formando a Data de Vencimento
    _TentativasDt := True;
    _DiaVence := _DiaMesFecha;
    while _TentativasDt = True do
    begin
      try
        _DataVenc := StrToDate(IntToStr(_DiaVence)+'/'+IntToStr(MonthOf(_DataBaseConv))+'/'+IntToStr(YearOf(_DataBaseConv)));
        Break;
      except
        Dec(_DiaVence);
      end;
      if (_DiaVence <= 0) then Break;
    end;

    if (_DataBaseConv > _DataVenc) then
    begin
      if ((_DiaMesFecha > 15) or ((_DiaMesFecha = 14)and(DaysInMonth(_DataVenc) = 28))) then
      begin
        _DataVenc := IncMonth(_DataVenc,1) - 15;

        if (DaysInMonth(_DataVenc) < _DiaMesFecha) then
          _DataVenc := _DataVenc + ( _DiaMesFecha - DaysInMonth(_DataVenc))
        else if ((_DiaMesFecha = 14)and(DaysInMonth(_DataVenc) = 28)) then
          _DataVenc := _DataVenc + 1;
      end
      else if (_DiaMesFecha = 15) then
      begin
        if ((DayOf(_DataBaseConv) > 15)and(DaysInMonth(_DataVenc) < 30)) then
          _DataVenc := _DataVenc + (DaysInMonth(_DataVenc) - DayOf(_DataVenc))
        else begin
          if (DayOf(_DataBaseConv) = 31) then
            _DataVenc := IncMonth(_DataVenc,1)
          else
            _DataVenc := _DataVenc + 15;
        end;
      end
      else begin
        _DataVenc := _DataVenc + 15;
        if (_DataBaseConv > _DataVenc) then
        begin
          _DataVenc := IncMonth(_DataVenc,1) - 15;
          if (DaysInMonth(_DataVenc) < _DiaMesFecha) then
            _DataVenc := _DataVenc + ( _DiaMesFecha - DaysInMonth(_DataVenc))
        end;
      end;
    end
    else begin
      if (_DataBaseConv <= (_DataVenc - 15) + (IIF((_DiaMesFecha in [29,30,31]) and ((DaysInMonth(_DataVenc) < _DiaMesFecha)),(_DiaMesFecha - DaysInMonth(_DataVenc)),0))) then
      begin
        _DataVenc := _DataVenc - 15;
        if ((DaysInMonth(_DataVenc) < _DiaMesFecha)) then
          _DataVenc := _DataVenc + (_DiaMesFecha - DaysInMonth(_DataVenc))
      end;
    end;
    Result := _DataVenc;
    }

    _ErroGerarVenc := False;

    if (_DiaMesFecha <= 0) then
    begin
      Result := _DataBaseConv;
      Application.MessageBox('Não foi informado o dia para Fechamento da 1ª Quinzena, verifique no cadastro do Cliente/Convênio.','ATENÇÃO',MB_ICONINFORMATION+MB_OK);
      Exit;
    end;

    if (_DiaMesVence <= 0) then
    begin
      Result := _DataBaseConv;
      Application.MessageBox('Não foi informado o dia para Fechamento da 2ª Quinzena, verifique no cadastro do Cliente/Convênio.','ATENÇÃO',MB_ICONINFORMATION+MB_OK);
      Exit;
    end;

    {if (_IniProcConv) then
    begin
      _DiaBase := DayOf(_DataBaseConv);
    end
    else begin
      if (DayOf(_DataVendaConv) <= 15) then
      begin
        if (_NroParc mod 2 <> 0) then // Parcelas ímpares significa 1ª Quinzena
          _DiaBase := 1
        else begin
          _DiaBase := 16;
          _DataBaseConv := IncMonth(_DataBaseConv,-1);
        end;
      end
      else begin
        if (_NroParc mod 2 <> 0) then // Parcelas ímpares significa 1ª Quinzena
        begin
          _DiaBase := 16;
          _DataBaseConv := IncMonth(_DataBaseConv,-1);
        end
        else
          _DiaBase := 1
      end;
    end; }

    _DiaBase := DayOf(_DataVendaConv);

    // 1ª Quinzena
    if (_DiaBase in [1..15]) then
    begin
      while True do
      begin
        try
          _DataVenc := StrToDate(IntToStr(_DiaMesFecha)+'/'+IntToStr(MonthOf(IncMonth(_DataBaseConv,1)))+'/'+IntToStr(YearOf(IncMonth(_DataBaseConv,1))));
          Break;
        except
          Dec(_DiaMesFecha);
          if (_DiaMesFecha <= 0) then
          begin
            _ErroGerarVenc := True;
            Break;
          end;
        end;
      end;

      if (_ErroGerarVenc) then
      begin
        Result := _DataBaseConv;
        Application.MessageBox('Não foi possível calcular o vencimento da 1ª Quinzena, tente novamente.','ATENÇÃO',MB_ICONINFORMATION+MB_OK);
        Exit;
      end;
      Result := _DataVenc;
    end
    else begin // 2ª Quinzena
      while True do
      begin
        try
          _DataVenc := StrToDate(IntToStr(_DiaMesVence)+'/'+IntToStr(MonthOf(IncMonth(_DataBaseConv,1)))+'/'+IntToStr(YearOf(IncMonth(_DataBaseConv,1))));
          Break;
        except
          Dec(_DiaMesVence);
          if (_DiaMesVence <= 0) then
          begin
            _ErroGerarVenc := True;
            Break;
          end;
        end;
      end;

      if (_ErroGerarVenc) then
      begin
        Result := _DataBaseConv;
        Application.MessageBox('Não foi possível calcular o vencimento da 2ª Quinzena, tente novamente.','ATENÇÃO',MB_ICONINFORMATION+MB_OK);
        Exit;
      end;
      Result := _DataVenc;
    end;
  end
  else if (_TipoFecha = 'S') then
  begin
    { Regra do Convênio - Tipo: SEMANAL - Luiz - 27/01/2012 }

    _DiaVencSemana := DiaSemanaNumero(_DiaSemanaVencConv);
    _DiaBase := DayOfWeek(_DataBaseConv);

    _DataVenc := _DataBaseConv + (IIF(_DiaVencSemana >= _DiaBase,
                                    _DiaVencSemana - _DiaBase,
                                    (7 - _DiaBase) + _DiaVencSemana));

    // Luiz - 31/01/2012 (a incrementação é pra calcular próximas parcelas
    //                    e também pra evitar que o vencimento seja no dia do fechamento - padrão 2 Irmãos)
    if ((not(_IniProcConv))or(_DiaBase = _DiaVencSemana)) then
      _DataVenc := IncWeek(_DataVenc,1);

    Result := _DataVenc;
  end;
end;

//function ICMSAliqOperacao(_UFOrigem : String = ''; _UFDestino : String = ''; _Modo : String = 'N') : Currency;
function ICMSAliqOperacao(_CodProduto: Integer; _NCM, _UFOrigem, _UFDestino: String; _Modo: String = 'N'): Currency;
begin
  Result := 0.0000;

  if (_Modo <> 'T') then
  begin
    if (_CodProduto <= 0) then
    begin
      raise Exception.Create('Falha ao carregar a alíquota do tributo. É necessário informar o código do produto.');
      Exit;
    end
    else
    if (Trim(_NCM) = '') then
    begin
      raise Exception.Create('Falha ao carregar a alíquota do tributo. É necessário informar o NCM (Nomenclatura Comum do Mercosul) do produto.');
      Exit;
    end
    else
    if (Length(Trim(_NCM)) <> 8) then
    begin
      raise Exception.Create('Falha ao carregar a alíquota do tributo. O NCM (Nomenclatura Comum do Mercosul) deve conter 8 dígitos.');
      Exit;
    end
    else
    if ((Trim(_UFOrigem) = '') or (Trim(_UFDestino) = '')) then
    begin
      raise Exception.Create('Falha ao carregar a alíquota do tributo. É necessário informar a UF de Origem e Destino.');
      Exit;
    end;
  end;

  try
    _Cria_IBQuery(nil,999);
    _IBQuery999.Close;

    if (_Modo = 'T') then
    begin
      _IBQuery999.SQL.Text := 'select count(codigo) as "QTD" from uf_tributo';
      _IBQuery999.Open;

      if (_IBQuery999.FieldByName('QTD').AsCurrency <> 729) then
      begin
        Result := 0;
        Application.MessageBox('Tabela de alíquota por Estado está incompleta ou vazia.'+#13+#13+'Contate o Suporte Técnico.','ATENÇÃO',MB_OK+MB_ICONINFORMATION);
      end
      else
        Result := 729;
    end
    else
    begin
      _IBQuery999.SQL.Text := 'select aliquota from sp_retorna_tributo(:ncm, :uf_origem, :uf_dest, :cod_produto)';
      _IBQuery999.ParamByName('ncm').AsString := _NCM;
      _IBQuery999.ParamByName('uf_origem').AsString := _UFOrigem;
      _IBQuery999.ParamByName('uf_dest').AsString := _UFDestino;
      _IBQuery999.ParamByName('cod_produto').AsInteger := _CodProduto;
      _IBQuery999.Open;
    
      Result := _IBQuery999.FieldByName('aliquota').AsCurrency;
    end;
  finally
    _IBQuery999.Close;
    _Destroy_IBQuery(999);
  end;
end;

function ValidarCodigoBarras(GTIN: String): String;
var
  d01, d02, d03, d04, d05, d06, d07, d08, d09, d10, d11, d12, iDV : String;
  vSomaPar, vSomaImp, cDV: Integer;
begin
  // Função utilizada apenas para NF-e geradas pela Flexdocs - foi criada a ValidarGTIN com a checagem correta do DV
  //OBS: O result "INVALIDO" é interpretado pelo layout da Nota Fiscal Eletrônica como um código analisado mas é inválido;
  //     O result "nulo" deve ser retornado quando o código não satisfazer requisitos de tamanho e consequentemente não puder ser validado;
  Result := '';

  if (StrLen(PChar(GTIN)) < 8) or (StrLen(PChar(GTIN)) > 13) then
  begin
    Result := '';
    Exit;
  end
  else
  if (Trim(StringReplace(GTIN,'0','',[rfReplaceAll])) = '') then
  begin
    Result := 'INVALIDO';
    Exit;
  end;

  GTIN := DupeString('0',13 - StrLen(PChar(GTIN))) + GTIN;

  if (Pos(','+Copy(GTIN,1,3)+',', MatrizPaisesValidos) <= 0) then
  begin
    //Código de barras inválido;
    Result := 'INVALIDO';
    Exit;
  end;

  try
    d01 := Copy(GTIN, 12, 1);
    d02 := Copy(GTIN, 11, 1);
    d03 := Copy(GTIN, 10, 1);
    d04 := Copy(GTIN, 09, 1);
    d05 := Copy(GTIN, 08, 1);
    d06 := Copy(GTIN, 07, 1);
    d07 := Copy(GTIN, 06, 1);
    d08 := Copy(GTIN, 05, 1);
    d09 := Copy(GTIN, 04, 1);
    d10 := Copy(GTIN, 03, 1);
    d11 := Copy(GTIN, 02, 1);
    d12 := Copy(GTIN, 01, 1);

    iDV := Copy(GTIN, 13, 1);

    vSomaPar := (StrToInt(d02) + StrToInt(d04) + StrToInt(d06) + StrToInt(d08) + StrToInt(d10) + StrToInt(d12)) * 9;
    vSomaImp := (StrToInt(d01) + StrToInt(d03) + StrToInt(d05) + StrToInt(d07) + StrToInt(d09) + StrToInt(d11)) * 7;

    cDV := ((vSomaPar + vSomaImp) mod 10);

    if (iDV <> IntToStr(cDV)) then
      Result := 'INVALIDO'
    else
      Result := GTIN;
  except
    Result := 'INVALIDO';
  end;
end;

function BuscaSaldoBanco(_CodigoContaBanco : Integer) : Extended;
begin
  _Cria_IBQuery(nil,999);
  _IBQuery999.Close;
  _IBQuery999.SQL.Text := ' select first 1 cs.saldo_atual '
                         +' from conta_saldo cs '
                         +' where cs.codigo_conta = '+IntToStr(_CodigoContaBanco)
                         +' order by cs.data_movimentacao descending ';
  _IBQuery999.Open;
  _IBQuery999.First;

  Result := _IBQuery999.FieldByName('saldo_atual').AsCurrency;

  _IBQuery999.Close;
  _Destroy_IBQuery(999);
end;

function TemItemPendLibDesc(_CodigoOrcamento : Integer): Boolean;
var
  _x : Integer;
  _CodADConf : String;
begin
  // Verifica se tem item pendente de liberação das chaves de desconto
  Result := False;
  _Cria_IBQuery(nil,999);
  _IBQuery999.Close;
  _IBQuery999.SQL.Text := ' select oi.codigo, oi.codigo_ad '
                         +' from orcamento_item oi '
                         +' where oi.codigo_orcamento = '+IntToStr(_CodigoOrcamento)
                         +'   and oi.codigo_ad is not null ';
  _IBQuery999.Open;
  _IBQuery999.FetchAll;

  if not(_IBQuery999.IsEmpty) then
  begin
    _IBQuery999.First;
    while not(_IBQuery999.Eof) do
    begin
      _CodADConf := _IBQuery999.FieldbyName('codigo_ad').AsString;
      _x := 1;
      while _x <= StrLen(pChar(Trim(_CodADConf))) do
      begin
        if (Copy(_CodADConf,_x + 3,1) = '0') then
        begin
          Result := True;
          Break;
        end;
        _x := _x + 4;
      end;

      if (Result) then
        Break;

      _IBQuery999.Next;

    end;
    _IBQuery999.Close;
    _Destroy_IBQuery(999);
  end
  else begin
    _IBQuery999.Close;
    _Destroy_IBQuery(999);
  end;
end;

procedure VisualizarDANFE(vCodigoNF, vNumeroNF: Integer; vSerieNF: String);
var
  RetornoConversao: TfnRetornoConvTXTemXML;
  RetornoGeracaoPDF: TfnRetornoGeraPDF;
  vTempoEspera: Integer;
  vNomeArquivoTXT, vNomeArquivoPDF, vNomeArquivoXML, vMensagem: String;
  vStatus_ParNFETransmite: Boolean;
  mmXML: TMemo;
begin
  vTempoEspera := 10;
  vNomeArquivoTXT := '';
  vNomeArquivoPDF := '';
  vNomeArquivoXML := '';
  vMensagem := '';
  vStatus_ParNFETransmite := _ParNFETransmite;

  try
    if (StrToInt(Trim(vSerieNF)) <= 0) then
    begin
      Application.MessageBox('Número de Série inválido. Informe um valor entre 1 e 990.','ATENÇÃO',MB_OK+MB_ICONINFORMATION);
      Exit;
    end;
  except
    Application.MessageBox('Número de Série inválido. Informe um valor entre 1 e 990.','ATENÇÃO',MB_OK+MB_ICONINFORMATION);
    Exit;
  end;

  if (vNumeroNF <= 0) and ((_ParNFTipoEmissao = 'F') or ((_ParNFTipoEmissao = 'E') and (not _ParNFETransmite))) then
  begin
    Application.MessageBox('Número de Nota Fiscal inválido. Informe um valor acima de 1.','ATENÇÃO',MB_OK+MB_ICONINFORMATION);
    Exit;
  end;

  vNomeArquivoTXT := 'NFeTXT' + FormatFloat('000000000', vCodigoNF) + '.txt';
  vNomeArquivoXML := 'PrvNFeXML' + FormatFloat('000000000', vCodigoNF) + '.xml';

  if FileExists(GetGansoTempDir + vNomeArquivoXML) then
  begin
    if not DeleteFile(GetGansoTempDir + vNomeArquivoXML) then
    begin
      Application.MessageBox(PChar('O sistema não conseguiu excluir o arquivo XML gerado anteriormente para visualização desta Nota Fiscal.'),'ATENÇÃO',MB_OK+MB_ICONINFORMATION);
      Exit;
    end;
  end;

  try
    if not Assigned(FrmExportarNFe) then
       FrmExportarNFe:= TFrmExportarNFe.Create(nil);

    //vVisualizacaoDANFE := True;
    FrmExportarNFe.FrxRelatorio.ShowProgress := False;
    FrmExportarNFe.OnShow(nil);

    with FrmExportarNFe do
    begin
      try
        _ParNFETransmite := True;

        if ((_ParNFTipoEmissao = 'F') or ((_ParNFTipoEmissao = 'E') and (not _ParNFETransmite))) then
        begin
          edtNumeroNF.Text := IntToStr(vNumeroNF);
          edtSerieNF.Text := Trim(vSerieNF);
        end
        else
        begin
          //Convenção adotada para definir a numeração da Nota Fiscal somente no momento que está sendo transmitida para a SEFAZ.
          edtNumeroNF.Text := '-1' + IntToStr(vCodigoNF);
          edtSerieNF.Text := '999';
        end;

        BtnImprimirClick(BtnImprimir);
      finally
        _ParNFETransmite := vStatus_ParNFETransmite;
      end;
    end;
  except
    on E: Exception do
    begin
      Application.MessageBox(PChar('Falha no processo' +#13+#13+ E.Message),'ATENÇÃO',MB_OK+MB_ICONINFORMATION);
      Exit;
    end;
  end;

  if not FrmExportarNFe.vArquivoGerado then
  begin
    if Assigned(FrmExportarNFe) then
      FrmExportarNFe.Close;

    Exit;
  end;

  repeat
    begin
      Application.ProcessMessages;
      Dec(vTempoEspera);
      Sleep(1000);
    end;
  until
    FileExists(GetGansoTempDir + vNomeArquivoTXT) or (vTempoEspera <= 0);

  if Assigned(FrmExportarNFe) then
     FrmExportarNFe.Close;

  Application.ProcessMessages;

  if not FileExists(GetGansoTempDir + vNomeArquivoTXT) then
  begin
    Application.MessageBox('Tempo limite excedido para disponibilidade do arquivo.','ATENÇÃO',MB_OK+MB_ICONINFORMATION);
    Exit;
  end;

  if not CarregarDLL_FlexDocs then
    Exit;

  RetornoConversao := ConverterTXTemXML(vNomeArquivoTXT, GetGansoTempDir);
  DeleteFile(GetGansoTempDir + vNomeArquivoTXT);
  mmXML := TMemo.Create(nil);
  mmXML.Width := 0;
  mmXML.Height := 0;
  mmXML.Visible := False;
  mmXML.Parent := FrmPrincipalGanso;

  if not RetornoConversao.ExecOK then
  begin
    vMensagem := RetornoConversao.msgResultado;
    Application.MessageBox(PChar('Falha na geração do arquivo. A mensagem completa foi copiada para a Área de Transferência.' +#13+#13+ vMensagem),'ATENÇÃO',MB_OK+MB_ICONINFORMATION);
    mmXML.Lines.Text := RetornoConversao.erros;
    mmXML.SelectAll;
    mmXML.CopyToClipboard;
    Exit;
  end
  else
  begin
    //vNomeArquivoPDF := 'PrvNFePDF' + FormatFloat('000000000', vCodigoNF) + '.pdf';
    //O nome do arquivo PDF teve que ser modificado porque o componente da ACBr não permite alterar o nome do arquivo.
    vNomeArquivoPDF := CopyStrInTag(RetornoConversao.ArquivoXML, 'Id="NFe', '"><ide>') + '-nfe.pdf';

    if FileExists(GetGansoTempDir + vNomeArquivoPDF) then
    begin
      if not DeleteFile(GetGansoTempDir + vNomeArquivoPDF) then
      begin
        if (Application.MessageBox(PChar('O sistema não conseguiu excluir o arquivo PDF do DANFE gerado anteriormente para visualização desta Nota Fiscal.' +#13+
                                         'Feche a visualização do DANFE da Nota Fiscal número ' + IntToStr(vNumeroNF) + ' e clique em OK para continuar.'),'ATENÇÃO',MB_OKCANCEL+MB_ICONINFORMATION) = idCancel) then
          Exit
        else
        begin
          if not DeleteFile(GetGansoTempDir + vNomeArquivoPDF) then
          begin
            Application.MessageBox(PChar('O sistema não conseguiu excluir o arquivo PDF do DANFE gerado anteriormente para visualização desta Nota Fiscal.' +#13+
                                         'Certifique-se de que a visualização do DANFE da Nota Fiscal número ' + IntToStr(vNumeroNF) + ' foi fechada e tente novamente.'),'ATENÇÃO',MB_OK+MB_ICONINFORMATION);
            Exit;
          end;
        end;
      end;
    end;

    if (_usuario = 'TECMIC') then
    begin
      mmXML.Lines.Text := RetornoConversao.ArquivoXML;
      mmXML.Lines.SaveToFile(GetGansoTempDir + vNomeArquivoXML);
    end;
    
    RetornoGeracaoPDF := GerarPDF(UTF8Encode(RetornoConversao.ArquivoXML), '', GetGansoTempDir);

    if RetornoGeracaoPDF.ExecOK then
      ShellExecute(0, 'Open', PWideChar(vNomeArquivoPDF), '', PWideChar(GetGansoTempDir), SW_NORMAL);
  end;

  mmXML.Free;
end;

function CapturarVendedores(idVendas, idOrcamentos, idOS: String): String;
var
  vInfo: String;
  vCodigoAnterior: Integer;
begin
  //Captura informações das vendas
  Result := '';
  
  vCodigoAnterior := 0;
  vInfo := '';
  _Cria_IBQuery(nil,999);

  if (Trim(idVendas) <> '') then
    _IBQuery999.SQL.Add('select vi.codigo_funcionario from venda_item vi where vi.codigo_venda in (' + Trim(idVendas) + ') group by vi.codigo_funcionario');

  if (Trim(idOrcamentos) <> '') and (Trim(idVendas) <> '') then
    _IBQuery999.SQL.Add('union select oi.codigo_funcionario from orcamento_item oi where oi.codigo_orcamento in (' + Trim(idOrcamentos) + ') group by oi.codigo_funcionario')
  else
  if (Trim(idOrcamentos) <> '') and (Trim(idVendas) = '') then
    _IBQuery999.SQL.Add('select oi.codigo_funcionario from orcamento_item oi where oi.codigo_orcamento in (' + Trim(idOrcamentos) + ') group by oi.codigo_funcionario');

  if (Trim(idOS) <> '') and (Trim(idVendas + idOrcamentos) <> '') then
    _IBQuery999.SQL.Add('union select os.codigo_funcionario from os where os.codigo in (' + Trim(idOS) + ') group by os.codigo_funcionario')
  else
  if (Trim(idOS) <> '') and (Trim(idVendas + idOrcamentos) = '') then
    _IBQuery999.SQL.Add('select os.codigo_funcionario from os where os.codigo in (' + Trim(idOS) + ') group by os.codigo_funcionario');

  _IBQuery999.SQL.Add('order by 1');
  _IBQuery999.Open;

  while not _IBQuery999.Eof do
  begin
    if (_IBQuery999.FieldByName('codigo_funcionario').AsInteger <> vCodigoAnterior) then
    begin
      if (Trim(vInfo) = '') then
        vInfo := _IBQuery999.FieldByName('codigo_funcionario').AsString
      else
        vInfo := Trim(vInfo) + ', ' + _IBQuery999.FieldByName('codigo_funcionario').AsString;
    end;

    vCodigoAnterior := _IBQuery999.FieldByName('codigo_funcionario').AsInteger;
    _IBQuery999.Next;
  end;

  _Destroy_IBQuery(999);

  if (Trim(vInfo) <> '') then
    Result := 'Cód.Vendedor(es): ' + Trim(vInfo)
  else
    Result := '';
end;

function GenNumeroLoteRPS(vDefinirNumero: Integer = -1; Incrementar: Integer = 0): Integer;
begin
  Result := 0;
  _Cria_IBQuery(nil,999);
  _IBQuery999.Close;
  _IBQuery999.SQL.Text := 'select g.rdb$generator_name from rdb$generators g where g.rdb$generator_name = ' + QuotedStr('GEN_NFSE_NUMERO_LOTE_RPS_' + FormatFloat('000', _CodFilial));
  _IBQuery999.Open;

  if (vDefinirNumero < 0) then
  begin
    if (_IBQuery999.IsEmpty) then
      Result := -1000 //-1000: Generator não existe;
    else
    begin
      _IBQuery999.SQL.Text := 'select gen_id(' + _IBQuery999.FieldByName('rdb$generator_name').AsString + ',' + IntToStr(Incrementar) + ') from rdb$database';
      _IBQuery999.Close;
      _IBQuery999.Open;

      Result := _IBQuery999.FieldByName('gen_id').AsInteger;
    end;
  end
  else
  begin
    if (_IBQuery999.IsEmpty) then
    begin
      _IBQuery999.Close;
      _IBQuery999.SQL.Text := 'CREATE GENERATOR GEN_NFSE_NUMERO_LOTE_RPS_' + FormatFloat('000', _CodFilial);

      try
        _IBQuery999.ExecSQL;
        _IBQuery999.Transaction.Commit;
      except
      end;
    end;

    _IBQuery999.Close;
    _IBQuery999.SQL.Text := 'SET GENERATOR GEN_NFSE_NUMERO_LOTE_RPS_' + FormatFloat('000', _CodFilial) + ' TO ' + IntToStr(Abs(vDefinirNumero));

    try
      _IBQuery999.ExecSQL;
      _IBQuery999.Transaction.Commit;
    except
    end;
  end;

  _IBQuery999.Close;
  _Destroy_IBQuery(999);
end;

