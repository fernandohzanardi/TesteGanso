procedure FecharHyperlinks(const pForm: String);
var
  Form: TForm;
  I, J: Integer;
begin
  Form := Application.FindComponent('FrmPrincipalGanso').FindComponent(pForm) as TForm;
  if not Assigned(Form) then
  begin
    Exit;
  end;

  for I := 0 to Form.ComponentCount -1 do
  begin
    if not (Form.Components[I] is TfrxReport) then
    begin
      Continue;
    end;

    for J := TfrxPreview(TfrxReport(Form.Components[I]).Preview).TabItems.Count - 1 downto 1 do
    begin
      TfrxPreview(TfrxReport(Form.Components[I]).Preview).RemoveTab(J);
    end;
  end;
end;

