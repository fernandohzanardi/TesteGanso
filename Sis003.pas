Function BuscaPlCtr : Integer;
  function ValidaPadraoMD5(_MD5Valida : String) : Boolean;
  var
    _xc : Integer;
    _RCValid : String;
  begin
    Result := True;
    if StrLen(pChar(Trim(_MD5Valida))) < 32 then
    begin
      Result := False;
      Application.MessageBox('Chave incompleta, verifique','ATENÇÃO',MB_OK + MB_ICONINFORMATION)
    end
    else if StrLen(pChar(Trim(_MD5Valida))) > 32 then
    begin
      Result := False;
      Application.MessageBox('Excesso de caracteres para a Chave, verifique','ATENÇÃO',MB_OK + MB_ICONINFORMATION)
    end
    else begin
      _RCValid := _MD5Valida;
      _RCValid := StringReplace(StringReplace(StringReplace(StringReplace(StringReplace(StringReplace(StringReplace(StringReplace(StringReplace(StringReplace(_RCValid,
                  '0','',[rfReplaceAll]),
                  '1','',[rfReplaceAll]),
                  '2','',[rfReplaceAll]),
                  '3','',[rfReplaceAll]),
                  '4','',[rfReplaceAll]),
                  '5','',[rfReplaceAll]),
                  '6','',[rfReplaceAll]),
                  '7','',[rfReplaceAll]),
                  '8','',[rfReplaceAll]),
                  '9','',[rfReplaceAll]);

      _RCValid := StringReplace(StringReplace(StringReplace(StringReplace(StringReplace(StringReplace(_RCValid,
                  'A','',[rfReplaceAll]),
                  'B','',[rfReplaceAll]),
                  'C','',[rfReplaceAll]),
                  'D','',[rfReplaceAll]),
                  'E','',[rfReplaceAll]),
                  'F','',[rfReplaceAll]);

      if Trim(_RCValid) <> '' then
      begin
        Result := False;
        Application.MessageBox('Padrão de Chave inválido, verifique','ATENÇÃO',MB_OK + MB_ICONINFORMATION)
      end;
    end;
  end;

  function VPLCTRCL : Integer;
  var
    _ArqLicPl : TStringList;
    _StrArqPlCtr, _StrDecrPlCtr, _AssArqVPL, _StrArqSemAss, _ConfAssArq : String;
  begin
    try
      Result := 0; // ( 0 - Não precisa validar; 1 - Precisa validar chave do Plano; 2 - Arquivo corrompido/violado
      _ArqLicPl := TStringList.Create; _ArqLicPl.Clear;
      _ArqLicPl.LoadFromFile(ExtractFilePath(Application.ExeName) + 'GSCPlCtr.gs');
      _StrArqPlCtr := StringReplace(StringReplace(_ArqLicPl.GetText,#10,'',[rfReplaceAll]),#13,'',[rfReplaceAll]);
      _StrDecrPlCtr := Decrypt(Decrypt(Decrypt(_StrArqPlCtr,59365),19568),32659);
      _AssArqVPL := RightStr(_StrDecrPlCtr,36);
      _StrArqSemAss := StringReplace(_StrDecrPlCtr,_AssArqVPL,'',[rfReplaceAll]);
      _ConfAssArq := '{[(/'+UpperCase(MD5Print(MD5String(_StrArqSemAss + Decrypt(Decrypt('482j54WPnlzNPrtrMpHb4wFVsC',25263),24152)  ))); {'GSACPC18042016'}
      if _ConfAssArq<>_AssArqVPL then
      begin
        // Msg's:
        //       Arquivo auxiliar "GSCPlCtr.gs" corrompido/violado, faça a reposição desse arquivo!
        //       -> Esse arquivo encontra-se disponível na pasta oficial de atualização da versão no FTP.
        Application.MessageBox(pChar(String(Decrypt('xDZU6QZXTRb2jnxFNIBEPBjTXonPX6K1kzCsHZ6qM9U0cIVzk0dpI2jb4n0CNj3+SouQNyVUvnXVt2t5AFRtMrwQ3w5TjDFMypyptSNHSq4Z0B',45256)
                            +#13+#13+Decrypt('LKE/O5SFiBPPXzoWvd4foEPt+xmKjusY+w6iQ2kPofmzhe2QCAonMKSQJWECR/b+i75seHOw88pe1tSVDMQ9M+SaWiQUZ67LleeKr/SzluuliE/Duw+1pB',42587)
                                     )),'ATENÇÃO',MB_OK + MB_ICONINFORMATION);
        Result := 2;
