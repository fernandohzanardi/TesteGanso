Procedure PegaDataHoraServer(_PDHIBCnx : TIBDatabase = nil);
var
  _IBQDHSrv: TIBQuery;  _IBTDHSrv: TIBTransaction;
begin
  _IBQDHSrv := TIBQuery.Create(nil);
  _IBTDHSrv := TIBTransaction.Create(nil);
  _IBTDHSrv.Params.Add('read_committed');
  _IBTDHSrv.Params.Add('rec_version');
  _IBTDHSrv.Params.Add('nowait');
  _IBQDHSrv.Transaction := _IBTDHSrv;

  try
    if _PDHIBCnx = nil then
      _IBTDHSrv.DefaultDatabase := DM.IBbanco
    else
      _IBTDHSrv.DefaultDatabase := _PDHIBCnx;

    _IBQDHSrv.Close;
    _IBQDHSrv.SQL.Text := 'select current_date, current_time, current_timestamp from rdb$database';
    _IBQDHSrv.Open;
    try
      _DataServidor := _IBQDHSrv.FieldValues['current_date'];
      _HoraServidor := _IBQDHSrv.FieldValues['current_time'];
      _DataHoraServidor := _IBQDHSrv.FieldValues['current_timestamp'];
    except
      _DataServidor := Date;
      _HoraServidor := Time;
      _DataHoraServidor := Now;
    end;
    _IBQDHSrv.Close;
  finally
    _IBQDHSrv.Close;
    if _IBTDHSrv.InTransaction then
      _IBTDHSrv.Rollback;
    _IBQDHSrv.Free;
    _IBTDHSrv.Free;
  end;
end;

Function PegarNomeArquivo(_Path_Arquivo : String) : String;
var
  x : integer;
  _Str : String;
begin
  Result := '';
  for x := StrLen(PChar(Trim(_Path_Arquivo))) downto 0 do
  begin
    if Copy(_Path_Arquivo,x,1) = '\' then
      break
    else
      _Str := _Str + Copy(_Path_Arquivo,x,1);
  end;

  for x := StrLen(PChar(Trim(_str))) downto 1 do
  begin
    Result := Result + Copy(_Str,x,1);
  end;
  
end;

