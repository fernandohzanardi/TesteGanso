procedure CalcularValorBaseRetencoesItems(pDestacIR, pDestacCSLL, pDestacPIS, pDestacCofins, pDAV: string;
  pAliqIR, pAliqCSLL, pAliqPIS, pAliqCofins, pVlrTotalItem: Currency; pCodItem, pCodProd: Integer; var pTotalBase: Currency; var pTotalIR,
  pTotalCSLL, pTotalPIS, pTotalCofins: Extended; pCoeficiente: Extended = 1; pPersistir: Boolean = False);
var
  lProdNReterPISCofins: Boolean;
  lBaseItem: Extended;
begin
  try
    lProdNReterPISCofins := GetQryResult('select coalesce(DFE_NAO_DESTAC_RET_IMP_PIS_COF, ''N'') from produto_parametros p where ' +
      'codigo_filial = ' + _CodFilial.ToString + ' and codigo_produto = ' + pCodProd.ToString) = 'S';
    lBaseItem := 0;

    if not lProdNReterPISCofins then
    begin
      if pDestacPIS = 'S' then
      begin
        lBaseItem := pVlrTotalItem * pCoeficiente * (pAliqPIS / 100.00);
        pTotalPIS := pTotalPIS + (pVlrTotalItem * pAliqPIS * pCoeficiente / 100.00);
      end;

      if pDestacCofins = 'S' then
      begin
        lBaseItem := lBaseItem + (pVlrTotalItem * pAliqCofins * pCoeficiente / 100.00);
        pTotalCofins := pTotalCofins + (pVlrTotalItem * pAliqCofins * pCoeficiente / 100.00);
      end;
    end;

    if pDestacIR = 'S' then
    begin
      lBaseItem := lBaseItem + (pVlrTotalItem * pAliqIR * pCoeficiente / 100.00);
      pTotalIR := pTotalIR + (pVlrTotalItem * pAliqIR * pCoeficiente / 100.00);
    end;

    if pDestacCSLL = 'S' then
    begin
      lBaseItem := lBaseItem + (pVlrTotalItem * pAliqCSLL * pCoeficiente / 100.00);
      pTotalCSLL := pTotalCSLL + (pVlrTotalItem * pAliqCSLL * pCoeficiente / 100.00);
    end;

    lBaseItem := ArredCurr(lBaseItem, 2);

    if pPersistir then
    begin
      var vControle := ExecSQLScript('update ' + pDAV + '_item set vlr_retencao_imposto = ' +
        FloatToStr(lBaseItem).Replace(',','.', [rfReplaceAll]) + ' where codigo = ' + pCodItem.ToString);

      if vControle <> EmptyStr then raise Exception.Create('Erro ao atualizar o valor de retenção do item');
    end;

    pTotalBase := pTotalBase + lBaseItem;

  except on E: Exception do
    begin
      Application.MessageBox(PChar('Ocorreu um erro ao tentar calcular a base das retenções de itens. Verifique: ' + E.Message), 'Atenção', MB_OK);
      Abort;
    end;
  end;
end;

procedure InsercaoOuRemocaoFinalizadorRetencao(pVlrTotalRetencao: Currency; pDav: string; pCodigoDAV: Integer);
var
  lCodFinRetencao: Integer;
begin
  if (pVlrTotalRetencao > 0) then
  begin
    _Cria_IBQuery(nil,999);
    _IBQuery999.Close;
    _IBQuery999.SQL.Text := 'select first 1 codigo from finalizador where codigo_empresa = '+IntToStr(_CodEmpresa)+
      ' and coalesce(retencao_imposto,''N'') = ''S'' ';
    _IBQuery999.Open;
    _IBQuery999.First;
    lCodFinRetencao := _IBQuery999.FieldByName('codigo').AsInteger;

    _IBQuery999.Close;
    _IBQuery999.SQL.Text := ' select coalesce(sum(neg.valor),0) as "TT_FINRETENCAO" '
                           +' from '+pDav+'_negociacao neg '
                           +' join finalizador f on (f.codigo = neg.codigo_finalizador) '
                           +' where neg.codigo_'+pDav+' = '+pCodigoDAV.ToString
                           +'   and coalesce(f.retencao_imposto,''N'') = ''S'' ';
    _IBQuery999.Open;
    _IBQuery999.First;
    if (_IBQuery999.FieldByName('TT_FINRETENCAO').AsCurrency <> pVlrTotalRetencao) then
    begin
      _IBQuery999.Close;
      _IBQuery999.SQL.Text := ' delete from '+pDav+'_negociacao neg '
                             +' where neg.codigo_'+pDav+' = '+pCodigoDAV.ToString
                             +'   and neg.codigo_finalizador in (select f.codigo '
                             +'                                  from finalizador f '
                             +'                                  where coalesce(f.retencao_imposto,''N'') = ''S'') ';
      try
        _IBQuery999.ExecSQL;
        if (lCodFinRetencao > 0) then
        begin
          _IBQuery999.Close;
          _IBQuery999.SQL.Text := ' insert into '+pDav+'_negociacao '
                                 +' (codigo_'+pDav+', numero_parcela, valor, acrescimo_valor, desconto_valor, acrescimo, desconto, valor_original, codigo_finalizador, tipo_finalizacao) '
                                 +' values ('+pCodigoDAV.ToString
                                 +'         ,1,'+StringReplace(CurrToStr(pVlrTotalRetencao),',','.',[rfReplaceAll])
                                 +'         ,0'
                                 +'         ,0'
                                 +'         ,0'
                                 +'         ,0'
                                 +'         ,'+StringReplace(CurrToStr(pVlrTotalRetencao),',','.',[rfReplaceAll])
                                 +'         ,'+IntToStr(lCodFinRetencao)
                                 +'         ,''NO'') ';
          _IBQuery999.ExecSQL;
        end;
        if (_IBQuery999.Transaction.InTransaction) then
          _IBQuery999.Transaction.Commit;
      except
      end;
    end;
    _IBQuery999.Close;
    _Destroy_IBQuery(999);
  end
  else if (pVlrTotalRetencao <= 0) then
  begin
    _Cria_IBQuery(nil,999);
    _IBQuery999.Close;
    _IBQuery999.SQL.Text := ' delete from '+pDav+'_negociacao neg '
                           +' where neg.codigo_'+pDav+' = '+pCodigoDAV.ToString
                           +'   and neg.codigo_finalizador in (select f.codigo '
                           +'                                  from finalizador f '
                           +'                                  where coalesce(f.retencao_imposto,''N'') = ''S'') ';
    try
      _IBQuery999.ExecSQL;
      if (_IBQuery999.Transaction.InTransaction) then
        _IBQuery999.Transaction.Commit;
    except
    end;
    _IBQuery999.Close;
    _Destroy_IBQuery(999);
  end;
end;

