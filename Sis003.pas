        Tipo := ' and CODIGO_EMPRESA = ' + IntToStr(_CodEmpresa)
      else if _Empresa_Filial = 2 then
        Tipo := ' and CODIGO_FILIAL = ' + IntToStr(_CodFilial);

      SQL.Clear;
      if _campo4 = '' then
        SQL.Add('select '+_campo1+' from '+_tabela+' where '+_campo2+' = '+IfThen(_TipoTexto,QuotedStr(_campo3.Text),_campo3.Text) + AddWhere + Tipo)
      else
      begin
        if _campo6 = '' then
          SQL.Add('select '+_campo1+' from '+_tabela+' where '+_campo2+' = ' +IfThen(_TipoTexto,QuotedStr(_campo3.Text),_campo3.Text)+' and '+_campo4+' = '+IfThen(_TipoTexto,QuotedStr(_campo5.Text),_campo5.Text)+ AddWhere + Tipo)
        else
          SQL.Add('select '+_campo1+' from '+_tabela+' where '+_campo2+' = ' +IfThen(_TipoTexto,QuotedStr(_campo3.Text),_campo3.Text)+' and '+_campo4+' = '+IfThen(_TipoTexto,QuotedStr(_campo5.Text),_campo5.Text)+' and '+_campo6+' = '+IfThen(_TipoTexto,QuotedStr(_campo7.Text),_campo7.Text)+ AddWhere + Tipo)
      end;
      Open;
    end;
    if (_query.FieldValues[_campo1] = Null) and (_campo5.Text <> '') and (NotisNull) then
    begin
      Result := '';
      Application.MessageBox(PChar('Não foi encontrado '+Trim(AuxMensagem)+' com o Código Informado.'),'ATENÇÃO !',MB_OK+MB_ICONINFORMATION); {29/01/2018 - Edson Gregorio}
      _campo3.Clear;
      if _campo3.CanFocus then
        _campo3.SetFocus;
    end
    else
       result := _query.Fieldbyname(_campo1).AsString;
    _query.Free;
  end;
end;

