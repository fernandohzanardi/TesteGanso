      end;

      TMessageForm(Result).pnBar := TPanel.Create(Result);

      with TMessageForm(Result).pnBar do
      begin
        Parent := Result;
        BevelInner := bvNone;
        BevelOuter := bvNone;
        Caption := '';
        Align := alBottom;
        Height := 19;
      end;

      TMessageForm(Result).spTopLine := TShape.Create(TMessageForm(Result).pnBar);

