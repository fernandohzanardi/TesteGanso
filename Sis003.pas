function CarregaFr3Padrao(Formulario_Origem : String; Componente_Name : String): TBlobData;
begin
  _Cria_IBQuery(nil,999);
  _IBQuery999.Close;
  _IBQuery999.SQL.Clear;
  _IBQuery999.SQL.Add('SELECT FIRST 1 "FILE" FROM REPORT WHERE "TYPE" = ' + QuotedStr('P')
                + ' AND ID_REPORT_FORM = (SELECT ID FROM REPORT_FORM WHERE FORM = ' + QuotedStr(Formulario_Origem) + ')'
                + ' AND COMPONENT_NAME = ' + QuotedStr(UpperCase(Componente_Name)));
  _IBQuery999.Open;

  if _IBQuery999.IsEmpty then
    Result := TEncoding.ANSI.GetBytes(NullAsStringValue)
  else
    Result := TEncoding.ANSI.GetBytes(_IBQuery999.Fields[0].AsString); { TODO -oHeliton -cMigração Xe : definindo TEncoding.ANSI para compatibilizar tipo de retorno }
  _Destroy_IBQuery(999);
end;


procedure CarregaFr3Banco(FrxReport : TfrxReport; Arquivo : TBlobField; Titulo : String);
Var
  stMem: TMemoryStream;
begin
  If (Arquivo.IsNull) or (Trim(Arquivo.AsString) = NullAsStringValue) Then
    Exit;
  stMem := TMemoryStream.Create;
  Try
    Arquivo.SaveToStream( stMem );
    stMem.Position := 0;
    FrxReport.LoadFromStream( stMem );
    FrxReport.FileName := Titulo;
  Finally
    stMem.Free;
  End;
end;


procedure CarregaFr3Banco(FrxReport : TfrxReport; Arquivo, Titulo : String);
Var
  stMem: TStringStream;
begin
  If Trim(Arquivo) = EmptyStr Then
    Exit;
  Try
    stMem := TStringStream.Create(Arquivo);
    FrxReport.LoadFromStream( stMem );
    FrxReport.FileName := Titulo;
  Finally
    stMem.Free;
  End;
end;

procedure GravaFr3Banco(FrxReport : TfrxReport; IBDataSet : TIBQuery; Arquivo : TBlobField);
var Stream : TMemoryStream;
begin
  IBDataSet.Edit;
  Stream := TMemoryStream.Create;
  try
    FrxReport.SaveToStream(Stream);

    Stream.Seek(0,soFromBeginning);
    TBlobField(Arquivo).LoadFromStream(Stream);

    TBlobField(Arquivo).AsString := CorrigeParent(TBlobField(Arquivo).AsString);
  finally
    Stream.Free;
  end;
  IBDataSet.Post;
  IBDataSet.Transaction.CommitRetaining;
end;

function CorrigeParent(ConteudoFR3 : String): String;
var Inicio, Final : Integer;
    OldParent, NewParent : String;
begin
  if (PosEx('ParentReport="', ConteudoFR3) > 0) and (PosEx('" EngineOptions', ConteudoFR3) > 0) then
  begin
    Inicio := PosEx('ParentReport="', ConteudoFR3);
    Final  := PosEx('" EngineOptions', ConteudoFR3);
    OldParent := copy(ConteudoFR3, Inicio + length('ParentReport="'), Final - (Inicio + length('ParentReport="')));
    NewParent := ExtractFileName(OldParent);
    Result := copy(ConteudoFR3, 1, Inicio - 1) + 'ParentReport="' + NewParent + copy(ConteudoFR3, Final, length(ConteudoFR3));
  end
  else
    Result := ConteudoFR3;
end;


procedure ExportaFr3BancoMestre;
var Nome_Fr3 : String;
    Arquivo : TStringStream; { TODO -oHeliton -cMigração Xe : Substituido TBlobFile por TStringStream }
    stArq, stBlob: TMemoryStream;
    Lidos : Integer;
    B1, B2: array[0..4095] of Byte;
    Iguais : Boolean;
begin
  _Cria_IBQuery(nil,999);
  _IBQuery999.SQL.Clear;
  _IBQuery999.SQL.Add('SELECT MODEL, "FILE" FROM REPORT WHERE "TYPE" = ' + QuotedStr('M'));
  _IBQuery999.Open;
  _IBQuery999.First;

  stBlob := TMemoryStream.Create;
  stArq := TMemoryStream.Create;

  while not _IBQuery999.Eof do
  begin
    Iguais := False;
    stBlob.Clear;
    stArq.Clear;
    Nome_Fr3 := _IBQuery999.Fields[0].AsString;
    Arquivo := TStringStream.Create(_IBQuery999.Fields[1].AsString);
    Arquivo.SaveToStream(stBlob);
    stBlob.Position := 0;
    try
      FileSetAttr(ExtractFilePath(Application.ExeName) + Nome_Fr3 + '.fr3', 0);

      if FileExists(ExtractFilePath(Application.ExeName) + Nome_Fr3 + '.fr3') then
       begin
        stArq.LoadFromFile(ExtractFilePath(Application.ExeName) + Nome_Fr3 + '.fr3');
        stArq.Position := 0;

        if stArq.Size = stBlob.Size then
        begin
          repeat
            Lidos := stArq.Read(B1, SizeOf(B1));
            stBlob.ReadBuffer(B2, Lidos);
            until not CompareMem(@B1, @B2, Lidos) or (Lidos = 0);
            Iguais := Lidos = 0;
        end
        else
          Iguais := False;

        if not Iguais then
          DeleteFile(ExtractFilePath(Application.ExeName) + Nome_Fr3 + '.fr3')
        else
          FileSetAttr(ExtractFilePath(Application.ExeName) + Nome_Fr3 + '.fr3', 7)
      end;

      if not Iguais then
      begin
        Arquivo.SaveToFile(ExtractFilePath(Application.ExeName) + Nome_Fr3 + '.fr3'); { TODO -oHeliton -cMigração Xe : TStringStream exporta direto com SaveToFile }
        FileSetAttr(ExtractFilePath(Application.ExeName) + Nome_Fr3 + '.fr3', 7)
      end;
    finally
    end;
    _IBQuery999.Next;
  end;
  _Destroy_IBQuery(999);
  stArq.Free;
  stBlob.Free;
end;

Function EncriptECF(TEncSenha: String):String;
var
  x  : integer;
  v  : Char;
  m  : Char;
  E  : Char;
  EncSenha : String;
  Mascara : String;
  Soma : String;
  J : String;
begin
  EncSenha := '';
  for x := 1 to StrLen(PChar(TEncSenha)) do
  begin
    v := Char(TEncSenha[x]);
    EncSenha := EncSenha + Chr(Ord(v)+27+x);
  end;
  Soma := '';
  for x := 1 to StrLen(PChar(EncSenha)) do
  begin
    m := Char(EncSenha[x]);
    Soma := Soma + Chr(Ord(m)-6-x);
  end;
  Mascara := '';
  for x := 1 to StrLen(PChar(EncSenha+Soma)) do
  begin
    E := Char(EncSenha[x]);
    J := Char(Soma[x]);
    Mascara := Mascara + E + J
  end;
  Result := Mascara;
end;

Function DecriptECF(TDecSenha: String):String;
var
  E  : Char;
  Mascara : String;
  x  : integer;
  v  : Char;
  DecSenha : String;
begin
  Mascara := '';
  for x := 1 to StrLen(PChar(TDecSenha)) do begin
    if (x mod 2 )<>0 then
    begin
      E := Char(TDecSenha[x]);
      Mascara := Mascara + E ;
    end;
  end;
  DecSenha := '';
  for x := 1 to StrLen(PChar(Mascara)) do begin
    v := Char(Mascara[x]);
    DecSenha := DecSenha + Chr(Ord(v)-27-x);
  end;
  Result := DecSenha;
end;

