Function TEFImprCabecalho(var _ArqImpPrint : TextFile; _QtdCharLn : Integer; _TextCompl : String = ''; _ImpCabNFC : Boolean = True; _TextNNF : String = ''; _ImpSubCab : Boolean = True) : Boolean;
var
  _FontSize : Integer;
  _Cent : String;
begin
  _Cria_IBQuery(nil,999);
  try
    try
      // Luiz Santana - 25/02/2019 - CD - 3051 - Criar forma de não aparecer Dados da Empresa na Promissória (_ImpCabNFC -> criado parâmetro no PDV.ini)
      _FontSize := Printer.Canvas.Font.Size;
      if _ImpCabNFC then
      begin
        _IBQuery999.Close;
        _IBQuery999.SQL.Text := 'select ef.fantasia, ef.razao_social, ef.endereco, ef.numero, ef.bairro, ef.cep, cv.nome||'' / ''||ef.uf as "CIDADE_UF", '
                               +'       ef.cnpj, ef.insc_estadual, ef.insc_municipal '
                               +'from empresa_filial ef '
                               +'left join cidade_vila cv on cv.codigo = ef.codigo_cidade '
                               +'where ef.codigo = '+IntToStr(_CodFilial);
        _IBQuery999.Open;

        //Printer.Canvas.Font.Name := 'Arial';
        Printer.Canvas.Font.Style := [fsBold];
        WriteLN(_ArqImpPrint, '');
        try
          //Gustavo Espíndola - centralizando - 20/01/2016
          _Cent := '';
          _Cent := DupeString(' ',Trunc((_QtdCharLn - Length(Trim(Copy(_IBQuery999.FieldByName('fantasia').AsString,1,_QtdCharLn))))/2))+
                   Copy(_IBQuery999.FieldByName('fantasia').AsString,1,_QtdCharLn);
        except
          _Cent := _IBQuery999.FieldByName('fantasia').AsString;
        end;

        WriteLN(_ArqImpPrint,_Cent);

        try
          _Cent := '';
          _Cent := DupeString(' ',Trunc((_QtdCharLn - Length(Trim(Copy(_IBQuery999.FieldByName('razao_social').AsString,1,_QtdCharLn))))/2))+
                   Copy(_IBQuery999.FieldByName('razao_social').AsString,1,_QtdCharLn);
        except
          _Cent := _IBQuery999.FieldByName('razao_social').AsString;
        end;

        WriteLN(_ArqImpPrint,_Cent);

        Printer.Canvas.Font.Style := [fsBold];
        Printer.Canvas.Font.Size := 7;
        WriteLN(_ArqImpPrint, '');
        WriteLN(_ArqImpPrint, '  End.: '+_IBQuery999.FieldByName('endereco').AsString+', '+_IBQuery999.FieldByName('numero').AsString);
        WriteLN(_ArqImpPrint, '  Bairro: '+_IBQuery999.FieldByName('bairro').AsString);
        WriteLN(_ArqImpPrint, '  CEP: '+FormatoCEP(_IBQuery999.FieldByName('cep').AsString)+' - ' +_IBQuery999.FieldByName('cidade_uf').AsString);
        WriteLN(_ArqImpPrint, '  CNPJ: '+FormatoCPF_CNPJ(_IBQuery999.FieldByName('cnpj').AsString));
        {10/05/2016 - Vicente Neto - CD 1998 - IE quando é muito grande está quebrando linha}
        WriteLN(_ArqImpPrint, '  IE: '+_IBQuery999.FieldByName('insc_estadual').AsString);
        if Trim(_IBQuery999.FieldByName('insc_municipal').AsString) <> '' then
          WriteLN(_ArqImpPrint,'  IM: '+_IBQuery999.FieldByName('insc_municipal').AsString);
      end;

      // Luiz Santana - 09/01/2021 - CD - 4119 - Parâmetro para imprimir apenas 1 via do TEF (economia de espaço com remoção de cabeçaho via parametro e sub-cabeçalho
      if _ImpSubCab then
      begin
        Printer.Canvas.Font.Name := 'Courier New';
        Printer.Canvas.Font.Size := _FontSize;
        WriteLN(_ArqImpPrint, DupeString('-',_QtdCharLn));

        if Trim(_TextCompl) <> '' then
        begin
          Printer.Canvas.Font.Name := 'Courier New';
          Printer.Canvas.Font.Size := 7; // Luiz Santana - 03/12/2019 - Redução da fonte de 8 para 7, problemas em impressoras Epson
          Printer.Canvas.Font.Style := [fsBold];

          WriteLN(_ArqImpPrint, _TextCompl);

          Printer.Canvas.Font.Name := 'Courier New';
          Printer.Canvas.Font.Size := _FontSize;
          Printer.Canvas.Font.Style := [fsBold];
          WriteLN(_ArqImpPrint, DupeString('-',_QtdCharLn));
        end;
        // Luiz Santana - 11/05/2020 - CD - 3492 - Inserir o número da NFC-e no Lay-out das promissórias impressas no
        if Trim(_TextNNF) <> '' then
          WriteLN(_ArqImpPrint, _TextNNF);
        //

        { 09/05/2016 - Vicente Neto - CD 1998 - Informar a data corrente no impresso da promissória tanto NFC-e quanto SAT-CF-e }
        // Luiz Santana - 09/01/2021 - CD - 4119 - Parâmetro para imprimir apenas 1 via do TEF (economia de espaço com remoção de cabeçaho via parametro e sub-cabeçalho
        if _ImpSubCab then
        begin
          WriteLN(_ArqImpPrint, '');
          WriteLN(_ArqImpPrint, 'Operador: ' + _usuario); // Luiz Santana - 15/05/2020 - CD - 3820 - Acrescentar campos na impressão de promissórias no PDV
          WriteLN(_ArqImpPrint, '');
          WriteLN(_ArqImpPrint, 'Data/Hora: ' + DateTimeToStr(Now)); // Luiz Santana - 15/05/2020 - CD - 3820 - Acrescentar campos na impressão de promissórias no PDV
          WriteLN(_ArqImpPrint, '');
        end;
      end;
    except
      on _Err : exception do
      begin
        //ShowMessage(_Err.Message);
      end;
    end;
  finally
    _Destroy_IBQuery(999);
  end;
end;

function TEFDAnulaTransaBD(_TEFAnulaValor : Currency; _TEFAnulaSeqCrt : Integer; pTabela: string) : Boolean;
var
  _IBQAnulaTEFBD : TIBQuery;
  _IBTAnulaTEFBD : TIBTransaction;
begin
  Result := True;
  _IBQAnulaTEFBD := TIBQuery.Create(nil);
  _IBTAnulaTEFBD := TIBTransaction.Create(nil);
  _IBTAnulaTEFBD.Params.Clear;
  _IBTAnulaTEFBD.DefaultDatabase := DM.IBbanco;
  _IBTAnulaTEFBD.DefaultAction := TARollback;

  _IBQAnulaTEFBD.Transaction := _IBTAnulaTEFBD;
  _IBTAnulaTEFBD.Params.Add('read_committed');
  _IBTAnulaTEFBD.Params.Add('rec_version');
  _IBTAnulaTEFBD.Params.Add('nowait');
  try
    _IBQAnulaTEFBD.Close;
    _IBQAnulaTEFBD.SQL.Text := Format(' update %s._negociacao set tef_valor = 0 ', [pTabela])
                              +' where tef_seqcartao = '+IntToStr(_TEFAnulaSeqCrt)
                              +'   and tef_valor = '+StringReplace(CurrToStr(_TEFAnulaValor),',','.',[rfReplaceAll]);
    _IBQAnulaTEFBD.ExecSQL;
  except
  end;

  if (_IBTAnulaTEFBD.InTransaction) then
  begin
    try
      _IBTAnulaTEFBD.Commit;
    except
    end;
  end;

  try
    _IBQAnulaTEFBD.Close;
    _IBQAnulaTEFBD.Free;
    _IBTAnulaTEFBD.Free;
  except
  end;
end;

function TEFVerificarSeTemFinalizadoresTefExecutados(pCodDAV, pDAV: string): Boolean;
begin
  Result := False;
  try
    _Cria_IBQuery(nil, 999, nil);
    _IBQuery999.Close;
    _IBQuery999.SQL.Clear;

    _IBQuery999.SQL.Add(' select neg.tef_indice_instituicao, neg.valor, neg.tef_data, neg.tef_hora ');
    _IBQuery999.SQL.Add(' from ' + pDAV +'_negociacao neg ');
    _IBQuery999.SQL.Add(' left join finalizador f on (f.codigo = neg.codigo_finalizador) ');
    _IBQuery999.SQL.Add(' where neg.codigo_' + pDAV + ' = ' + pCodDAV + ' and neg.tipo_finalizacao = ''NO'' ');
    _IBQuery999.SQL.Add('   and coalesce(f.tef,''N'') = ''S'' and neg.tef_retaguarda = ''S'' ');
    _IBQuery999.Open;

    if not _IBQuery999.IsEmpty then
      Result := True;

  finally
    _Destroy_IBQuery(999);
  end;

end;

procedure ExcluirArquivosTEF(pCodigo, pAbreviacao, pTabela: string);
var
  lQuery: TIBQuery;
begin
  lQuery := TIBQuery.Criar(DM.IBBanco);
  try
    try
      lQuery.SQL.Clear;
      lQuery.SQL.Add(Format(' select %s.codigo, f.indice_finalizador_if, f.descricao, %s.valor, ', [pAbreviacao, pAbreviacao]));
      lQuery.SQL.Add(Format('        %s.tef_seqcartao, %s.tef_valor_saque, %s.tef_iTEF, %s.tef_temimpr, ', [pAbreviacao, pAbreviacao, pAbreviacao, pAbreviacao]));
      lQuery.SQL.Add(Format('        %s.tef_valor, %s.tef_rede, %s.tef_indice_adm, %s.tef_nsu, ', [pAbreviacao, pAbreviacao, pAbreviacao, pAbreviacao]));
      lQuery.SQL.Add(Format('        %s.tef_produto, f.tef ', [pAbreviacao]));
      lQuery.SQL.Add(Format(' from %s_negociacao %s ', [pTabela, pAbreviacao]));
      lQuery.SQL.Add(Format(' left join finalizador f on (f.codigo = %s.codigo_finalizador) ', [pAbreviacao]));
      lQuery.SQL.Add(Format(' where %s.codigo_%s = ', [pAbreviacao, pTabela]) + pCodigo);
      lQuery.SQL.Add(Format(' and (%s.tipo_finalizacao = ''NO'') ', [pAbreviacao]));
      lQuery.SQL.Add(' and (f.tef = ''S'') ');
      lQuery.SQL.Add(Format(' order by %s.tef_seqcartao ', [pAbreviacao]));
      lQuery.Open;
      while not(lQuery.Eof) do
      begin
        try
          DeleteFile(ExtractFilePath(Application.ExeName)+'TEFC'+_TEFDCupomFiscal+'_'+FormatFloat('00',lQuery.FieldByName('tef_seqcartao').AsInteger)+'V1.TXT' );
          DeleteFile(ExtractFilePath(Application.ExeName)+'TEFC'+_TEFDCupomFiscal+'_'+FormatFloat('00',lQuery.FieldByName('tef_seqcartao').AsInteger)+'V2.TXT' );
        except

        end;
        lQuery.Next;
      end;
    except
      on E: Exception do
      begin
        lQuery.Transaction.Rollback;
      end;
    end;
  finally
    lQuery.Destruir;
  end;
end;

function VerificarFinalizadorTefFinalizado(pCodFin, pCodNeg, pAbreviacao, pTabela: string): boolean;
var
  lQuery: TIBQuery;
begin
  lQuery := TIBQuery.Criar(DM.IBBanco);
  try
    try
      lQuery.SQL.Add(Format('SELECT coalesce(%s.tef_retaguarda, ''N'') "TEF"', [pAbreviacao]));
      lQuery.SQL.Add(Format('FROM %s_negociacao %s', [pTabela, pAbreviacao]));

      if pCodFin = 'iTEF' then
      begin
        lQuery.SQL.Add(Format(' left join finalizador f on (f.codigo = %s.codigo_finalizador) ', [pAbreviacao]));
      end;

      lQuery.SQL.Add(Format('WHERE %s.codigo_%s = :pCodNeg', [pAbreviacao, pTabela]));

      if not (pCodFin = 'iTEF') then
      begin
        lQuery.SQL.Add(Format(' AND %s.codigo_finalizador = :pCodFin ', [pAbreviacao]));
        lQuery.ParamByName('pCodFin').AsString := pCodFin;
      end
      else if pCodFin = 'iTEF' then
      begin
        lQuery.SQL.Add(Format(' and %s.tipo_finalizacao = ''NO'' ', [pAbreviacao]));
        lQuery.SQL.Add(Format(' and coalesce(f.tef,''N'') = ''S'' and %s.tef_itef = 1', [pAbreviacao]));
      end;

      lQuery.ParamByName('pCodNeg').AsString := pCodNeg;
      lQuery.Open;

      Result := ( not (lQuery.IsEmpty) and (lQuery.FieldByName('TEF').AsString = 'S')  );
    except
      lQuery.Transaction.Rollback;
    end;
  finally
    lQuery.Destruir;
  end;
end;

procedure DesbloquearDAVTefEmProcessamento(pCodNegociacao, pDAV: string);
var
  lQuery: TIBQuery;
begin
  lQuery := TIBQuery.Criar(DM.IBBanco);
  try
    try
      lQuery.SQL.Add(Format('update %s set tef_em_processamento = ''#'', ndef = upper(f_encryptmd5(cast(:pCodNegociacao as varchar(100)) || ''MSGanso'' ||' +
      ' ''CliSiTef''))', [pDAV]));
      lQuery.SQL.Add(' where codigo = :pCodNegociacao ');
      lQuery.ParamByName('pCodNegociacao').AsString := pCodNegociacao;
      lQuery.Prepare;
      lQuery.ExecSQL;
      lQuery.Transaction.Commit;
    except on E: Exception do
      begin
        lQuery.Transaction.Rollback;
        raise Exception.Create(E.Message);
      end;
    end;
  finally
    lQuery.Destruir;
  end;
end;

procedure TEFGravarNumeroPagamentoCupom(pTEFCupomFiscal, pCodFin: string; pTEFNumeroPagamentoCupom: AnsiString);
var
  lDAV: string;
  lNumeroDAV: string;
begin
    lDAV := IfThen(pTEFCupomFiscal.Contains('PED'), 'ORCAMENTO', 'OS');
    lNumeroDAV := RetornaNumeros(pTEFCupomFiscal);

    try
      _Cria_IBQuery(nil, 999, nil);
      _IBQuery999.Close;
      _IBQuery999.SQL.Clear;

      _IBQuery999.SQL.Add(' update '+ lDAV +'_negociacao set ');
      _IBQuery999.SQL.Add(' tef_num_pag_cupom = :pTEFNumeroPagamentoCupom ');
      _IBQuery999.SQL.Add(' where codigo_' + lDAV + ' = :pNumeroDAV and codigo_finalizador = :pCodFin ');
      _IBQuery999.ParamByName('pTEFNumeroPagamentoCupom').AsInteger := StrToInt(pTEFNumeroPagamentoCupom);
      _IBQuery999.ParamByName('pNumeroDAV').AsString := lNumeroDAV;
      _IBQuery999.ParamByName('pCodFin').AsString := pCodFin;

      GravarLOGErroRT('TEFRetaguarda_'+StringReplace(DateToStr(Date),'/','',[rfReplaceAll]),
        'GravarNumeroPagamentoCupom sql: '+#13+ _IBQuery999.SQL.Text
        + ' Numero Cupom: ' + pTEFNumeroPagamentoCupom
        + ' Numero DAV: ' + lNumeroDAV
        + ' Codigo Finalizador: ' + pCodFin + #13#13
        );

      try
        _IBQuery999.ExecSQL;
        _IBQuery999.Transaction.Commit;

        GravarLOGErroRT('TEFRetaguarda_'+StringReplace(DateToStr(Date),'/','',[rfReplaceAll]),
          'GravouNumeroPagamentoCupom' + #13#13
          );
      except on E: Exception do
        begin
          _IBQuery999.Transaction.Rollback;
          GravarLOGErroRT('TEFRetaguarda_'+StringReplace(DateToStr(Date),'/','',[rfReplaceAll]),
            'NãoGravouNumeroPagamentoCupom' + #13#13
            );
          Application.MessageBox('Não foi possível gravar o número atual do pagameto do cupom', 'Atenção');
        end;
      end;
    finally
      _Destroy_IBQuery(999);
    end;
end;

function TEFDVerECancIndiv(pCodNegociacao, pDAV, pCodFin: string; _OpF: string = 'C'): string;
var
  vParamAdicional: AnsiString;
  vTEF: TCliSiTef;
  vRespostaConfig: string;
  _IBQConsNegTEF : TIBQuery;
  _IBTConsNegTEF : TIBTransaction;
  lTEFDDescComp: string;
begin
  Result := '';

  if not(_TEFDTeveCom) then
  begin
    vTEF := TCliSiTef.Create(_ParEnderecoTEF, _ParNumEmpresaTEF, _caixaPadrao.ToString, _CNPJFilial, _CodUsuario.ToString);
    try
      vRespostaConfig := vTEF.Configurar(_TEFDTeveCom);
    finally
      FreeAndNil(vTef);
    end;
    if not(_TEFDTeveCom) then
    begin
      Application.MessageBox(PChar('Nao foi possível realizar comunicação com o servidor !' + sLineBreak + vRespostaConfig), 'ATENÇÂO');
      Abort;
    end;
  end;

  _IBQConsNegTEF := TIBQuery.Create(nil);
  _IBTConsNegTEF := TIBTransaction.Create(nil);
  _IBTConsNegTEF.Params.Clear;
  _IBTConsNegTEF.DefaultDatabase := DM.IBbanco;
  _IBTConsNegTEF.DefaultAction := TARollback;

  _IBQConsNegTEF.Transaction := _IBTConsNegTEF;
  _IBTConsNegTEF.Params.Add('read_committed');
  _IBTConsNegTEF.Params.Add('rec_version');
  _IBTConsNegTEF.Params.Add('nowait');
  try
    _IBQConsNegTEF.Close;
    _IBQConsNegTEF.SQL.Text := ' select neg.tef_indice_instituicao, neg.valor, neg.tef_data, neg.tef_hora, f.descricao, tef_data_fiscal,'
                              +' tef_hora_fiscal, tef_num_pag_cupom '
                              +' from ' + pDAV +'_negociacao neg '
                              +' left join finalizador f on (f.codigo = neg.codigo_finalizador) '
                              +' where neg.codigo_' + pDAV + ' = ' + pCodNegociacao + ' and codigo_finalizador = ' + pCodFin
                              +' and neg.tipo_finalizacao = ''NO'' and coalesce(f.tef,''N'') = ''S'' and neg.tef_retaguarda = ''S'' ';
    _IBQConsNegTEF.Open;

    lTEFDDescComp := _IBQConsNegTEF.FieldByName('descricao').AsString+' - '
                 + 'Valor: '+ FormatFloat(',0.00',_IBQConsNegTEF.FieldByName('valor').AsCurrency);

    if _IBQConsNegTEF.FieldByName('tef_indice_instituicao').AsString <> '' then
    begin
      _TEFDDataFiscal := _IBQConsNegTEF.FieldByName('tef_data').AsDateTime;
      _TEFDHorario := _IBQConsNegTEF.FieldByName('tef_hora_fiscal').AsDateTime;
    end
    else
    begin
      _TEFDDataFiscal := _IBQConsNegTEF.FieldByName('tef_data_fiscal').AsDateTime;
      _TEFDHorario := _IBQConsNegTEF.FieldByName('tef_hora_fiscal').AsDateTime;
    end;

    if (_OpF = 'C') then
    begin
      vParamAdicional := AnsiString( Format('{NumeroPagamentoCupom=%s}',
      [_IBQConsNegTEF.FieldByName('tef_num_pag_cupom').AsAnsiString]));

      TEFDConfirmaIndividual(0, IfThen(pDAV = 'ORCAMENTO', 'PED','OS') + AnsiString(pCodNegociacao),
        FormatDateTime('YYYYMMDD', _TEFDDataFiscal), StringReplace(TimeToStr(_TEFDHorario),':','',[rfReplaceAll]), AnsiString(vParamAdicional));
      try
        var _lSQLExec := ' update ' + pDAV + '_negociacao set tef_rede = null, tef_indice_adm = null, tef_indice_transacao = null, ';
        _lSQLExec := _lSQLExec + 'tef_nsu = null, tef_valor = null, tef_parcelas = null, tef_predatado = null, tef_data = null, ';
        _lSQLExec := _lSQLExec + 'tef_hora = null, tef_cielo_descpremia = null, ';
        _lSQLExec := _lSQLExec + 'tef_valor_saque = null, tef_codigo_autorizacao = null, tef_nsu_host = null, ';
        _lSQLExec := _lSQLExec + 'tef_indice_instituicao = null, tef_idtermpag = null, tef_bin = null, tef_ultimo_digc = null, ';
        _lSQLExec := _lSQLExec + 'tef_data_fiscal = null, tef_hora_fiscal = null, tef_retaguarda = null, tef_produto = null, ';
        _lSQLExec := _lSQLExec + 'tef_seqcartao = null, tef_temimpr = null, tef_itef = null, tef_num_pag_cupom = null, '
                               + 'valor = valor + coalesce(tef_cielo_descpremia, 0), valor_original = valor_original + '
                               + 'coalesce(tef_cielo_descpremia, 0) ';
        _lSQLExec := _lSQLExec + 'where codigo_' + pDAV + ' = ' + pCodNegociacao + ' and codigo_finalizador = ' + pCodFin +
          ' and tef_retaguarda = ''S'' ';
        _Cria_IBQuery(nil,999);
        _IBQuery999.Close;
        _IBQuery999.SQL.Text := '';
        _IBQuery999.SQL.Text := _lSQLExec;
        try
          _IBQuery999.ExecSQL;
          _IBTransaction999.Commit;
        except
          on _err : exception do
          begin
            raise Exception.Create(_err.Message);
          end;
        end;

      finally
        _IBQuery999.Close;
        _Destroy_IBQuery(999);
      end;

      Result := 'A transação TEF a seguir foi cancelada, verifique:' + #13 + lTEFDDescComp;
    end
    else
    begin
      Result := 'A transação TEF a seguir precisa ser cancelada manualmente via [Alt + T] - TEF Administrativo, verifique:' + #13 + lTEFDDescComp;
    end;

  finally
    _IBQConsNegTEF.Close;
    _IBTConsNegTEF.Rollback;
    _IBQConsNegTEF.Free;
    _IBTConsNegTEF.Free;
  end;
end;

