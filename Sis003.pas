function TemEmpPAFComECF : Boolean;
begin
  try
    Result := False;
    _Cria_IBQuery(nil,998);
    // Regra: Tendo pelo menos 1 empresa no banco onde possui ECF configurado e seja PAF-ECF, será considerado para proteção dos DAVs assinados (com Hash)

    _IBQuery998.SQL.Text := ' select ef.codigo, (select sp.result from SP_CHKRNOPAF(ef.codigo) sp) as "QTD", '
                           +'        (select first 1 cc.codigo '
                           +'         from caixa_cadastro cc '
                           +'         where cc.codigo_filial = ef.codigo '
                           +'           and (cc.tipo_doc_fiscal = ''C'') '
                           +'           and (coalesce(cc.fabricante_ecf,'''') <> '''') '
                           +'           and (coalesce(cc.fabricante_ecf,'''') <> ''NENHUM'') '
                           +'           and (coalesce(cc.modelo_ecf,'''') <> '''')) as "CXCADECF" '
                           +' from empresa_filial ef ';

    _IBQuery998.Open;
    _IBQuery998.First;

    while not(_IBQuery998.Eof) do
    begin
      // Alimentando o Result para a variável _TemEmpPAFComECF
      if not(Result) and (_IBQuery998.FieldByName('QTD').AsInteger = 0) and (_IBQuery998.FieldByName('CXCADECF').AsInteger > 0) then
        Result := True;

      // Alimentando variável _PAFTemECFConfig
      if (_IBQuery998.FieldByName('codigo').AsInteger = _CodFilial) and (_IBQuery998.FieldByName('QTD').AsInteger = 0) and (_IBQuery998.FieldByName('CXCADECF').AsInteger > 0) then
        _PAFTemECFConfig := True;

      _IBQuery998.Next;
    end;

    // Luiz Santana - 10/07/2023 - Com o advento da NFCe, a versão PAF não está sendo homologada mais, portanto, não faz sentido travar edição dos leiautes
    _PAFTemECFConfig := False;

  finally
    _Destroy_IBQuery(998);
  end;
end;

