function FiltrarChars(pStr: String; pChrPermitido: TfcSetsChars; pRemoveAcentos: Boolean = False; pRemoverEspaco: Boolean = False; pForceUpperChr: Boolean = True; pExcetoChr: TfcSetExpChr = []): String;
const
  Str_A = 'ÀÁÂÃÄÈÉÊËÌÍÎÏÒÓÔÕÖÙÚÛÜÇàáâãäèéêëìíîïòóôõöùúûüçºª&€';
  Str_B = 'AAAAAEEEEIIIIOOOOOUUUUCaaaaaeeeeiiiiooooouuuucoaEE';
var
  UprChrEx: TfcSetUprChrEx;
  LwrChrEx: TfcSetLwrChrEx;
  i: Integer;
  s: String;                       
begin
  s := '';
  pStr := Trim(pStr);

  if (pChrPermitido = fcNum) then
  begin
    for i := 1 to Length(pStr) do
      if (pStr[i] in ['0'..'9']) or ((pStr[i] in pExcetoChr)) then
        s := (s + pStr[i]);
  end
  else
  begin
    UprChrEx := ['À','Á','Â','Ã','È','É','Ê','Ì','Í','Î','Ò','Ó','Ô','Õ','Ù','Ú','Û','Ü','Ç'];
    LwrChrEx := ['à','á','â','ã','è','é','ê','ì','í','î','ò','ó','ô','õ','ù','ú','û','ü','ç'];

    if (pChrPermitido = fcEmail) then
      pRemoveAcentos := True;

    if (pRemoveAcentos) then
    begin
      for i := 1 to Length(pStr) do
        if (Pos(pStr[i],Str_A) <> 0) and (not (pStr[i] in pExcetoChr)) then
          pStr[i] := Str_B[Pos(pStr[i], Str_A)];
    end;

    if (pForceUpperChr) then
      pStr := AnsiUpperCase(pStr);

    if (pRemoverEspaco) then
      pStr := StringReplace(pStr,' ','',[rfReplaceAll]);

    if (pChrPermitido = fcEmail) then
    begin
      //O caractere "+" é permitido pela RFC2821 e RFC2822; 
      for i := 1 to Length(pStr) do
        if (pStr[i] in ['A'..'Z','a'..'z','0'..'9','.','_','-','@','+',',',';']) or (pStr[i] in pExcetoChr) then {31/03/2017 - Edson Gregorio - CD 2405}
          s := (s + pStr[i]);
    end
    else
    if (pChrPermitido = fcAlphaNum) then
    begin
      for i := 1 to Length(pStr) do
        if (pStr[i] in ['A'..'Z','a'..'z','0'..'9',' ']) or (pStr[i] in UprChrEx) or (pStr[i] in LwrChrEx) or (pStr[i] in pExcetoChr) then
          s := (s + pStr[i]);
    end
    else
    if (pChrPermitido = fcAlpha) then
    begin
      for i := 1 to Length(pStr) do
        if (pStr[i] in ['A'..'Z','a'..'z',' ']) or (pStr[i] in UprChrEx) or (pStr[i] in LwrChrEx) or (pStr[i] in pExcetoChr) then
          s := (s + pStr[i]);
    end;
  end;

  Result := s;
end;

