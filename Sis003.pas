{
  Luiz Santana - 06/06/2014 - função foi substituída devido erros

function ArredCurr(x : Extended; d : Integer) : Extended;
const
  t: array [0..12] of int64 = (1, 10, 100, 1000, 10000, 100000,
      1000000, 10000000, 100000000, 1000000000, 10000000000,
      100000000000, 1000000000000);
begin
  if Abs(d) > 12 then
    raise ERangeError.Create('RoundN: O valor deve estar entre -12..12');
  if d = 0 then
    Result := Int(x) + Int(Frac(x) * 2)
  else if d > 0 then
  begin
    x := x * t[d];
    Result := (Int(x) + Int(Frac(x) * 2)) / t[d];
  end
  else begin  // d < 0
    x := x / t[-d];
    Result := (Int(x) + Int(Frac(x) * 2)) * t[-d];
  end;
end;}

function ArredCurr(const AValue: Extended; ADigit: Integer): Extended;
var
  LFactor: Extended;
  _DigC : TRoundToRange;
begin
  Result := 0;

  if IsNan(AValue) then
    Exit;

  if ADigit > 0 then // Só converte pra negativo caso venha positivo, devido aos relatórios que usavam o antigo método
    _DigC := ADigit * (-1) // Luiz Santana - converte em negativo pois a função nativa (SimpleRoundTo) trabalha com negativo.
  else
    _DigC := ADigit;

  LFactor := IntPower(10.0, _DigC);
  if AValue < 0 then
    Result := Int((AValue / LFactor) - 0.5) * LFactor
  else
    Result := Int((AValue / LFactor) + 0.5) * LFactor;
end;

Function Truncar(const _Valor : Variant; Const _Decimais : Integer): Extended;
var
  ValorS: String;
  NumInt, NumFrac, Num: String;
  Y: Integer;
begin
  Result := 0;
  ValorS := FloatToStr(_Valor);
  //Pegar a parte fracionária
  Y := PosEx(FormatSettings.DecimalSeparator, ValorS);
  if Y > 0 then
  begin
    NumInt := Copy(ValorS, 1, Y - 1);
    NumFrac := Copy(ValorS, Y + 1, _Decimais);
  end//if
  else begin
    NumInt := ValorS;
    NumFrac := '';
  end;//if

  Num := NumInt;
  if Trim(NumFrac) <> '' then
    Num := Num + ',' + NumFrac;

  Result := StrToFloat(Num);    
end;

