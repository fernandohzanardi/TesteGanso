Function GeraNossoNumero(_NumeroTituloCR : Integer) : String;
  function I(_TN : String) : Integer;
  begin
    Result := StrToInt(_TN);
  end;
var
  _NumDoc, _Peso, _DV : String;
  _Soma, _Resto, _DVCalc : Integer;
begin

  // Função foi substituída pela procedure SP_GERANOSSONUMERO

  Result := '';
  _DV := '';
  if ((DM._ParBancoConvenioBloqueto > 0)and(_ParBloquetoBancoNum > 0)) then {26/01/2017 - Edson Gregorio - CD 2328}
  begin
    // BRADESCO ------------------------------------------------------------------------------------------------------
    if (_ParBloquetoBancoNum = 237) then
    begin
      // Formato do Nosso Número: 12 + 12345678901 - DV (Carteira + Número e Dígito)
      _NumDoc := _ParBloquetoCarteira + FormatFloat('00000000000',_NumeroTituloCR); // Base p/ gerar o Cálculo do DV
      _Peso := '765432';
      _Soma := (I(_Peso[6]) * I(_NumDoc[13]))
             + (I(_Peso[5]) * I(_NumDoc[12]))
             + (I(_Peso[4]) * I(_NumDoc[11]))
             + (I(_Peso[3]) * I(_NumDoc[10]))
             + (I(_Peso[2]) * I(_NumDoc[ 9]))
             + (I(_Peso[1]) * I(_NumDoc[ 8]))
             + (I(_Peso[6]) * I(_NumDoc[ 7]))
             + (I(_Peso[5]) * I(_NumDoc[ 6]))
             + (I(_Peso[4]) * I(_NumDoc[ 5]))
             + (I(_Peso[3]) * I(_NumDoc[ 4]))
             + (I(_Peso[2]) * I(_NumDoc[ 3]))
             + (I(_Peso[1]) * I(_NumDoc[ 2]))
             + (I(_Peso[6]) * I(_NumDoc[ 1]));

      _Resto := (_Soma mod 11);
      _DVCalc := 11 - _Resto; // Possível DV Calculado (dependerá do Resto)

      if (_Resto = 1) then
        _DV := 'P'
      else if (_Resto = 0) then
        _DV := '0'
      else
        _DV := Trim(IntToStr(_DVCalc));

      Result := _ParBloquetoCarteira + '/' +
                FormatFloat('00000000000',_NumeroTituloCR) +
                '-'+_DV;
    end;
  end;
end;

