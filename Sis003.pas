function ExibirMensagem(vTitulo, vMensagem, vMsgEx: String; imIconeMensagem: TIconeMensagem; pAlturaDetalhes: Integer; pDetalhesAbertos: Boolean; TextoBotao: String = 'OK'; BotaoPadrao: Integer = 1; PermiteFechar: Boolean = False; TemporizadorFechaMSG: Integer = 0): Integer;
var
  I, nBtn: Integer;
  vStrBtn: String;
  IdxBtn: array of Integer;
  StrBtn: array[0..10] of String;
  LForm: TForm;
  LMemo: TComponent;
  LAlturaFinal, LTetoUtil: Integer;
begin
  // Sobrecarga de "ExibirMensagem" que permite definir a altura da caixa de detalhes (MessageEx)
  // e se ela ja deve ser exibida aberta. Util para mensagens com lista longa (ex.: F10 - Gerar Recebimento),
  // evitando que a janela cresca alem da tela e oculte os botoes CONFIRMAR/CANCELAR.

  vStrBtn := '';
  nBtn := 1;

  try
    if (Trim(StringReplace(TextoBotao,'|','',[rfReplaceAll])) = '') then
      TextoBotao := 'OK';

    TextoBotao := TextoBotao + '||';

    for I := 1 to StrLen(PChar(Trim(TextoBotao))) do
      if (Copy(Trim(TextoBotao),I,2) = '||') then
        Inc(nBtn);

    SetLength(IdxBtn,nBtn);
    nBtn := 1;

    for I := 1 to StrLen(PChar(Trim(TextoBotao)))-1 do
    begin
      if (Copy(Trim(TextoBotao),I,2) = '||') then
      begin
        IdxBtn[nBtn] := nBtn;
        StrBtn[nBtn] := StringReplace(vStrBtn,'|','',[rfReplaceAll]);
        Inc(nBtn);
        vStrBtn := '';
      end
      else
        vStrBtn := vStrBtn + Copy(Trim(TextoBotao),I,1);
    end;

    if (BotaoPadrao >= nBtn) or (BotaoPadrao <= 0) then
      BotaoPadrao := 1;

    try
      //O valor de "ExMsgRegLog" não deve ser um parâmetro implícito nesta função.
      if (Trim(vMensagem) <> '') and (ExMsgRegLog <> nil) and ((ExMsgRegLog is TMemo) or (ExMsgRegLog is TDBMemo) or (ExMsgRegLog is TcxMemo) or (ExMsgRegLog is TcxDBMemo)) then
      begin
        if (ExMsgRegLog is TMemo) then
        begin
          with (ExMsgRegLog as TMemo).Lines do
          begin
            Add('');
            Add('');
            Add('[' + vTitulo + '] ' + vMensagem);

            if (vMsgEx <> '') then
              Add('### Detalhes: ' + vMsgEx);
          end;
        end
        else
        if (ExMsgRegLog is TcxMemo) then
        begin
          with (ExMsgRegLog as TcxMemo).Lines do
          begin
            Add('');
            Add('');
            Add('[' + vTitulo + '] ' + vMensagem);

            if (vMsgEx <> '') then
              Add('### Detalhes: ' + vMsgEx);
          end;
        end
        else
        if (ExMsgRegLog is TDBMemo) then
        begin
          if ((ExMsgRegLog as TDBMemo).DataSource.State in [dsInsert, dsEdit]) then
          begin
            with (ExMsgRegLog as TDBMemo).Lines do
            begin
              Add('');
              Add('');
              Add('[' + vTitulo + '] ' + vMensagem);

              if (vMsgEx <> '') then
                Add('### Detalhes: ' + vMsgEx);
            end;
          end;
        end
        else
        if (ExMsgRegLog is TcxDBMemo) then
        begin
          if ((ExMsgRegLog as TcxDBMemo).DataBinding.DataSource.State in [dsInsert, dsEdit]) then
          begin
            with (ExMsgRegLog as TcxDBMemo).Lines do
            begin
              Add('');
              Add('');
              Add('[' + vTitulo + '] ' + vMensagem);

              if (vMsgEx <> '') then
                Add('### Detalhes: ' + vMsgEx);
            end;
          end;
        end;
      end;
    except
    end;
  finally
    try
      ExMsgRegLog := nil;
    except
    end;
  end;

  LForm := fnMontarCaixaMensagem(vTitulo, vMensagem, vMsgEx, imIconeMensagem, IdxBtn, StrBtn, BotaoPadrao, PermiteFechar, TemporizadorFechaMSG);

  // Clipagem defensiva: nunca deixar a caixa de detalhes estourar a area util da tela,
  // preservando os botoes CONFIRMAR/CANCELAR sempre visiveis.
  if (LForm is TMessageForm) then
    LTetoUtil := Screen.WorkAreaHeight - TMessageForm(LForm).vHeightOriginal - 60
  else
    LTetoUtil := Screen.WorkAreaHeight - 200;

  if (LTetoUtil < 80) then
    LTetoUtil := 80;

  LAlturaFinal := pAlturaDetalhes;
  if (LAlturaFinal < 80) then
    LAlturaFinal := 80;
  if (LAlturaFinal > LTetoUtil) then
    LAlturaFinal := LTetoUtil;

  LMemo := LForm.FindComponent('MessageEx');
  if (LMemo is TMemo) then
    TMemo(LMemo).Height := LAlturaFinal;

  // Expande a caixa de detalhes antes do ShowModal quando solicitado.
  // MaisDetalhesClick usa MessageEx.Height (ja ajustado acima) para calcular ClientHeight,
  // e vHeightOriginal (calculado em fnMontarCaixaMensagem) para colapsar.
  if pDetalhesAbertos and (LMemo is TMemo) and (LForm is TMessageForm) then
  begin
    TMessageForm(LForm).MaisDetalhesClick(nil);

    // Reposiciona verticalmente se a expansao empurrou a base para fora da area util
    if (LForm.Top + LForm.Height) > (Screen.WorkAreaTop + Screen.WorkAreaHeight) then
      LForm.Top := (Screen.WorkAreaTop + Screen.WorkAreaHeight) - LForm.Height;
    if LForm.Top < Screen.WorkAreaTop then
      LForm.Top := Screen.WorkAreaTop;
  end;

  Result := LForm.ShowModal;
end;

function ExecScript_SYSDBA(Script: String): Boolean;
var
  tmpDatabase: TIBDatabase;
  tmpIBScript: TIBScript;
  tmpIBTransaction: TIBTransaction;
begin
  Result := False;
  
  if (Trim(Script) = '') then
    Exit;

  try
    try
      tmpDatabase := TIBDatabase.Create(nil);
      tmpDatabase.DatabaseName := _caminho_banco;
      tmpDatabase.Params.Values['user_name'] := UsSys;
      tmpDatabase.Params.Values['password'] := PWSys;
      tmpDatabase.Params.Values['lc_ctype'] := 'WIN1252';
      tmpDatabase.LoginPrompt := False;
      tmpDatabase.Connected := True;
    except
      on E: Exception do
      begin
        Application.MessageBox(PChar('Ocorreu um erro ao tentar acessar o servidor.' +#13+#13+ E.Message),'ATENÇÃO',MB_OK+MB_ICONINFORMATION);
        Exit;
      end;
    end;

    tmpIBTransaction := TIBTransaction.Create(nil);
    tmpIBTransaction.DefaultDatabase := tmpDatabase;
    tmpIBTransaction.Params.Clear;
    tmpIBTransaction.Params.Add('read_committed');
    tmpIBTransaction.Params.Add('rec_version');
    tmpIBTransaction.Params.Add('nowait');
    tmpIBTransaction.Active := True;

    tmpIBScript := TIBScript.Create(nil);
    tmpIBScript.Database := tmpDatabase;
    tmpIBScript.Transaction := tmpIBTransaction;
    tmpIBScript.Script.Text := Script;

    if not tmpIBTransaction.InTransaction then
      tmpIBTransaction.StartTransaction;

    tmpIBScript.ExecuteScript;
    tmpIBTransaction.Commit;
    tmpIBTransaction.Active := False;
    tmpDatabase.Connected := False;
    Result := True;
  finally
    tmpIBScript.Free;
    if tmpIBTransaction.InTransaction then
      tmpIBTransaction.Rollback;
    tmpIBTransaction.Free;
    try tmpDatabase.CloseDataSets; except end;
    try tmpDatabase.Connected := False; except end;
    tmpDatabase.Free;
  end;
end;

function GetDetalhesHonoFaturamento(_CodFaturamento : Integer):String;
var
  _mensagem : String;
  
begin
  Result := '';
  if _CodFaturamento > 0 then
  begin
    _Cria_IBQuery(nil,999);
    _IBQuery999.Close;
    _IBQuery999.SQL.Text :=
        ' select distinct cast(substr(f_propercase(hch.historico),1,80) as varchar(1000)) as descricao, 0 '+
        ' from hono_contratos_histreaj hch '+
        ' join hono_faturamento_itens hfi on (hfi.codigo_contrato = hch.codigo_contrato) '+
        ' join hono_faturamento hf on (hf.codigo = hfi.codigo_faturamento) '+
        ' where hfi.codigo_faturamento = :pCodFaturamento '+
        '   and lpad(f_month(hch.data_reajuste),2,''0'')||lpad(f_year(hch.data_reajuste),4,''0'') = hf.competencia '+
        ' '+
        ' union all '+
        ' '+
        ' select cast(f_propercase(he.descricao) '+
        '        ||'' ''||substr(hf.competencia,1,2)||''/''||substr(hf.competencia,3,6) '+
        '        ||'' R$ ''||f_fixedpointlang(f_abs(hfi.valor_liquido),2,'','',''.'') '+
        '        ||'' ''||coalesce(Substr(f_propercase(hfi.descricao),1,100),'''') as varchar(1000))as descricao, hfi.codigo_evento '+
        ' from hono_faturamento_itens hfi '+
        ' join hono_faturamento hf on (hf.codigo = hfi.codigo_faturamento) '+
        ' join hono_eventos he on (he.codigo = hfi.codigo_evento) '+
        ' where hfi.codigo_faturamento = :pCodFaturamento '+
        ' order by 2 '; // Luiz Santana - 07/03/2019 - Nesse caso o TEF sairá em segundo (sempre)
    _IBQuery999.ParamByName('pCodFaturamento').AsInteger:= _CodFaturamento;
    _IBQuery999.Open;
    _IBQuery999.First;
    while not (_IBQuery999.eof) do
    begin
      _mensagem := Trim(_IBQuery999.FieldByName('descricao').AsString);

      if Length(_mensagem) > 80 then
        _mensagem := copy(_mensagem,1,77)+'...'
      else if Length(_mensagem) < 41 then
        _mensagem := copy(_mensagem,1,Length(_mensagem))+StringOfChar(' ',40-Length(_mensagem))+';';

      Result := Result + _mensagem +#13+#10;
      _IBQuery999.Next;
    end;
    _Destroy_IBQuery(999);
  end;
end;

procedure ShowBalloonTip(vCompnt: HWND; vTipText: String; imTipIcon: TIconeMensagem; _QtdCaracts : Integer = 1000);

type
  TEditBalloonTip = packed record
    cbStruct: DWORD;
    pszTitle: LPCWSTR;
    pszText: LPCWSTR;
    ttiIcon: Integer;
  end;

var
  EditBalloonTip: TEditBalloonTip;
  vTitulo, vMensagem: String;
  vTIcon: Cardinal;
begin
  vTitulo := '';
  vMensagem := '';
  vTIcon := 0;

  if (Trim(vTipText) = '') then
    Exit;

  if (PosEx('{', vTipText) > 0) and (PosEx('}', vTipText) > 0) then
  begin
    vTitulo := Trim(StringReplace(StringReplace(Copy(vTipText, PosEx('{', vTipText), PosEx('}', vTipText)),'{','',[rfReplaceAll]),'}','',[rfReplaceAll]));
    vMensagem := Trim(Copy(vTipText, (PosEx('}', vTipText) + 1), _QtdCaracts));
  end
  else
  begin
    case imTipIcon of
      imOutro: vTitulo := 'Informação';
      imInformacao: vTitulo := 'Informação';
      imAlerta: vTitulo := 'Atenção';
      imErro: vTitulo := 'Erro';
    end;

    vMensagem := Trim(Copy(vTipText, 1, _QtdCaracts));
  end;

  case imTipIcon of
    imOutro: vTIcon := 0;
    imInformacao: vTIcon := 1;
    imAlerta: vTIcon := 2;
    imErro: vTIcon := 3;
  end;

  EditBalloonTip.cbStruct := SizeOf(TEditBalloonTip);
  EditBalloonTip.pszTitle := StringToOleStr(vTitulo);
  EditBalloonTip.pszText := StringToOleStr(vMensagem);
  EditBalloonTip.ttiIcon := vTIcon;

  SendMessageW(vCompnt, ($1500 + 3), 0, Integer(@EditBalloonTip));
end;

function RestoDivisao(_Base : Currency; _Divisor : Currency) : Currency;
var
  _Resultado : Currency;
begin
  try
    _Resultado := (_Base / _Divisor);
    Result := _Resultado - Int(_Resultado);
  except
    Result := 1;
  end;
end;

function NFeGravaCalcsFR3BD(_FormOrigem : TForm) : Boolean;
var
  _PanelProg : TPanel;
  _ArqLogErrGravaNF : TextFile;
  _PathArqLog : String;
begin
  Result := True;
  _FormOrigem.KeyPreview := False;
  _PanelProg := TPanel.Create(nil);
  _PanelProg.Parent := _FormOrigem;
  _PanelProg.Height := 37;
  _PanelProg.Align := alBottom;
  _PanelProg.Font.Name := 'Courier New';
  _PanelProg.Font.Size := 9;
  _PanelProg.Font.Style := [fsBold];

  _Cria_IBQuery(nil,998);
  _Cria_IBQuery(nil,999);
  _IBQuery998.Close;
  _IBQuery999.Close;

  try
    _IBQuery999.SQL.Text := ' select nfl.codigo, nfl.log from nota_fiscal_log nfl ';
    _IBQuery999.Open;
    _IBQuery999.First;
    if not(_IBQuery999.IsEmpty) then
    begin
      _PathArqLog := ExtractFilePath(Application.ExeName)+'GansoLogGravaDadosNFeBD.TXT';
      try
        if FileExists(_PathArqLog) then DeleteFile(_PathArqLog);
        if FileExists(_PathArqLog) then DeleteFile(_PathArqLog);
        AssignFile(_ArqLogErrGravaNF,_PathArqLog);
        Rewrite(_ArqLogErrGravaNF);
        Application.ProcessMessages;
      except
      end;
      while not(_IBQuery999.Eof) do
      begin
        _PanelProg.Caption := 'Aguarde, gravando informações no Banco de Dados - ID LogNF: '+_IBQuery999.FieldByName('codigo').AsString+'...';
        Application.ProcessMessages;
        try
          _IBQuery998.Close;
          _IBQuery998.SQL.Text := _IBQuery999.FieldByName('log').AsString;
          _IBQuery998.ExecSQL;

          _IBQuery998.SQL.Text := 'delete from nota_fiscal_log where codigo = '+_IBQuery999.FieldByName('codigo').AsString;
          _IBQuery998.ExecSQL;

          _IBQuery998.Transaction.Commit;
        except
          on _err : Exception do
          begin
            Result := False;
            _IBQuery998.Transaction.Rollback;
            WriteLn(_ArqLogErrGravaNF,DateToStr(Date)+' '+TimeToStr(Time)+' - ID: '+_IBQuery999.FieldByName('codigo').AsString+' - Comando SQL: '+_IBQuery999.FieldByName('log').AsString);
            WriteLn(_ArqLogErrGravaNF,'     Erro: '+_err.Message);
          end;
        end;
        _IBQuery999.Next;
      end;
      Application.ProcessMessages;
      Sleep( 1000 );
      if not(Result) then
      begin
        Application.MessageBox(pChar('Houve erro ao gravar algum(ns) registro(s) da NFe no Banco de Dados.'
                            +#13+#13+'Foi criado um arquivo de "LOG" contendo tais erros em: '
                            +#13+_PathArqLog+'.'
                            +#13+#13+'Obs: A gravação desses dados (update) é de muita importância para coerência das informações prestadas pelo SPED, por isso, encontrar a solução é a alternativa mais sensata ao invés de excluí-las.')
                               ,'ATENÇÃO',MB_OK + MB_ICONINFORMATION);

        ShellExecute(0, 'Open', PChar('GansoLogGravaDadosNFeBD.TXT'), '', PChar(ExtractFileDir(Application.ExeName)), SW_MAXIMIZE);
      end;
    end;

  finally
    if _IBQuery998.Transaction.InTransaction then _IBQuery998.Transaction.Rollback;
    if _IBQuery999.Transaction.InTransaction then _IBQuery999.Transaction.Rollback;
    _Destroy_IBQuery(998); _Destroy_IBQuery(999);
    _FormOrigem.KeyPreview := True;
    _PanelProg.Free;
    try
      CloseFile(_ArqLogErrGravaNF);
    except
    end;
    Application.ProcessMessages;
  end;
end;

function NFeExecSQL_FR3BD(_FormOrigem: TForm): Boolean;
var
  _ArqLogErrGravaNF : TextFile;
  _PathArqLog : String;
  _CodNF, _StatusNF: String;
begin
  Result := True;
  _CodNF := '';
  _StatusNF := '';

  _Cria_IBQuery(nil,997);
  _Cria_IBQuery(nil,998);
  _Cria_IBQuery(nil,999);
  _IBQuery997.Close;
  _IBQuery998.Close;
  _IBQuery999.Close;

  try
    _IBQuery999.SQL.Text := ' select nfl.codigo, nfl.log from nota_fiscal_log nfl where (nfl.codigo_orcamento is not null) ';
    _IBQuery999.Open;
    _IBQuery999.First;

    if (not _IBQuery999.IsEmpty) then
    begin
      _PathArqLog := ExtractFilePath(Application.ExeName)+'GansoLogGravaDadosNFeBD.TXT';

      try
        if FileExists(_PathArqLog) then
          DeleteFile(_PathArqLog);

        if FileExists(_PathArqLog) then
          DeleteFile(_PathArqLog);

        AssignFile(_ArqLogErrGravaNF,_PathArqLog);
        Rewrite(_ArqLogErrGravaNF);
        Application.ProcessMessages;
      except
      end;

      while (not _IBQuery999.Eof) do
      begin
        try
          _CodNF := Trim(CopyStrInTag(_IBQuery999.FieldByName('log').AsString,'<idnf>','</idnf>'));

          if (_CodNF <> '') then
          begin
            _IBQuery997.Close;
            _IBQuery997.SQL.Text := 'select status from nota_fiscal where (codigo = ' + _CodNF + ')';
            _IBQuery997.Open;

            _StatusNF := Trim(_IBQuery997.FieldByName('status').AsString);

            if (_StatusNF = 'E') then
            begin
              _IBQuery998.Close;
              _IBQuery998.SQL.Text := CopyStrInTag(_IBQuery999.FieldByName('log').AsString,'<sql>','</sql>');
              _IBQuery998.ExecSQL;
            end;
          end;

          _IBQuery998.SQL.Text := 'delete from nota_fiscal_log where (codigo = ' + _IBQuery999.FieldByName('codigo').AsString + ')';
          _IBQuery998.ExecSQL;

          _IBQuery998.Transaction.Commit;
        except
          on _err : Exception do
          begin
            Result := False;
            _IBQuery998.Transaction.Rollback;
            WriteLn(_ArqLogErrGravaNF,DateToStr(Date)+' '+TimeToStr(Time)+' - ID: '+_IBQuery999.FieldByName('codigo').AsString+' - Comando SQL: '+_IBQuery999.FieldByName('log').AsString);
            WriteLn(_ArqLogErrGravaNF,'     Erro: '+_err.Message);
          end;
        end;

        _IBQuery999.Next;
      end;

      Application.ProcessMessages;
      Sleep(1000);

      if (not Result) then
      begin
        Application.MessageBox(pChar('Houve erro ao gravar algum(ns) registro(s) da NFe no Banco de Dados.'
                            +#13+#13+'Foi criado um arquivo de "LOG" contendo tais erros em: '
                            +#13+_PathArqLog+'.'
                            +#13+#13+'Obs: A gravação desses dados é de muita importância para ajustes nos títulos à receber, por isso, encontrar a solução é a alternativa mais sensata ao invés de excluí-las.')
                               ,'ATENÇÃO',MB_OK + MB_ICONINFORMATION);

        ShellExecute(0, 'Open', PChar('GansoLogGravaDadosNFeBD.TXT'), '', PChar(ExtractFileDir(Application.ExeName)), SW_MAXIMIZE);
      end;
    end;
  finally
    if _IBQuery998.Transaction.InTransaction then
      _IBQuery998.Transaction.Rollback;

    if _IBQuery999.Transaction.InTransaction then
      _IBQuery999.Transaction.Rollback;

    _IBQuery997.Close;
    _IBQuery998.Close;
    _IBQuery999.Close;

    _Destroy_IBQuery(997);
    _Destroy_IBQuery(998);
    _Destroy_IBQuery(999);

    try
      CloseFile(_ArqLogErrGravaNF);
    except
    end;

    Application.ProcessMessages;
  end;
end;

