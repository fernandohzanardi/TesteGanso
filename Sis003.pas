function ValidarDataEmissaoNFe(pDataInformada: TDate): Boolean;
var
  vDHServidor: TDateTime;
  vDataServidor, vDataUltNFe: TDate;
  vHoraServidor: TTime;
  vMsg: String;
begin
  //11.03.2016 - Marcio Rodrigues
  //10.03.2016 - Em reunião com Alexandre, Osvaldo, Adriano, Fábio e Luiz ficou decidido bloquear definitivamente qualquer emissão retroativa;
  //Caso: Um usuário voltou a data do computador e transmitiu nove NF-e com data de emissão retroativa sem que o
  //      sistema solicitasse a Chave de Operação Especial e isso causou sérios problemas na contabilidade.

  Result := False;
  vMsg := '';

  vDHServidor := GetQryResult('select current_timestamp from rdb$database');
  vDataServidor := StrToDate(FormatDateTime('DD/MM/YYYY', vDHServidor));
  vHoraServidor := StrToTime(FormatDateTime('HH:NN:SS', vDHServidor));

  if (vDataServidor <> Date) then
  begin
    vMsg := 'A data do servidor é diferente da data deste terminal.' +#13+
            'Para evitar problemas com movimentações em datas incorretas o sistema só poderá operar com as datas sincronizadas.' +#13+#13+
            'Data e Hora no Servidor: ' + FormatDateTime('DD/MM/YYYY - HH:NN:SS', vDHServidor) +#13+
            'Data e Hora neste Terminal: ' + FormatDateTime('DD/MM/YYYY - HH:NN:SS', Now);

    if (FormatDateTime('HH', vDHServidor) <> FormatDateTime('HH', Now)) then
      vMsg := vMsg + '*' +#13+#13+ '*Considere ajustar o horário.';

    Application.MessageBox(PChar(vMsg), 'ATENÇÃO', MB_OK+MB_ICONINFORMATION);
    Exit;
  end;

  if (vDataServidor <> pDataInformada) then
  begin
    vMsg := 'A data do servidor é diferente da Data de Emissão informada.' +#13+
            'Para evitar problemas com movimentações em datas incorretas o sistema só poderá operar com as datas sincronizadas.' +#13+#13+
            'Data de Emissão informada: ' + FormatDateTime('DD/MM/YYYY', pDataInformada) +#13+
            'Data e Hora no Servidor: ' + FormatDateTime('DD/MM/YYYY - HH:NN:SS', vDHServidor) +#13+
            'Data e Hora neste Terminal: ' + FormatDateTime('DD/MM/YYYY - HH:NN:SS', Now);

    if (FormatDateTime('HH', vDHServidor) <> FormatDateTime('HH', Now)) then
      vMsg := vMsg + '*' +#13+#13+ '*Considere ajustar o horário.';

    Application.MessageBox(PChar(vMsg), 'ATENÇÃO', MB_OK+MB_ICONINFORMATION);
    Exit;
  end;

  vDataUltNFe := Coalesce(GetQryResult('select first 1 nf.data_emissao from nota_fiscal nf where (nf.status in (''E'',''C'',''D'')) ' +
                                       'and (nf.data_emissao is not null) and (coalesce(nf.tipo_nf,0) <> 4) and (nf.codigo_filial = ' + IntToStr(_CodFilial) + ') ' +
                                       'order by nf.data_emissao desc'),0);

  if (vDataUltNFe > vDataServidor) then
  begin
    vMsg := 'O sistema detectou que a data deste terminal é inferior a data da última NF-e emitida.' +#13+
            'Para evitar problemas com movimentações em datas incorretas o sistema só poderá operar com datas sincronizadas e progressivas.' +#13+#13+
            'Data de Emissão da última NF-e: ' + FormatDateTime('DD/MM/YYYY', vDataUltNFe) +#13+
            'Data e Hora no Servidor: ' + FormatDateTime('DD/MM/YYYY - HH:NN:SS', vDHServidor) +#13+
            'Data e Hora neste Terminal: ' + FormatDateTime('DD/MM/YYYY - HH:NN:SS', Now);

    if (FormatDateTime('HH', vDHServidor) <> FormatDateTime('HH', Now)) then
      vMsg := vMsg + '*' +#13+#13+ '*Considere ajustar o horário.';

    Application.MessageBox(PChar(vMsg), 'ATENÇÃO', MB_OK+MB_ICONINFORMATION);
    Exit;
  end;

  if (vDataUltNFe > pDataInformada) then
  begin
    vMsg := 'O sistema detectou que a data de emissão informada é inferior a data da última NF-e emitida.' +#13+
            'Para evitar problemas com movimentações em datas incorretas o sistema só poderá operar com datas sincronizadas e progressivas.' +#13+#13+
            'Data de Emissão informada: ' + FormatDateTime('DD/MM/YYYY', pDataInformada) +#13+
            'Data de Emissão da última NF-e: ' + FormatDateTime('DD/MM/YYYY', vDataUltNFe) +#13+
            'Data e Hora no Servidor: ' + FormatDateTime('DD/MM/YYYY - HH:NN:SS', vDHServidor) +#13+
            'Data e Hora neste Terminal: ' + FormatDateTime('DD/MM/YYYY - HH:NN:SS', Now);

    if (FormatDateTime('HH', vDHServidor) <> FormatDateTime('HH', Now)) then
      vMsg := vMsg + '*' +#13+#13+ '*Considere ajustar o horário.';

    Application.MessageBox(PChar(vMsg), 'ATENÇÃO', MB_OK+MB_ICONINFORMATION);
    Exit;
  end;

  Result := True;
end;

procedure PrepararNFe_VEN(pSender: TComponent; pCodCliente, pCodPropriedade, pCodVenda: Integer);
var
  vSQL, vRetStr, vCodDF, vStatusDF, vMsg, vBtn: String;
  vCount, vResp: Integer;
  vARetirar: Boolean;
begin
  //Preparar NF-e de venda
  vSQL := 'select ''<cod>'' || df.codigo || ''</cod><sts>'' || df.status || ''</sts>''' +
          'from doc_fiscal_dependencia dfd join doc_fiscal df on (df.codigo = dfd.codigo_doc_fiscal) ' +
          'where (dfd.codigo_orcamento = </pCodVenda>) and (df.codigo_filial = </pCodFilial>) and (df.status in (''AUT'',''AUP'',''NTR'',''TRI'',''TXT''))';

  vSQL := StringReplace(vSQL, '</pCodFilial>', IntToStr(_CodFilial), [rfReplaceAll]);
  vSQL := StringReplace(vSQL, '</pCodVenda>', IntToStr(pCodVenda), [rfReplaceAll]);

  vRetStr := Trim(Coalesce(GetQryResult(vSQL),''));

  if (vRetStr <> '') then
  begin
    vCodDF := CopyStrInTag(vRetStr,'<cod>','</cod>');
    vStatusDF := CopyStrInTag(vRetStr,'<sts>','</sts>');

    if (not Assigned(FrmDFe)) then
      FrmDFe := TFrmDFe.Create(nil)
    else
    begin
      FrmDFe.CancelarClick(nil);
      FrmDFe.Close;
      Application.ProcessMessages;
      FrmDFe := TFrmDFe.Create(nil);
    end;

    FrmDFe.ibdsDFe.SelectSQL.Add('WHERE CODIGO = ' + vCodDF);
    FrmDFe.ibdsDFe.Open;
    FrmDFe.Show;
    Exit;
  end;


  vSQL := 'execute block returns (vQtdeRegVenda integer) ' +
          'as declare variable vTipoModulo char(1); ' +
          'begin ' +
          'select first 1 par.tipo_modulo from parametros par ' +
          'where (par.codigo_filial = </pCodFilial>) into :vTipoModulo; ' +
          'if (:vTipoModulo = ''C'') then ' +
          'vTipoModulo = ''A''; else vTipoModulo = ''F''; ' +
          'select distinct count(o.codigo) from orcamento o ' +
          'left join cliente c on (c.codigo = o.codigo_cliente) ' +
          'left join cliente_propriedade cp on (cp.codigo = o.codigo_propriedade) ' +
          'left join funcionario f on (f.codigo = o.codigo_funcionario) ' +
          'join orcamento_negociacao one on (one.codigo_orcamento = o.codigo) ' +
          'join prevenda pv on (pv.codigo_orcamento = o.codigo) and (pv.status = :vTipoModulo) ' +
          'where (o.tipo_doc_fiscal is null) and (o.tipo_orcamento = ''P'') and (o.status = ''F'') ' +
          'and (o.codigo_filial = </pCodFilial>) and (pv.origem_prevenda = ''P'') and (pv.doc_fiscal_status is null) ' +
          'and (pv.pdv_mescla is null) and (o.codigo in (</pCodVenda>)) into :vQtdeRegVenda; ' +
          'suspend; ' +
          'end';

  vSQL := StringReplace(vSQL, '</pCodFilial>', IntToStr(_CodFilial), [rfReplaceAll]);
  vSQL := StringReplace(vSQL, '</pCodVenda>', IntToStr(pCodVenda), [rfReplaceAll]);

  vCount := Coalesce(GetQryResult(vSQL),0);

  if (vCount <= 0) then
  begin
    ExibirMensagem('ATENÇÃO','O pedido ' + IntToStr(pCodVenda) + ' não está preparado para emissão de NF-e.','',imInformacao);
    Exit;
  end;

  if (_ParSitEntrega = 'S') then
  begin
    if (_ParARetirarComoVendaFut = 'S') then
      vARetirar := True
    else
    if (_ParARetirarComoVendaFut = 'N') then
      vARetirar := False
    else
    begin
      vCount := Coalesce(GetQryResult('select count(oi.codigo) from orcamento_item oi ' +
                                      '  join orcamento o on (o.codigo = oi.codigo_orcamento) ' +
                                      '  left join produto p on (p.codigo = oi.codigo_produto) ' +#13+
                                      '  left join empresa_filial ef on (ef.codigo = o.codigo_filial) ' +#13+
                                      'where (oi.codigo_orcamento = ' + IntToStr(pCodVenda) + ') ' +
                                      'and (coalesce(oi.situacao_entrega,'''') = ''AR'') '),0);

      if (vCount > 0) then
      begin
        if (vCount = 1) then
          vMsg := 'Há um item com a Situação de Entrega definida como "À Retirar".'
        else
          vMsg := 'Há ' + IntToStr(vCount) + ' itens com a Situação de Entrega definida como "À Retirar".';

        {25/08/2025 - Weliton Goulart - CD_5373}
        if (_EmpCRT in [1, 4]) then
        begin
          vBtn := 'Como venda para Entrega Futura;;(CSOSN 400 com CFOP 5922/6922)'
        end
        else
        if (_EmpCRT in [2,3]) then
        begin
          vBtn := 'Como venda para Entrega Futura;;(CST 41 com CFOP 5922/6922)';
        end;

        vResp := ExibirMensagem('ATENÇÃO',vMsg +#13+#13+ 'Como deseja considerar esses itens na Nota Fiscal?','',imPergunta,vBtn + '||Com disponibilidade imediata;;(Será aplicado o CFOP padrão)||Cancelar',3);

        if (vResp = 1) then
          vARetirar := True
        else
        if (vResp = 2) then
          vARetirar := False
        else
        begin
          vARetirar := False;
          Exit;
        end;
      end;
    end;
  end
  else
    vARetirar := False;

  if (not Assigned(FrmDFe)) then
  begin
      FrmDFe := TFrmDFe.Create(nil, pCodCliente, pCodPropriedade, pCodVenda, vARetirar);
  end
  else
  begin
    FrmDFe.CancelarClick(nil);
    FrmDFe.Close;
    Application.ProcessMessages;
    FrmDFe := TFrmDFe.Create(nil, pCodCliente, pCodPropriedade, pCodVenda, vARetirar);
  end;

  FrmDFe.Show;
end;

Function SomaQtdVendaConvProd(_DataIni, _DataFim : TDate; _CodCliV, _CodConvProdV : Integer) : Currency;
begin
  // 20/04/2016 - Luiz Santana - CD - 1456 - Convênio com Preços Pré Acertados - Acordo Comercial
  Result := 0;
  _Cria_IBQuery(nil,999);
  try
    _IBQuery999.Close;
    _IBQuery999.SQL.Text := ' select '
                           +' (select coalesce(sum(oi.quantidade - coalesce(oi.quantidade_estornado,0)),0) '
                           +'  from orcamento_item oi '
                           +'  join orcamento o on o.codigo = oi.codigo_orcamento '
                           +'  where o.codigo_cliente = :pCodCli '
                           +'    and oi.codigo_cliconvprod = :pCodConvProd '
                           +'    and o.data_orcamento between :pDtIni and :pDtFim '
                           { CD 2811 - Removendos DAVs Desistidos com o argumento abaixo
                                       Gustavo Espíndola - 28/09/2018}
                           +'    and (coalesce(o.dav_desist,''N'') = ''N'')) '
                           +' + '
                           +' (select coalesce(sum(osi.quantidade),0) '
                           +'  from os_item osi '
                           +'  join os os on os.codigo = osi.codigo_os '
                           +'  where os.codigo_cliente = :pCodCli '
                           +'    and osi.codigo_cliconvprod = :pCodConvProd '
