function GravaDuplicata(_banco: Tibdatabase; _transacao: TIBTransaction; _NumeroDup: Integer): Boolean;
var
  _query : TIBQuery;
  _Transaction : TIBTransaction;
begin
  _query := TIBQuery.Create(nil);
  _transaction := TIBTransaction.Create(nil);
  _transaction.DefaultDatabase := dm.IBbanco;
  with _query do
  begin
    Database := _banco;
    _query.Transaction := _transaction;
    SQL.Clear;
    SQL.Add('SELECT numero_duplicata FROM parametros WHERE codigo_filial = '+IntToStr(_CodFilial)+' and numero_duplicata = '+IntToStr(_NumeroDup));
    Open;
    if _query.IsEmpty then
    begin
      Close;
      SQL.Clear;
      SQL.Add('UPDATE parametros SET numero_duplicata = '+IntToStr(_NumeroDup)+' WHERE codigo_filial = '+IntToStr(_CodFilial));
      ExecSQL;
      _Transaction.Commit;
      Result := True;
    end
    else begin
      Result := False;
    end;
  end;
  _query.Close;
  _query.Free;
end;

