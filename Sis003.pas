    DM.SaveDialog.DefaultExt := '*.txt';
    DM.SaveDialog.Filter     := 'Arquivo de Texto (*.txt)|*.txt|Todos Arquivos (*.*)|*.*';
    DM.SaveDialog.FileName   := FileName;

    if not DM.SaveDialog.Execute then
    begin
      DM.SaveDialog.FileName := '<vCancelar>';
      DM.SaveDialog.Tag := 0;
      Exit;
    end;
  end;
end;

function Grau_Mascara_Contabil(Valor : String): Integer;
var Mascarado : String;
    i, Cont : integer;
begin
   Mascarado := Formata_Marcara_Contabil(Valor);
   Cont := 1;

   for I := 1 To Length(mascarado) Do
   begin
     Application.ProcessMessages;
     if Mascarado[i] = '.' then
       Inc(Cont);
   end;

   Result := Cont;
end;    

function Formata_Marcara_Contabil(Valor : String): String;
var Retorno : String;
  function RemoveChar(Const Texto:String):String;
  var I: integer;
      S: string;
  begin
    S := '';
    for I := 1 To Length(Texto) Do
    begin
      Application.ProcessMessages;
      if (Texto[I] in ['0'..'9', '.']) then
        S := S + Copy(Texto, I, 1);
    end;
    result := S;
  end;
begin
  Retorno := Trim(FormatMaskText(_ParMarcara_Contabil + ';0;', Valor));
  Retorno := RemoveChar(Retorno);

  if(Retorno = '')then { TODO -oHeliton -cMigração Xe : Valida a variavel Retorno para não causar erro no While abaixo }
  begin
    Result := Retorno;
    exit;
  end;

  while Retorno[Length(Retorno)] = '.' do
  begin
    Application.ProcessMessages;
    Delete(Retorno, Length(Retorno), 1);
  end;

  Result := Retorno;
end;

function Acesso_Restrito(pTituloLibera : String; pChave : String; pOrigemDoc : String = ''; pCodigoDocOrigem : Integer = 0; pDadosEmTransacao: String = ''; pCodigoLiberacao: pointer = nil) : Boolean;
  {
    01/10/2015 - Vicente Neto - CD 1748
    Foi adicionado um parâmetro do tipo pointer a este método e este parâmetro receberá do chamador
    o endereço de uma variável local (já instanciada) do tipo integer, de modo que a esta variável seja atribuído
    o código da liberação remota que foi criada.
  }
begin
  _LiberaOperacao := False;
  if not Assigned(FrmLibera) then
  begin
    _TituloLibera := pTituloLibera;
    _Chave := pChave;
    {
      01/10/2015 - Vicente Neto - CD 1748
      O parâmetro pCodigoLiberacao (que é um ponteiro) é passado como parâmetro novamente para o create do Frmlibera, pois lá será atribuído à variável
      referenciada, o código da liberação remota criada.
    }
    FrmLibera := TFrmLibera.Create(Application,pOrigemDoc,pCodigoDocOrigem,pDadosEmTransacao, pCodigoLiberacao); {02/06/2015 - Edson Gregorio - CD 1649}

    if (_ParUsuarioMestrePSenha = 'N') then
    begin
      _Cria_IBQuery(nil,999);
      _IBQuery999.Close;
      _IBQuery999.SQL.Clear;
      _IBQuery999.SQL.Add('SELECT A.CODIGO FROM IBXBCTABUSERS_ACRESTRITO A WHERE A.CODIGO_USUARIO = :USUARIO AND A.CODIGO_FILIAL = :EMPRESA AND A.CHAVE = :CHAVE');
      _IBQuery999.ParamByName('USUARIO').AsInteger := _CodUsuario;
      _IBQuery999.ParamByName('EMPRESA').AsInteger := _CodFilial;
      _IBQuery999.ParamByName('CHAVE').AsString := _Chave;
      _IBQuery999.Open;

      if not(_IBQuery999.IsEmpty) then
      begin
        FrmLibera.FormShow(nil);
        FrmLibera.Edit1.Text := _usuario;
        FrmLibera.Edit2.Text := _senha;

        _LiberaOperacao := True;
        FrmLibera._Sair := True;
        _Digitado := True;
        _usuario_acesso := _usuario;
        _Usuario_Liberacao := _usuario; {26/11/2020 - Wéliton Goulart - CD_4101}

        FrmLibera.GravaAcessoRestrito;
        _Chave := '';
        _IBQuery999.Close;
        _Destroy_IBQuery(999);
        if FrmLibera.IBElibera.Registered then
          FrmLibera.IBElibera.UnRegisterEvents;
        FrmLibera.Release;
        FrmLibera := nil;
        //FrmLibera.Free;
      end
      else
        FrmLibera.ShowModal;
    end
    else
      FrmLibera.ShowModal;
  end;
  Result := _LiberaOperacao;
  SetForegroundWindow(Application.Handle);
//  Application.ProcessMessages;  // Alexandre Nascimento, Jr. - Retirado porque perdia o foco em edits - CD - 5369 }
end;


function Agregado(Expressao : String; DataSource : TDataSource): String;
var ClientDataSet : TClientDataSet;
    Provider : TDataSetProvider;
    Field : TAggregateField;
begin
  inc(_Contador);
  ClientDataSet := TClientDataSet.Create(DM);
  Provider := TDataSetProvider.Create(DM);
  ClientDataSet.AggregatesActive := True;
  Provider.Name := 'Provider' + IntToStr(_Contador);
  ClientDataSet.Name := 'ClientDataSet' + IntToStr(_Contador);
  Provider.DataSet := DataSource.DataSet;
  ClientDataSet.ProviderName := Provider.Name;
  ClientDataSet.Fields.Clear;

  Field := TAggregateField.Create(ClientDataSet);
  Field.Active := True;
  Field.Expression := Expressao;
  Field.FieldKind := fkAggregate;
  Field.FieldName := 'Total';
  Field.Name := ClientDataSet.Name + Field.FieldName;
  Field.DataSet := ClientDataSet;

  ClientDataSet.Open;
  Result := ClientDataSet.FieldByName(Field.FieldName).AsString;
  ClientDataSet.Close;
  ClientDataSet.Free;
  Provider.Free;
  DataSource.DataSet.Open;
end;

