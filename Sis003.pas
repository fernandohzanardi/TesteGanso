        Pen.Color := $00515151;
      end;

      TMessageForm(Result).lblSeta := TLabel.Create(TMessageForm(Result).pnBar);

      with TMessageForm(Result).lblSeta do
      begin
        ParentFont := False;
        Parent := TMessageForm(Result).pnBar;
