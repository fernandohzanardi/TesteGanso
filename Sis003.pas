Procedure IndicadorAtualizaPopUp(_Valor : Currency; _Titulo : String; _CodigoDocumento : Integer = 0; _TipoDoc : String = ''; _TipoFinal : String = ''; _DataHoraOperacao : String = ''; _VlrLiquido : Currency = 0);
var
  _DiaOperacao : String;
begin
  if Assigned(FrmIndicador_PopUp) then
  begin
    FrmIndicador_PopUp.Caption := _Titulo;
    Application.ProcessMessages;
    FrmIndicador_PopUp.IBQOutraMoeda.Close;
    with FrmIndicador_PopUp do
    begin
      if _TipoDoc = '' then // Significa que apenas estou pedindo um valor qualquer para ser cotado
      begin
        if _DataHoraOperacao <> '' then
          _DiaOperacao := ' and ifc.data_hora <= cast( '''+_DataHoraOperacao+''' as TimeStamp) '
        else
          _DiaOperacao := '';

        IBQOutraMoeda.SQL.Text := ' select ifin.descricao ||'' ('' || '
                                 +' COALESCE(Cast((COALESCE((select first 1 ifc.valor from indicador_financeiro_cotacao ifc '
                                 +'    where ifc.codigo_indicador = ifin.codigo '+_DiaOperacao+' and ifin.codigo_empresa = '+IntToStr(_CodEmpresa)
                                 +'    order by ifc.data_hora descending),0)) as NUMERIC(15,2)),0)||'')'' as DESCRICAO , '
                                 +' COALESCE(Cast((COALESCE((select first 1 ifc.valor from indicador_financeiro_cotacao ifc '
                                 +'    where ifc.codigo_indicador = ifin.codigo '+_DiaOperacao+' and ifin.codigo_empresa = '+IntToStr(_CodEmpresa)
                                 +'    order by ifc.data_hora descending),0)*'+StringReplace(StringReplace(CurrToStr(_Valor),'.','',[rfReplaceAll]),',','.',[rfReplaceAll])+') as NUMERIC(15,2)),0) '
                                 +' as "TOTAL_NA_MOEDA", '
                                 +' ifin.simbolo_moeda, ifin.bandeira, '' '' AS "ICONE", '' '' as "F_1" '
                                 +' from indicador_financeiro ifin where ifin.codigo_empresa = '+IntToStr(_CodEmpresa);
      end
      else if _TipoDoc = 'ORCAMENTO' then // Mostrando uma Venda Fechada
      begin
        IBQOutraMoeda.SQL.Text := '';

        if _TipoFinal = 'NO' then
        begin
          IBQOutraMoeda.SQL.Add(' select distinct ifi.descricao || '' (''||coalesce(Cast(n.cotacao_dodia as Numeric(15,2)),1)||'')'' as "DESCRICAO", ifi.simbolo_moeda, ifi.bandeira, '' '' AS "ICONE", '' '' as "F_1", ');
          IBQOutraMoeda.SQL.Add(' cast(o.orcamento_liquido * coalesce(n.cotacao_dodia,1) as numeric(15,2)) as "TOTAL_NA_MOEDA" ');
        end
        else if _TipoFinal = 'TR' then
        begin
          IBQOutraMoeda.SQL.Add(' select distinct ifi.descricao ||'' ('' || coalesce(Cast(n.cotacao_dodia as Numeric(15,2)),1) ||'')'' as "DESCRICAO", ');
          IBQOutraMoeda.SQL.Add(' ifi.simbolo_moeda, ifi.bandeira, '' '' AS "ICONE", '' '' as "F_1", ');
