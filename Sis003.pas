function Caixa_Mista(_Texto: String; _ListaMinuscula : String = ''; _ListaMaiuscula : String = ''): String;
var
  tam,pos1,pos2 : integer ;
  pal : string;
begin
  tam := 0;
  pos1 := 0;
  pos2 := 0;
  pal := '';
  Result := '';

  tam := Length(_Texto);
  _Texto := TrimRight(_Texto) + ' ';
  _Texto := AnsiUpperCase(_Texto);
  while True do
  begin
    pos1 := PosEx(' ', _Texto);
    if pos1 = 0 then
      break;
    pal := Copy(_Texto,1,pos1) ;

    // Desconsiderar o "-"
    pos1 := PosEx('-',pal) ;

    if pos1 > 0 then
      pal := Copy(_Texto,1,pos1)
    else begin
      // Após o ponto "." - em casos de abreviações de nome (ex: L.A.S.S.)
      pos1 := PosEx('.',pal) ;

      if pos1 > 0 then
        pal := Copy(_Texto,1,pos1)
      else
        pos1 := PosEx(' ', _Texto);
    end;

    pos2 := PosEx(pal, ' DA - DAS - DE - DO - DOS - PARA - POR - P/ - EM - E - '+_ListaMinuscula);

    if pos2 > 0 then
    begin
      pal := AnsiLowerCase(pal);
    end
    else begin
      pos2 := PosEx(pal, _ListaMaiuscula);
      if pos2 > 0 then
      begin
        pal := AnsiUpperCase(pal);
      end
      else
        pal := Copy(pal,1,1) + AnsiLowerCase(Copy(pal,2,tam));
    end;
    Result := Result + pal ;
    _Texto := copy(_Texto,pos1+1,tam)
  end;
end;

