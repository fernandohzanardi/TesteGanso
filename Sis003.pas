    if _SinCEP = '' then _SinCEP := '0';

    Result := '11'
             +Copy(Trim(_EmpEndereco) + DupeString(Chr(32),34 - StrLen(pChar(Trim(_EmpEndereco)))),1,34)
             +FormatFloat('00000',_EmpNumero)
             +DupeString(Chr(32),22) // Complemento
             +Copy(Trim(_EmpBairro) + DupeString(Chr(32),15 - StrLen(pChar(Trim(_EmpBairro)))),1,15)
             +FormatFloat('00000000',StrToFloat(_SinCEP))
             +Copy(Trim(_EmpContato) + DupeString(Chr(32),28 - StrLen(pChar(Trim(_EmpContato)))),1,28)
             +FormatFloat('000000000000',StrToFloat(_SinTelEmp));
  except
    on _e : exception do
    begin
      Application.MessageBox(pChar('Erro ao gerar o Registro 11 do SINTEGRA.'+#13+#13+_e.Message),'ATENÇÃO',MB_OK+MB_ICONINFORMATION);
