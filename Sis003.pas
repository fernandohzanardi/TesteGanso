procedure CalcularValorBaseRetencoesServicos(pDestacIR, pDestacCSLL, pDestacPIS, pDestacCofins, pDestacISS: string; pAliqIR,
  pAliqCSLL, pAliqPIS, pAliqCofins, pAliqISS, pVlrTotalItem: Currency; pCodigo, pCodServico: Integer; var pTotalBase: Currency; var pTotalIR
  , pTotalCSLL, pTotalPIS, pTotalCofins, pTotalISS: Extended; pCoeficiente: Extended = 1; pPersistir: Boolean = False);
var
  lServNReterIRCSLLPISCofins: Boolean;
  lBaseServico: Extended;
begin
  try
    lServNReterIRCSLLPISCofins := GetQryResult('select coalesce(DFE_NAO_DESTACAR_RET_IMP, ''N'') from servico where ' +
      'codigo_filial = ' + _CodFilial.ToString + ' and codigo = ' + pCodServico.ToString) = 'S';
    lBaseServico := 0;

    if not lServNReterIRCSLLPISCofins then
    begin
      if pDestacPIS = 'S' then
      begin
        lBaseServico := pVlrTotalItem * pCoeficiente * (pAliqPIS / 100.00);
        pTotalPIS := pTotalPIS + (pVlrTotalItem * pCoeficiente * pAliqPIS / 100.00);
      end;

      if pDestacCofins = 'S' then
      begin
        lBaseServico := lBaseServico + (pVlrTotalItem * pCoeficiente * pAliqCofins / 100.00);
        pTotalCofins := pTotalCofins + (pVlrTotalItem * pCoeficiente * pAliqCofins / 100.00);
      end;

      if pDestacIR = 'S' then
      begin
        lBaseServico := lBaseServico + (pVlrTotalItem * pCoeficiente * pAliqIR / 100.00);
        pTotalIR := pTotalIR + (pVlrTotalItem * pCoeficiente * pAliqIR / 100.00);
      end;

      if pDestacCSLL = 'S' then
      begin
        lBaseServico := lBaseServico + (pVlrTotalItem * pCoeficiente * pAliqCSLL / 100.00);
        pTotalCSLL := pTotalCSLL + (pVlrTotalItem * pCoeficiente * pAliqCSLL / 100.00);
      end;
    end;

    if pDestacISS = 'S' then
    begin
      lBaseServico := lBaseServico + (pVlrTotalItem * pCoeficiente * pAliqISS / 100.00);
      pTotalISS := pTotalISS + (pVlrTotalItem * pCoeficiente * pAliqISS / 100.00);
    end;

    lBaseServico := ArredCurr(lBaseServico, 2);

    if pPersistir then
    begin
      var vControle := ExecSQLScript('update os_servico set vlr_retencao_imposto = ' +
        FloatToStr(lBaseServico).Replace(',','.', [rfReplaceAll]) + ' where codigo = ' + pCodigo.ToString);

      if vControle <> EmptyStr then raise Exception.Create('Erro ao atualizar o valor de retenção do servico');
    end;

    pTotalBase := pTotalBase + lBaseServico;

  except on E: Exception do
    begin
      Application.MessageBox(PChar('Ocorreu um erro ao tentar calcular a base das retenções de serviços. Verifique: ' + E.Message),
        'Atenção', MB_OK);
      Abort;
    end;
  end;
end;

procedure DesconsiderarRetencaoMenor10(var pTotalIR, pTotalCSLL, pTotalPIS, pTotalCofins: Extended; const pVlrTotalItem, pAliqIR, pAliqCSLL,
  pAliqPIS, pAliqCofins: Currency; pDAV: string; pCodItem, pCodProd: Integer; var pTotalBase: Currency; pCoeficiente: Extended = 1;
  pPersistir: Boolean = False);
var
  lProdNReterPISCofins: Boolean;
  lVlrRetencaoItem: Currency;
  lVlrDesconsiderar: Extended;
begin
  try
    lVlrRetencaoItem := GetQryResult('select coalesce(vlr_retencao_imposto, 0) from ' + pDAV + '_item where codigo = ' + pCodItem.ToString);

    if pTotalBase = 0 then
      Exit;

    lProdNReterPISCofins := GetQryResult('select coalesce(DFE_NAO_DESTAC_RET_IMP_PIS_COF, ''N'') from produto_parametros p where ' +
      'codigo_filial = ' + _CodFilial.ToString + ' and codigo_produto = ' + pCodProd.ToString) = 'S';
    lVlrDesconsiderar := 0;

    if not lProdNReterPISCofins then
    begin
      if (pTotalPIS > 0.00) and (pTotalPIS < 10.00) then
      begin
        lVlrDesconsiderar := pVlrTotalItem * pCoeficiente * pAliqPIS / 100.00;
      end;

      if (pTotalCofins > 0.00) and (pTotalCofins < 10.00) then
      begin
        lVlrDesconsiderar := lVlrDesconsiderar + (pVlrTotalItem * pCoeficiente * pAliqCofins / 100.00);
      end;
    end;

    if (pTotalIR > 0.00) and (pTotalIR < 10.00) then
    begin
      lVlrDesconsiderar := lVlrDesconsiderar + (pVlrTotalItem * pCoeficiente * pAliqIR / 100.00);
    end;

    if (pTotalCSLL > 0.00) and (pTotalCSLL < 10.00) then
    begin
      lVlrDesconsiderar := lVlrDesconsiderar + (pVlrTotalItem * pCoeficiente * pAliqCSLL / 100.00);
    end;

    lVlrDesconsiderar := ArredCurr(lVlrDesconsiderar, 2);

    if pPersistir then
    begin
      var vControle := ExecSQLScript('update ' + pDAV + '_item set vlr_retencao_imposto = ' +
        IfThen(lVlrRetencaoItem - lVlrDesconsiderar > 0.00 , FloatToStr(lVlrRetencaoItem - lVlrDesconsiderar).Replace(',','.', [rfReplaceAll]),
        'null') + ' where codigo = ' + pCodItem.ToString);

      if vControle <> EmptyStr then raise Exception.Create('Erro ao atualizar o valor de retenção do item');
    end;

    pTotalBase := pTotalBase - lVlrDesconsiderar;

  except on E: Exception do
    begin
      Application.MessageBox(PChar('Ocorreu um erro ao tentar calcular a base das retenções de itens. Verifique: ' + E.Message), 'Atenção', MB_OK);
      Abort;
    end;
  end;
end;

