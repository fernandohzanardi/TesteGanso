Function VerVendaEmbarque(_CodVenda : Integer) : Boolean;
var
  _codigo_embarque : Integer;
  _Vazio : Boolean;
  _Status : String;
begin
  // Luiz Santana - 17/12/2013 - Liberado módulo de Ordem de Embarque a Pedido do Suporte (Wudson - Atac.Fernandes, Alexandre, dentro outros) 
  //if _ParRamo = 'ATACADO' then
  //begin
    _Cria_IBQuery(nil,999); // Tratamento esse para não deixar editar, inserir e excluir o item se tiver na ordem de embarque
    _IBQuery999.Close;
    _IBQuery999.SQL.Text := ' SELECT OV.CODIGO_ORDEM_EMBARQUE, OE.STATUS '
                           +' FROM ORDEM_EMBARQUE_VENDAS OV '
                           +' JOIN ORDEM_EMBARQUE OE ON (OE.CODIGO = OV.CODIGO_ORDEM_EMBARQUE) '
                           +' WHERE OV.CODIGO_ORCAMENTO = '+IntToSTr(_CodVenda);
    _IBQuery999.Open;
    _codigo_embarque := _IBQuery999.Fields[0].AsInteger;
    _Vazio := _IBQuery999.IsEmpty;
    _Status := _IBQuery999.Fields[1].AsString;
    _Destroy_IBQuery(999);
    //** Procedimento para pedir senha de acesso restrito para alterar Prè-Vendas
    //** desde que a Ordem de Embarque não esteja fechada
    // David - 17/05/2007
    if (not _Vazio) and (_ParSenha_Alterar_Venda_Embarque) then
    begin
      // ACESSO RESTRITO \\
      if (_Status = 'A') and (_ParStatus_PreVenda_Embarque = 'A') then
      begin
        Result := not Acesso_Restrito('Liberação para Alterar Venda ' + IntToSTr(_CodVenda) + ' vinculada a Ordem de Embarque ' + FormatFloat('00000', _codigo_embarque), Pchar('<029>'));
      end
      else
        Result := True;
    end
    else
      Result := False;

    if Result then
      Application.MessageBox(PChar('Existe uma Ordem de Embarque para essa Venda, Verifique... '+#13+#13'Código da Ordem de Embarque: '+FormatFloat('00000', _codigo_embarque)),'ATENÇÃO',MB_OK+MB_ICONINFORMATION);
  //end
  //else
  //  Result := False;
end;


function ChecaFinalizadorBanco(_CodigoConta : Integer ; _Tipo : String): Integer;
begin
  // Buscando Finalizador da Conta Bancária
  _Cria_IBQuery(nil,999);
  _IBQuery999.Close;
  Result := 0;
  with _IBQuery999 do
  begin
    SQL.Text := ' select f.codigo_indicador, bc.codigo_finalizador '
               +' from banco_conta bc '
               +' left join finalizador f on (f.codigo = bc.codigo_finalizador) '
               +' where bc.codigo = '+IntToStr(_CodigoConta);
    Open;
    if not(IsEmpty) then
    begin
      if _tipo = 'F' then
      begin
        if (FieldValues['codigo_finalizador'] = null)or(FieldValues['codigo_finalizador'] <= 0) then Result := 0
        else Result := FieldValues['codigo_finalizador'];
      end;
      if _tipo = 'I' then
      begin
        if (FieldValues['codigo_indicador'] = null)or(FieldValues['codigo_indicador'] <= 0) then Result := 0
        else Result := FieldValues['codigo_indicador'];
      end
    end;
  end;
  _Destroy_IBQuery(999);
end;

function GeraInputsDBMemo(Titulo, Descricao : String; var Texto : String; _MemoReadOnly : Boolean = False; _MemoWidth : Integer = 500; _MemoHeight : Integer = 150; _MemoFont : String = 'MS Sans Serif'; _MemoTam : Integer = 8; pMemoMaxLength : Integer = 0): Boolean;
var
  Memo : TMemo;
  Valor_Antes : String;
begin
  Valor_Antes := Texto;
  Result := False;
  _Form := TForm.Create(Application);
  try
    _Form.BorderStyle := bsDialog;
    _Form.Caption     := Titulo;
    _Form.Position    := poScreenCenter;
    _Form.Width       := _MemoWidth;
    _Form.OnKeyDown   := FrmPrincipalGanso.FormKeyBaixo;
    _Form.KeyPreview  := True;
    Memo := TMemo.Create(_Form);

    Memo.Parent       := _Form;
    Memo.Left         := 05;
    Memo.Height       := _MemoHeight;
    Memo.Width        := _Form.Width - 15;
    Memo.Top          := 25;
    Memo.Text         := Texto;
    Memo.ScrollBars   := ssVertical;
    Memo.ReadOnly     := _MemoReadOnly;
    Memo.Font.Name    := _MemoFont;
    Memo.Font.Size    := _MemoTam;
    Memo.MaxLength    := pMemoMaxLength;
    SendMessage(Memo.Handle, WM_VSCROLL, SB_PAGEDOWN, 0);

    _Form.Height := Memo.Top + Memo.Height + 80;

    with TLabel.Create(_Form) do
    begin
      Parent := _Form;
      Caption := Descricao;
      Left := 05;
      Height := 15;
      Top := Memo.Top - 15;
    end;

    with TBitBtn.Create(_Form) do
    begin
      Parent := _Form;
      Left := (_Form.ClientWidth div 2) - Width;
      Top := _Form.ClientHeight - 35;
      Caption := '&' + SMsgDlgOK;
      TabStop := False;
      ModalResult := mrOk;
    end;
    with TBitBtn.Create(_Form) do
    begin
      Parent := _Form;
      Left := (_Form.ClientWidth div 2);
      Top := _Form.ClientHeight - 35;
      Caption := '&' + SMsgDlgCancel;
      TabStop := False;
      ModalResult := mrCancel;
    end;
    if _Form.ShowModal = mrOK then
    begin
      Texto := Memo.Text;
      Result := true;
    end;
  finally
    _Form.Free;
  end;
end;

function GeraImputsNumerico(Titulo: String; var Valor: Vetor_Numerico; Mascaras, Labels : array of string; _SaiDireto : Boolean = False; Edit1ReadOnly : Boolean = False): boolean;
var
  Edt: array of TCurrencyEdit;
  i : Integer;
  Mask : String;
begin
  if _SaiDireto then
  begin
    Result := True;
    Exit;
  end;
  Result := False;
  SetLength(Edt, HIGH(Valor)+1);
  _Form := TForm.Create(Application);
  try
    _Form.BorderStyle := bsDialog;
    _Form.Caption := Titulo;
    _Form.Position := poScreenCenter;
    _Form.Width := 220;
    _Form.OnKeyDown := FrmPrincipalGanso.FormKeyBaixo;
    _Form.KeyPreview := True;
    for i := 0 to HIGH(Edt) do
    begin
      Edt[i] := TCurrencyEdit.Create(_Form);
      with Edt[i] do
      begin
        Parent := _Form;
        Left := 10;
        Height := 25;
        MaxLength := 255;
        Font.Size := 12;
        Top := (40 * i)+ 20;
        value := Valor[i];
        if High(Mascaras) < i then
          Mask := '#,##0.00'
        else
          Mask := Mascaras[i];
        DisplayFormat := Mask;

        if (PosEx('.000', Mask) > 0) then
          DecimalPlaces := 3;  

        Width := _Form.ClientWidth - 20;
        if ((Edit1ReadOnly)and(i = 0)) then
          Edt[i].ReadOnly := True;
      end;
      with TLabel.Create(_Form) do
      begin
        Parent := _Form;

        if High(Labels) < i then
          Caption := ''
        else
          Caption := Labels[i];
        Left := 10;
        Height := 15;
        Top := Edt[i].Top - 15;
      end;
      _Form.Height := Edt[i].Top + Edt[i].Height + 80;
    end;
    with TBitBtn.Create(_Form) do
    begin
      Parent := _Form;
      Left := (_Form.ClientWidth div 2) - Width;
      Top := _Form.ClientHeight - 30;
      Caption := '&' + SMsgDlgOK;
      ModalResult := mrOk;
    end;
    with TBitBtn.Create(_Form) do
    begin
      Parent := _Form;
      Left := (_Form.ClientWidth div 2);
      Top := _Form.ClientHeight - 30;
      Caption := '&' + SMsgDlgCancel;
      ModalResult := mrCancel;
    end;
    if _Form.ShowModal = mrOK then
    begin
      for i := 0 to HIGH(Edt) do
        Valor[i] := Edt[i].Value;
      Result := True;
    end;
  finally
    _Form.Free;
  end;
end;

procedure Valida_Cadastro(Form : TForm; DataSourse : TDataSource); //Criado para ñ mostrar messagem do Banco, caso tiver problemas é só alterar o "Required = False" //**David Rodrigo 19/09/2006
var i, j : Integer;
    Componente : TComponent;
    Campo : String;
begin

  for i := 0 to TIBDataSet(DataSourse.DataSet).FieldCount-1 do
  begin
    if (TIBDataSet(DataSourse.DataSet).Fields[i].Required) and
       (TIBDataSet(DataSourse.DataSet).Fields[i].AsString = NullAsStringValue) and
       (TIBDataSet(DataSourse.DataSet).Fields[i].FieldName <> 'CODIGO') and
       (TIBDataSet(DataSourse.DataSet).Fields[i].FieldKind = fkData) then
    begin
      Componente := nil;
      Campo := _SubStr(TIBDataSet(DataSourse.DataSet).Fields[i].DisplayLabel, ':', '');
      Campo := _SubStr(Campo, '_', ' ');
      Campo := Caixa_Mista(Campo);
      for j := 0 to Form.ComponentCount-1 do
      begin
        if Form.Components[j] is TDBCheckBox then
        begin
          if ((Form.Components[j] as TDBCheckBox).DataSource = DataSourse) and ((Form.Components[j] as TDBCheckBox).Field = TIBDataSet(DataSourse.DataSet).Fields[i]) then
            Componente := Form.Components[j];
        end
        else if Form.Components[j] is TDBComboBox then
        begin
          if ((Form.Components[j] as TDBComboBox).DataSource = DataSourse) and ((Form.Components[j] as TDBComboBox).Field = TIBDataSet(DataSourse.DataSet).Fields[i]) then
            Componente := Form.Components[j];
        end
