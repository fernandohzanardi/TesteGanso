    for B := Low(IdxBotao) to High(IdxBotao) do
      ButtonWidths[B] := 0;

    for B := Low(IdxBotao) to High(IdxBotao) do
    begin
      if (ButtonWidths[B] = 0) then
      begin
        TextRect := Rect(0,0,0,0);

        try
          LBStrBtn := TStringList.Create;
          LBStrBtn.Text := Trim(StringReplace(StrBotao[B],';;',#13,[rfReplaceAll]));

          for Ln := 0 to (LBStrBtn.Count - 1) do
          begin
            if (Length(LBStrBtn.Strings[Ln]) > Length(MaxStr)) then
              MaxStr := LBStrBtn.Strings[Ln];
          end;

          if (LBStrBtn.Count > MaxLineBreak) then
            MaxLineBreak := LBStrBtn.Count;
        finally
          LBStrBtn.Free;
        end;

        Windows.DrawText(Canvas.Handle, PChar(MaxStr), -1, TextRect, DT_CALCRECT or DT_LEFT or DT_SINGLELINE or DrawTextBiDiModeFlagsReadingOnly);
        ButtonWidths[B] := (TextRect.Right - TextRect.Left + 20);
      end;

      if (ButtonWidths[B] > ButtonWidth) then
        ButtonWidth := ButtonWidths[B];
    end;

    ButtonHeight := ((MulDiv(mcButtonHeight, DialogUnits.Y, 8) * MaxLineBreak) - (MaxLineBreak * 4));

    if (ButtonHeight < MulDiv(mcButtonHeight, DialogUnits.Y, 8)) then
      ButtonHeight := MulDiv(mcButtonHeight, DialogUnits.Y, 8);

    ButtonSpacing := MulDiv(mcButtonSpacing, DialogUnits.X, 4);
    SetRect(TextRect, 0, 0, Screen.Width div 2, 0);
    DrawText(Canvas.Handle, PChar(vMensagem), Length(vMensagem)+1, TextRect, DT_EXPANDTABS or DT_CALCRECT or DT_WORDBREAK or DrawTextBiDiModeFlagsReadingOnly);
    IconID := IconIDs[imIconeMensagem];
    IconTextWidth := TextRect.Right;
    IconTextHeight := TextRect.Bottom;

    if (IconID <> nil) then
    begin
      Inc(IconTextWidth, (32 + HorzSpacing));

      if (IconTextHeight < 32) then
        IconTextHeight := 32;
    end;

    for B := Low(IdxBotao) to High(IdxBotao) do
      if (IdxBotao[B] > 0) then
        Inc(ButtonCount);

    ButtonGroupWidth := 0;

    if (ButtonCount <> 0) then
      ButtonGroupWidth := (ButtonWidth * ButtonCount + ButtonSpacing * (ButtonCount - 1));

    ClientWidth := (Max(IconTextWidth, ButtonGroupWidth) + HorzMargin * 2);
    ClientHeight := (IconTextHeight + ButtonHeight + VertSpacing + VertMargin * 2);
    Left := ((Screen.Width div 2) - (Width div 2));
    Top := ((Screen.Height div 2) - (Height div 2));

    if (IconID <> nil) then
