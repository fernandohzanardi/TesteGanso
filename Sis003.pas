Function Mostra_ID_Report_Form(Form : String) : integer;
begin
  try
    DM.IBDForm.Close;
    DM.IBDForm.Params[0].AsString := Form;
    DM.IBDForm.Open;

    if DM.IBDForm.IsEmpty then
    begin
      DM.IBDForm.Insert;
      DM.IBDFormFORM.AsString := Form;
      DM.IBDFormPREVIEW.AsString := BoolToStr(True);
      DM.IBDForm.Post;
      Result := DM.IBDFormID.AsInteger;
      DM.IBDForm.Transaction.Commit;
    end
    else
      Result := DM.IBDFormID.AsInteger;
    DM.IBDForm.Close;
  except
    if DM.IBDForm.Active then
      DM.IBDForm.Close;
      
    if DM.IBDForm.Transaction.InTransaction then
      DM.IBDForm.Transaction.Rollback;
    Result := 0;
  end;
end;

