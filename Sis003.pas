Function BuscaPIDCCnxAppGS(_UsaCnxGanso : Boolean = True) : Integer;
var
  _IBDPID : TIBDatabase; _IBQPID : TIBQuery;  _IBTPID : TIBTransaction;
  _PathIni, _IPSrv, _PathDB : String;
  _FileIni : TIniFile;
  _CnxBDOk : Boolean;
begin
  Result := 0;
  if _UsaCnxGanso then
  begin
    _Cria_IBQuery(nil,999);
    try
      try
        _IBQuery999.Close;
        _IBQuery999.SQL.Text := 'select mon$remote_pid from mon$attachments where mon$attachment_id = current_connection';
        _IBQuery999.Open;
        Result := _IBQuery999.FieldByName('mon$remote_pid').AsInteger;
      except
      end;
    finally
      _Destroy_IBQuery(999);
    end;
  end
  else begin
    try
      try
        _PathIni := ExtractFilePath(Application.ExeName)+'Banco.INI';
        _FileIni := TIniFile.Create(_PathIni);
        _IPSrv := _FileIni.ReadString('CONFIG', 'ip_servidor', '');
        _PathDB := _FileIni.ReadString('CONFIG', 'caminho_banco', '');
      except
      end;
    finally
      _FileIni.Free;
    end;

    _IBDPID := TIBDatabase.Create(nil);
    _IBDPID.DatabaseName := _IPSrv+':'+_PathDB;
    _IBDPID.LoginPrompt := False;
    _IBDPID.Params.Values['lc_ctype'] := 'WIN1252';

    try
      _IBQPID := TIBQuery.Create(nil);
      _IBTPID := TIBTransaction.Create(nil);
      _IBTPID.Params.Add('read_committed');
      _IBTPID.Params.Add('rec_version');
      _IBTPID.Params.Add('nowait');
      _IBTPID.DefaultDatabase := _IBDPID;
      _IBQPID.Transaction := _IBTPID;
    except
    end;

    _CnxBDOk := False;

    try
      _IBDPID.Params.Values['user_name'] := UsSys;
      _IBDPID.Params.Values['password'] := PWSys;
      _IBDPID.Connected := True;
      _CnxBDOk := True;
    except
      _CnxBDOk := False;
    end;

    if not(_CnxBDOk) then
    begin
      try _IBDPID.Connected := False; except end;
      try
        _IBDPID.Params.Values['user_name'] := 'SYSDBA';
        _IBDPID.Params.Values['password'] := 'masterkey';
        _IBDPID.Connected := True;
        _CnxBDOk := True;
      except
      end;
    end;

    if _CnxBDOk then
    begin
      try
        _IBQPID.Close;
        _IBQPID.SQL.Text := 'select mon$remote_pid from mon$attachments where mon$attachment_id = current_connection';
        _IBQPID.Open;
        Result := _IBQPID.FieldByName('mon$remote_pid').AsInteger;
      except
      end;
    end;

    _IBQPID.Close; if _IBTPID.InTransaction then _IBTPID.Rollback; _IBQPID.Free; _IBTPID.Free;
    _IBDPID.CloseDataSets; _IBDPID.Connected := False; _IBDPID.Free;
