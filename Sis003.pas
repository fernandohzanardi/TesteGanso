constructor TMessageForm.CreateNew(AOwner: TComponent; pTempoTemporizadorMSG: Integer = 0);
var
  NonClientMetrics: TNonClientMetrics;
begin
  inherited CreateNew(AOwner);
  NonClientMetrics.cbSize := SizeOf(NonClientMetrics);

  if SystemParametersInfo(SPI_GETNONCLIENTMETRICS, 0, @NonClientMetrics, 0) then
    Font.Handle := CreateFontIndirect(NonClientMetrics.lfMessageFont);

  // Luiz Santana - 26/03/2026 - Programando temporizador para fechar a mensagem após "N" milessegundos
  if pTempoTemporizadorMSG > 0 then
  begin
    FTTemporizador := TTimer.Create(Self);
    FTTemporizador.Interval := pTempoTemporizadorMSG;
    FTTemporizador.OnTimer := TMessageFormOnTimer;
    FTTemporizador.Enabled := True;
  end;
end;


procedure TMessageForm.MaisDetalhesClick(Sender: TObject);
begin
  if (Self.lblSeta.Caption = '6') then //Seta pra baixo;
  begin
    Self.ClientHeight := (Self.ClientHeight + TMessageForm(Self).MessageEx.Height + 5);
    TMessageForm(Self).lblSeta.Caption := '5';
    TMessageForm(Self).lblDetalhes.Caption := ' Menos detalhes';
    TMessageForm(Self).MessageEx.Visible := True;
  end
  else
  if (Self.lblSeta.Caption = '5') then //Seta pra cima;
  begin
    TMessageForm(Self).MessageEx.Visible := False;
    TMessageForm(Self).lblSeta.Caption := '6';
    TMessageForm(Self).lblDetalhes.Caption := ' Mais detalhes';
    ClientHeight := Self.vHeightOriginal;
  end;

  Application.ProcessMessages;
end;

procedure TMessageForm.TMessageFormOnTimer(Sender: TObject);
var
  vActionClose : TCloseAction;
begin
  FTTemporizador.Enabled := False;
  Self.HelpContext := mrOK;
  EventoSaidaMensagem(Self,vActionClose);
end;

procedure TMessageForm.EventoBotaoMensagem(Sender: TObject);
begin
  ((Sender as TButton).Parent as TForm).HelpContext := (Sender as TButton).Tag;
  ((Sender as TButton).Parent as TForm).ModalResult := (Sender as TButton).Tag;
end;

procedure TMessageForm.EventoSaidaMensagem(Sender: TObject; var Action: TCloseAction);
begin
  if ((Sender as TForm).BorderIcons = []) and ((Sender as TForm).HelpContext < 0) then
  begin
    (Sender as TForm).ModalResult := -1;
    Action := caNone;
    Exit;
  end;

  (Sender as TForm).ModalResult := (Sender as TForm).HelpContext;
  (Sender as TForm).Release;
end;

procedure TMessageForm.EventoKeyDownMensagem(Sender: TObject; var Key: Word; Shift: TShiftState);
var
  vMsg: String;
  i: Integer;
begin
  if (Key = VK_ESCAPE) and ((Sender as TForm).BorderIcons = [biSystemMenu]) then
  begin
    (Sender as TForm).HelpContext := -1;
    (Sender as TForm).ModalResult := -1;
  end
  else
  if (Key = VK_F1) and (Assigned(Self.MessageEx)) then
  begin
    Self.MaisDetalhesClick(nil);
    Key := 0;
  end
  else
  if (Key in [67,99]) and (Shift = [ssCtrl]) then //Ctrl + C
  begin
    vMsg := '';

    for i := 0 to (Self.ComponentCount - 1) do
    begin
      if (Self.Components[i].ClassType = TButton) then
      begin
        if (vMsg = '') then
          vMsg := '[' + StringReplace((((Self.Components[i]) as TButton).Caption),#13,' ',[rfReplaceAll]) + ']'
        else
          vMsg := vMsg + '   [' + StringReplace((((Self.Components[i]) as TButton).Caption),#13,' ',[rfReplaceAll]) + ']';
      end;
    end;

    vMsg := '[ ' + Self.Caption + ' ]' + sLineBreak + sLineBreak +
            Self.Message.Caption + sLineBreak + sLineBreak +
            vMsg;

    if (Assigned(Self.MessageEx)) then
      vMsg := vMsg + sLineBreak + sLineBreak + Self.MessageEx.Lines.Text;

    Clipboard.SetTextBuf(PwideChar(vMsg));
    Key := 0;
  end; 
end;

Function ExecSQLScript(SQLScript: String; ChaveMD5: String = '') : String;
var
  i : Integer;
  _ScriptExecutar, _ScriptValidar, _VLCampoValidar, _Hash :String;
  vDesativarValidacao: Boolean;
begin
  Result := '';
  vDesativarValidacao := True;

//  ALTERE, INSIRA e APAGUE
  if (not vDesativarValidacao) then
    begin
    i :=1;
    _ScriptExecutar := StringReplace(UpperCase(SQLScript),'ALTERE', 'UPDATE',[rfReplaceAll]);
    _ScriptExecutar := StringReplace(UpperCase(_ScriptExecutar),'INSIRA', 'INSERT',[rfReplaceAll]);
    _ScriptExecutar := StringReplace(UpperCase(_ScriptExecutar),'APAGUE', 'DELETE',[rfReplaceAll]);
    _ScriptValidar  := UpperCase(_ScriptExecutar);
    while PosEx('</',_ScriptExecutar) > 0 do
    begin
      _VLCampoValidar := copy(_ScriptExecutar,Pos(('<'+IntToStr(i)+'>'),_ScriptExecutar),
                                              PosEx(('</'+IntToStr(i)+'>'),_ScriptExecutar)+length(IntToStr(i))+3
                                             -Pos(('<'+IntToStr(i)+'>'),_ScriptExecutar));

      if((Pos('UPDATE',_VLCampoValidar)>0)or(Pos('INSERT',_VLCampoValidar)>0)or(Pos('DELETE',_VLCampoValidar)>0))then
      begin
        if ((Pos('UPDATE NOTA_FISCAL',_VLCampoValidar)=0)or(Pos('UPDATE NOTA_FISCAL_ITEM',_VLCampoValidar)=0)) then
        begin
          Result := 'Script não executado! Formação do SQL não está de acordo com o padrão estabelecido pelo desenvolvimento!';
          Exit;
        end;
      end;

      _ScriptExecutar := StringReplace(_ScriptExecutar,'<'+IntToStr(i)+'>','',[rfIgnoreCase]);
      _ScriptExecutar := StringReplace(_ScriptExecutar,'</'+IntToStr(i)+'>','',[rfIgnoreCase]);
      _ScriptValidar := StringReplace(_ScriptValidar,_VLCampoValidar,'',[rfReplaceAll]);
      i := i+1;
    end;
    //Retorna a palavra original para gerar o MD5
    _ScriptValidar := StringReplace(_ScriptValidar,'UPDATE','ALTERE',[rfReplaceAll]);
    _ScriptValidar := StringReplace(_ScriptValidar,'INSERT','INSIRA',[rfReplaceAll]);
    _ScriptValidar := StringReplace(_ScriptValidar,'DELETE','APAGUE',[rfReplaceAll]);

    _ScriptValidar := StringReplace(_ScriptValidar,' ','',[rfReplaceAll]);
    _ScriptValidar := StringReplace(_ScriptValidar,#13,'',[rfReplaceAll]);
    _ScriptValidar := StringReplace(_ScriptValidar,#10,'',[rfReplaceAll]);
    _Hash := MD5Print(MD5String(Trim(_ScriptValidar)+'B1u8rMOHkkl7yZ1X7k0pvZhylQHcxCexgXmD/ODyj5J3Yh2RKOleMgz5QwZJIYB'));
  end
  else
    _ScriptExecutar := SQLScript;

  if (trim(_Hash) = Trim(ChaveMD5)) or (vDesativarValidacao) then
  begin
    try
      try
        _Cria_IBQuery(nil,999);
        if not(_IBQuery999.Transaction.InTransaction) then
          _IBQuery999.Transaction.StartTransaction;
        _IBQuery999.SQL.Text := _ScriptExecutar;
        _IBQuery999.ExecSQL;
        _IBQuery999.Transaction.Commit;
      except
        on _ErrQ : Exception do
        begin
          Result := _ErrQ.Message;
          if not(_IBQuery999.Transaction.InTransaction) then
            _IBQuery999.Transaction.Rollback;
        end;
      end;
    finally
      _Destroy_IBQuery(999);
    end;
  end;
end;

