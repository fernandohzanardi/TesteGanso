    Abort;
end;

function EnviarEmail(_Assunto, _Address, _To, _Username, _Password, _Anexo, _Msg: String; var _Erro: String; _Conf: Boolean; _ReplyTo: String = ''; _NomeIdentEmail : String = ''; _SMTPOutro : String = ''; _PortaOutro : Integer = 0): Boolean;
var
  IdTLSAuth: TIdSSLIOHandlerSocketOpenSSL;
  SMTP: TIdSMTP;
  IdMsgSend: TIdMessage;
  _EMailGanso : Boolean;
begin
  // Criação dos componentes em RunTime
  IdTLSAuth := TIdSSLIOHandlerSocketOpenSSL.Create;
  SMTP := TIdSMTP.Create;
  IdMsgSend := TIdMessage.Create(nil);
  SMTP.IOHandler := IdTLSAuth;

  _Erro := '';
  try
    if SMTP.Connected then
      SMTP.Disconnect;

    IdMsgSend.Clear;

    with TIdText.Create(IdMsgSend.MessageParts, nil) do
    begin
      Body.Text := _msg;
      ContentType := 'text/html';
    end;

    if (_anexo <> '') and (FileExists(_anexo)) then
    begin
      with TIdAttachmentFile.Create(IdMsgSend.MessageParts,_anexo) do
      begin
        //ContentType := 'pdf/application'; Luiz Santana - 26/08/2013 - Comentado a pedido do Gustavo
        FileName := ExtractFileName(_anexo);
      end;
    end;

    _EMailGanso := (_Address = Decrypt('91P8N5yuGpBoGSP1YxeSHIkDRNK2jXYNPA',3628));
    //Preparação dos dados da mensagem
    with IdMsgSend do
    begin
      ContentType := 'multipart/mixed';
      Body.Text := '';
      From.Address := _Address;
      if Trim(_NomeIdentEmail) <> '' then
        From.Name := _NomeIdentEmail
      else
        From.Name := _Address;
      ReplyTo.EMailAddresses := _ReplyTo;
      Recipients.EMailAddresses := _To;
      Subject := _Assunto;
      if _conf then
        ReceiptRecipient.Text := _Address
      else
        ReceiptRecipient.Text := '';
    end;
  except
    on e : Exception do
    begin
      Result := False;
      _Erro := e.Message;
      try
        IdTLSAuth.Free;
        SMTP.Free;
        IdMsgSend.Free;
      except
      end;
      Exit;
    end;
  end;

  //Configuração do SMTP
  try
    // Luiz Santana - 15/12/2016 (Criado parâmetro SMTPOutro e PortaOutro para emails do Ganso que serão utilizados email padrão da Amazon)
    if (_SMTPOutro <> '') and (_PortaOutro > 0) then
    begin
      SMTP.Host := _SMTPOutro;
      SMTP.Port := _PortaOutro;
    end
    else begin
      SMTP.Host := _ParEMailSMTP;
      SMTP.Port := _ParEMailPorta;
    end;
    SMTP.AuthType := satDefault;

    if _ParEMailRequerAutenticacao or _EMailGanso then //Caso usa TLS, entra e define os parâmetros 
    begin
      SMTP.IOHandler := IdTLSAuth;

      // Luiz Santana - 15/12/2016 (Criado parâmetro SMTPOutro e PortaOutro para emails do Ganso que serão utilizados email padrão da Amazon)
      if (_PortaOutro > 0) then
        IdTLSAuth.Port := _PortaOutro
      else
        IdTLSAuth.Port := _ParEMailPorta;

      SMTP.Username := _username;
      SMTP.Password := _password;
      SMTP.UseTLS := utUseExplicitTLS;
      IdTLSAuth.SSLOptions.Method := sslvSSLv23;
      IdTLSAuth.SSLOptions.Mode := sslmBoth;
    end
    else //Caso não use TLS, ignora o que foi escolhido no form e define por padrão os dados para não usar
    begin
      SMTP.IOHandler := nil;
      SMTP.Username := '';
      SMTP.Password := '';
      SMTP.UseTLS := utNoTLSSupport;

      SMTP.IOHandler := nil;
      SMTP.UseTLS := utNoTLSSupport;
    end;

    SMTP.ConnectTimeout := 15000;
    SMTP.ReadTimeout    := 25000;

    //Conexão
    if not(SMTP.Connected) then
    begin
      SMTP.Connect;

      //Autenticação
      try
        if (_ParEMailRequerAutenticacao or _EMailGanso) and not(SMTP.DidAuthenticate)  then
          SMTP.Authenticate;
      except
        // Luiz Santana - 06/02/2017 - Após várias tentativas para resolver o problema que só envia email na segunda tentativa, consegui "resolver" esse problema
        //                             desconectando, conectando e autenticando novamente o SMTP caso haja falha na 1ª Autenticação
        SMTP.Disconnect;
        SMTP.Connect;
        //Autenticação
        if (_ParEMailRequerAutenticacao or _EMailGanso) and not(SMTP.DidAuthenticate)  then
          SMTP.Authenticate;
      end;
    end;
  except
    on e : exception do
    begin
      if SMTP.Connected then
      begin
        try
          SMTP.Disconnect;
        except
          Result := False;
          _Erro := e.Message;
          try
            IdTLSAuth.Free;
            SMTP.Free;
            IdMsgSend.Free;
          except
          end;
          Exit;
        end;
      end;
      Result := False;
      _Erro := e.Message;
      try
        IdTLSAuth.Free;
        SMTP.Free;
        IdMsgSend.Free;
      except
      end;
      Exit;
    end;
  end;

  //Tenta enviar a mensagem - Caso dê algum problema (provavelmente time out) joga pro except,
  //mas de qualquer forma destroi os componentes
  try
    try
      SMTP.Send(IdMsgSend);
      Result := True;
    finally
      //Tenta fechar a conexão antes de destruir o componente
      if SMTP.Connected then
      begin
        try
          SMTP.Disconnect;
        except
          on e: Exception do
          begin
            Result := False;
            _Erro := e.Message;
          end;
        end;
      end;
      //Destoi os componentes, que evita o erro "Connection Gracefully Closed" Independente se deu erro ou não
      IdTLSAuth.Free;
      SMTP.Free;
      IdMsgSend.Free;
    end;
  except
    on e : Exception do
    begin
      Result := False;
      _Erro := e.Message;
    end;
  end;
end;

function StrToInteiro(valor : String): Integer;
begin
  Result := Max(StrToIntDef(valor,0),0);
end;

function StrToFlutuante(valor : String): Integer;
var i : Integer;
    retorno : String;
begin
  if valor = '' then
    Result := 0
  else
  begin
    for i := 0 to length(valor) do
    begin
      if valor[i] in ['0'..'9'] then
        retorno := retorno + valor[i];
    end;
    if retorno = '' then
      Result := 0
    else
      Result := StrtoInt(retorno);
  end;

end;


