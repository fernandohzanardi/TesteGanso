Function TrataCST_IPI(_CSTIPI : String; _TipoES : String) : Integer;
begin
  Result := 5; // Result 5 significa OK ou Vazio
  if Trim(_CSTIPI) = '' then Exit;

  if (StrLen(pChar(Trim(_CSTIPI))) > 2) then
  begin
    Result := -0;
    Exit;
  end;

  if (_TipoES = 'E') then // IPI de Entrada
  begin
    if not(_CSTIPI[1] in ['0', '4']) then
      Result := 1
    else if ((not(_CSTIPI[2] in ['0', '1', '2', '3', '4', '5', '9']))
          or((_CSTIPI[1] in ['0'])and(not(_CSTIPI[2] in ['0', '1', '2', '3', '4', '5'])))
          or((_CSTIPI[1] in ['4'])and(_CSTIPI[2] <> '9')) ) then
      Result := 2;
  end
  else if (_TipoES = 'S') then // IPI de Saída
  begin
    if not(_CSTIPI[1] in ['5', '9']) then
      Result := 1
    else if ((not(_CSTIPI[2] in ['0', '1', '2', '3', '4', '5', '9']))
          or((_CSTIPI[1] in ['5'])and(not(_CSTIPI[2] in ['0', '1', '2', '3', '4', '5'])))
          or((_CSTIPI[1] in ['9'])and(_CSTIPI[2] <> '9')) ) then
      Result := 2;
  end;
end;

procedure GravarChaveAcessoNFe(vID: Integer = 0; vNumeroNF: Integer = 0; vSerieNF : String = ''; vChaveAcesso: String = '');
var
  ibsUpdate: TIBSQL;
  ibtTransaction: TIBTransaction;
begin
  //Gravar Chave de Acesso da NF-e;

  if (_ParNFTipoEmissao <> 'E') or (_ParNFE_SolicitarChaveAcesso <> 'S') then
    Exit;

  if ((Trim(vChaveAcesso) = '') and (vID = 0)) or ((Trim(vChaveAcesso) = '') and (vNumeroNF > 0)) then
    Exit;

  ibsUpdate := TIBSQL.Create(nil);
  ibtTransaction := TIBTransaction.Create(nil);

  ibtTransaction.Params.Clear;
  ibtTransaction.Params.Add('read_committed');
  ibtTransaction.Params.Add('rec_version');
  ibtTransaction.Params.Add('nowait');
  ibtTransaction.DefaultDatabase := DM.IBbanco;
  ibsUpdate.Transaction := ibtTransaction;
  ibsUpdate.Database := DM.IBbanco;

  if (vID > 0) then
  begin
    try
      vChaveAcesso := Trim(InputBox('Nota Fiscal Eletrônica','Chave de Acesso gerada no Emissor de NF-e:',''));

      if (vChaveAcesso = '') then
      begin
        Application.MessageBox('Para gravar a Chave de Acesso posteriormente acesse o menu Utilitários -> Importar Chave de Acesso da NF-e.','ATENÇÃO',MB_OK+MB_ICONINFORMATION);
        Exit;
      end;

      if (StrLen(PChar(vChaveAcesso)) <> 44) then
      begin
        Application.MessageBox(PChar('Chave de acesso inválida. A chave deve conter 44 dígitos.' +#13+
                                     'Para gravar a Chave de Acesso acesse o menu Utilitários -> Importar Chave de Acesso da NF-e.'),'ATENÇÃO',MB_OK+MB_ICONINFORMATION);
        Exit;
      end;

      ibtTransaction.StartTransaction;
      ibsUpdate.SQL.Text := 'update nota_fiscal nf set nf.chave_acesso_nfe = ' + QuotedStr(vChaveAcesso) + ' where nf.codigo = ' + IntToStr(vID);
      ibsUpdate.ExecQuery;
      ibtTransaction.Commit;
    except
      on E: Exception do
      begin
        Application.MessageBox(PChar('Houve falha ao tentar gravar a Chave de Acesso.' +#13+
                                     'Para gravar a Chave de Acesso acesse o menu Utilitários -> Importar Chave de Acesso da NF-e.' +#13+#13+ 
                                     E.Message),'ATENÇÃO',MB_OK+MB_ICONINFORMATION);
        Exit;
      end;
    end;
  end
  else
  if (vNumeroNF > 0) then
  begin
    try
      ibsUpdate.SQL.Text := 'update nota_fiscal nf set nf.chave_acesso_nfe = ' + QuotedStr(vChaveAcesso) + ' where nf.numero_nf = ' + IntToStr(vNumeroNF) + ' and nf.serie = ' + QuotedStr(vSerieNF) + ' and nf.status = ''E''';
      ibsUpdate.ExecQuery;
      ibtTransaction.Commit;
    except
      Application.MessageBox('Houve falha ao tentar gravar a Chave de Acesso.','ATENÇÃO',MB_OK+MB_ICONINFORMATION);
      Exit;
    end;                        
  end;

  ibsUpdate.Free;
  if ibtTransaction.InTransaction then ibtTransaction.Rollback;
  ibtTransaction.Free;
end;

