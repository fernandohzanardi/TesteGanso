    // Checando e criando generator para controle do sequencial por Filial
    _IBQuery999.Close;
    _IBQuery999.SQL.Text := ' select g.rdb$generator_name from rdb$generators g where g.rdb$generator_name = '+QuotedStr('GEN_IDENTORC_FIL'+FormatFloat('000',_CodFilial));
    _IBQuery999.Open;

    if _IBQuery999.IsEmpty then
    begin
      _IBQuery999.Close;
      _IBQuery999.SQL.Text := 'CREATE GENERATOR GEN_IDENTORC_FIL'+FormatFloat('000',_CodFilial);
      try
        _IBQuery999.ExecSQL;
        _IBQuery999.Transaction.Commit;
      except
      end;
    end;

    _IBQuery999.Close;
