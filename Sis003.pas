procedure TCfg.Drop(pLocal: TLocalCfg; pURI: String; var vReturnCode: Integer);
var
  fINI: TIniFile;
  fDB: TMemIniFile;
  StrList: TStringList;
  r: TRegistry;
  dc: TDataContext;
  p, s: String;
begin
  {
    ### Classe criada para prover manipulação mais prática de configurações para objetos em Run-Time;
    ### 26.08.2015 - Marcio Rodrigues (Projeto DF-e)

    ### Nota: - Cuidado ao utilizar esta função em laço de repetição, pois a performance pode cair ao acessar arquivos muito grande ou o banco de dados.
              - ATENÇÃO para "lcINIDB": Se precisar utilizar no Firebird 1.5 então deve ser feita uma compatibilização.
              - ATENÇÃO para "lcReg": Foi programado para apagar um valor de cada vez, se precisar apagar chaves inteiras é necessário implementar.


    ### [lcINI] - Arquivo INI ###

    []:FILIAL_0001\Chave1  ->  Acessa o arquivo "Banco.INI", padrão do Ganso, e apaga o valor "Chave1" da sessão "FILIAL_0001".
    [C:\Ganso\Outro.INI]:Grupo1\Chave2  ->  Acessa um arquivo específico pelo caminho absoluto, e apaga o valor "Chave2" da sessão "Grupo1".

    []:FILIAL_0001  ->  Acessa o arquivo "Banco.INI", padrão do Ganso, e apaga toda a sessão "FILIAL_0001", inclusive seus valores.
    [C:\Ganso\Outro.INI]:Grupo1  ->  Acessa um arquivo específico pelo caminho absoluto, e apaga toda a sessão "Grupo1", inclusive seus valores.


    ### [lcINIDB] - Banco de Dados (INI) ###

    [REG_ID]:FILIAL_0001\Chave1  ->  Selecionar o registro indicado em "REG_ID" e apaga o valor "Chave1" da sessão "FILIAL_0001".
    [REG_ID]:FILIAL_0001  ->  Selecionar o registro indicado em "REG_ID" e apaga toda a sessão "FILIAL_0001".


    ### [lcReg] - Registro do Windows ###

    [HKEY_CURRENT_USER]:Grupo1\Subgrupo\Subgrupo\Valor3  ->  Apaga apenas o valor "Valor3" armazenado no caminho especificado.
  }

  try
    p := '';
    s := '';

    if (CheckURI(pLocal, pURI) > 0) then
      Exit;

    p := CopyStrInTag(Trim(pURI), '[', ']');

    if (pLocal = lcINI) then
    begin
      if (Trim(p) = '') or (LowerCase(Trim(p)) = 'ganso') or (LowerCase(Trim(p)) = 'path') then
        p := ExtractFilePath(Application.ExeName) + '\Banco.ini';

      if (not FileExists(p)) then
      begin
        //Se o arquivo não existir, retorna o valor padrão e sai;
        vReturnCode := 6;
        Exit;
      end;

      dc := SetINIContext(pURI);

      try
        fINI := TIniFile.Create(p);

        if (dc.dcINI_Ident <> '') then
        begin
          if (fINI.ValueExists(dc.dcINI_Sessao, dc.dcINI_Ident)) then
            fINI.DeleteKey(dc.dcINI_Sessao, dc.dcINI_Ident);
        end
        else
        if (fINI.SectionExists(dc.dcINI_Sessao)) then
          fINI.EraseSection(dc.dcINI_Sessao);
      finally
        fINI.Free;
      end;
    end
    else
    if (pLocal = lcINIDB) then
    begin
      if (p = '') then
      begin
        vReturnCode := 8;
        raise Exception.Create('O identificador do registro de configuração não foi informado.');
      end;

      s := coalesce(GetQryResult('select ini_file from ibe$f_config where (id = ''' + p + ''')'),'');{ TODO -oWéliton : Conversão XE }

      if (s = '') then
      begin
        vReturnCode := 9; //Registro de configuração não encontrado.
        Exit;
      end;

      try
        StrList := TStringList.Create;
        StrList.Clear;
        StrList.Text := s;

        fDB := TMemIniFile.Create('');
        fDB.SetStrings(StrList);

        dc := SetINIContext(pURI);;

        if (dc.dcINI_Ident <> '') then
        begin
          if (fDB.ValueExists(dc.dcINI_Sessao, dc.dcINI_Ident)) then
            fDB.DeleteKey(dc.dcINI_Sessao, dc.dcINI_Ident);
        end
        else
        if (fDB.SectionExists(dc.dcINI_Sessao)) then
          fDB.EraseSection(dc.dcINI_Sessao);

        StrList.Clear;
        fDB.GetStrings(StrList);

        //ATENÇÃO: Se precisar utilizar no Firebird 1.5 então deve ser feita uma compatibilização.
        ExecCmdSQL('update or insert into ibe$f_config (id, ini_file) values (' + QuotedStr(p) + ', ' + QuotedStr(StrList.GetText) + ')');
      finally
        StrList.Free;
        fDB.Free;
      end;
    end
    else
    if (pLocal = lcReg) then
    begin
      //ATENÇÃO: Este parâmetro apaga apenas um valor de cada vez, se precisar apagar chaves inteiras é necessário implementar;

      if (p = '') then
        raise Exception.Create('O endereço raiz não foi informado.');

      //O usuário sempre tem acesso a sua configuração raiz (HKEY_CURRENT_USER) e algumas do computador (HKEY_LOCAL_MACHINE), mas pode não ter de outras raizes.
      //Se precisar acessar outros locais é necessário uma análise e adição no conjunto abaixo.

      if (Pos((',' + UpperCase(p) + ','), ',HKEY_CURRENT_USER,HKEY_LOCAL_MACHINE,') <= 0) then
        raise Exception.Create('O endereço raiz informado não é permitido.');

      s := Trim(Copy(pURI, (Pos(':', pURI) + 1), Length(pURI)));

      if (s = '') then
        raise Exception.Create('O endereço da chave de configuração não foi informado.');

      try
        r := TRegistry.Create;

        if (p = 'HKEY_CURRENT_USER') then
          r.RootKey := HKEY_CURRENT_USER
        else
        if (p = 'HKEY_LOCAL_MACHINE') then
          r.RootKey := HKEY_LOCAL_MACHINE
        else
          raise Exception.Create('O endereço raiz é inválido.');

        dc := SetRegContext(pURI);

        if (r.KeyExists(dc.dcREG_Chave)) then
          r.OpenKey(dc.dcREG_Chave, False);

        if (dc.dcREG_Valor <> '') then
          r.DeleteValue(dc.dcREG_Valor);
      finally
        r.Free;
      end;
    end;
  finally
    Free;
  end;
end;

procedure FormataMascaraFone(Sender: TObject);
begin
  //Procedure Formatar máscara telefone ao sair do dbedit
  if (TDBEdit(sender).Field <> nil) then
  begin
    if (Length(Trim(TDBEdit(sender).Field.AsString)) = 10) then
      TDBEdit(sender).Field.EditMask := '(99) 9999-9999;0'
    else
    if (Length(Trim(TDBEdit(sender).Field.AsString)) = 11) then
      TDBEdit(sender).Field.EditMask := '(99) 99999-9999;0'
    else
      TDBEdit(sender).Field.EditMask := '';
  end;
end;

procedure FormataMaskCPF_CNPJ(Sender: TObject);
begin
  //Procedure Formatar máscara CPF_CNPJ ao sair do dbedit
  if (Length(Trim(TDBEdit(sender).Field.AsString)) = 11) then
    TDBEdit(sender).Field.EditMask := '999.999.999-99;0'
  else
  if (Length(Trim(TDBEdit(sender).Field.AsString)) = 14) then
    TDBEdit(sender).Field.EditMask := 'aa.aaa.aaa/aaaa-99;0'
  else
    TDBEdit(sender).Field.EditMask := '';
end;

