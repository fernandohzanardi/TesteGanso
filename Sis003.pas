        _IBQuery999.ExecSQL;
        _IBQuery999.Transaction.Commit;
      except
      end;
    end
    else begin
      _ProximaPV := _IBQuery999.FieldByName('GEN_PV').AsInteger;

      if StrToInt(RightStr(IntToStr(_ProximaPV),8)) >= 99999999 then // Reiniciando a numeração e Mudando a Série (1º Dígito)
      begin
        _ReiniciaNPV := StrToInt(IntToStr(StrToInt(LeftStr(IntToStr(_ProximaPV),1))+1)+FormatFloat('0',_CodFilial)+'00000000');
        _IBQuery999.Close;
        _IBQuery999.SQL.Text := 'SET GENERATOR GEN_PV_FILIAL'+FormatFloat('000',_CodFilial)+' TO '+IntToStr(_ReiniciaNPV);
        try
          _IBQuery999.ExecSQL;
          _IBQuery999.Transaction.Commit;
        except
