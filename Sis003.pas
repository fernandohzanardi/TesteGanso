function DataKPC : String;
var
  _PCLPCModelProc, _PCLPCNomFab, _PCLPCSrFisHD, _PCLPCSrBios, _PCLPCSrMTB, _PCLPCModelHD, _PCLPCModelPC : String;
begin
  Result := '';
  try
    _PCLPCModelProc := Trim(MagWmiGetProcInfo('Name')); // Modelo do processador
  except
    _PCLPCModelProc := '';
  end;
  try
    _PCLPCNomFab := Trim(dllWmiGetSrBIOS('Manufacturer')); // Nome do montador/OEM
  except
    _PCLPCNomFab := '';
  end;

  try
    _PCLPCSrFisHD := Trim(dllWmiGetPhysicalHD(0)); // Serial físico do HD
  except
    _PCLPCSrFisHD := '';
  end;

  try
    _PCLPCSrBios := Trim(dllWmiGetSrBIOS('SerialNumber')); // Serial da BIOS
  except
    _PCLPCSrBios := '';
  end;

  try
    _PCLPCSrMTB := Trim(dllWmiGetBaseBoard('SerialNumber')); // Serial da placa mãe
  except
    _PCLPCSrMTB := '';
  end;

  try
    _PCLPCModelHD := Trim(dllWmiGetProcHD('Model')); // Modelo do HD
  except
    _PCLPCModelHD := '';
  end;

  try
    _PCLPCModelPC := Trim(dllWmiGetCompSystem('Model')); // Modelo do PC
  except
    _PCLPCModelPC := '';
  end;

  Result := _PCLPCModelProc+'|'
          + _PCLPCNomFab+'|'
          + _PCLPCSrFisHD+'|'
          + _PCLPCSrBios+'|'
          + _PCLPCSrMTB+'|'
          + _PCLPCModelHD+'|'
          + _PCLPCModelPC;

end;

procedure ForceKillProcess(hWindowHandle: HWND);
var
  hprocessID: INTEGER;
  processHandle: THandle;
  DWResult: DWORD;
begin
  if _ModKillProc = 1 then
  begin
    // Luiz Santana - 12/06/2018
    // SendMessageTimeout(hWindowHandle, WM_CLOSE, 0, 0, SMTO_ABORTIFHUNG or SMTO_NORMAL, 5000, DWResult); // Essa linha faz o aplicativo sair normalmente,
    //                    sem forçar, Ex: Se utilizar esse processo para o Ganso Sistema passa pelo close fazendo pergunta se deseja finalizar o Ganso
    if isWindow(hWindowHandle) then
    begin
      { Get the process identifier for the window}
      GetWindowThreadProcessID(hWindowHandle, @hprocessID);
      if hprocessID <> 0 then
      begin
        { Get the process handle }
        processHandle := OpenProcess(PROCESS_TERMINATE or PROCESS_QUERY_INFORMATION, False, hprocessID);
        //processHandle := OpenProcess(PROCESS_TERMINATE, False, hprocessID);
        if processHandle <> 0 then
        begin
          { Terminate the process }
          TerminateProcess(processHandle, 0);
          CloseHandle(ProcessHandle);
        end;
      end;
    end;
  end
  else if _ModKillProc = 2 then
  begin
    TerminateProcess(GetCurrentProcess, 0);
  end;
end;

