function fnMontarCaixaMensagem(const vTitulo, vMensagem, vMsgEx: String; imIconeMensagem: TIconeMensagem; IdxBotao: array of Integer; StrBotao: array of String; BotaoPadrao: Integer = 1; PermiteFechar: Boolean = False; TemporizadorFechaMSG: Integer = 0): TForm;
  function GetAveCharSize(Canvas: TCanvas): TPoint;
  var
    I: Integer;
    Buffer: array[0..51] of Char;
  begin
    for I := 0 to 25 do
      Buffer[I] := Chr(I + Ord('A'));

    for I := 0 to 25 do
      Buffer[I + 26] := Chr(I + Ord('a'));

    GetTextExtentPoint(Canvas.Handle, Buffer, 52, TSize(Result));
    Result.X := (Result.X div 52) + 5;
  end;

const
  mcHorzMargin = 8;
  mcVertMargin = 8;
  mcHorzSpacing = 10;
  mcVertSpacing = 10;
  mcButtonWidth = 50;
  mcButtonHeight = 14;
  mcButtonSpacing = 2;
var
  DialogUnits: TPoint;
  HorzMargin, VertMargin, HorzSpacing, VertSpacing, ButtonWidth, ButtonHeight, ButtonSpacing, ButtonCount, ButtonGroupWidth,
  IconTextWidth, IconTextHeight, X, ALeft, B, vTabOrder, IdxCmpPadrao, MaxLineBreak, Ln: Integer;
  MaxStr: String;
  IconID: PChar;
  TextRect: TRect;
  LBStrBtn: TStringList;
begin
  //Função desenvolvida a partir da função original "CreateMessageDialog" da biblioteca "Dialog";
  //Nunca chamar diretamente a função "fnMontarCaixaMensagem", chamar somente a função "ExibirMensagem()";
  //Marcio Rodrigues - 26/12/2012

  Result := TMessageForm.CreateNew(Application, TemporizadorFechaMSG);
  IdxCmpPadrao := -1;
  MaxStr := '';
  MaxLineBreak := 0;
  vTabOrder := 0;
  ButtonCount := 0;

  with Result do
  begin
    Caption := vTitulo;
    BiDiMode := Application.BiDiMode;
    BorderStyle := bsDialog;
    Canvas.Font := Font;
    KeyPreview := True;
    DialogUnits := GetAveCharSize(Canvas);
    HorzMargin := MulDiv(mcHorzMargin, DialogUnits.X, 4);
    VertMargin := MulDiv(mcVertMargin, DialogUnits.Y, 8);
    HorzSpacing := MulDiv(mcHorzSpacing, DialogUnits.X, 4);
    VertSpacing := MulDiv(mcVertSpacing, DialogUnits.Y, 8);
    ButtonWidth := MulDiv(mcButtonWidth, DialogUnits.X, 4);
