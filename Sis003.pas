Procedure GeraMensagem(Mensagem : string; Condicao : Boolean = True; WinControl : TWinControl = nil; Abortar : Boolean = True);
var
  Flag : Integer;
begin
  if not Condicao then
    Exit;

  case Abortar of
     True: Flag := MB_ICONEXCLAMATION;
    False: Flag := MB_ICONINFORMATION;
  end;

  Application.MessageBox(pchar(Mensagem), 'ATENÇÃO', MB_OK + Flag);
  if Assigned(WinControl) and WinControl.CanFocus then
  begin
    try
      WinControl.SetFocus;
    except
    end;
  end;

  if Abortar then
    Abort;
end;

function _SubStr(Text,Busca,Troca : string) : string;
{ Substitui um caractere dentro da string}
var n : integer;
begin
  for n := 1 to length(Text) do
  begin
    if Copy(Text,n,1) = Busca then
    begin
      Delete(Text,n,1);
      Insert(Troca,Text,n);
    end;
  end;
  Result := Text;
end;

