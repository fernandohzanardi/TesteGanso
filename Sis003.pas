Procedure BuscaParFinalizador(_CodigoFinalizador : Integer ; _Resetar : Boolean = False ; _Segundo : Boolean = False);
begin
  // Buscando o Caixa Padrão do Usuário na Filial Logada
  if not(_Resetar) then
  begin
    _Cria_IBQuery(nil,999);
    _IBQuery999.Close;
    with _IBQuery999 do
