Procedure ExibeConjugados(_HdwCpt : LongWord; _ConsProdConjIDProd, _ConsProdConjIDEst : Integer);
var
  _TextoHint : String;
begin
  if (_ConsProdConjIDProd > 0) then
  begin
    _Cria_IBQuery(nil,999);
    try
      _IBQuery999.Close;
      _IBQuery999.SQL.Text := ' select distinct p.codigo, p.codigo_barra, p.cod_marca,  p.descricao, pp.preco_venda, '
                             +'        coalesce(ep.estoque,0) - coalesce(ep.estoque_reservado,0) - (case when coalesce((select par.estoque_cons_aretpresumido from parametros par where par.codigo_filial = e.codigo_filial),''N'') = ''S'' then ep.estoque_aretirar else 0 end) as "ESTOQUE", '
                             +'        pa.codigo as "CODIGO_PRODCONJ", p.ref_produto_auxiliar, pm.descricao as "MARCA", p.ref_produto_fornec '
                             +' from produto_conjugado pa '
                             +' join produto p on ((pa.conjugado2 = p.codigo and p.codigo <> :pCodProduto) or (pa.conjugado1 = p.codigo and p.codigo <> :pCodProduto)) '
                             +' join estoque_produto ep on (ep.codigo_produto = p.codigo and ep.codigo_estoque = :pcodestoque) '
                             +' join estoque e on (e.codigo = ep.codigo_estoque) '
                             +' left join produto_marca pm on(pm.codigo = p.cod_marca) '
                             +' left join produto_parametros pp on (pp.codigo_produto = p.codigo) and (pp.codigo_filial = '+inttoStr(_CodFilial)+') '
                             +' where (conjugado1 = :pCodProduto or (conjugado2 = :pCodProduto and espelhar = 1)) '
                             +' order by p.descricao ' ;
      _IBQuery999.ParamByName('pCodProduto').AsInteger := _ConsProdConjIDProd;
      _IBQuery999.ParamByName('pCodEstoque').AsInteger := _ConsProdConjIDEst;
      _IBQuery999.Open;
      if not(_IBQuery999.IsEmpty) then
      begin
        _IBQuery999.First;
        _TextoHint := '';

        while not(_IBQuery999.Eof) do
        begin
          _TextoHint := _TextoHint +#13
                     + FormatFloat('000000000',_IBQuery999.FieldByName('codigo').AsCurrency) + ' - ' + _IBQuery999.FieldByName('descricao').AsString + IIF(Trim(_IBQuery999.FieldByName('marca').AsString) <> '',' ('+_IBQuery999.FieldByName('marca').AsString+') ','')
               +'   '+ 'Preço Venda: '+FormatSettings.CurrencyString+FormatCurr(' ,0.00',_IBQuery999.FieldByName('preco_venda').AsCurrency)
               +'   '+ 'Estoque: '+FormatCurr(' ,0.000',_IBQuery999.FieldByName('estoque').AsCurrency)
               +IIF(Trim(_IBQuery999.FieldByName('ref_produto_auxiliar').AsString) <> '','   Ref.Auxiliar: '+_IBQuery999.FieldByName('ref_produto_auxiliar').AsString,'')
               +IIF(Trim(_IBQuery999.FieldByName('ref_produto_fornec').AsString) <> '','   Ref.Fornecedor: '+_IBQuery999.FieldByName('ref_produto_fornec').AsString,'');
          _IBQuery999.Next;
        end;

        _TextoHint := 'Produtos Conjugados:' + #13 + _TextoHint;

        ShowBalloonTip(_HdwCpt, _TextoHint, imInformacao, StrLen(pChar(_TextoHint)));
      end;
    finally
      _IBQuery999.Close;
      if _IBQuery999.Transaction.InTransaction then
        _IBQuery999.Transaction.Rollback;
      _Destroy_IBQuery(999);
    end;
  end;
end;

