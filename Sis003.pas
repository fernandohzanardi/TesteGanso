Procedure AlertaBarra(Wnd: HWND; Count: Integer; StopNow: Boolean);
var
  Flash: TFlashWInfo;
begin
  try
    with Flash do
    begin
      cbSize := SizeOf(Flash);
      hwnd := Wnd;
      if StopNow then
        dwFlags := FLASHW_STOP
      else
      begin
        if Count = 0 then
          dwFlags := FLASHW_ALL or FLASHW_TIMERNOFG
        else
          dwFlags := FLASHW_ALL;
      end;
      uCount := Count;
      dwTimeout := 0;
      FlashWindowEx(Flash);
    end;
  except
  end;    
end;


function IntervaloPaginas(Selecao : String; NumeroMaxPaginas : Integer): String;
var Vetor_Strings : array of string;
    Selecao_2 : String;
    Retorno : array of Integer;
    i, j, k, cont : Integer;
begin
  if Trim(Selecao) = NullAsStringValue then exit;

  SetLength(Vetor_Strings, 1);
  Selecao_2 := Selecao;
  j := 0;   

  //Verifica Erros e Separa Intervalos
  if (Selecao_2[1] = ',') or (Selecao_2[Length(Selecao_2)] = ',') then //Separadores Inválidos
    GeraMensagem('Intervalo de Páginas Inválido. Verifique !', True);

  for i := 1 to Length(Selecao_2) do
  begin
    if not (Selecao_2[i] in ['0'..'9', '-', ',', ' ']) then //Caracteres Inválidos
    begin
      GeraMensagem('Intervalo de Paginas Inválido. Verifique !', True);
    end
    else if Selecao_2[i] = ',' then
    begin
      inc(j);
      SetLength(vetor_strings, j + 1);
    end
    else
    begin
      Vetor_Strings[j] := Trim(Vetor_Strings[j] + Selecao_2[i]);
    end;  
  end;
  //

  cont := 0;
  SetLength(Retorno, 1);
  k := 0;
  for i := 0 to High(Vetor_Strings) do
  begin
    //Intervalos Inválidos
    for j := 1 to Length(Vetor_Strings[i]) do
    begin
      if Vetor_Strings[i][j] = '-' then
      begin
        inc(cont);
      end;

      if cont > 1 then
        GeraMensagem('Intervalo de Páginas Inválido. Verifique !', True);
    end;
    cont := 0;
    //

    if Vetor_Strings[i][1] = '-' then // Coluna <= X
    begin
      for j := 1 to StrToInt(Trim(StringReplace(Vetor_Strings[i], '-', '', [rfIgnoreCase, rfReplaceAll]))) do
      begin
        SetLength(Retorno, k+1);
        Retorno[k] := j;
        inc(k);
      end;
    end
    else if Vetor_Strings[i][Length(Vetor_Strings[i])] = '-' then // Coluna >= X
    begin
      for j := StrToInt(Trim(StringReplace(Vetor_Strings[i], '-', '', [rfIgnoreCase, rfReplaceAll]))) to NumeroMaxPaginas do
      begin
        SetLength(Retorno, k+1);
        Retorno[k] := j;
        inc(k);
      end;
    end
    else if PosEx('-', Vetor_Strings[i]) > 0 then // Coluna entre x e y
    begin
      for j := StrToInt(copy(Vetor_Strings[i], 1, PosEx('-', Vetor_Strings[i]) - 1)) to StrToInt(copy(Vetor_Strings[i], PosEx('-',  Vetor_Strings[i]) + 1, length(Vetor_Strings[i]))) do
      begin
        SetLength(Retorno, k+1);
        Retorno[k] := j;
        inc(k);
      end;
    end
    else // Coluna = X
    begin
      SetLength(Retorno, k+1);
      Retorno[k] := StrToInt(StringReplace(Vetor_Strings[i], '-', '', [rfIgnoreCase, rfReplaceAll]));
      inc(k);
    end
  end;

  for i := 0 to High(Retorno) do
  begin
    for j := 0 to High(Retorno) do
    begin
      if Retorno[i] < Retorno[j] then
      begin
        k := Retorno[j];
        Retorno[j] := Retorno[i];
        Retorno[i] := k;
      end;
    end;
  end;
   
  k := 0;
  for i := 0 to High(Retorno) do
  begin
    if k <> Retorno[i] then
    begin
      if i < High(Retorno) then
        Result := Result + IntToStr(Retorno[i]) + ', '
      else
        Result := Result + IntToStr(Retorno[i])
    end;
    k := Retorno[i]
  end;
end;


function InterpretadorSQLIntervalos(Selecao, Coluna_do_Where : String; WinControl : TWinControl = nil): String;
var Vetor_Strings : array of string;
    Selecao_2, Clausula : String;
    i, j, cont : Integer;
begin
  if Trim(Selecao) = NullAsStringValue then exit;

  SetLength(Vetor_Strings, 1);
  Selecao_2 := Selecao;
  j := 0;   

  //Verifica Erros e Separa Intervalos
  if (Selecao_2[1] = ',') or (Selecao_2[Length(Selecao_2)] = ',') then //Separadores Inválidos
    GeraMensagem('Intervalo de Impressão Inválido. Verifique !', True, WinControl);

  for i := 1 to Length(Selecao_2) do
  begin
    if not (Selecao_2[i] in ['0'..'9', '-', ',', ' ']) then //Caracteres Inválidos
    begin
      GeraMensagem('Intervalo de Impressão Inválido. Verifique !', True, WinControl);
    end
    else if Selecao_2[i] = ',' then
    begin
      inc(j);
      SetLength(vetor_strings, j + 1);
    end
    else
    begin
      Vetor_Strings[j] := Trim(Vetor_Strings[j] + Selecao_2[i]);
    end;  
  end;
  //

  cont := 0;
  Clausula := NullAsStringValue;
  for i := 0 to High(Vetor_Strings) do
  begin
    //Intervalos Inválidos
    for j := 1 to Length(Vetor_Strings[i]) do
    begin
      if Vetor_Strings[i][j] = '-' then
      begin
        inc(cont);
      end;

      if cont > 1 then
        GeraMensagem('Intervalo de Impressão Inválido. Verifique !', True, WinControl);
    end;
    cont := 0;
    //

    if Vetor_Strings[i][1] = '-' then // Coluna <= X
      Clausula := Clausula + '(' +  Coluna_do_Where + ' <= ' + QuotedStr(StringReplace(Vetor_Strings[i], '-', '', [rfIgnoreCase, rfReplaceAll])) + ') OR '
    else if Vetor_Strings[i][Length(Vetor_Strings[i])] = '-' then // Coluna >= X
      Clausula := Clausula + '(' +  Coluna_do_Where + ' >= ' + QuotedStr(StringReplace(Vetor_Strings[i], '-', '', [rfIgnoreCase, rfReplaceAll])) + ') OR '
    else if PosEx('-', Vetor_Strings[i]) > 0 then // Coluna entre x e y
      Clausula := Clausula + '(' + Coluna_do_Where + ' BETWEEN ' + QuotedStr(copy(Vetor_Strings[i], 1, PosEx('-', Vetor_Strings[i]) - 1)) + ' AND ' + QuotedStr(copy(Vetor_Strings[i], PosEx('-',  Vetor_Strings[i]) + 1, length(Vetor_Strings[i]))) + ') OR '
    else // Coluna = X
      Clausula := Clausula + '(' +  Coluna_do_Where + ' = ' + QuotedStr(StringReplace(Vetor_Strings[i], '-', '', [rfIgnoreCase, rfReplaceAll])) + ') OR '
  end;

  Delete(Clausula, length(Clausula) - 3, 3);

  Result := '(' + Trim(Clausula) + ') ';


end;

