Procedure VerifAtualizaPWUsrMob(_UCLOGIN : String; _UCPW : String; _MD5UCPW : String);
var
  _ConfMD5PW : String;
begin
  _Cria_IBQuery(nil,999);
  try
    if Trim(_MD5UCPW) <> '' then // Conferindo - Login do Ganso
    begin
      _ConfMD5PW := UpperCase(MD5Print(MD5String(_UCPW)));
    end
    else begin // Outras rotinas (alteração senha usuário, cadastro de usuário...)
      _IBQuery999.Close;
      _IBQuery999.SQL.Text := ' select ucpassword, pwmob '
                             +' from ibxbctabusers '
                             +' where uclogin = '+QuotedStr(_UCLOGIN);
      _IBQuery999.Open;
      
      if not(_IBQuery999.IsEmpty) then
      begin
        _ConfMD5PW := UpperCase(MD5Print(MD5String(Decrypt(_IBQuery999.FieldByName('ucpassword').AsString,226))));
        _MD5UCPW := _IBQuery999.FieldByName('pwmob').AsString;
      end
      else begin
        _ConfMD5PW := '';
        _MD5UCPW := '';
      end;
    end;

    if _ConfMD5PW <> _MD5UCPW then
    begin
      _IBQuery999.Close;
      _IBQuery999.SQL.Text := 'update ibxbctabusers set pwmob = '+QuotedStr(_ConfMD5PW)+' where uclogin = '+QuotedStr(_UCLOGIN);
      _IBQuery999.ExecSQL;
      _IBQuery999.Transaction.Commit;
    end;

  finally
    _IBQuery999.Close;
    _Destroy_IBQuery(999);
  end;
end;

{ TConfGrid }

constructor TConfGrid.Create(AOwner : TComponent; Grid: TSMDBGrid; pOcultarCol : Boolean);
var
  lCol : String;
begin
  FURI  := Uppercase(AOwner.Name)+'_'+ UpperCase(Grid.Name);
  FGrid := Grid;
  FFields := TStringList.Create;

  FPopup := TPopupMenu.Create(nil);
  FmiSalvar := TMenuItem.Create(FPopup);
  FmiRestaurar  := TMenuItem.Create(FPopup);
  if pOcultarCol then
  begin
    FmiConfig     := TMenuItem.Create(FPopup);
    FPopup.Items.Insert(0,FmiConfig);
    FPopup.Items.Insert(1,FmiSalvar);
    FPopup.Items.Insert(2,FmiRestaurar);
    FPopup.Items[0].OnClick := miConfigurarclick;
    FPopup.Items[1].OnClick := miSalvarClick;
    FPopup.Items[2].OnClick := miRestaurarClick;
    FPopup.Items[0].Caption := 'Configurações do Grid';
    FPopup.Items[1].Caption := 'Salvar Configurações do Grid';
    FPopup.Items[2].Caption := 'Restaurar Configuração Padrão';
  end
  else
  begin
    FPopup.Items.Insert(0,FmiSalvar);
    FPopup.Items.Insert(1,FmiRestaurar);
    FPopup.Items[0].OnClick := miSalvarClick;
    FPopup.Items[1].OnClick := miRestaurarClick;
    FPopup.Items[0].Caption := 'Salvar Configurações do Grid';
    FPopup.Items[1].Caption := 'Restaurar Configuração Padrão';
  end;

  FGrid.PopupMenu := FPopup;

  FSetGridDlg := TSMSetDBGridDialog.Create(nil);
  FSetGridDlg.Caption := 'Configurar Organização das Colunas';
  FSetGridDlg.DBGrid := FGrid;
  PegaDadosColunas;
  FGrid.OnColumnMoved := GridColumnMoved;

  lCol := LerColunasIni();
  if lCol <> '' then
  begin
    //Recarregar colunas
    ConfigurarGrid(lCol);
    FIndices := lCol;
    AtualizaDadosColunas();
  end;

  OcultarCampos;
end;

destructor TConfGrid.Destroy;
begin
  if Assigned(FSetGridDlg) then
    FreeAndNil(FSetGridDlg);

  if Assigned(FPopup) then
    FreeAndNil(FPopup);

  if Assigned(FFields) then
    FreeAndNil(FFields);
    
  inherited;
end;

procedure TConfGrid.miConfigurarclick(Sender: TObject);
var
  i, j : Integer;
begin
  FSetGridDlg.AllowedFields := FFields;

  Atu_DisplayLabel;

  if FSetGridDlg.Execute then
  begin
    if FGrid.Columns.Count > 0 then
      FIndices := '';
    for i := 0 to FGrid.Columns.count - 1 do
    begin
      for j := 0 to High(FColunas) do
    begin
        if (FGrid.Columns[i].FieldName = FColunas[j].field) then
      begin
          FGrid.Columns[i].Title.Alignment := taCenter;
          FGrid.Columns[i].ReadOnly := FColunas[j].ReadOnly;
          FGrid.Columns[i].width := FColunas[j].width;
          FGrid.Columns[i].Color := FColunas[j].Cor;
          FGrid.Columns[i].Alignment  := FColunas[j].Alinhamento;
          FGrid.Columns[i].Title.Caption := FColunas[j].Titulo;
          FGrid.Columns[i].Title.Font.Color := clBlack;
          if FIndices = '' then
            FIndices := FGrid.Columns[i].FieldName + ',' + IntToStr(FGrid.Columns[i].width)
          else
            FIndices := FIndices + '|' + FGrid.Columns[i].FieldName + ',' + IntToStr(FGrid.Columns[i].width);
          Break;
        end;
      end;
    end;
  end
  else
  begin
    for i := 0 to FGrid.Columns.count - 1 do
    begin
      for j := 0 to High(FColunas) do
      begin
        if (FGrid.Columns[i].FieldName = FColunas[j].field) then
        begin
          FGrid.Columns[i].Title.Font.Color := clBlack;
          FGrid.Columns[i].Title.Caption := FColunas[j].Titulo;
        end;
      end;
    end;
  end;
end;

procedure TConfGrid.miRestaurarclick(Sender: TObject);
begin
  ConfigurarGrid('');
end;

procedure TConfGrid.miSalvarclick(Sender: TObject);
begin
  AtualizaDadosColunas;
  SalvarColunasIni;
end;

procedure TConfGrid.OcultarCampos;
var
  lMatch: Integer;
begin
  FGrid.DataSource.DataSet.DisableControls;

  try
    for var vField in FGrid.DataSource.DataSet.Fields do
    begin
      lMatch := 0;

      for var vI := 0 to Pred(FGrid.Columns.Count) do
      begin
        if FGrid.Columns[vI].FieldName.Equals(vField.FieldName) then
        begin
          Inc(lMatch);
          Break;
        end;
      end;

      if lMatch = 0 then
      begin
        vField.Visible := False;
      end;
    end;
  finally
    FGrid.DataSource.DataSet.EnableControls;
  end;
end;

procedure TConfGrid.PegaDadosColunas();
var
  i: Integer;
begin
  SetLength(FColunas, 0); // Limpa vetor
  FIndices := '';
  SetLength(FColunas, FGrid.Columns.Count);
  FFields.Clear;
  for i := 0 to High(FColunas) do
  begin
    FColunas[i].Titulo      := FGrid.Columns[i].Title.Caption;
    FColunas[i].Field       := FGrid.Columns[i].FieldName;
    FColunas[i].Width       := FGrid.Columns[i].Width;
    FColunas[i].WidthP      := FGrid.Columns[i].Width;
    FColunas[i].ReadOnly    := FGrid.Columns[i].ReadOnly;
    if (FGrid.Columns[i].Color = 0) then
      FColunas[i].Cor := clWhite
    else
      FColunas[i].Cor       := FGrid.Columns[i].Color;
    FColunas[i].Alinhamento := FGrid.Columns[i].Alignment;
    FColunas[i].Visible     := FGrid.Columns[i].Visible;
    if FGrid.Columns[i].Visible then
      FFields.Add(FGrid.Columns[i].FieldName);
    if FIndices = '' then
      FIndices := FGrid.Columns[i].FieldName + ',' + IntToStr(FGrid.Columns[i].Width)
    else
      FIndices := FIndices + '|' + FGrid.Columns[i].FieldName + ',' + IntToStr(FGrid.Columns[i].Width);
  end;
end;

procedure TConfGrid.AtualizaDadosColunas();
var
  i, j: Integer;
begin
  FIndices := '';
  for j := 0 to FGrid.Columns.Count - 1 do
  begin
    for i := 0 to High(FColunas) do
    begin
      if (FColunas[i].Field = FGrid.Columns[j].FieldName) then
      begin
        FColunas[i].Width := FGrid.Columns[j].Width;
        if FIndices = '' then
          FIndices := FGrid.Columns[j].FieldName + ',' + IntToStr(FGrid.Columns[j].Width)
        else
          FIndices := FIndices + '|' + FGrid.Columns[j].FieldName + ',' + IntToStr(FGrid.Columns[j].Width);
        Break;
      end;
    end;
  end;
end;


procedure TConfGrid.GridColumnMoved(Sender: TObject; FromIndex, ToIndex: Integer);
begin
  AtualizaDadosColunas;
end;

