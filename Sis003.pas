function ProximaNotaP: Integer;
var
  _query : TIBQuery;
  _transaction : TIBTransaction;
begin
  Result := 0;

  try
    _query := TIBQuery.Create(nil);
    _transaction := TIBTransaction.Create(nil);
    _transaction.DefaultDatabase := DM.IBbanco;
    _query.Transaction := _transaction;

    with _query do
    begin
      Close;
      SQL.Text := 'select numero_nf from sp_numero_nfe(:pCodFilial, :pSerie)';
      ParamByName('pSerie').Value := _ParNF_SeriePadrao;
      ParamByName('pCodFilial').Value := _CodFilial;

      try
        Open;
      except
        on E: Exception do
        begin
          Application.MessageBox(PChar('Problemas ao Localizar a Última Nota Fiscal, Verifique a Base de Dados.' +#13+#13+ E.Message),'ATENÇÃO',MB_OK+MB_ICONINFORMATION);
          _query.Close;
        end;
      end;
    end;

    if _query.IsEmpty then
      Result := 1
    else
      Result := _query.FieldByName('numero_nf').AsInteger;
  finally
    if _transaction.InTransaction then _transaction.Rollback;
    _query.Free;
    _transaction.Free;
  end;
end;

function ProximaNotaS(): Integer;
var
  _query : TIBQuery;
  _transaction : TIBTransaction;
begin
  Result := 0;

  if (Coalesce(_ParNFSTipoTransmissao,' ',True)[1] in ['E']) then
  begin
    //'E' - O Web Service define o número da Nota;
    Result := 1;
    Exit;
  end;

  _query := TIBQuery.Create(nil);
  _transaction := TIBTransaction.Create(nil);
  _transaction.DefaultDatabase := DM.IBbanco;
  _query.Transaction := _transaction;

  with _query do
  begin
    Close;

    if (Coalesce(_ParNFSTipoTransmissao,' ',True)[1] in ['A']) then
    begin
      SQL.Text := 'select numero_nfs as NUMERO from sp_numero_nfse(:pCodFilial, :pSerie)';
      ParamByName('pCodFilial').AsInteger := _CodFilial;
      ParamByName('pSerie').AsString := _ParNFS_SeriePadrao;
    end
    else
    begin
      SQL.Text := 'SELECT NUMERO FROM SP_NUMERO_NF(:Tipo, :FILIAL)';
      ParamByName('tipo').Value := 'S';
      ParamByName('filial').Value := _CodFilial;
    end;

    try
      Open;
    except
      Application.MessageBox('Falha ao pesquisar última Nota Fiscal. Entre em contato com o Suporte Técnico.','ATENÇÃO',MB_OK+MB_ICONINFORMATION);
      _query.Close;
    end;
  end;

  if _query.IsEmpty then
    Result := 1
  else
  begin
    if (Coalesce(_ParNFSTipoTransmissao,' ',True)[1] in ['E','A']) then
      Result := _query.FieldByName('NUMERO').AsInteger
    else
      Result := _query.FieldByName('NUMERO').AsInteger + 1;
  end;

  _query.Free;
  if _transaction.InTransaction then _transaction.Rollback;
  _transaction.Free;
end;

procedure Centralizar_Form(Form : TForm);
var
  R: TRect;
begin
  R := Form.Monitor.WorkareaRect;
  Form.Top := (R.Top + R.Bottom - Form.Height) div 2;
  Form.Left := (R.Left + R.Right - Form.Width) div 2;
end;

