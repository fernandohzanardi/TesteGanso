procedure SplitDelimitedText(const Value: string; List: TStrings; StrictDelimiter: Boolean = True);
var
  P, P1: PChar;
  S: string;
begin
  if not StrictDelimiter then
  begin
    List.DelimitedText := Value;
    Exit;
  end;

  List.BeginUpdate;
  try
    List.Clear;
    P := PChar(Value);
    while P^ <> #0 do
    begin
      if P^ = List.QuoteChar then
        S := AnsiExtractQuotedStr(P, List.QuoteChar)
      else
      begin
        P1 := P;
        while (P^ <> #0) and (P^ <> List.Delimiter) do
          P := CharNext(P);
        SetString(S, P1, P - P1);
      end;
      List.Add(S);

      if P^ = List.Delimiter then
      begin
        P1 := P;
        if CharNext(P1)^ = #0 then
          List.Add('');
        P := CharNext(P);
      end;
    end;
  finally
    List.EndUpdate;
  end;
end;

function CheckoutBloquear(const Codigo: Integer): Boolean;
var
  Status: string;
begin
  with TQuery.Create(DM.IBBanco) do
  try
     Add('select')
    .Add('   o.checkout_status')
    .Add('from')
    .Add('  orcamento o')
    .Add('where')
    .Add('    o.codigo = :Codigo')
    .Param('Codigo', Codigo)
    .Open;

    Status := FieldValue('checkout_status').AsString;

    Result := IndexStr(Status, ['AB', 'DI', 'ES', 'EC']) >= 0;
  finally
    Free;
  end;
end;

function CheckoutValido(const pCodigoOrcamento: Integer; const pMsgAcao, pModalidadeConf: string): Boolean; {CD-5086 - 15/01/2024 - José Augusto}
var
  lMsg: string;
begin
  Result := True;
  if (pModalidadeConf.Equals('C') or pModalidadeConf.Equals('S')) and CheckoutBloquear(pCodigoOrcamento) then
