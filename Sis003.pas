function AcessarMenu(pMenuItem: TMenuItem; pAcessar: Boolean = False): Boolean;
var
  vCmptMenu: TComponent;
begin
  Result := False;

  if (pMenuItem = nil) or (pMenuItem.ClassType <> TMenuItem) then
    Exit;

  Result := True;
  vCmptMenu := pMenuItem;

  while (vCmptMenu is TMenuItem) do
  begin
    if (vCmptMenu.ClassType = TMenuItem) then
    begin
      if (not (vCmptMenu as TMenuItem).Enabled) or (not (vCmptMenu as TMenuItem).Visible) then
      begin
        Result := False;
        Exit;
      end;
    end
    else
      Exit;

    vCmptMenu := (vCmptMenu as TMenuItem).Parent;
  end;

  if (pAcessar) then
    pMenuItem.Click;
end;

function ValidaChaveDFESrv(out pNomeServidor, pMensagemErro: String; _IBCnxDB : TIBDatabase = nil): Boolean;
var
  vRetornoDLL, vControle: Integer;
  vKeySrv, vKeyAtual, vDsSrvEnvMail: String;
  vKeySrvN: String;
begin
  vControle := 1;

  Result := False;

  if _IBCnxDB = nil then
    _IBCnxDB := DM.IBbanco;

  vKeyAtual := Trim(VarToStr(GetQryResult(_IBCnxDB,'select DFE_CHAVE_AUTORIZACAO_SRV from VERSAO')));

  if vKeyAtual = '' then Exit;

  //Validações da DLL
  try
    vRetornoDLL := GetRegProducaoSrv(_IBCnxDB,vKeySrv,vKeySrvN,vDsSrvEnvMail);

    if vRetornoDLL = 255 then
      raise Exception.Create('Erro desconhecido na validação da chave de autorização de DFE no servidor.');

    while (vRetornoDLL = 3) and (vControle <= 3) do
    begin
      vRetornoDLL := GetRegProducaoSrv(_IBCnxDB,vKeySrv,vKeySrvN,vDsSrvEnvMail);
      Inc(vControle);
    end;

    //Esgotou a quantidade de tentativas após o TO
    if vControle = 4 then
      raise Exception.Create('Quantidade máxima de tentativas de consulta atingida.');
  except
    on E: Exception do
    begin
      pMensagemErro := E.Message;
      Exit;
    end;
  end;

  pNomeServidor := vKeySrvN;

  //Validação da Chave
  Result := vKeyAtual = vKeySrv;
end;

