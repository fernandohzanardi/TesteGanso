Function ChecaCPF(Num: String; _ExibMsg : Boolean = True): Boolean;
var
  n1,n2,n3,n4,n5,n6,n7,n8,n9:integer;
  d1,d2:integer;
  digitado,calculado:STRING;
begin
  if Num = '' then
    ChecaCPF := True
  else if length(Trim(Num))<> 11 then
  begin
    ChecaCPF := False;
    if _ExibMsg then
      Application.MessageBox('CPF inválido, verifique.','ATENÇÃO !',MB_OK+MB_ICONINFORMATION);
  end
  else if ((Num = '00000000000') or (Num = '11111111111') or // Alterado por Luiz Santana (19/05/2006)
           (Num = '22222222222') or (Num = '33333333333') or
           (Num = '44444444444') or (Num = '55555555555') or
           (Num = '66666666666') or (Num = '77777777777') or
           (Num = '88888888888') or (Num = '99999999999')) then
  begin
    ChecaCPF := False;
    if _ExibMsg then
      Application.MessageBox('CPF não aceitável, verifique.','ATENÇÃO !',MB_OK+MB_ICONINFORMATION);
  end
  else
  begin
    try
      n1:=StrtoInteiro(num[1]);
      n2:=StrtoInteiro(num[2]);
      n3:=StrtoInteiro(num[3]);
      n4:=StrtoInteiro(num[4]);
      n5:=StrtoInteiro(num[5]);
      n6:=StrtoInteiro(num[6]);
      n7:=StrtoInteiro(num[7]);
      n8:=StrtoInteiro(num[8]);
      n9:=StrtoInteiro(num[9]);
      d1:=n9*2+n8*3+n7*4+n6*5++n5*6+n4*7+n3*8+n2*9+n1*10;
      d1:=11-(d1 mod 11);
      if d1>=10 then
        d1:=0;
      d2:=d1*2+n9*3+n8*4+n7*5+n6*6+n5*7+n4*8+n3*9+n2*10+n1*11;
      d2:=11-(d2 mod 11);
      if d2>=10 then
        d2:=0;
      calculado:=INTTOSTR(d1)+INTTOSTR(d2);
      digitado:=num[10]+num[11];
      if calculado = digitado then
        ChecaCPF:=true
      else
      begin
        ChecaCPF:=false;
        if _ExibMsg then
          Application.MessageBox('CPF inválido, verifique.','ATENÇÃO !',MB_OK+MB_ICONINFORMATION);
      end;
    except
      ChecaCPF:=false;
    end;
  end;
end;

function ChecaCNPJ(cnpj: String; _ExibMsg : Boolean = True): Boolean;
  procedure ExibirMensagem;
  begin
    if _ExibMsg then
    begin
      Application.MessageBox('CNPJ inválido, verifique.','ATENÇÃO !', MB_OK + MB_ICONINFORMATION);
    end;
  end;

begin
  Result := True;
  if not CNPJ.IsEmpty then
  begin
    if CNPJ.Trim.Length <> 14 then
    begin
      Result := False;
      ExibirMensagem;
    end else
    if not TCNPJAlfa.ValidarCNPJ(CNPJ.Trim) then
    begin
      Result := False;
      ExibirMensagem;
    end;
  end;
end;

procedure CompactarZM(ArqNormal : String; ArqCompactado: String; pLeveComp : Integer = 9; pProgressBar: TFlatGauge = nil);
var
  RS: TResourceStream;
  ZipM : TZipMaster;
  _OnMessage : TZMOnProgress;
begin
  {CD 3306 - Wéliton Goulart - 06/08/2019}
  try
    if not(FileExists(ExtractFilePath(Application.ExeName)+'\DelZip192.dll')) then
    begin
      RS := TResourceStream.Create(HInstance, 'ZIPM192', RT_RCDATA);
      if RS <> nil then
      begin
        RS.SaveToFile(ExtractFilePath(Application.ExeName)+'\DelZip192.dll');
        FreeAndNil(RS);
      end;
    end;
  except
  end;

  try
    ZipM := TZipMaster.Create(nil);

    if pProgressBar <> nil then
    begin
      _OnMessage := TZMOnProgress.Create(pProgressBar);
      ZipM.OnProgress := _OnMessage.ZipProgress;
    end
    else
      _OnMessage := TZMOnProgress.Create(nil);

    ZipM.OnMessage := _OnMessage.ZipMessage;

    ZipM.DLLDirectory := ExtractFilePath(Application.ExeName);
    ZipM.DLL_Load := True;
    ZipM.Active := False;
    ZipM.Unattended := True; {Habilitado para ocultar mensagens da ZipMaster, Erro será tratado na Função: _OnMessage.ZipMessage}
    ZipM.AddCompLevel := pLeveComp; // Faixa de Compressão, 9 mais apertada, 0 sem compressão!
    ZipM.Active := True;

    if FileExists(ArqCompactado) then // Luiz Santana - 08/08/2019
      ZipM.EraseFile(ArqCompactado, HtdFinal);

    ZipM.ZipFileName := ArqCompactado;

    ZipM.FSpecArgs.Clear;
    ZipM.FSpecArgs.Add(ArqNormal);
    ZipM.Add;

    if _OnMessage.FErroCode <> 0 then
    begin
      raise Exception.Create(_OnMessage.FErroMsg);
    end;
  finally
    ZipM.OnMessage := nil;
    ZipM.OnProgress := nil;
    if Assigned(_OnMessage) then
      FreeAndNil(_OnMessage);
    ZipM.Dll_Load := False;
    FreeAndNil(ZipM);
  end;
end;

procedure Compactar(ArqNormal, ArqCompactado: String);
var
  FileIni, FileOut: TFileStream;
  Zip: TCompressionStream;
begin
  FileIni:=TFileStream.Create(ArqNormal, fmOpenRead and fmShareExclusive);
  FileOut:=TFileStream.Create(ArqCompactado, fmCreate or fmShareExclusive);
  Zip:=TCompressionStream.Create(clMax, FileOut);
  Zip.CopyFrom(FileIni, FileIni.Size);
  Zip.Free;
  FileOut.Free;
  FileIni.Free;
end;

Procedure DesCompactarZM(ArqCompactado: String; ArqNormal : String; pProgressBar: TFlatGauge = nil);
var
  RS: TResourceStream;
  ZipM : TZipMaster;
  _OnMessage : TZMOnProgress;
begin
  {CD 3306 - Wéliton Goulart - 06/08/2019}
  try
    if not(FileExists(ExtractFilePath(Application.ExeName)+'\DelZip192.dll')) then
    begin
      RS := TResourceStream.Create(HInstance, 'ZIPM192', RT_RCDATA);
      if RS <> nil then
      begin
        RS.SaveToFile(ExtractFilePath(Application.ExeName)+'\DelZip192.dll');
        FreeAndNil(RS);
      end;
    end;
  except
  end;

  try
    ZipM := TZipMaster.Create(nil);

    if pProgressBar <> nil then
    begin
      _OnMessage := TZMOnProgress.Create(pProgressBar);
      ZipM.OnProgress := _OnMessage.ZipProgress;
    end
    else
      _OnMessage := TZMOnProgress.Create(nil);

    ZipM.OnMessage := _OnMessage.ZipMessage;

    ZipM.DLLDirectory := ExtractFilePath(Application.ExeName);
    ZipM.DLL_Load := True;
    ZipM.Active := False;
    ZipM.Unattended := True;
    ZipM.AddCompLevel := 9; // Faixa de Compressão, 9 mais apertada, 0 sem compressão!
    ZipM.Active := True;

    ZipM.ZipFileName := ArqCompactado;

    ZipM.ExtrBaseDir := ExtractFilePath(ArqNormal);
    ZipM.Extract;

    if _OnMessage.FErroCode <> 0 then
    begin
      raise Exception.Create(_OnMessage.FErroMsg);
    end;
  finally
    ZipM.OnMessage := nil;
    ZipM.OnProgress := nil;
    if Assigned(_OnMessage) then
      FreeAndNil(_OnMessage);
    ZipM.Dll_Load := False;
    FreeAndNil(ZipM);
  end;
end;

procedure DesCompactar(ArqCompactado, ArqNormal: String);
var
  FileIni, FileOut: TFileStream;
  DeZip: TDecompressionStream;
  i: Integer;
  Buf: array[0..1023]of Byte;
begin
  FileIni:=TFileStream.Create(ArqCompactado, fmOpenRead and fmShareExclusive);
  FileOut:=TFileStream.Create(ArqNormal, fmCreate or fmShareExclusive);
  DeZip:=TDecompressionStream.Create(FileIni);
  repeat
  i:=DeZip.Read(Buf, SizeOf(Buf));
  if i <> 0 then FileOut.Write(Buf, i);
  until i <= 0;
  DeZip.Free;
  FileOut.Free;
  FileIni.Free;
end;

