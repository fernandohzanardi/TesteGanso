procedure AlimentarParametrosTefRetaguarda;
begin
  _ParTipoTef := VerificaTipoTef;

  if _ParTipoTef <> 'E' then
  begin
    Exit;
  end;

  _Cria_IBQuery(nil,999);
  _IBQuery999.SQL.Text := 'select ativa_tef_retaguarda, tefd_numero_empresa, ip_servidor_tef, tef_impso1via from pdv_setup '+
                          ' where codigo_filial = '+ IntToStr(_CodFilial);
  _IBQuery999.Open;
  if (not _IBQuery999.IsEmpty) then
  begin
    _TefRetaguardaAtivado :=  (UpperCase(_IBQuery999.FieldByName('ativa_tef_retaguarda').AsString) = 'S');
    _ParNumEmpresaTEF := Trim(_IBQuery999.FieldByName('tefd_numero_empresa').AsString);
    _ParEnderecoTEF := Trim(_IBQuery999.FieldByName('ip_servidor_tef').AsString);
    _ParTEFImpSo1Via := (UpperCase(_IBQuery999.FieldByName('tef_impso1via').AsString) = 'S');
  end;

  _IBQuery999.Close;
  _Destroy_IBQuery(999);
end;

function TEFDVerECancTrans(pCodNegociacao, pDAV: string; _OpF: string = 'C'): string;
var
  _IBQConsNegTEF : TIBQuery;
  _IBTConsNegTEF : TIBTransaction;
  _QtdCartaoVenda : Integer;
  _TEFDDescComp: string;
  _EncSeqCard : Boolean;
  _TextoLOGCancela: string;
  vRespostaConfig: string;
  vTEF: TCliSiTef;
begin
  Result := '';

  if not(_TEFDTeveCom) and (_OpF = 'C') then
  begin
    vTEF := TCliSiTef.Create(_ParEnderecoTEF, _ParNumEmpresaTEF, _caixaPadrao.ToString, _CNPJFilial, _CodUsuario.ToString);
    try
      vRespostaConfig := vTEF.Configurar(_TEFDTeveCom);
    finally
      FreeAndNil(vTef);
    end;
    if not(_TEFDTeveCom) then
    begin
      Application.MessageBox(PChar('Nao foi possível realizar comunicação com o servidor !' + sLineBreak + vRespostaConfig), 'ATENÇÂO');
      Abort;
    end;
  end;

  _IBQConsNegTEF := TIBQuery.Create(nil);
  _IBTConsNegTEF := TIBTransaction.Create(nil);
  _IBTConsNegTEF.Params.Clear;
  _IBTConsNegTEF.DefaultDatabase := DM.IBbanco;
  _IBTConsNegTEF.DefaultAction := TARollback;

  _IBQConsNegTEF.Transaction := _IBTConsNegTEF;
  _IBTConsNegTEF.Params.Add('read_committed');
  _IBTConsNegTEF.Params.Add('rec_version');
  _IBTConsNegTEF.Params.Add('nowait');
  _EncSeqCard := False;
  try
    _IBQConsNegTEF.Close;
    _IBQConsNegTEF.SQL.Text := ' select neg.tef_indice_instituicao, neg.valor, neg.tef_data, neg.tef_hora, f.descricao, tef_data_fiscal,'
                              +' tef_hora_fiscal '
                              +' from ' + pDAV +'_negociacao neg '
                              +' left join finalizador f on (f.codigo = neg.codigo_finalizador) '
                              +' where neg.codigo_' + pDAV + ' = ' + pCodNegociacao + ' and neg.tipo_finalizacao = ''NO'' '
                              +'   and coalesce(f.tef,''N'') = ''S'' and neg.tef_retaguarda = ''S'' ';
    _IBQConsNegTEF.Open;
    _IBQConsNegTEF.First;
    _TEFDDescComp := '';
    _QtdCartaoVenda := 0;
    while not(_IBQConsNegTEF.Eof) do
    begin
      Inc(_QtdCartaoVenda);

      _TEFDDescComp := _TEFDDescComp
                   + #13
                   + _IBQConsNegTEF.FieldByName('descricao').AsString+' - '
                   + IfThen(Trim(_IBQConsNegTEF.FieldByName('tef_indice_instituicao').AsString) <> '',
                     Trim(_IBQConsNegTEF.FieldByName('tef_indice_instituicao').AsString),
                     'SEM DADOS TEF GRAVADOS NO BANCO')+': '
                   + ' '+FormatFloat(',0.00',_IBQConsNegTEF.FieldByName('valor').AsCurrency) ;
      if (_IBQConsNegTEF.FieldByName('tef_indice_instituicao').AsString <> '') then
      begin
        _TEFDDataFiscal := _IBQConsNegTEF.FieldByName('tef_data').AsDateTime;
        _TEFDHorario := _IBQConsNegTEF.FieldByName('tef_hora_fiscal').AsDateTime;
      end
      else if (_QtdCartaoVenda = 1) then
      begin
        _TEFDDataFiscal := _IBQConsNegTEF.FieldByName('tef_data_fiscal').AsDateTime;
        _TEFDHorario := _IBQConsNegTEF.FieldByName('tef_hora_fiscal').AsDateTime;
      end;
      _IBQConsNegTEF.Next;
    end;

    if (_QtdCartaoVenda > 0) then
    begin
      if (_TEFDCupomFiscal = IfThen(pDAV = 'ORCAMENTO', 'PED','OS') + AnsiString(pCodNegociacao)) then
      begin
        if (_OpF = 'C') then
        begin
          TEFDConfirmaTransacao(0, IfThen(pDAV = 'ORCAMENTO', 'PED','OS') + AnsiString(pCodNegociacao),
            FormatDateTime('YYYYMMDD', _TEFDDataFiscal), StringReplace(TimeToStr(_TEFDHorario),':','',[rfReplaceAll]));
          if ObterQuantidadeTransacoesTEFPendentes(pCodNegociacao, pDAV) > 0 then
          begin
            if (_QtdCartaoVenda > 1) then
              Application.MessageBox(Pchar('Não foi possível cancelar a transação automaticamente, efetue o cancelamento via [Alt + T] TEF'
                +' Gerencial. E tente novamente essa ação.'),'T.E.F',MB_OK+MB_ICONINFORMATION)
            else
              Application.MessageBox(Pchar('Não foi possível cancelar as transações automaticamente, efetue o cancelamento via [Alt + T] TEF'
                +' Gerencial. E tente novamente essa ação.'),'T.E.F',MB_OK+MB_ICONINFORMATION);
            Result := 'NAO CANCELOU';
            Exit;
          end;
          try
            var _lSQLExec := ' update ' + pDAV + '_negociacao set tef_rede = null, tef_indice_adm = null, tef_indice_transacao = null, ';
            _lSQLExec := _lSQLExec + 'tef_nsu = null, tef_valor = null, tef_parcelas = null, tef_predatado = null, tef_data = null, ';
            _lSQLExec := _lSQLExec + 'tef_hora = null, tef_cielo_descpremia = null, ';
            _lSQLExec := _lSQLExec + 'tef_valor_saque = null, tef_codigo_autorizacao = null, tef_nsu_host = null, ';
            _lSQLExec := _lSQLExec + 'tef_indice_instituicao = null, tef_idtermpag = null, tef_bin = null, tef_ultimo_digc = null, ';
            _lSQLExec := _lSQLExec + 'tef_data_fiscal = null, tef_hora_fiscal = null, tef_retaguarda = null, tef_produto = null, ';
            _lSQLExec := _lSQLExec + 'tef_seqcartao = null, tef_temimpr = null, tef_itef = null, tef_num_pag_cupom = null, '
                                   + 'valor = valor + coalesce(tef_cielo_descpremia, 0), valor_original = valor_original + '
                                   + 'coalesce(tef_cielo_descpremia, 0) ';
            _lSQLExec := _lSQLExec + 'where codigo_' + pDAV + ' = ' + pCodNegociacao + ' and tef_retaguarda = ''S'' ';
            _Cria_IBQuery(nil,999);
            _IBQuery999.Close;
            _IBQuery999.SQL.Text := '';
            _IBQuery999.SQL.Text := _lSQLExec;
            try
              _IBQuery999.ExecSQL;
              _IBTransaction999.Commit;
            except
              on _err : exception do
              begin
                raise Exception.Create(_err.Message);
              end;
            end;

          finally
            _IBQuery999.Close;
            _Destroy_IBQuery(999);
          end;
          InsereQueTEFEmProcessamento(pCodNegociacao, pDAV, 'null');
          if (_QtdCartaoVenda > 1) then
            Application.MessageBox(Pchar(String('Foram canceladas '+IntToStr(_QtdCartaoVenda)+' transações TEF, verifique:'+#13+_TEFDDescComp+#13+#13)),'T.E.F',MB_OK+MB_ICONINFORMATION)
          else
            Application.MessageBox(Pchar(String('A transação TEF foi cancelada, verifique:'+#13+_TEFDDescComp+#13+#13)),'T.E.F',MB_OK+MB_ICONINFORMATION);
        end
        else if (_OpF = 'R') then
        begin
          if (_QtdCartaoVenda > 1) then
            Result := 'Existem '+IntToStr(_QtdCartaoVenda)
                     +' transações TEF em andamento, verifique:'
                     +#13+_TEFDDescComp+#13+#13
          else
            Result := 'Existe '+IntToStr(_QtdCartaoVenda)
                     +' transação TEF em andamento, verifique:'
                     +#13+_TEFDDescComp+#13+#13;
        end
        else if (_OpF = 'AF') then // Luiz Santana - 21/02/2014 - AF = Após Fechamento da Venda, ou seja, erro ao mudar STATUS de "A" p/ "F"
        begin
          Windows.Beep(200, 100);
          Result := '';
          if (_QtdCartaoVenda > 1) then
            Result := 'Existem '+IntToStr(_QtdCartaoVenda)+' transações TEF CONFIRMADAS para esta Venda, verifique:'+#13+_TEFDDescComp+#13+#13
          else
            Result := 'Existe '+IntToStr(_QtdCartaoVenda)+' transação TEF CONFIRMADA para esta Venda, verifique:'+#13+_TEFDDescComp+#13+#13;

          _TextoLOGCancela := Result + 'NÃO foi possível efetuar o estorno desta Transação TEF. Efetue o estorno pelo Administrativo (ADM) do TEF - tela principal do PDV utilizando atalho "CTRL + T".';
          while Application.MessageBox(pChar(String(_TextoLOGCancela
                                    +#13+#13+'Confirma a leitura desta mensagem ?')
                                       ),'ATENÇÃO',MB_YESNO + MB_ICONINFORMATION + MB_DEFBUTTON2) = IDNo do
          begin
            Windows.Beep(800, 100);
          end;
          Result := '';
        end;
      end;
    end;
  finally
    _IBQConsNegTEF.Close;
    _IBTConsNegTEF.Rollback;
    _IBQConsNegTEF.Free;
    _IBTConsNegTEF.Free;
  end;
end;

function VerSeTemTEFEmProcessamento(pCodNegociacao, pDAV: string; pHash: Boolean = False): Boolean;
begin
  Result := True;

  if _PKeyCli <> _PKeyLib then Result := False;

  _Cria_IBQuery(nil,999);
  _IBQuery999.Close;
  _IBQuery999.SQL.Text := ' SELECT COALESCE(TEF_EM_PROCESSAMENTO, ''N'') as TEF_EM_PROCESSAMENTO FROM ' + pDAV + ' WHERE CODIGO = '
    + pCodNegociacao + ' and tipo_' + pDAV + ' = ' + QuotedStr(IfThen(pDAV.ToUpper = 'ORCAMENTO', 'P', 'OS'));
  if pHash then
  begin
     _IBQuery999.SQL.Text :=  _IBQuery999.SQL.Text + ' and ndef = f_encryptmd5((select current_user || ma.mon$remote_pid  ' +
     'from mon$attachments ma where ma.mon$attachment_id = current_connection)) ';
  end;
  _IBQuery999.Open;
  if (_IBQuery999.FieldValues['TEF_EM_PROCESSAMENTO'] <> 'S') or (_IBQuery999.IsEmpty) then
    Result := False;
  _Destroy_IBQuery(999);
end;

procedure InsereQueTEFEmProcessamento(pCodNegociacao, pDAV: string; pStatus: string = 'S'; pTransacao : TIBTransaction = nil);
begin
  _Cria_IBQuery(pTransacao,999);
  _IBQuery999.Close;
  _IBQuery999.SQL.Text := ' UPDATE ' + pDAV + ' SET TEF_EM_PROCESSAMENTO = '+ IfThen(pStatus = 'null', 'null', QuotedStr(pStatus))
   + ', TEF_TERMINAL = ' + IFThen(pStatus = 'null', 'null', QuotedStr(_Nome_Computador + '\' + _CodUsuario.ToString + '-' + _usuario_nome + '/'
   + _caixaPadrao.ToString + '-' + _CaixaPadraoDesc))
    + ' WHERE CODIGO = '+ pCodNegociacao;
  _IBQuery999.ExecSQL;
  if pTransacao = nil then
  begin
    _ibquery999.Transaction.Commit;
  end;
  _Destroy_IBQuery(999);
end;

procedure EfetuarTEFGerencial(Self: TForm);
var
  _ArqEspelhoVia1, _ArqEspelhoVia2: AnsiString;
  _TEFDResult: Integer;
  AspectRatio: Double;
  lCaminho, lLogErroRetaguarda: string;
  lArquivoIni: TIniFile;
begin
  AspectRatio := Trunc(Screen.Width / Screen.Height * 10) / 10;

  if AspectRatio < 1.5 then
  begin // Calcular escala 4:3
    _Scale := Floor(Screen.Width / 1024 * 100);
  end else // Calcular escala 16:9
    _Scale := Floor(Screen.Width / 1366 * 100);

  _TEFCapCancNSU := ''; // Variável que vai receber a NSU da Transação Cancelada
  _TEFECancela := False; // Flag que vai indicar se é um cancelamento ou não
  _TEFCapRede := ''; _TEFCapIndADM := ''; _TEFCapIndTransacao := ''; _TEFCapNSU := ''; _TEFCapValor := 0; _TEFCapParcelas := 0; _TEFCapPreDatado := ''; _TEFCapEmissao := ''; _TEFCapHora := ''; _TEFCapIndInstit := ''; _TEFCapCodAut := ''; _TEFCapNSUHost := '' ;
  _TEFCapBIN := ''; _TEFCapEmbosso := ''; _TEFCapCodAutPIX := ''; _TEFCapEmissaoCancela := '';
  _TEFCapCancCampo106 := ''; _TEFCapCancNSUHostVenda := ''; // Luiz Santana - 26/03/2021 - PIX

  _TEFDCupomFiscal :='GER'+QueimaGenerator('GEN_TEFRET_IDTRN_ADM').ToString;

  _ArqEspelhoVia1 := 'TEFC'+_TEFDCupomFiscal+'_01V1.TXT';               // USAR O NUMERO DO _TEFDCUPOMFISCAL NO NOME DOS ARQUIVOS AQUI E DENTRO NA HORA DE IMPRIMIR
  _ArqEspelhoVia2 := 'TEFC'+_TEFDCupomFiscal+'_01V2.TXT';

  if FileExists(_ArqEspelhoVia1) then DeleteFile(_ArqEspelhoVia1);
  if FileExists(_ArqEspelhoVia2) then DeleteFile(_ArqEspelhoVia2);

  lCaminho := ExtractFilePath(Application.ExeName)+'Banco.ini';
  lArquivoIni := TIniFile.Create(lCaminho);
  try
    if not lArquivoIni.ValueExists('APLICACAO', 'LogErroRetaguarda') then
      lArquivoIni.WriteString('APLICACAO', 'LogErroRetaguarda', 'N');

    lLogErroRetaguarda := lArquivoIni.ReadString('APLICACAO', 'LogErroRetaguarda', 'N');

    if not (lLogErroRetaguarda.Equals('S')) then
    begin
      _TEFDedicadoGeraTrace := '';
    end
    else
    begin
      _TEFDedicadoGeraTrace := 'S'; // VARIAVEL PARA DEPURAÇÂO
    end;
  finally
    lArquivoIni.Free;
  end;
  _TEFDModalidade := 110;
  _TEFDValor := ''; _TEFDOperador := ''; _TEFDParamAdic := '';
  _TEFDDataFiscal := Date;
  _TEFDHorario := Time;

  iTEF := 0;
  _TEFDTemImpressao := False;
  if not Assigned(FrmTEFDedicado) then
    FrmTEFDedicado := TFrmTEFDedicado.Create(Self,1)
  else
    FrmTEFDedicado.WindowState := wsNormal;
  FrmTEFDedicado.ShowModal;
  Application.ProcessMessages;

  if (iTEF = 1)and(_TEFDTemImpressao) then
  begin
    // Certified 2013 - Se for cancelamento tem que confirmar independente se
    // deu certo ou não a impressão (teste Redecard - Homologador Emerson Almeida 2013)
    _TEFDResult := TEFDImprimeGerencial(1, _CaixaPadrao, _ParTEFQuebrarPaginaCompr{CD-5389 - José Augusto - 16/07/2024});
    if ((_TEFDResult = 1)or(_TEFECancela)) then
    begin
      TEFDConfirmaTransacao(1, _TEFDCupomFiscal, FormatDateTime('YYYYMMDD', _TEFDDataFiscal), StringReplace(TimeToStr(_TEFDHorario),':','',[rfReplaceAll]));
      if _TEFECancela then
      begin
        TEFEnviaCancela(Self.Name); // Enviando Cancelamento da Captura para Retaguarda
        //Gustavo Espíndola - Homologação TEF 2016 - 22/01/2016
        //No caso de cancelamento com impressão interrompida (queda de energia) e respondido "NÃO" à pergunta de reimpressão,
        //mostra mensagem abaixo
        if _TEFDResult = -2 then
          Application.MessageBox(Pchar(String('Transação TEF efetuada. Favor reimprimir último cupom. Caso CIELO, utilizar apenas os 6 últimos dígitos.'+#13#10#13#10+
                                 'NSU: '+_TEFCapNSUHost)),'T.E.F',MB_OK+MB_ICONINFORMATION);


      end;
      _TEFECancela := False;
    end
    else begin
      TEFDConfirmaTransacao(0, _TEFDCupomFiscal, FormatDateTime('YYYYMMDD', _TEFDDataFiscal), StringReplace(TimeToStr(_TEFDHorario),':','',[rfReplaceAll]));
      Application.MessageBox('Transação não efetuada. Favor reter Cupom.','T.E.F',MB_OK+MB_ICONINFORMATION);
    end;
  end;
  if FileExists(_ArqEspelhoVia1) then DeleteFile(_ArqEspelhoVia1);
  if FileExists(_ArqEspelhoVia2) then DeleteFile(_ArqEspelhoVia2);
end;

procedure TEFEnviaCancela(pDav: string);
var
  lDav, lCodigo, lNSU, lSiglaPixKeyLoc, lPixKeyLoc: string;
begin
  _Cria_IBQuery(nil, 999);
  try
    _IBQuery999.Close;

    // Luiz Santana - 26/03/2021 - PIX
    if (_TEFCapCancCampo106 = '60110024') then
    begin // select na os negociacao ou orcamento negociacao utilizando dos dados retornados pela clisitef pra pegar o
          // cod_orcamento ou o cod_os pra atraves dos dados da orcamento ou da os montar o pix_keyloc pra ai fazer o update abaixo
      lDav := IfThen(pDav = 'FrmVenda_Retaguarda', 'orcamento', 'os');
      lSiglaPixKeyLoc := IfThen(pDav = 'FrmVenda_Retaguarda', 'PED', 'OS');
      lNSU := RightStr(_TEFCapCancNSU,6);
      _IBQuery999.SQL.Text := ' select codigo_' + lDav + ' as codigo_dav, tef_nsu, codigo_finalizador from ' + lDav +
        '_negociacao where tef_rede = ' + QuotedStr(_TEFCapRede) + ' and tef_nsu = ' +  QuotedStr(lNSU);
      try
        _IBQuery999.Open;
        _IBQuery999.Transaction.CommitRetaining;
      except
      on _err : exception do
        begin
          if _IBQuery999.Transaction.InTransaction then
            _IBQuery999.Transaction.Rollback;
          raise Exception.Create(_err.Message);
        end;
      end;
      lCodigo := _IBQuery999.FieldByName('codigo_dav').AsInteger.ToString;

      var _lSQLExec: string;

      _lSQLExec := ' select ' + QuotedStr(lSiglaPixKeyLoc)
        + '||codigo||' + _IBQuery999.FieldByName('codigo_finalizador').AsString + '||data_fechamento||hora_fechamento as pix_keyloc from '
        + lDav + ' where codigo = ' + lCodigo;

      _Cria_IBQuery(nil,998);
      try
        _IBQuery998.Close;
        _IBQuery998.SQL.Text := '';
        _IBQuery998.SQL.Text := _lSQLExec;

         GravarLOGErroRT('TEFRetaguarda_'+StringReplace(DateToStr(Date),'/','',[rfReplaceAll]),'Select pix :' + _IBQuery998.SQL.Text);
        try
          _IBQuery998.Open;
          if (_IBQuery998.IsEmpty) or (_IBQuery998.FieldByName('pix_keyloc').AsString = EmptyStr) then
          begin
            _IBQuery999.SQL.Text := '';
            lDav := 'segunda orcamento';
            _lSQLExec := '';
            _IBQuery999.SQL.Text := ' select codigo_orcamento, tef_nsu as nsu from orcamento_negociacao where tef_retaguarda = ''S'' and tef_rede = '
              + QuotedStr(_TEFCapRede) + ' and tef_indice_adm = ' + QuotedStr(_TEFCapIndADM) + ' and (tef_nsu = ' + QuotedStr(RightStr(_TEFCapCancNSU,6))
              + ' or tef_nsu_host = ' + QuotedStr(_TEFCapCancNSU) + ' or tef_codigo_autorizacao = ' + QuotedStr(RightStr(_TEFCapCancNSU,6))
              + ') and tef_data_fiscal = ' + QuotedStr(_TEFCapEmissaoCancela) + ' and (tef_valor + coalesce(tef_valor_saque,0)) = '
              + StringReplace(CurrToStr(_TEFCapValor),',','.',[rfReplaceAll]);
            GravarLOGErroRT('TEFRetaguarda_'+StringReplace(DateToStr(Date),'/','',[rfReplaceAll]),'Select pix segunda orcamento:' + _IBQuery999.SQL.Text);
            _IBQuery999.Open;
            if _IBQuery999.IsEmpty then
            begin
              lDav := 'segunda os';
              _IBQuery999.SQL.Text := _IBQuery999.SQL.Text.Replace('orcamento', 'os', [rfReplaceAll]);
              GravarLOGErroRT('TEFRetaguarda_'+StringReplace(DateToStr(Date),'/','',[rfReplaceAll]),'Select pix segunda os:' + _IBQuery999.SQL.Text);
              _IBQuery999.Open;
            end;
          end;
          if (_IBQuery998.SQL.Text.Contains('pix_keyloc')) and (_lSQLExec <> EmptyStr) then
            lPixKeyLoc := _IBQuery998.FieldByName('pix_keyloc').AsString
        except
          on E: Exception do
          begin
            if _IBQuery998.Transaction.InTransaction then
              _IBQuery998.Transaction.Rollback;

            Application.ProcessMessages;
            Windows.Beep(800, 200); Sleep(50); Windows.Beep(200, 100);
            while Application.MessageBox('Estorno do PIX na conta do cliente realizado com sucesso!' + #13#13 +
              'Porém, não foi possivel fazer o estorno bancário no Sistema Ganso. Motivo: ' + #13#13 +
              '- Origem dessa movimentação não corresponde a essa tela ou o pix não tinha dados no ganso.' + #13#13 + 'Efetue estorno manualmente ou tente concluir o fechamento!' + #13#13
              + 'Confirma a Leitura da mensagem?',
              'ATENÇÃO', MB_ICONWARNING + MB_YESNO + MB_DEFBUTTON2) = IDNO do
            begin
              Application.ProcessMessages;
              Windows.Beep(800, 200); Sleep(50); Windows.Beep(200, 100);
              // Confirmação de Leitura da Mensagem
            end;
            Windows.Beep(800, 100);

            Abort;
          end;
        end;

        if (_IBQuery998.SQL.Text.Contains('pix_keyloc')) and (lPixKeyloc <> emptystr) then
        begin
          _lSQLExec := '';
          _lSQLExec := ' update conta_movimento set pix_dataestorno = '+QuotedStr(_TEFCapEmissao)
            + ' where pix_keyloc = '+QuotedStr(lPixKeyLoc);
        end
      finally
        _IBQuery998.Close;
        _Destroy_IBQuery(998);
      end;

      _Cria_IBQuery(nil,998);
      try
        if _lSQLExec.Contains('pix_dataestorno') then
        begin
          _IBQuery998.Close;
          _IBQuery998.SQL.Text := '';
          _IBQuery998.SQL.Text := _lSQLExec;
          _IBQuery998.ExecSQL;
          try
            _IBTransaction998.Commit;
          except
            on _err : exception do
            begin
              if _IBQuery998.Transaction.InTransaction then
                _IBQuery998.Transaction.Rollback;
              raise Exception.Create(_err.Message);
            end;
          end;
        end;
      finally
        _IBQuery998.Close;
        _Destroy_IBQuery(998);
      end;

    end
    else if (_ParTipoTEF = 'E') then
    begin
      _IBQuery999.SQL.Text := ' select cl.codigo, cl.codigo_orcamento, cl.codigo_os, cl.nsu from cartao_lancamento cl '
         + ' where ((cl.codigo_rede in (select cp.codigo_cartao_rede from cartao_parametros cp where cp.indice_rede = '+QuotedStr(_TEFCapRede)
         +' and cp.codigo_filial = ' +IntToStr(_CodFilial)+')'+ ' and cl.codigo_administradora in '
         + '(select cp.codigo_cartao_administradora from cartao_parametros cp where cp.indice_administradora = '
         +QuotedStr(_TEFCapIndADM)+' and cp.codigo_filial = '+IntToStr(_CodFilial)+'))'
         + ' or (cl.observacao like '+QuotedStr(_TEFCapRede)+'||'';''||'+QuotedStr(_TEFCapIndADM)+'||''%''))'
         + ' and (cl.nsu = '+QuotedStr(RightStr(_TEFCapCancNSU,6))+ ' or cl.nsu_host = ' + QuotedStr(_TEFCapCancNSU)
         + ' or cl.tef_codigo_autorizacao = '+ QuotedStr(RightStr(_TEFCapCancNSU,6))  + ')'
         + IIF(Trim(_TEFCapEmissaoCancela) = '','',' and cl.data_emissao = '+QuotedStr(_TEFCapEmissaoCancela))
         + ' and (cl.valor + coalesce(cl.tef_valor_saque,0)) = '+StringReplace(CurrToStr(_TEFCapValor),',','.',[rfReplaceAll])
         + ' and cl.codigo_filial = '+IntToStr(_CodFilial);

      GravarLOGErroRT('TEFRetaguarda_'+StringReplace(DateToStr(Date),'/','',[rfReplaceAll]),'Select cartao lancamento:' + _IBQuery999.SQL.Text);
      try
        _IBQuery999.Open;
        if _IBQuery999.IsEmpty then
        begin
          lDav := 'segunda orcamento';
          _IBQuery999.SQL.Text := ' select codigo_orcamento, tef_nsu as nsu from orcamento_negociacao where tef_retaguarda = ''S'' and tef_rede = '
            + QuotedStr(_TEFCapRede) + ' and tef_indice_adm = ' + QuotedStr(_TEFCapIndADM) + ' and (tef_nsu = ' + QuotedStr(RightStr(_TEFCapCancNSU,6))
            + ' or tef_nsu_host = ' + QuotedStr(_TEFCapCancNSU) + ' or tef_codigo_autorizacao = ' + QuotedStr(RightStr(_TEFCapCancNSU,6))
            + ') and tef_data_fiscal = ' + QuotedStr(_TEFCapEmissaoCancela) + ' and (tef_valor + coalesce(tef_valor_saque,0)) = '
            + StringReplace(CurrToStr(_TEFCapValor),',','.',[rfReplaceAll]);
          GravarLOGErroRT('TEFRetaguarda_'+StringReplace(DateToStr(Date),'/','',[rfReplaceAll]),'Select cartao segunda orcamento:' + _IBQuery999.SQL.Text);
          _IBQuery999.Open;
          if _IBQuery999.IsEmpty then
          begin
            lDav := 'segunda os';
            _IBQuery999.SQL.Text := _IBQuery999.SQL.Text.Replace('orcamento', 'os', [rfReplaceAll]);

            GravarLOGErroRT('TEFRetaguarda_'+StringReplace(DateToStr(Date),'/','',[rfReplaceAll]),'Select cartao segunda os:' + _IBQuery999.SQL.Text);
          end;
          _IBQuery999.Open;
        end;

      except
      on _err : exception do
        begin
          if _IBQuery999.Transaction.InTransaction then
            _IBQuery999.Transaction.Rollback;
          raise Exception.Create(_err.Message);
        end;
      end;
    end;

    if (lDav = '') or (lDav = 'segunda orcamento') or (lDav = 'segunda os') then
    begin
      if not (lDav = 'segunda os') and not (_IBQuery999.FieldByName('codigo_orcamento').IsNull) then
      begin
        lDav := 'orcamento';
        lCodigo := _IBQuery999.FieldByName('codigo_orcamento').AsString;
      end
      else
      begin
        lDav := 'os';
        lCodigo := _IBQuery999.FieldByName('codigo_os').AsString;
      end;
      lNSU := _IBQuery999.FieldByName('nsu').AsString;
    end;

    var _lSQLExec: string;

    if not _IBQuery999.SQL.Text.Contains('tef_retaguarda')  then
    begin
      DesbloquearDAVTefEmProcessamento(lCodigo, lDav);
      _lSQLExec := ' update ' + lDAV + '_negociacao set tef_rede = null, tef_indice_adm = null, tef_indice_transacao = null, ';
      _lSQLExec := _lSQLExec + 'tef_nsu = null, tef_valor = null, tef_parcelas = null, tef_predatado = null, tef_data = null, ';
      _lSQLExec := _lSQLExec + 'tef_hora = null, tef_cielo_descpremia = null, ';
      _lSQLExec := _lSQLExec + 'tef_valor_saque = null, tef_codigo_autorizacao = null, tef_nsu_host = null, ';
      _lSQLExec := _lSQLExec + 'tef_indice_instituicao = null, tef_idtermpag = null, tef_bin = null, tef_ultimo_digc = null, ';
      _lSQLExec := _lSQLExec + 'tef_data_fiscal = null, tef_hora_fiscal = null, tef_retaguarda = null, tef_produto = null, ';
      _lSQLExec := _lSQLExec + 'tef_seqcartao = null, tef_temimpr = null, tef_itef = null, tef_num_pag_cupom = null, '
                             + 'valor = valor + coalesce(tef_cielo_descpremia, 0), valor_original = valor_original + '
                             + 'coalesce(tef_cielo_descpremia, 0) ';
      _lSQLExec := _lSQLExec + 'where tef_rede is not null and codigo_' + lDAV + ' = ' + lCodigo + ' and tef_retaguarda = ''S'' ';
      _lSQLExec := _lSQLExec + 'and tef_nsu = ' + lNSU;
    end
    else if lCodigo <> '' then
    begin
      DesbloquearDAVTefEmProcessamento(lCodigo, lDav);
      _lSQLExec := ' update ' + lDAV + '_negociacao set tef_rede = null, tef_indice_adm = null, tef_indice_transacao = null, ';
      _lSQLExec := _lSQLExec + 'tef_nsu = null, tef_valor = null, tef_parcelas = null, tef_predatado = null, tef_data = null, ';
      _lSQLExec := _lSQLExec + 'tef_hora = null, tef_cielo_descpremia = null, ';
      _lSQLExec := _lSQLExec + 'tef_valor_saque = null, tef_codigo_autorizacao = null, tef_nsu_host = null, ';
      _lSQLExec := _lSQLExec + 'tef_indice_instituicao = null, tef_idtermpag = null, tef_bin = null, tef_ultimo_digc = null, ';
      _lSQLExec := _lSQLExec + 'tef_data_fiscal = null, tef_hora_fiscal = null, tef_retaguarda = null, tef_produto = null, ';
      _lSQLExec := _lSQLExec + 'tef_seqcartao = null, tef_temimpr = null, tef_itef = null, tef_num_pag_cupom = null, '
                             + 'valor = valor + coalesce(tef_cielo_descpremia, 0), valor_original = valor_original + '
                             + 'coalesce(tef_cielo_descpremia, 0) ';
      _lSQLExec := _lSQLExec + 'where codigo_' + lDAV + ' = ' + lCodigo + ' and tef_retaguarda = ''S'' and ( (tef_nsu = '+ lNSU +
        ' and tef_itef = 1) or (tef_data_fiscal is not null and tef_nsu is null) ) ';
    end;

    _Cria_IBQuery(nil,998);
    try
      _IBQuery998.Close;
      _IBQuery998.SQL.Text := '';
      _IBQuery998.SQL.Text := _lSQLExec;
      GravarLOGErroRT('TEFRetaguarda_'+StringReplace(DateToStr(Date),'/','',[rfReplaceAll]),'Update negociacao :' + _IBQuery998.SQL.Text);
      try
        _IBQuery998.ExecSQL;
        _IBTransaction998.Commit;
        InsereQueTEFEmProcessamento(lCodigo, lDAV, 'null');
      except
        on _err : exception do
        begin

          if _IBQuery998.Transaction.InTransaction then
            _IBQuery998.Transaction.Rollback;
          ExibirMensagem('ATENÇÃO', 'Estorno da transação no cartão realizado com sucesso, porém não foi possível realizar o cancelamento no ' +
            'Sistema Ganso, verifique.', _err.Message, imInformacao);
          Abort;
        end;
      end;

    finally
      _IBQuery998.Close;
      _Destroy_IBQuery(998);
    end;
  finally
    _Destroy_IBQuery(999);
  end;
end;


procedure TEFPanel(_Mensagem: String = ''; _Cor: TColor = $0058482F; _Visivel: Boolean = True);
begin
  if _Visivel then
  begin
    if not Assigned(frmPanelTEF) then
      frmPanelTEF := TfrmPanelTEF.Create(Application)
    else
      frmPanelTEF.WindowState := wsNormal;

    frmPanelTEF.PanelTEF.Caption := _Mensagem;
    frmPanelTEF.BringToFront;
