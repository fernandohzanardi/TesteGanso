Function IndicadorBuscaCotacao(_CodigoIndicador : Integer = 0; _DataHoraOperacao : String = ''; _CodigoFinalizador : Integer = 0) : Currency;
var
  _DiaOperacao : String;
begin
  Result := 1;
  if (_CodigoIndicador <= 0)and(_CodigoFinalizador <= 0) then Exit;
  _Cria_IBQuery(nil,998);
  _FinIndicadorSimb := FormatSettings.CurrencyString;
  with _IBQuery998 do
  begin
    _IBQuery998.Close;
    if _DataHoraOperacao <> '' then
      _DiaOperacao := ' and ifc.data_hora <= cast( '''+_DataHoraOperacao+''' as TimeStamp) '
    else
      _DiaOperacao := '';

    if _CodigoIndicador > 0 then
    begin
      SQL.Text := ' select first 1 coalesce(ifc.valor,0) as "VALOR", '
                 +' (select ifin.simbolo_moeda from indicador_financeiro ifin where ifin.codigo = ifc.codigo_indicador) as "SIMBOLO" '
                 +' from indicador_financeiro_cotacao ifc '
                 +' where ifc.codigo_indicador = '+IntToStr(_CodigoIndicador)+_DiaOperacao
                 +' order by ifc.data_hora descending ';
    end
    else if _CodigoFinalizador > 0 then // Do Contas a Receber para buscar a Cotação Maior entre dia Emissão e Cot.Atual.
    begin
      if _ParCrUsarMelhorCot = 'S' then
      begin
        SQL.Text := ' select '
                   +'   case when '
                   +'    (select first 1 coalesce(ifc.valor,0) from indicador_financeiro_cotacao ifc '
                   +'    where ifc.codigo_indicador = f.codigo_indicador '+_DiaOperacao
                   +'    order by ifc.data_hora descending) '
                   +'    > '
                   +'    (select first 1 coalesce(ifc.valor,0) from indicador_financeiro_cotacao ifc '
                   +'    where ifc.codigo_indicador = f.codigo_indicador '
                   +'    order by ifc.data_hora descending) '
                   +'    then '
                   +'    (select first 1 coalesce(ifc.valor,0) from indicador_financeiro_cotacao ifc '
                   +'    where ifc.codigo_indicador = f.codigo_indicador '+_DiaOperacao
                   +'    order by ifc.data_hora descending) '
                   +'    else  '
                   +'    (select first 1 coalesce(ifc.valor,0) from indicador_financeiro_cotacao ifc '
                   +'    where ifc.codigo_indicador = f.codigo_indicador '
                   +'    order by ifc.data_hora descending) '
                   +'  end as "VALOR"'
                   +' from finalizador f '
                   +' where f.codigo = '+IntToStr(_CodigoFinalizador);
      end
      else begin
        SQL.Text := ' select '
                   +'    (select first 1 coalesce(ifc.valor,0) from indicador_financeiro_cotacao ifc '
                   +'    where ifc.codigo_indicador = f.codigo_indicador '
                   +'    order by ifc.data_hora descending) as "VALOR" '
                   +' from finalizador f '
                   +' where f.codigo = '+IntToStr(_CodigoFinalizador);
      end;
    end;
    if (_CodigoIndicador > 0)or(_CodigoFinalizador > 0) then
    begin
      Open;
      if not(IsEmpty) then
      begin
        if FieldByName('VALOR').AsCurrency = 0 then Result := 1
        else Result := FieldByName('VALOR').AsCurrency;
        if _CodigoIndicador > 0 then
        begin
          if FieldValues['SIMBOLO'] = null then _FinIndicadorSimb := ''
          else _FinIndicadorSimb := FieldValues['SIMBOLO'];
        end;
      end;
    end;
  end;
  _Destroy_IBQuery(998);
end;

Function NSHD(): String;
var
  Serial:DWord;
  DirLen,Flags: DWord;
  DLabel : Array[0..11] of Char;
  _Drive : String;
begin
  _Drive := Copy(ExtractFilePath(Application.ExeName),1,1);
  Result := '';
  Try
    GetVolumeInformation(PChar(_Drive+':\'),DLabel,12,@Serial,DirLen,Flags,nil,0);
    Result := IntToStr(Serial);
  Except
  end;
end;

Function VerVendaAberta(_CodVenda : Integer) : Boolean;
begin
  { 24/02/2016 - Add Status "C" no IF  CD-1934 - Wéliton Goulart }
  Result := True;
  _Cria_IBQuery(nil,999); // Tratamento esse porq os usuários estavam deixando na pegunta e mandavam o outro fechar a venda
  _IBQuery999.Close;
  _IBQuery999.SQL.Text := ' SELECT STATUS FROM ORCAMENTO WHERE CODIGO = '+IntToSTr(_CodVenda);
