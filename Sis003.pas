function BuscarFormaDePagamento(pCodVenda: Integer; pTabela, pAbreviacao, pCampoWhere: string): string;
var
  lQuery: TIBQuery;
begin
  try
    try
      lQuery := TQueryHelper.CriarQuery(DM.IBbanco);
      lQuery.Close;
      lQuery.SQL.Clear;
      lQuery.SQL.Add(Format(' select f.descricao, %s.valor ', [pAbreviacao]));
      lQuery.SQL.Add(Format(' from %s %s ', [pTabela, pAbreviacao]));
      lQuery.SQL.Add(Format(' left join finalizador f on f.codigo = %s.codigo_finalizador ',[pAbreviacao]));
      lQuery.SQL.Add(Format(' where %s.%s = :pCodOrcamento ', [pAbreviacao, pCampoWhere]));
      lQuery.ParamByName('pCodOrcamento').AsString := pCodVenda.ToString;
      lQuery.Open;
      while not(lQuery.Eof) do
      begin
        Result := Result +lQuery.FieldByName('DESCRICAO').AsString +' ('
                  +FormatFloat(',0.00', lQuery.FieldByName('VALOR').AsCurrency) + '), ';
        lQuery.Next;
      end;
      Result := Copy(Result, 1, Result.Length-2);
    except
      lQuery.Transaction.Rollback;
    end;
  finally
    TQueryHelper.DestruirQuery(lQuery);
  end;
end;

